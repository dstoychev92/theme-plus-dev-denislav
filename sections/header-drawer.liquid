				}
			],
			"visible_if": "{{ section.settings.show_secondary_links == true and section.settings.type_preset_secondary_link != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font_secondary_link",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ section.settings.type_preset_secondary_link == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size_secondary_link",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 5,
			"visible_if": "{{ section.settings.type_preset_secondary_link == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase_secondary_link",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ section.settings.type_preset_secondary_link == 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_preset_account_locale",
			"label": "Account & locale",
