			"id": "type_uppercase_main_link",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ section.settings.type_preset_main_link == 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_preset_secondary_link",
			"label": "Secondary links",
			"default": "p",
			"visible_if": "{{ section.settings.show_secondary_links == true }}",
			"options": [
				{
					"value": "p",
