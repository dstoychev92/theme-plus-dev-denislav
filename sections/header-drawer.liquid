		},
		{
			"type": "select",
			"id": "type_font_main_link",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ section.settings.type_preset_main_link == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size_main_link",
			"label": "Size",
			"min": 1,
