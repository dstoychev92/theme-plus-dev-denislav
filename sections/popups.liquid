					"id": "success_message",
					"label": "Success message",
					"default": "Success! Use code CLUB10 to save 10%",
					"info": "The success message can contain an optional discount code to be applied at checkout."
				},
				{
					"type": "header",
					"content": "Popup behavior"
				},
				{
					"type": "select",
					"id": "position",
					"label": "Position",
					"default": "bottom right",
					"options": [
						{
							"value": "center left",
							"label": "Middle left"
						},
						{
							"value": "center center",
							"label": "Absolute center"
						},
						{
							"value": "center right",
							"label": "Middle right"
						},
						{
							"value": "bottom left",
							"label": "Bottom left"
						},
						{
							"value": "bottom center",
							"label": "Bottom center"
						},
						{
							"value": "bottom right",
							"label": "Bottom right"
						}
					]
				},
				{
					"type": "select",
					"id": "trigger",
					"label": "Delay appearance",
					"default": "always",
					"options": [
						{
							"value": "always",
							"label": "Show immediately"
						},
						{
							"value": "delayed",
							"label": "Show 10 seconds after page load"
						},
						{
							"value": "bottom",
							"label": "Show after user scrolls to page bottom"
						},
						{
							"value": "idle",
							"label": "Show after user has been idle for 1 minute"
						}
					]
				},
				{
					"type": "header",
					"content": "Target page"
				},
				{
					"type": "checkbox",
					"id": "set_target_url",
					"label": "Limit to specific page"
				},
				{
					"type": "url",
					"id": "target_url",
					"label": "Targeted page"
				},
				{
					"type": "header",
					"content": "Target page by URL query parameter"
				},
				{
					"type": "checkbox",
					"id": "set_target_query_parameter",
					"label": "Limit to specific URL query parameter"
				},
				{
					"type": "text",
					"id": "target_query_parameter",
					"label": "Query parameter",
					"info": "Example: 'summersale', then add '?summersale' to the end of the link where you want this popup to appear"
				},
				{
					"type": "header",
					"content": "Target by screen size",
					"info": "Limit this popup to desktop or mobile"
				},
				{
					"type": "select",
					"label": "Show on",
					"id": "target_device",
					"default": "both",
					"options": [
						{
							"value": "mobile",
							"label": "Mobile"
						},
						{
							"value": "desktop",
							"label": "Desktop"
						},
						{
							"value": "both",
							"label": "Both"
						}
					]
				},
			]
		},
		{
			"type": "text",
			"name": "Text popup",
			"settings": [
				{
					"type": "color_scheme",
					"id": "color_scheme",
					"label": "Color scheme"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title",
					"default": "Get 10% off"
				},
				{
					"type": "inline_richtext",
					"id": "text",
					"label": "Text",
					"default": "Sign up to receive a discount on your first purchase"
				},
				{
					"type": "header",
					"content": "Button 1"
				},
				{
					"type": "text",
					"id": "button_text_one",
					"label": "Text",
					"default": "Take quiz"
				},
				{
					"type": "url",
					"id": "button_url_one",
