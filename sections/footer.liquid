<!-- sections/footer.liquid -->

{%- capture content -%}
  <div
    class="
      grid gap-r8 grid-cols-1
      {% if section.settings.custom_col_span %}
        md:grid-cols-[--cols-tablet]
        lg:grid-cols-[--cols-desktop]
      {% else %}
        md:grid-cols-[--columns]
      {% endif %}
    "
    style="
      {% if section.settings.custom_col_span %}
        --cols-desktop: repeat({{ section.settings.columns_lg }}, minmax(0, 1fr));
        --cols-tablet: repeat({{ section.settings.columns_md }}, minmax(0, 1fr));
      {% else %}
        --columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
      {% endif %}
    "
  >
    {% for block in section.blocks %}
      {% render block %}
    {% endfor %}
  </div>
{%- endcapture -%}

{%- render 'core-section', s: section.settings, content: content, photoswipe: false -%}

{% schema %}
{
	"name": "Footer",
	"class": "section-footer",
	"max_blocks": 6,
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-opposite"
		},
		{
			"type": "select",
			"id": "background",
			"label": "Background",
			"default": "canvas",
			"options": [
				{
					"value": "canvas",
					"label": "Default"
				},
				{
					"value": "tint",
					"label": "Tint"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background color",
			"default": "#f2f2f2",
			"alpha": false,
			"visible_if": "{{ section.settings.background == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Block titles"
		},
		{
			"type": "select",
			"id": "color",
			"label": "Color",
			"default": "content",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ section.settings.color == 'custom' }}",
			"label": "Custom color"
		},
		{
			"type": "select",
			"id": "type_preset",
			"label": "Text style",
			"default": "accordion",
			"options": [
				{
					"group": "Headings",
					"value": "h1",
					"label": "Heading 1"
				},
				{
					"group": "Headings",
					"value": "h2",
					"label": "Heading 2"
				},
				{
					"group": "Headings",
					"value": "h3",
					"label": "Heading 3"
				},
				{
					"group": "Headings",
					"value": "h4",
					"label": "Heading 4"
				},
				{
					"group": "Headings",
					"value": "h5",
					"label": "Heading 5"
				},
				{
					"group": "Headings",
					"value": "h6",
					"label": "Heading 6"
				},
				{
					"group": "Content",
					"value": "section",
					"label": "Section title"
				},
				{
					"group": "Content",
					"value": "p",
					"label": "Paragraph"
				},
				{
					"group": "Content",
					"value": "kicker",
					"label": "Kicker"
				},
				{
					"group": "Content",
					"value": "micro",
					"label": "Micro"
				},
				{
					"group": "Elements",
					"value": "btn",
					"label": "Button"
				},
				{
					"group": "Elements",
					"value": "accordion",
					"label": "Accordion"
				},
				{
					"group": "Elements",
					"value": "tab",
					"label": "Tab"
				},
				{
					"group": "Custom",
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ section.settings.type_preset != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ section.settings.type_preset == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 4,
			"visible_if": "{{ section.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ section.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "set_heading_tag",
			"label": "Set HTML tag",
			"visible_if": "{{ settings.show_tag_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "HTML tag",
			"info": "Override the style preset with a specific HTML tag",
			"default": "h2",
			"visible_if": "{{ settings.show_tag_settings == true and section.settings.set_heading_tag == true }}",
			"options": [
				{
					"value": "p",
					"label": "p"
				},
				{
					"value": "h1",
					"label": "h1"
				},
				{
					"value": "h2",
					"label": "h2"
				},
				{
					"value": "h3",
					"label": "h3"
				},
				{
					"value": "h4",
					"label": "h4"
				},
				{
					"value": "h5",
					"label": "h5"
				},
				{
					"value": "h6",
					"label": "h6"
				}
			]
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "checkbox",
			"id": "set_rhythm",
			"label": "Custom rhythm",
			"default": false
		},
		{
			"type": "range",
			"id": "section_padding_top",
			"label": "Spacing top",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "range",
			"id": "section_padding_bottom",
			"label": "Spacing bottom",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "select",
			"id": "content_width",
			"label": "Width",
			"default": "full",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "custom_col_span",
			"label": "Set column grid",
			"default": false
		},
		{
			"type": "range",
			"id": "columns_lg",
			"min": 1,
			"max": 6,
			"step": 1,
			"label": "Desktop",
			"default": 4,
			"visible_if": "{{ section.settings.custom_col_span == true }}"
		},
		{
			"type": "range",
			"id": "columns_md",
			"min": 1,
			"max": 6,
			"step": 1,
			"label": "Tablet",
			"default": 4,
			"visible_if": "{{ section.settings.custom_col_span == true }}"
		}
	],
	"blocks": [
		{
			"type": "_footer-column"
		}
	],
	"presets": [
		{
			"name": "Footer",
			"blocks": [
				{
					"type": "_footer-column",
					"settings": {
						"title": "Main menu"
					},
					"blocks": [
						{
							"type": "_footer-link-list",
							"settings": {
								"linklist": "main-menu"
							}
						}
					]
				},
				{
					"type": "_footer-column",
					"settings": {
						"title": "Quick links"
					},
					"blocks": [
						{
							"type": "_footer-link-list",
							"settings": {
								"linklist": "footer"
							}
						}
					]
				},
				{
					"type": "_footer-column",
					"settings": {
						"title": "About"
					},
					"blocks": [
						{
							"type": "theme-richtext",
							"settings": {
								"text": "<p>Share your brand story, introduce your team, or explain what makes your products unique. This is a great place to connect with your customers and build trust.</p>"
							}
						}
					]
				},
				{
					"type": "_footer-column",
					"settings": {
						"title": "Stay connected"
					},
					"blocks": [
						{
							"type": "theme-form-newsletter"
						},
						{
							"type": "theme-social-links"
						}
					]
				}
			]
		}
	],
	"enabled_on": {
		"groups": [
			"footer"
		]
	}
}
{% endschema %}
