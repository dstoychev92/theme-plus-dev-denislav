<!-- sections/section-pair.liquid -->

{% liquid
  assign column_width = section.settings.column_width
  assign order_mobile = section.settings.order_mobile
%}

{% capture style %}
  --section-content-col-start: section-start;
  --section-content-col-end: section-end;
  {% render 'props-style-gap', _settings: section.settings, apply: false, vars: false %}
  --pair-gap-x: var(--custom-gutter-x);

  {% if section.settings.contain_section %}
    --pair-gap-y: var(--layout-bg-buffer-x);
  {% else %}
    --pair-gap-y: var(--custom-gutter-y);
  {% endif %}
{% endcapture %}

{% capture class %}
  entrance-container
  pair-section-grid
  vars-section-grid-layout-pair
  {% if section.blocks.size > 1 %}
    {% case column_width %}
      {% when 'even' %}
        vars-section-grid-layout-pair-even
      {% when 'first-wide' %}
        vars-section-grid-layout-pair-first-wide
      {% when 'second-wide' %}
        vars-section-grid-layout-pair-second-wide
    {% endcase %}

    {% if order_mobile == 'reversed' %}
      max-md:[&>:first-child]:order-last
    {% endif %}
  {% endif %}
{% endcapture %}

{% capture blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture content %}
  {% if request.visual_preview_mode and section.blocks.size < 2 %}
    {% if section.blocks.size == 1 %}
      {{ blocks }}
      {% render 'pair-column', content: '', background: 'accent', color_scheme: 'scheme-default' %}
    {% elsif section.blocks.size == 0 %}
      {% render 'pair-column', content: '', background: 'accent', color_scheme: 'scheme-default' %}
      {% render 'pair-column', content: '', background: 'accent', color_scheme: 'scheme-default' %}
    {% endif %}
  {% elsif request.design_mode and section.blocks.size == 0 %}
    {% render 'pair-column', content: '', background: 'accent', color_scheme: 'scheme-default' %}
    {% render 'pair-column', content: '', background: 'accent', color_scheme: 'scheme-default' %}
  {% else %}
    {{ blocks }}
  {% endif %}
{% endcapture %}

{% capture attributes %}
  x-data

  {% if section.settings.enable_ensemble %}
    {% if section.settings.autoplay %}
      x-ensemble.autoplay
    {% else %}
      x-ensemble
    {% endif %}
  {% endif %}

  {{ section.shopify_attributes }}
{% endcapture %}

{% render 'core-section-wrapper',
  _settings: section.settings,
  set_rhythm: true,
  content: content,
  style: style,
  class: class,
  attributes: attributes,
  content_padding: 'lg'
%}

{{ 'theme.pair.css' | asset_url | stylesheet_tag: preload: true }}

