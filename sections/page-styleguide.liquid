  {% render 'styleguide-card', content: typography_elements_content %}

  <h2 id="richtext" class="type-h2 mb-r7 mt-r12"><a href="#richtext">Richtext output (page, product description, article, etc.)</a></h2>

  {% capture typographic_prose_sizes_content %}

