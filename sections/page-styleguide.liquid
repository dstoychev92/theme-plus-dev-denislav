      <h3>Typographic elements in type-resize-all-xl prose wrapper</h3>
    </div>

    <div class="prose type-resize-all-lg mt-r8">
      <h3>Typographic elements in type-resize-all-lg prose wrapper</h3>
    </div>

    <div class="prose type-resize-all-md mt-r8">
      <h3>Typographic elements in type-resize-all-md prose wrapper</h3>
    </div>

    <div class="prose type-resize-all-sm mt-r8">
      <h3>Typographic elements in type-resize-all-sm prose wrapper</h3>
