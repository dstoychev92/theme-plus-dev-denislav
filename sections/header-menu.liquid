<!-- sections/header-menu.liquid -->

{% liquid
  assign icon_size = section.settings.icon_size | plus: 110.0 | divided_by: 130.0
  assign icon_stroke_weight = section.settings.icon_stroke_weight

  assign left_items = ''
  assign center_items = ''
  assign right_items = ''

  assign left_items_class = ''
  assign center_items_class = ''
  assign right_items_class = ''

  if section.settings.color_scheme.settings.color_canvas.lightness < 50
    assign header_menu_style = 'dark'
  else
    assign header_menu_style = 'light'
  endif
%}

{% capture class %}
  group/header-menu vars-control-xs md:vars-control-sm
  [--control-font-size:--font-size-calc]
  [--header-menu-link-hit-area-x:calc(var(--header-row-gap-x)/2)]
  {% comment %} We use a 'shadow' so that the mega menu covers the line except when header menu is transparent and thus the header menu will appear to have one continous background {% endcomment %}
  shadow-[0_1px_0px_0px_oklch(var(--content-oklch)/var(--header-section-border-opacity))]
{% endcapture %}

{% capture style %}
  {% render 'props-style-gap', _settings: section.settings, vars: false, apply: false %}
  --header-row-gap-x:var(--custom-gutter-x);
  --icon-size: {{ icon_size }}em;
  {% case icon_stroke_weight %}
    {% when 'light' %}
      --icon-stroke-weight: var(--icon-stroke-weight-light);
    {% when 'bold' %}
      --icon-stroke-weight: var(--icon-stroke-weight-bold);
  {% endcase %}
{% endcapture %}

{% capture attributes %}
  aria-label="{{ 'header.accessibility.global' | t }}"

  {% comment %} Update this section when the cart API is called so the cart icon is updated {% endcomment %}
  x-cart-api-section

  data-header-menu-style="{{ header_menu_style }}"
{% endcapture %}

{% comment %} Always add drawer button to left {% endcomment %}
{% capture left_items %}
  {% render 'header-drawer-button', _settings: section.settings, target_device: section.settings.target_device_drawer_button %}
{% endcapture %}

{% comment %} Handle logo positioning {% endcomment %}

{% if section.settings.logo_position == 'left' %}
  {% capture left_items %}
    {{ left_items }}
    {% render 'header-logo', _settings: section.settings, target_device: 'desktop' %}
  {% endcapture %}
  {% capture center_items %}
    {% render 'header-logo', _settings: section.settings, target_device: 'mobile' %}
  {% endcapture %}
{% elsif section.settings.logo_position == 'center' %}
  {% capture center_items %}
    {% render 'header-logo', _settings: section.settings %}
  {% endcapture %}
{% endif %}

{% comment %} Handle navigation positioning {% endcomment %}
{% if section.settings.target_device_drawer_button == 'mobile' %}
  {% capture navigation %}
    {% render 'header-menu-navigation', _settings: section.settings, target_device: 'desktop' %}
  {% endcapture %}
{% endif %}

{% if section.settings.logo_position == 'left' %}
  {% if section.settings.logo_position_left_menu_position == 'left' %}
    {% comment %} The group containing the navigation should be allowed to shrink so that the content can overflow {% endcomment %}
    {% assign left_items_class = 'md:min-w-0 md:grow-1' %}
    {% assign center_items_class = 'md:hidden' %}
    {% capture left_items %}
      {{ left_items }}
      {{ navigation }}
    {% endcapture %}
  {% elsif section.settings.logo_position_left_menu_position == 'center' %}
    {% comment %} The group containing the navigation should be allowed to shrink so that the content can overflow {% endcomment %}
    {% assign center_items_class = 'md:min-w-0 md:grow-1' %}
    {% capture center_items %}
      {{ center_items }}
      {{ navigation }}
    {% endcapture %}
  {% elsif section.settings.logo_position_left_menu_position == 'right' %}
    {% assign center_items_class = 'md:hidden' %}
    {% comment %} The group containing the navigation should be allowed to shrink so that the content can overflow {% endcomment %}
    {% assign right_items_class = 'md:min-w-0 md:grow-1' %}
    {% capture right_items %}
      {{ navigation }}
    {% endcapture %}
  {% endif %}
{% elsif section.settings.logo_position == 'center' %}
  {% comment %} Navigation is always in the left group when logo is centered so the group content should be allowed to overflow {% endcomment %}
  {% assign left_items_class = 'md:min-w-0 md:grow-1' %}
  {% assign right_items_class = 'md:grow-1' %}
  {% capture left_items %}
    {{ left_items }}
    {{ navigation }}
  {% endcapture %}
{% endif %}

{% comment %} Handle action buttons (always go to right) {% endcomment %}
{% if section.settings.show_search_button
  or section.settings.show_account_button
  or section.settings.show_cart_button
%}
  {% assign has_right_items_on_desktop = false %}
  {% assign has_right_items_on_mobile = false %}

  {% if section.settings.show_cart_button %}
    {% assign has_right_items_on_desktop = true %}
    {% assign has_right_items_on_mobile = true %}
  {% else %}
    {% if section.settings.show_account_button and section.settings.target_device_account_button != 'mobile' %}
      {% assign has_right_items_on_desktop = true %}
    {% endif %}

    {% if section.settings.show_search_button and section.settings.target_device_search_button != 'mobile' %}
      {% assign has_right_items_on_desktop = true %}
    {% endif %}

    {% if section.settings.show_account_button and section.settings.target_device_account_button != 'desktop' %}
      {% assign has_right_items_on_mobile = true %}
    {% endif %}

    {% if section.settings.show_search_button and section.settings.target_device_search_button != 'desktop' %}
      {% assign has_right_items_on_mobile = true %}
    {% endif %}
  {% endif %}

  {% capture right_items %}
    {{ right_items }}
    <div
      class="
        flex-row-center h-full
        {% comment %} Padding is only really needed when the menu is positioned to the right and it's not the last item in the group on Desktop {% endcomment %}
        {% if section.settings.logo_position_left_menu_position == 'right' and has_right_items_on_desktop %}
          md:ps-[calc(var(--header-row-gap-x)/2)]
        {% endif %}

        {% comment %} Trim right padding on last item so it's flush with the grid {% endcomment %}
        last:*:pe-0
        last:*:hit-area-e-[--last-item-hit-area]
      "
      style="
        --last-item-hit-area: min(calc(var(--header-row-gap-x) / 2 + var(--section-content-margin)), 50px);
      "
    >
      {% capture nav_link_icon_type_class %}
        {%- render 'props-class-type-preset', _settings: section.settings, settings_suffix: 'nav_link' -%}
      {% endcapture %}

      {% if section.settings.show_search_button %}
        {% render 'header-phone-button', _settings: section.settings, target_device: section.settings.target_device_search_button, icon_type_class: nav_link_icon_type_class %}
      {% endif %}

      {% if section.settings.show_account_button %}
        {% render 'header-account-button', _settings: section.settings, target_device: section.settings.target_device_account_button, icon_type_class: nav_link_icon_type_class %}
      {% endif %}

      {% if section.settings.show_cart_button %}
        {% render 'header-cart-button', _settings: section.settings, icon_type_class: nav_link_icon_type_class %}
      {% endif %}
    </div>
  {% endcapture %}
{% endif %}

{% capture content %}
  <div
    class="
      focus-group
      flex-row-center
      min-w-fit shrink-1 basis-0 justify-start
      gap-[--header-row-gap-x]

      {% comment %} Trim left padding on first item so it's flush with the grid {% endcomment %}
      first:*:ps-0
      first:*:hit-area-s-[--first-item-hit-area]
      only:*:!hit-area-x-[--first-item-hit-area]
      {% comment %} Equalize left and right groups width on Mobile {% endcomment %}
      max-md:grow-1
      {{ left_items_class }}
    "
    style="
      --first-item-hit-area: min(calc(var(--header-row-gap-x) / 2 + var(--section-content-margin)), 50px);
    "
  >
    {{ left_items }}
  </div>
  <div
    class="
      focus-group
      flex-row-center
      min-w-min flex-initial justify-center
      {{ center_items_class }}
    "
  >
    {{ center_items }}
  </div>
  <div
    class="
      focus-group
      flex-row-center
      min-w-fit shrink-1 basis-0 justify-end

      {% comment %} Equalize left and right groups width on Mobile {% endcomment %}
      max-md:grow-1
      {{ right_items_class }}
    "
  >
    {{ right_items }}
  </div>
{% endcapture %}

{% render 'header-section',
  _settings: section.settings,
  class: class,
  inner_class: 'justify-between',
  attributes: attributes,
  style: style,
  tag: 'nav',
  content: content
%}

{% comment %} Megamenus get rendered outside of the header menu as they use <template> tags who's content is cloned into the correct parent menu item{% endcomment %}
{% content_for 'blocks' %}

{% # Help Google show a brand name and logo in search results or knowledge panels %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
    "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "url": {{ shop.url | json }},
    "sameAs": [
      "https://www.instagram.com/boomcoffee.bg",
      "https://www.facebook.com/boomcoffee.bg",
      "https://www.tiktok.com/@boomcoffee.bg"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "availableLanguage": ["Bulgarian", "English"]
    }
  }
</script>

{% schema %}
