            "quote": "10g протеин в кафето сутрин? Game changer.",
            "rating": 5,
            "gradient_1": "#e0c0a0",
            "gradient_2": "#8b5a2b"
          }
        },
        {
          "type": "_ugc-video-testimonial",
          "settings": {
            "name": "Георги",
