            "quote": "Преди тренировка и след — BOOM е в чантата ми.",
            "rating": 5,
            "gradient_1": "#c4a484",
            "gradient_2": "#6b4423"
          }
        },
        {
          "type": "_ugc-video-testimonial",
          "settings": {
            "name": "Виктория",
            "role": "Майка на две деца",
            "quote": "5 минути сутрин. Толкова отнема. И държи до обяд.",
            "rating": 5,
            "gradient_1": "#d8b894",
            "gradient_2": "#7d5535"
          }
        },
        {
          "type": "_ugc-video-testimonial",
