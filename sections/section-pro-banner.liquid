<!-- sections/section-pro-banner.liquid -->

{% capture content %}
  {% content_for "block", id: "content", type: "_section-content" %}
  {% content_for "blocks" %}

  {% if section.settings.height == 'screen' %}
    {% render 'scroll-button' %}
  {% endif %}
{% endcapture %}

{% capture class %}
  relative entrance-container
{% endcapture %}

{% render 'core-section-wrapper',
  _settings: section.settings,
  content: content,
  contain_controls_rhythm: true,
  contain_disables_transparent_header: true,
  background: 'custom',
  class: class
%}

{% schema %}
{
	"name": "Pro: Banner",
	"tag": "section",
	"settings": [
		{
			"type": "header",
			"content": "Section layout"
		},
		{
			"type": "checkbox",
			"id": "set_height",
			"label": "Set height",
			"default": true
		},
		{
			"type": "select",
			"id": "height",
			"label": "Height",
			"default": "screen-one-third",
			"visible_if": "{{ section.settings.set_height == true }}",
			"options": [
				{
					"value": "screen",
					"label": "Full screen height"
				},
				{
					"value": "screen-five-sixths",
					"label": "Five sixths screen"
				},
				{
					"value": "screen-three-quarters",
					"label": "Three quarters screen"
				},
				{
					"value": "screen-one-half",
					"label": "One half screen"
				},
				{
					"value": "screen-one-third",
					"label": "One third screen"
				},
				{
					"value": "screen-one-quarter",
					"label": "One quarter screen"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "custom_height_type",
			"label": "Height type",
			"default": "percentage",
			"options": [
				{
					"value": "percentage",
					"label": "%"
				},
				{
					"value": "px",
					"label": "px"
				}
			],
			"visible_if": "{{ section.settings.set_height == true and section.settings.height == 'custom' }}"
		},
		{
			"type": "range",
			"id": "custom_height_percentage",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Custom height",
			"default": 33,
			"visible_if": "{{ section.settings.set_height == true and section.settings.height == 'custom' and section.settings.custom_height_type == 'percentage' }}",
			"info": "Percentage of screen height"
		},
		{
			"type": "range",
			"id": "custom_height_px",
			"min": 0,
			"max": 1000,
			"step": 50,
			"unit": "px",
			"label": "Custom height",
			"default": 350,
			"visible_if": "{{ section.settings.set_height == true and section.settings.height == 'custom' and section.settings.custom_height_type == 'px' }}"
		},
		{
			"type": "checkbox",
			"id": "set_height_mobile",
			"label": "Set mobile height",
			"default": false
		},
		{
			"type": "select",
			"id": "height_mobile",
			"label": "Mobile height",
			"default": "screen-one-half",
			"visible_if": "{{ section.settings.set_height_mobile == true }}",
			"options": [
				{
					"value": "screen",
					"label": "Full screen height"
				},
				{
					"value": "screen-five-sixths",
					"label": "Five sixths screen"
				},
				{
					"value": "screen-three-quarters",
					"label": "Three quarters screen"
				},
				{
					"value": "screen-one-half",
					"label": "One half screen"
				},
				{
					"value": "screen-one-third",
					"label": "One third screen"
				},
				{
					"value": "screen-one-quarter",
					"label": "One quarter screen"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "custom_height_type_mobile",
			"label": "Mobile height type",
			"default": "percentage",
			"options": [
				{
					"value": "percentage",
					"label": "%"
				},
				{
					"value": "px",
					"label": "px"
				}
			],
			"visible_if": "{{ section.settings.set_height_mobile == true and section.settings.height_mobile == 'custom' }}"
		},
		{
			"type": "range",
			"id": "custom_height_percentage_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Mobile custom height",
			"default": 33,
			"visible_if": "{{ section.settings.set_height_mobile == true and section.settings.height_mobile == 'custom' and section.settings.custom_height_type_mobile == 'percentage' }}"
		},
		{
			"type": "range",
			"id": "custom_height_px_mobile",
			"min": 0,
			"max": 1000,
			"step": 50,
			"unit": "px",
			"label": "Mobile custom height",
			"default": 350,
			"visible_if": "{{ section.settings.set_height_mobile == true and section.settings.height_mobile == 'custom' and section.settings.custom_height_type_mobile == 'px' }}"
		},
		{
			"type": "checkbox",
			"id": "contain_section",
			"label": "Contain section",
			"default": false
		},
		{
			"type": "select",
			"id": "section_width",
			"label": "Width",
			"visible_if": "{{ section.settings.contain_section }}",
			"default": "full",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				}
			]
		},
		{
			"type": "range",
			"id": "section_padding_top",
			"label": "Spacing top",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.contain_section }}"
		},
		{
			"type": "range",
			"id": "section_padding_bottom",
			"label": "Spacing bottom",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.contain_section }}"
		},
		{
			"type": "checkbox",
			"id": "set_rounding",
			"label": "Set rounding",
			"default": false,
			"visible_if": "{{ section.settings.contain_section }}"
		},
		{
			"type": "select",
			"id": "rounding_radius",
			"label": "Radius",
			"default": "lg",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			],
			"visible_if": "{{ section.settings.set_rounding }}"
		},
		{
			"type": "range",
			"id": "rounding_radius_custom",
			"label": "Radius",
			"unit": "px",
			"min": 0,
			"max": 50,
			"step": 1,
			"default": 20,
			"visible_if": "{{ section.settings.set_rounding and section.settings.rounding_radius == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "set_border",
			"label": "Set border",
			"default": false,
			"visible_if": "{{ section.settings.contain_section }}"
		},
		{
			"type": "range",
			"id": "border_width",
			"label": "Thickness",
			"unit": "px",
			"min": 0,
			"max": 10,
			"step": 0.5,
			"default": 1,
			"visible_if": "{{ section.settings.set_border }}"
		},
		{
			"type": "color",
			"id": "border_color",
			"label": "Color",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ section.settings.set_border }}"
		},
		{
			"type": "header",
			"content": "Content layout"
		},
		{
			"type": "select",
			"id": "content_width",
			"label": "Content Width",
			"default": "page",
			"visible_if": "{{ section.settings.contain_section == false or section.settings.section_width == 'full' }}",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				}
			]
		},
		{
			"type": "select",
			"id": "vertical_placement",
			"label": "Placement",
			"default": "middle",
			"options": [
				{
					"value": "full",
					"label": "↕"
				},
				{
					"value": "top",
					"label": "⤒"
				},
				{
					"value": "middle",
					"label": "—"
				},
				{
					"value": "bottom",
					"label": "⤓"
				}
			]
		},
		{
			"type": "text_alignment",
			"id": "horizontal_placement",
			"label": "Alignment",
			"default": "left"
		},
		{
			"type": "select",
			"id": "content_padding",
			"label": "Padding",
			"default": "lg",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "content_padding_custom",
			"label": "Custom padding",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ section.settings.content_padding == 'custom'  }}"
		},
		{
			"type": "header",
			"content": "Appearance"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-opposite"
		},
		{
			"type": "select",
			"id": "background",
			"label": "Background",
			"default": "transparent",
			"options": [
				{
					"value": "canvas",
					"label": "Default"
				},
				{
					"value": "tint",
					"label": "Tint"
				},
				{
					"value": "transparent",
					"label": "∅"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			],
			"visible_if": "{{ section.settings.contain_section }}"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background color",
			"default": "#ffffff",
			"alpha": false,
			"visible_if": "{{ section.settings.background == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Transparent header",
			"info": "Applies when the header has transparency enabled, and this section is first.",
			"visible_if": "{{ section.settings.contain_section == false and section.settings.enable_transparent == true }}"
		},
		{
			"type": "checkbox",
			"id": "enable_transparent",
			"label": "Enable transparent header",
			"default": true,
			"visible_if": "{{ section.settings.contain_section == false }}"
		},
		{
			"type": "select",
			"id": "transparent_style",
			"visible_if": "{{ section.settings.contain_section == false and section.settings.enable_transparent == true }}",
			"label": "Transparent style",
			"info": "Note: Section content will be pushed down by the header height.",
			"default": "auto",
			"options": [
				{
					"value": "auto",
					"label": "Auto"
				},
				{
					"value": "light",
					"label": "Light"
				},
				{
					"value": "dark",
					"label": "Dark"
				}
			]
		},
		{
			"type": "header",
			"content": "Target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}"
		},
		{
			"type": "checkbox",
			"id": "set_target_device",
			"label": "Set target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"label": "Show on",
			"id": "target_device",
			"default": "desktop",
			"visible_if": "{{ settings.show_target_device_settings == true and section.settings.set_target_device == true }}",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				}
			]
		},
	],
	"blocks": [
		{
			"type": "_section-background"
		}
	],
	"presets": [
		{
			"name": "Pro: Banner",
			"category": "Banner",
			"blocks": [
				{
					"type": "_section-content",
					"static": true,
					"id": "content",
					"blocks": [
						{
							"type": "theme-group-frame",
							"blocks": [
								{
									"type": "theme-text",
									"settings": {
										"text": "Introducing",
										"type_preset": "h5"
									}
								},
								{
									"type": "theme-decoration"
								},
								{
									"type": "theme-text",
									"settings": {
										"text": "Your Title",
										"type_preset": "h2"
									}
								},
								{
									"type": "theme-richtext",
									"settings": {
										"text": "<p>Use this text to share information about your brand.</p>"
									}
								},
								{
									"type": "theme-group-row",
									"settings": {
										"gap": "lg"
									},
									"blocks": [
										{
											"type": "theme-button"
										},
										{
											"type": "theme-link"
										}
									]
								},
							],
						},
					],
				},
				{
					"type": "_section-background",
					"blocks": [
						{
							"type": "_background-image"
						}
					]
				}
			]
		}
	],
	"disabled_on": {
		"groups": [
			"header",
			"custom.overlays",
			"custom.drawers"
		]
	}
}
{% endschema %}
