<!-- sections/404.liquid -->

{%- capture content -%}
  <section class="lg:px-r10 text-content-align">
    <h1 class="type-h1 ">
      <span class="text-content text-r15">{{ 'page.404.title' | t }}</span>

      <br>

      <span class="text-muted text-r10">{{ 'page.404.subheading' | t }}</span>
    </h1>

    <p class="mt-r10 text-r5 max-w-[400px] mx-auto">{{ 'page.404.subtext_html' | t }}</p>
  </section>
{%- endcapture -%}

{%- render 'core-section',
  _settings: section.settings,
  content: content,
  inner_col_class: 'col-section-content justify-center',
  photoswipe: false,
  lazy_alpine: false
-%}

{% schema %}
{
	"name": "404",
	"settings": [
		{
			"type": "header",
			"content": "Style"
		},
		{
			"type": "text_alignment",
			"id": "content_align",
			"label": "Text alignment",
			"default": "center"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "content_width",
			"label": "Content width",
			"default": "page",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "content_width_custom",
			"label": "Desktop width",
			"visible_if": "{{ section.settings.content_width == 'custom' }}",
			"min": 25,
			"max": 100,
			"step": 5,
			"default": 65,
			"unit": "%"
		},
		{
			"type": "range",
			"id": "content_width_custom_mobile",
			"label": "Mobile width",
			"visible_if": "{{ section.settings.content_width == 'custom'  }}",
			"min": 25,
			"max": 100,
			"step": 5,
			"default": 100,
			"unit": "%"
		},
		{
			"type": "checkbox",
			"id": "set_rhythm",
			"label": "Custom rhythm",
			"default": false
		},
		{
			"type": "range",
			"id": "section_padding_top",
			"label": "Spacing top",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "range",
			"id": "section_padding_bottom",
			"label": "Spacing bottom",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
	]
}
{% endschema %}
