<!-- sections/section-text-spotlight.liquid -->

{% comment %}
  Section: Spotlight Text
  Large animated text with scroll-driven stagger effects. Text words animate in
  individually as the user scrolls — dramatic for brand statements, editorial
  intros, or manifesto-style content.

  Accepts _spotlight-text blocks (the animated text) plus theme-decoration,
  theme-icon, _inline-spacer, and _inline-image for embellishment.

  Scroll animation can trigger on enter, exit, or both. When height is set to
  "screen", enable_sticky pins the text in the viewport during the scroll
  animation. Optional background media (image or video) with overlay for
  cinematic effects.

  Typography uses the preset+custom pattern. Content width constrains how wide
  the text block can be within the section.
{% endcomment %}

{% liquid
  assign height = section.settings.height

  assign enable_sticky = false

  if height == 'screen' and section.settings.enable_sticky
    assign enable_sticky = true
  endif

  assign set_background_media = section.settings.set_background_media

  if set_background_media == true
    assign padding = false
  endif
%}
{% capture text %}
  <div
    {% if section.settings.enable_scroll_animation %}
      data-lazy-alpine
      data-lazy-alpine-module="@theme/scroll-stagger"
      x-scroll-stagger="
        {
          selector: '[data-scroll-stagger-item]',

          {% comment %} Start each word animation when the previous word is this percentage of the way through its animation {% endcomment %}
          stagger: 0.1,

          target: $sectionEl.querySelector('section-content'),

          {% if section.settings.height == 'screen' and section.settings.enable_sticky %}
            scrollOffset: ['25% 100%', '50% 0%'],
          {% else %}
            {% comment %}
            Start the enter stagger animations when the container is 25% visible at the bottom of the
            viewport and stop when the bottom of the container is 50% of the way through the viewport.
            Start the leave stagger animations when the top of the container
            meets the top of the viewport and end when the container is 75% out of view
            {% endcomment %}
            scrollOffset: ['25% 100%', '50% 50%', '0% 0%', '75% 0%'],
          {% endif %}
        }
      "
      {% if section.settings.scroll_animation_mode == 'enter' or section.settings.scroll_animation_mode == 'both' %}
      x-scroll-stagger:enter="{
        opacity: [0.1, 1.0]
      }"
      {% endif %}
      {% if section.settings.scroll_animation_mode == 'exit' or section.settings.scroll_animation_mode == 'both' %}
      x-scroll-stagger:leave="{
        opacity: [1.0, 0.1]
      }"
      {% endif %}
    {% endif %}
    class="
      text-content
      {% render 'props-class-type-preset', s: section.settings %}
      {% comment %} Make sure line-height is enough so the full-background highlight won't overlap the text on the previous/next row {% endcomment %}
      [--leading:1.4]

      overflow-hidden
      *:auto-stagger-animations-[--entrance-animation-stagger]
    "
    style="
      --entrance-animation-stagger: 150ms;
    "
  >
    {% content_for 'blocks' %}
  </div>
{% endcapture %}

{% capture placement_class %}
  {% if enable_sticky %}
    {% render 'props-class-custom-height', s: section.settings, mode: 'height' %}
    sticky top-0
  {% endif %}
{% endcapture %}

{% capture placement_style %}
  {% if enable_sticky %}
    {% render 'props-style-custom-height', s: section.settings %}
  {% endif %}
{% endcapture %}

{% capture placement %}
  {% render 'core-placement-grid', s: section.settings, content: text, class: placement_class, style: placement_style %}
{% endcapture %}

{% capture class %}
  {% if enable_sticky %}
    h-[200svh]
  {% else %}
    {% render 'props-class-custom-height', s: section.settings %}
  {% endif %}
{% endcapture %}

{% capture style %}
  {% if enable_sticky == false %}
    {% render 'props-style-custom-height', s: section.settings %}
  {% endif %}
{% endcapture %}

{% capture blocks %}
  {% render 'core-section-content', content: placement, s: section.settings %}

  {% if set_background_media == true %}
    {% capture background_media %}
      {% render 'core-background-media', s: section.settings %}
    {% endcapture %}

    {% capture background %}
      {% render 'core-background', content: background_media, s: section.settings %}
    {% endcapture %}

    {% render 'core-section-background', content: background, s: section.settings %}
  {% endif %}
{% endcapture %}

{% render 'core-section-wrapper',
  s: section.settings,
  padding: padding,
  content: blocks,
  class: class,
  style: style,
  photoswipe: false
%}

