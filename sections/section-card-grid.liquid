<!-- sections/section-card-grid.liquid -->

{% comment %}
  Section: Card Grid
  Static grid layout for product, collection, or article cards — all cards
  visible at once (no scrolling).

  Same block types as card-slider (_section-title, _cards-products,
  _cards-collections, _cards-articles) but renders in a grid rather than a
  carousel. Column count is configurable per breakpoint.

  Better for SEO than sliders since all content is visible. Cards stack into
  fewer columns on mobile. Content width can be full-bleed or page-contained.

  Gap uses the standard preset+custom pattern (sm/md/lg/custom).
{% endcomment %}

{% capture header %}
  {% content_for 'block', type: '_section-title', id: 'header' %}
{% endcapture %}

{% capture list_items %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'core-section-card-list',
  s: section.settings,
  list_items: list_items,
  header: header,
  layout_desktop: 'grid',
  layout_tablet: 'grid',
  class: 'entrance-container'
%}

{% schema %}
{
	"name": "Card grid",
	"class": "section-card-grid",
	"tag": "section",
	"settings": [
		{
			"type": "header",
			"content": "Columns"
		},
		{
			"type": "range",
			"id": "columns_lg",
			"min": 2,
			"max": 6,
			"step": 1,
			"label": "Desktop",
			"default": 4
		},
		{
			"type": "range",
			"id": "columns_md",
			"min": 2,
			"max": 6,
			"step": 1,
			"label": "Tablet",
			"default": 4
		},
		{
			"type": "select",
			"id": "layout_mobile",
			"label": "Mobile layout",
			"default": "slider",
			"options": [
				{
					"value": "slider",
					"label": "Carousel"
				},
				{
					"value": "grid",
					"label": "Grid"
				}
			]
		},
		{
			"type": "select",
			"id": "columns_sm_grid",
			"label": "Mobile columns",
			"default": "2",
			"options": [
				{
					"value": "1",
					"label": "1"
				},
				{
					"value": "2",
					"label": "2"
				}
			],
			"visible_if": "{{ section.settings.layout_mobile == 'grid' }}"
		},
		{
			"type": "select",
			"label": "Progress bar",
			"id": "progress_bar_visibility",
			"default": "mobile",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "never",
					"label": "Never"
				}
			],
			"visible_if": "{{ section.settings.layout_mobile == 'slider' }}"
		},
		{
			"type": "header",
			"content": "Section layout"
		},
		{
			"type": "select",
			"id": "content_width",
			"label": "Content width",
			"default": "page",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "content_width_custom",
			"label": "Desktop width",
			"visible_if": "{{ section.settings.content_width == 'custom'  }}",
			"min": 25,
			"max": 100,
			"step": 5,
			"default": 65,
			"unit": "%"
		},
		{
			"type": "paragraph",
			"visible_if": "{{ section.settings.content_width == 'custom' and section.settings.layout_mobile != 'grid'  }}",
			"content": "Mobile width is unavailable for carousel layout."
		},
		{
			"type": "range",
			"id": "content_width_custom_mobile",
			"label": "Mobile width",
			"visible_if": "{{ section.settings.content_width == 'custom'  and section.settings.layout_mobile == 'grid'   }}",
			"min": 25,
			"max": 100,
			"step": 5,
			"default": 100,
			"unit": "%"
		},
		{
			"type": "checkbox",
			"id": "set_rhythm",
			"label": "Custom rhythm",
			"default": false
		},
		{
			"type": "range",
			"id": "section_padding_top",
			"label": "Spacing top",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "range",
			"id": "section_padding_bottom",
			"label": "Spacing bottom",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "header",
			"content": "Content layout"
		},
		{
			"type": "text_alignment",
			"id": "title_placement",
			"label": "Title alignment",
			"default": "center"
		},
		{
			"type": "checkbox",
			"id": "set_gap_tab_y",
			"label": "Set vertical gap",
			"default": false
		},
		{
			"type": "select",
			"id": "gap_tab_y",
			"label": "Vertical gap",
			"default": "sm",
			"visible_if": "{{ section.settings.set_gap_tab_y }}",
			"options": [
				{
