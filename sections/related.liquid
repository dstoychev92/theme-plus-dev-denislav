			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ section.settings.enable_typography == true }}"
		},
		{
			"type": "header",
			"content": "Navigation"
		},
		{
			"type": "checkbox",
			"id": "set_pagination_style",
			"label": "Set button style",
			"default": false
		},
		{
			"type": "select",
			"id": "slider_control_style",
			"label": "Background style",
			"default": "tint",
			"options": [
				{
					"value": "tint",
					"label": "Tint"
				},
				{
					"value": "outline",
					"label": "Outline"
				},
				{
					"value": "bare",
					"label": "∅"
				}
			],
			"visible_if": "{{ section.settings.set_pagination_style }}"
		},
		{
			"type": "select",
			"label": "Progress bar",
			"id": "progress_bar_visibility",
			"default": "desktop",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				},
				{
					"value": "both",
					"label": "Both"
				},
				{
					"value": "never",
					"label": "Never"
				}
			]
		},
		{
			"type": "header",
			"content": "Target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}"
		},
		{
			"type": "checkbox",
			"id": "set_target_device",
			"label": "Set target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"label": "Show on",
			"id": "target_device",
			"default": "desktop",
			"visible_if": "{{ settings.show_target_device_settings == true and section.settings.set_target_device == true }}",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				}
			]
		},
	],
	"blocks": [
		{
			"type": "_related-tab-related-products"
		},
		{
			"type": "_related-tab-recent-products"
		},
		{
			"type": "_cards-tab"
		}
	],
	"presets": [
		{
			"name": "Related products",
			"category": "Cards",
			"blocks": [
				{
					"id": "header",
					"type": "_section-title",
					"static": true,
					"settings": {
						"text": "You may also like"
					}
				},
				{
					"type": "_related-tab-related-products"
				},
				{
					"type": "_related-tab-recent-products"
				}
			]
		}
	],
	"enabled_on": {
		"templates": [
			"product"
		]
	}
