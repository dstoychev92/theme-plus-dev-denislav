<!-- sections/section-custom.liquid -->

{% capture blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture style %}
  --section-content-col-start: section-start;
  --section-content-col-end: section-end;
  {%- if section.settings.background_image -%}
    {%- assign background_image_url = section.settings.background_image | image_url: width: 2000 -%}
    {%- if section.settings.overlay_color != blank and section.settings.overlay_opacity > 0 -%}
      {%- assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0 -%}
      {%- assign overlay_rgba = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha -%}
      background-image: linear-gradient({{ overlay_rgba }}, {{ overlay_rgba }}), url({{ background_image_url }});
    {%- else -%}
      background-image: url({{ background_image_url }});
    {%- endif -%}
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  {%- endif -%}
{% endcapture %}

{% liquid
  assign alignment = section.settings.alignment | default: section.settings.content_align
  assign gap = section.settings.gap | default: false, allow_false: true
%}

{% capture wrapped_blocks %}
  <div
    class="
      flex flex-col h-full

      text-content-align
      vars-content-align-{{ alignment }}
      items-content-align
    "
    style="
      {%- if gap -%}
        {% render 'props-style-gap', _settings: section.settings %}
      {%- endif -%}
    "
  >
    {{ blocks }}
  </div>
{% endcapture %}

{% render 'core-section',
  _settings: section.settings,
  content: wrapped_blocks,
  class: 'entrance-container',
  style: style
%}

{% schema %}
{
	"name": "Custom",
	"tag": "section",
	"settings": [
		{
			"type": "header",
			"content": "Section layout"
		},
		{
			"type": "checkbox",
			"id": "contain_section",
			"label": "Contain section",
			"default": true
		},
		{
			"type": "select",
			"id": "section_width",
			"label": "Width",
			"visible_if": "{{ section.settings.contain_section }}",
			"default": "page",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "set_rhythm",
			"label": "Custom rhythm",
			"default": false
		},
		{
			"type": "range",
			"id": "section_padding_top",
			"label": "Spacing top",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "range",
			"id": "section_padding_bottom",
			"label": "Spacing bottom",
			"min": 0,
			"max": 200,
			"step": 2,
			"unit": "px",
			"default": 40,
			"visible_if": "{{ section.settings.set_rhythm == true  }}"
		},
		{
			"type": "header",
			"content": "Content layout"
		},
		{
			"type": "select",
			"id": "gap",
			"label": "Gap",
			"default": "md",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom",
			"label": "Custom gap",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ section.settings.gap == 'custom'  }}"
		},
		{
			"type": "text_alignment",
			"id": "alignment",
			"label": "Alignment",
			"default": "center"
		},
		{
			"type": "header",
			"content": "Appearance"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme"
		},
		{
			"type": "select",
			"id": "background",
			"label": "Background",
			"default": "canvas",
			"options": [
				{
					"value": "canvas",
					"label": "Default"
				},
				{
					"value": "tint",
					"label": "Tint"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background color",
			"default": "#f2f2f2",
			"alpha": false,
			"visible_if": "{{ section.settings.background == 'custom' }}"
		},
		{
			"type": "image_picker",
			"id": "background_image",
			"label": "Background image"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"label": "Overlay opacity",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"default": 0,
			"visible_if": "{{ section.settings.background_image != blank }}"
		},
		{
			"type": "color",
			"id": "overlay_color",
			"label": "Overlay color",
			"default": "#000000",
			"visible_if": "{{ section.settings.background_image != blank }}"
		},
		{
			"type": "header",
			"content": "Target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}"
		},
		{
			"type": "checkbox",
			"id": "set_target_device",
			"label": "Set target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"label": "Show on",
			"id": "target_device",
			"default": "desktop",
			"visible_if": "{{ settings.show_target_device_settings == true and section.settings.set_target_device == true }}",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				}
			]
		},
	],
	"blocks": [
		{
			"type": "theme-badge"
		},
		{
			"type": "theme-button"
		},
		{
			"type": "theme-countdown"
		},
		{
			"type": "theme-decoration"
		},
		{
			"type": "theme-form-newsletter"
		},
		{
			"type": "theme-text"
		},
		{
			"type": "theme-image"
		},
		{
			"type": "theme-video"
		},
		{
			"type": "theme-icon"
		},
		{
			"type": "theme-link"
		},
		{
			"type": "theme-liquid-code"
		},
		{
			"type": "theme-social-links"
		},
		{
			"type": "theme-spacer"
		},
		{
			"type": "theme-richtext"
		},
		{
			"type": "theme-video-button"
		},
		{
			"type": "_card-showcase"
		},
		{
			"type": "_accordion-group"
		},
		{
			"type": "_tabs"
		},
		{
			"type": "theme-group-frame",
		},
		{
			"type": "theme-group-row",
		},
		{
			"type": "theme-group-flex",
		},
		{
			"type": "theme-group-text",
		},
		{
			"type": "theme-group-target",
		},
		{
			"type": "_group-grid",
		},
		{
			"type": "_glass-cup",
		},
		{
			"type": "@app",
		}
	],
	"presets": [
		{
			"name": "Custom",
			"category": "Custom"
		},
		{
			"name": "Text",
			"category": "Text",
			"blocks": [
				{
					"type": "theme-text",
					"settings": {
						"text": "Introducing",
						"type_preset": "h5"
					}
				},
				{
					"type": "theme-decoration"
				},
				{
					"type": "theme-text",
					"settings": {
						"text": "Your Title",
						"type_preset": "h2"
					}
				},
				{
					"type": "theme-button",
					"settings": {
						"text": "View products",
						"href": "shopify://collections/all",
					}
				}
			]
		}
	],
	"disabled_on": {
		"groups": [
			"header",
			"custom.overlays",
			"custom.drawers"
		]
	}
}
{% endschema %}
