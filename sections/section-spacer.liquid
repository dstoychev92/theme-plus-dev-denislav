<!-- sections/section-spacer.liquid -->

<div
  class="
    {% if settings.show_target_device_settings == true and section.settings.set_target_device == true %}
      {% render 'props-class-target-device', target_device: section.settings.target_device %}
    {% endif %}
  "
  style="
    height: calc({{ section.settings.spacer_section_height }}px * var(--r-multiplier));
    background-color: {{ section.settings.bg_color }};
  "
></div>

{% schema %}
{
	"name": "Spacer",
	"tag": "section",
	"settings": [
		{
			"type": "range",
			"id": "spacer_section_height",
			"min": 0,
			"max": 500,
			"step": 5,
			"unit": "px",
			"label": "Height",
			"default": 100
		},
		{
			"type": "color",
			"id": "bg_color",
			"label": "Background",
			"default": "#FFFFFF"
		},
		{
			"type": "header",
			"content": "Target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}"
		},
		{
			"type": "checkbox",
			"id": "set_target_device",
			"label": "Set target device",
			"visible_if": "{{ settings.show_target_device_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"label": "Show on",
			"id": "target_device",
			"default": "desktop",
			"visible_if": "{{ settings.show_target_device_settings == true and section.settings.set_target_device == true }}",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				}
			]
		},
	],
	"presets": [
		{
			"name": "Spacer",
			"category": "Custom"
		}
	],
	"disabled_on": {
		"groups": [
			"header",
			"custom.overlays",
			"custom.drawers"
		]
	}
}
{% endschema %}
