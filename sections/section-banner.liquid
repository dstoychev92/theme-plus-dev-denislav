<!-- sections/section-banner.liquid -->

{% comment %}
  Section: Banner
  The workhorse hero section. Full-width background media (image or video) with
  text overlay, flexible height, optional parallax, and transparent header
  support for seamless hero experiences.

  Accepts any theme-* content blocks plus _grid-editorial for layout. Content is
  positioned via horizontal_placement (left/center/right) and
  vertical_placement (top/middle/bottom) over the background media.

  Height options: screen fractions (screen, screen-five-sixths, etc.), content-
  based ("image" uses the image's natural height), or custom px/%. Parallax is
  disabled when height is set to "image" because the image already defines the
  section's size.

  Color scheme defaults to "scheme-opposite" (typically dark) so light text
  reads over imagery. Overlay opacity/color darken the background for
  readability — values of 8-20 with black work well for most photography.
{% endcomment %}

{% liquid
  # Can't do parallax if height is set to content
  if section.settings.height == 'image'
    assign parallax = false
  endif
%}

{% capture content_blocks %}
  {% content_for "blocks" %}
{% endcapture %}

{% capture placement %}
  {% render 'core-placement-grid', content: content_blocks, s: section.settings %}
{% endcapture %}

{% capture banner_widths %}
  {% comment %} Note: do not exceed 6 widths for images that will be preloaded. Shopify will ignore this image for preloading if it has more than 6 srcset items. {% endcomment %}
  832, 1200, 1600, 1920, 2560, 3840
{% endcapture %}

{% capture background_media %}
  {% render 'core-background-media', s: section.settings, widths: banner_widths, sizes: '100vw' %}
{% endcapture %}

{% capture background %}
  {% render 'core-background', content: background_media, parallax: parallax, s: section.settings %}
{% endcapture %}

{% capture content_class %}
  {% comment %} This allows the content to be offset by the header height for browsers that don't support subgrid {% endcomment %}
  top-[--banner-content-top-offset]
{% endcapture %}

{% capture blocks %}
  {% render 'core-section-content', class: content_class, content: placement, s: section.settings %}
  {% render 'core-section-background', content: background, s: section.settings %}

  {% if section.settings.height == 'screen' %}
    {% render 'scroll-button' %}
  {% endif %}
{% endcapture %}

{% capture class %}
  relative entrance-container
{% endcapture %}

{% render 'core-section-wrapper',
  s: section.settings,
  content: blocks,
  contain_controls_rhythm: true,
  contain_disables_transparent_header: true,
  contain_controls_background: true,
  class: class
%}

