					"label": "Kicker"
				},
				{
					"group": "Content",
					"value": "micro",
					"label": "Micro"
				},
				{
					"group": "Elements",
					"value": "btn",
					"label": "Button"
				},
				{
					"group": "Elements",
					"value": "accordion",
					"label": "Accordion"
				},
				{
					"group": "Elements",
					"value": "tab",
