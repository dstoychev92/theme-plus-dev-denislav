<!-- sections/section-card-slider-tabs.liquid -->

{% capture header %}
  {% content_for 'block', type: '_section-title', id: 'header' %}
{% endcapture %}

{% for block in section.blocks %}
  {% capture tabs %}
    {{ tabs }}
    <template x-clone="tabTemplates[{{ forloop.index0 }}]"></template>
  {% endcapture %}

  {% capture tab_panels %}
    {{ tab_panels }}
    {% render block %}
  {% endcapture %}
{% endfor %}

{% if header != blank and section.blocks.size != 1 %}
  {% capture title_row_content %}
    {{ header }}
  {% endcapture %}
{% endif %}

{% if section.blocks.size > 1 %}
  {% capture header_area_content %}
    {% render 'core-tablist', tabs: tabs, _settings: section.settings, class: 'z-20 self-center' %}
  {% endcapture %}
{% else %}
  {% capture header_area_content %}
    {{ header }}
  {% endcapture %}
{% endif %}

{% capture attributes %}
  x-tabs
  x-data="{
    sidePrevInView: false,
    sideNextInView: false,
    get overflowButtonPlacement() {
      return (this.sidePrevInView && this.sideNextInView) ? 'side' : 'top'
    },
    get tabTemplates() {
      const templates = Array.from($el.querySelectorAll('[data-tab-template]'));
      return templates.sort((a, b) => {
        const indexA = parseInt(a.getAttribute('data-tab-template') ?? '0', 10);
        const indexB = parseInt(b.getAttribute('data-tab-template') ?? '0', 10);
        return indexA - indexB;
      });
    }
  }"
  {{ attributes }}
{% endcapture %}

<style>
  #shopify-section-{{ section.id }} [role="tab"] {
    --tab-px: calc(var(--control-padding) * 3);
    line-height: 1;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  {% if section.settings.filled_tabs %}
    #shopify-section-{{ section.id }} [data-layout-id="{{ section.id }}-tab-outline"] {
      background-color: var(--content);
    }
    #shopify-section-{{ section.id }} [role="tab"][aria-selected="true"] {
      color: var(--canvas);
    }
  {% endif %}
</style>

{% render 'core-section-card-slider-tabs-layout',
  _settings: section.settings,
  title_row_content: title_row_content,
  header_area_content: header_area_content,
  tab_panels: tab_panels,
  tab_count: section.blocks.size,
  class: 'entrance-container',
  attributes: attributes
%}

