<!-- blocks/_card-custom-details.liquid -->

{% capture blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if blocks != blank %}
  <div class="flex flex-col gap-y-r4 text-content-align vars-content-align-{{ block.settings.content_align | default: 'start' }} items-content-align entrance-container p-r6">
    {{ blocks }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Below image",
  "tag": null,
  "settings": [
    {
      "type": "text_alignment",
      "id": "content_align",
      "label": "Alignment",
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
