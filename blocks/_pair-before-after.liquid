<!-- blocks/_pair-before-after.liquid -->

{% capture attributes %}
  {{ block.shopify_attributes }}
{% endcapture %}

{% capture content %}
  {% render 'before-after', _settings: block.settings, attributes: attributes %}
{% endcapture %}

{% capture class %}
  overflow-hidden pair-media
{% endcapture %}

{% render 'pair-column',
  content: content,
  _settings: block.settings,
  class: class,
  attributes: attributes,
  is_media_block: true
%}

{% schema %}
{
	"name": "Before/After",
	"tag": null,
	"settings": [
		{
			"type": "image_picker",
			"id": "before_image",
			"label": "Before Image"
		},
		{
			"type": "image_picker",
			"id": "after_image",
			"label": "After Image"
		},
		{
			"type": "select",
			"id": "orientation",
			"label": "Orientation",
			"default": "horizontal",
			"options": [
				{
					"value": "horizontal",
					"label": "Horizontal"
				},
				{
					"value": "vertical",
					"label": "Vertical"
				}
			]
		},
		{
			"type": "color",
			"id": "handle_color",
			"label": "Handle color",
			"default": "#FFFFFF"
		},
		{
			"type": "range",
			"id": "start_position",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Start position",
			"default": 50
		},
		{
			"type": "header",
			"content": "Border"
		},
		{
			"type": "checkbox",
			"id": "set_border",
			"label": "Set border",
			"default": false
		},
		{
			"type": "range",
			"id": "border_width",
			"label": "Thickness",
			"unit": "px",
			"min": 0,
			"max": 10,
			"step": 0.5,
			"default": 1,
			"visible_if": "{{ block.settings.set_border }}"
		},
		{
			"type": "color",
			"id": "border_color",
			"label": "Color",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.set_border }}"
		},
		{
			"type": "header",
			"content": "Rounding"
		},
		{
			"type": "checkbox",
			"id": "set_rounding",
			"label": "Set rounding",
			"default": false
		},
		{
			"type": "select",
			"id": "rounding_radius",
			"label": "Radius",
			"default": "lg",
			"options": [
				{
					"value": "none",
					"label": "0"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			],
			"visible_if": "{{ block.settings.set_rounding  }}"
		},
		{
			"type": "range",
			"id": "rounding_radius_custom",
			"label": "Radius",
			"unit": "px",
			"min": 0,
			"max": 50,
			"step": 1,
			"default": 20,
			"visible_if": "{{ block.settings.set_rounding and block.settings.rounding_radius == 'custom'  }}"
		},
		{
			"type": "header",
			"content": "Height"
		},
		{
			"type": "select",
			"id": "height",
			"label": "Desktop height",
			"default": "screen-one-half",
			"visible_if": "{{ section.settings.height_mode == 'column' }}",
			"options": [
				{
					"value": "image",
					"label": "Image height"
				},
				{
					"value": "screen",
					"label": "Full screen height"
				},
				{
					"value": "screen-five-sixths",
					"label": "Five sixths screen"
				},
				{
					"value": "screen-three-quarters",
					"label": "Three quarters screen"
				},
				{
					"value": "screen-one-half",
					"label": "One half screen"
				},
				{
					"value": "screen-one-third",
					"label": "One third screen"
				},
				{
					"value": "screen-one-quarter",
					"label": "One quarter screen"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "custom_height_type",
			"label": "Height type",
			"default": "percentage",
			"options": [
				{
					"value": "percentage",
					"label": "%"
				},
				{
					"value": "px",
					"label": "px"
				}
			],
			"visible_if": "{{ section.settings.height_mode == 'column' and block.settings.height == 'custom' }}"
		},
		{
			"type": "range",
			"id": "custom_height_percentage",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Custom height",
			"default": 33,
			"visible_if": "{{ section.settings.height_mode == 'column' and block.settings.height == 'custom' and block.settings.custom_height_type == 'percentage' }}",
			"info": "Percentage of screen height"
		},
		{
			"type": "range",
			"id": "custom_height_px",
			"min": 0,
			"max": 1000,
			"step": 50,
			"unit": "px",
			"label": "Custom height",
			"default": 350,
			"visible_if": "{{ section.settings.height_mode == 'column' and block.settings.height == 'custom' and block.settings.custom_height_type == 'px' }}"
		},
		{
			"visible_if": "{{ section.settings.height_mode != 'column' }}",
			"type": "paragraph",
			"content": "Desktop height setting isn't available when the height is set by the section."
		},
		{
			"type": "select",
			"id": "height_mobile",
			"label": "Mobile height",
			"default": "image",
			"options": [
				{
					"value": "image",
					"label": "Image height"
				},
				{
					"value": "screen",
					"label": "Full screen height"
				},
				{
					"value": "screen-five-sixths",
					"label": "Five sixths screen"
				},
				{
					"value": "screen-three-quarters",
					"label": "Three quarters screen"
				},
				{
					"value": "screen-one-half",
					"label": "One half screen"
				},
				{
					"value": "screen-one-third",
					"label": "One third screen"
				},
				{
					"value": "screen-one-quarter",
					"label": "One quarter screen"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "custom_height_type_mobile",
			"label": "Mobile height type",
			"default": "percentage",
			"options": [
				{
					"value": "percentage",
					"label": "%"
				},
				{
					"value": "px",
					"label": "px"
				}
			],
			"visible_if": "{{ block.settings.height_mobile == 'custom' }}"
		},
		{
			"type": "range",
			"id": "custom_height_percentage_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Mobile custom height",
			"default": 33,
			"visible_if": "{{ block.settings.height_mobile == 'custom' and block.settings.custom_height_type_mobile == 'percentage' }}"
		},
		{
			"type": "range",
			"id": "custom_height_px_mobile",
			"min": 0,
			"max": 1000,
			"step": 50,
			"unit": "px",
			"label": "Mobile custom height",
			"default": 350,
			"visible_if": "{{ block.settings.height_mobile == 'custom' and block.settings.custom_height_type_mobile == 'px' }}"
		},
	],
	"presets": [
		{
			"name": "Before/After",
			"category": "Banner"
		}
	]
}
{% endschema %}
