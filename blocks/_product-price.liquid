<!-- blocks/_product-price.liquid -->

{%- liquid
  assign product = closest.product
  assign current_variant = product.selected_or_first_available_variant

  # Check if subscription discount exists but no regular sale
  assign has_subscription_discount = false
  assign has_regular_sale = false

  if current_variant
    if current_variant.compare_at_price != blank and current_variant.compare_at_price > current_variant.price
      assign has_regular_sale = true
    endif

    if product.selling_plan_groups.size > 0
      assign _selling_plan = product.selected_selling_plan
      if product.requires_selling_plan and _selling_plan == blank
        assign _selling_plan = product.selected_or_first_available_selling_plan_allocation.selling_plan | default: product.selling_plan_groups[0].selling_plans[0]
      endif
      if _selling_plan
        assign _adj = _selling_plan.price_adjustments[0]
        if _adj.value_type == 'price'
          if _adj.value < current_variant.price
            assign has_subscription_discount = true
          endif
        elsif _adj.value > 0
          assign has_subscription_discount = true
        endif
      endif
    endif
  endif

  # NOTE: The dedicated subscription price snippet (product-form-price-subscription)
  # is disabled for this store — the subscription total is shown inside <product-price>
  # itself, kept in sync by the custom quantity block. So we must NOT hide it on
  # subscription, otherwise the main price vanishes when switching to a selling plan.
  assign hide_product_price = false
-%}

{%- capture price_content -%}
  <product-price
    class="
      flex-row-center flex-wrap gap-r6 justify-content-align
      {% comment %} Hide price if variant is 'unavailable' {% endcomment %}
      {% unless current_variant %}opacity-0{% endunless %}
      {% comment %} Hide when subscription discount fully replaces regular price {% endcomment %}
      {% if hide_product_price %}!hidden{% endif %}
    "
    aria-live="polite"
  >
    {% if product != blank %}
    {% render 'product-form-price',
      product: product,
      variant: current_variant,
      _settings: block.settings
    %}
    {% elsif settings.placeholder_mode or request.design_mode %}
      {% render 'core-text-preset', _settings:  block.settings, tag: 'div', text: '$100' %}
    {% endif %}
  </product-price>

  {% comment %} If a selling plan discount exists, show the selling plan discount on a second line {% endcomment %}
  {% render 'product-form-price-subscription',
    product: product,
    variant: current_variant,
    _settings: block.settings,
    selected_selling_plan: _selling_plan,
    has_subscription_discount: has_subscription_discount
  %}
{%- endcapture -%}

{% render 'product-block', _settings: block.settings, content: price_content, attributes: block.shopify_attributes %}

{% schema %}
{
	"name": "Product price",
	"tag": null,
	"settings": [
		{
			"type": "select",
			"id": "type_preset",
			"label": "Style",
			"default": "h5",
			"options": [
				{
					"value": "section",
					"label": "Section title"
				},
				{
					"value": "kicker",
					"label": "Kicker"
				},
				{
					"value": "p",
					"label": "Paragraph"
				},
				{
					"value": "h1",
					"label": "Heading 1"
				},
				{
					"value": "h2",
					"label": "Heading 2"
				},
				{
					"value": "h3",
					"label": "Heading 3"
				},
				{
					"value": "h4",
					"label": "Heading 4"
				},
				{
					"value": "h5",
					"label": "Heading 5"
				},
				{
					"value": "h6",
					"label": "Heading 6"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ block.settings.type_preset != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "accent",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 5,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Sale style"
		},
		{
			"type": "checkbox",
			"id": "show_compare_at_price",
			"label": "Show compare at price",
			"default": true,
		},
		{
			"type": "checkbox",
			"id": "show_discount_amount",
			"label": "Show discount amount",
			"default": true,
		},
		{
			"type": "select",
			"id": "discount_amount_style",
			"label": "Discount amount",
			"visible_if": "{{ block.settings.show_discount_amount == true }}",
			"info": "Calculated from price minus compare at price",
			"default": "percentage",
			"options": [
				{
					"value": "percentage",
					"label": "% off"
				},
				{
					"value": "dollar",
					"label": "$ off"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "show_sale_label",
			"label": "Show sale label",
			"default": false,
		},
		{
			"type": "text",
			"id": "sale_label",
			"label": "Sale label",
			"visible_if": "{{ block.settings.show_sale_label == true }}",
			"default": "On Sale"
		},
		{
			"type": "select",
			"id": "sale_type",
			"label": "Sale display style",
			"visible_if": "{{ false }}",
			"default": "percentage",
			"options": [
				{
					"value": "strike",
					"label": "Line"
				},
				{
					"value": "word",
					"label": "Badge"
				},
				{
					"value": "percentage",
					"label": "%"
				},
				{
					"value": "dollar",
					"label": "$"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Product price"
		}
	]
}
{% endschema %}
