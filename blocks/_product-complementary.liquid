<!-- blocks/_product-complementary.liquid -->

{% capture content %}
  <div
    id="product-recommendations-{{ section.id }}"
    {% comment %} Leave this element alone when changing variants, etc {% endcomment %}
    data-morph-skip
    x-product-complementary.limit.{{ block.settings.limit }}="{{ closest.product.id }}"
  >
    {% comment %} Check for visual preview mode first, since the recommendation logic can behave unpredictably in visual preview window and may not always show {% endcomment %}
    {%- if request.visual_preview_mode -%}
      {%- render 'product-upsell-list', loader: true -%}
    {%- elsif recommendations.performed -%}
      {% comment %} When recommendations are loaded {% endcomment %}
      {%- if recommendations.intent == 'complementary' -%}
        {%- render 'product-upsell-list', _settings: block.settings, products: recommendations.products -%}
      {%- endif -%}
    {%- else -%}
      {%- render 'product-upsell-list', _settings: block.settings, loader: true -%}
    {%- endif -%}
  </div>
{% endcapture %}

{% render 'product-block',
  _settings: block.settings,
  content: content,
  class: 'has-[>:only-child:empty]:!mb-0 w-full',
  attributes: block.shopify_attributes
%}

{% schema %}
{
	"name": "Complementary products",
	"tag": null,
	"settings": [
		{
			"type": "header",
			"content": "From [Search & Discovery](https://apps.shopify.com/search-and-discovery)"
		},
		{
			"type": "paragraph",
			"content": "Once the app is installed you can [create complementary products](/admin/apps/search-and-discovery/product-recommendations/new) that are unique to each product."
		},
		{
			"type": "paragraph",
			"content": "Complementary products with variants will open a quick-view window. [Learn more](https://groupthought.com/link/pipeline/v9/docs/complementary-products)"
		},
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Bought together"
		},
		{
			"type": "range",
			"id": "limit",
			"label": "Product limit",
			"min": 1,
			"max": 3,
			"step": 1,
			"default": 1
		}
	],
	"presets": [
		{
			"name": "Complementary products"
		}
	]
}
{% endschema %}
