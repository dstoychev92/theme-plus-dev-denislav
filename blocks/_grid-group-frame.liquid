<!-- blocks/_grid-group-frame.liquid -->





{% capture blocks %}
  {% content_for "blocks" %}
{% endcapture %}

{% render 'core-frame', _settings: block.settings, content: blocks, attributes: block.shopify_attributes %}

{% schema %}
{
	"name": "Frame",
	"tag": null,
	"settings": [
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "checkbox",
			"id": "set_layout",
			"label": "Set layout",
			"default": false
		},
		{
			"type": "text_alignment",
			"id": "content_align",
			"label": "Alignment",
			"default": "center",
			"visible_if": "{{ block.settings.set_layout }}"
		},
		{
			"type": "select",
			"id": "gap",
			"label": "Gap",
			"default": "md",
			"visible_if": "{{ block.settings.set_layout }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom",
			"label": "Custom gap",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.gap == 'custom'  and block.settings.set_layout }}"
		},
		{
			"type": "checkbox",
			"id": "full_height",
			"label": "Full height",
			"default": false,
			"visible_if": "{{ block.settings.set_layout }}"
		},
		{
			"type": "select",
			"id": "justification_column",
			"label": "Justification",
			"default": "center",
			"options": [
				{
					"value": "space-between",
					"label": "↕"
				},
				{
					"value": "start",
					"label": "⤒"
				},
				{
					"value": "center",
					"label": "—"
				},
				{
					"value": "end",
					"label": "⤓"
				}
			],
			"visible_if": "{{ block.settings.set_layout and block.settings.full_height }}"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "set_color_scheme",
			"label": "Set colors",
			"default": false
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"visible_if": "{{ block.settings.set_color_scheme }}"
		},
		{
			"type": "select",
			"id": "background",
			"label": "Background",
			"default": "canvas",
			"options": [
				{
					"value": "canvas",
					"label": "Default"
				},
				{
					"value": "tint",
					"label": "Tint"
				},
				{
					"value": "transparent",
					"label": "∅"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			],
			"visible_if": "{{ block.settings.set_color_scheme }}"
		},
		{
			"type": "color",
			"id": "background_custom",
			"label": "Background color",
			"default": "#f7f7f730",
			"alpha": true,
			"visible_if": "{{ block.settings.set_color_scheme and block.settings.background == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "background_blur",
			"label": "Blur background",
			"info": "For best results, use 5% - 90% opacity",
			"default": false,
			"visible_if": "{{ block.settings.set_color_scheme and block.settings.background == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Border"
		},
		{
			"type": "checkbox",
			"id": "set_border",
			"label": "Set border",
			"default": false
		},
		{
			"type": "range",
			"id": "border_width",
			"label": "Thickness",
			"unit": "px",
			"min": 0,
			"max": 10,
			"step": 0.5,
			"default": 1,
			"visible_if": "{{ block.settings.set_border }}"
		},
		{
			"type": "color",
			"id": "border_color",
			"label": "Color",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.set_border }}"
		},
		{
			"type": "header",
			"content": "Rounding"
		},
		{
			"type": "checkbox",
			"id": "set_rounding",
			"label": "Set rounding",
			"default": false
		},
		{
			"type": "select",
			"id": "rounding_radius",
			"label": "Radius",
			"default": "lg",
			"options": [
				{
					"value": "none",
					"label": "0"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			],
			"visible_if": "{{ block.settings.set_rounding  }}"
		},
		{
			"type": "range",
			"id": "rounding_radius_custom",
			"label": "Radius",
			"unit": "px",
			"min": 0,
			"max": 50,
			"step": 1,
			"default": 20,
			"visible_if": "{{ block.settings.set_rounding and block.settings.rounding_radius == 'custom'  }}"
		},
		{
			"type": "header",
			"content": "Padding"
		},
		{
			"type": "checkbox",
			"id": "set_padding",
			"label": "Set padding",
			"default": false,
			"visible_if": "{{ block.settings.set_color_scheme == false and block.settings.set_border == false }}"
		},
		{
			"type": "select",
			"id": "padding",
			"label": "Padding",
			"default": "lg",
			"visible_if": "{{ block.settings.set_color_scheme or block.settings.set_border or block.settings.set_padding }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "padding_custom",
			"label": "Custom padding",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.padding == 'custom'  and block.settings.set_color_scheme or block.settings.set_border or block.settings.set_padding }}"
		},
		{
			"type": "select",
			"id": "padding_border",
			"label": "Outer padding",
			"default": "custom",
			"visible_if": "{{ block.settings.set_border and block.settings.set_color_scheme }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "padding_custom_border",
			"label": "Custom outer padding",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.padding_border == 'custom'  and block.settings.set_border and block.settings.set_color_scheme }}"
		},
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "@theme"
		},
		{
			"type": "_pair-card-grid"
		},
		{
			"type": "_pair-card-showcase"
		},
		{
			"type": "_pair-card-slider"
		},
		{
			"type": "_card-product"
		},
		{
			"type": "_card-collection"
		},
		{
			"type": "_tile"
		},
	],
	"presets": [
		{
			"name": "Text frame",
			"category": "Cards",
			"settings": {
				"set_layout": true,
				"content_align": "center",
				"gap": "md",
				"full_height": true,
				"justification_column": "space-between",
				"set_color_scheme": true,
				"background": "tint",
				"padding": "md",
			},
			"blocks": [
				{
					"type": "theme-text",
					"settings": {
						"text": "Card title",
					}
				},
				{
					"type": "theme-richtext",
					"settings": {
						"text": "<p>Custom text</p>",
					}
				}
			]
		}
	]
}
{% endschema %}

