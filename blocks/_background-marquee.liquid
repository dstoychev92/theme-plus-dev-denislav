		},
		{
			"type": "select",
			"id": "padding",
			"label": "Padding",
			"default": "md",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "padding_custom",
			"label": "Custom padding",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.padding == 'custom'  }}"
		},
		{
			"type": "select",
			"id": "block_alignment",
			"label": "Block alignment",
			"info": "Relevant when blocks are different heights",
			"default": "middle",
			"options": [
				{
					"value": "top",
					"label": "⤒"
				},
				{
					"value": "middle",
					"label": "—"
				},
				{
					"value": "bottom",
					"label": "⤓"
				}
			]
		},
		{
