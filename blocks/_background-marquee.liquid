			"content": "Positioning"
		},
		{
			"type": "range",
			"id": "rotation",
			"min": -90,
			"max": 90,
			"step": 2,
			"label": "Rotation",
			"default": 0,
			"unit": "%"
		},
		{
			"type": "range",
			"id": "top",
			"min": 0,
			"max": 100,
			"step": 1,
