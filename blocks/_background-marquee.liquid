			"id": "top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"label": "Top (Mobile)",
			"default": 50,
			"unit": "%"
		},
	],
	"presets": [
		{
			"name": "Marquee",
			"settings": {
				"rotation": 10
			},
			"blocks": [
				{
					"type": "_background-marquee-text",
					"settings": {
						"text": "Act Now"
					}
				},
				{
					"type": "_background-marquee-text",
					"settings": {
						"text": "Limited time only"
					}
				}
			]
		}
	],
	"blocks": [
		{
			"type": "_background-marquee-text"
		},
		{
			"type": "_background-marquee-image"
		}
	]
}
{% endschema %}
