<!-- blocks/_product-subscription-alt.liquid -->
<!-- Card-based subscription selector with frequency grid + USPs -->
<!-- Styled to match boom-product-protein.html wireframe -->

{% doc %}
  Renders a two-card purchase type selector (one-time vs subscription)
  with expandable frequency grid and USP perks when subscription is active.

  @param {object} product - The product (auto-resolved from closest)
{% enddoc %}

{% liquid
  assign product = closest.product

  if product == blank and request.visual_preview_mode
    assign product = collections.all.products.first
  endif
%}

{%- if product.selling_plan_groups.size > 0 -%}
  {% assign product_form_id = 'product-form-' | append: product.handle | append: '-' | append: section.id %}

  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    assign price = current_variant.price
    assign history = section.settings.enable_history

    # Accent color: 'primary' (orange) for Protein, 'secondary' (blue) for Brain.
    # Drives the active-state colors below (selected card border, radio dot,
    # frequency button active state). Matches the pattern from _product-quantity-alt.liquid.
    assign accent_color_name = block.settings.accent_color | default: 'primary'
    if accent_color_name == 'secondary'
      assign accent_rgb = '16, 6, 159'
    else
      assign accent_rgb = '255, 105, 0'
    endif

    if history
      assign history_mode = 'replace'
    else
      assign history_mode = 'none'
    endif

    # Select current selling plan if it's specified in the URL
    assign selected_selling_plan = product.selected_selling_plan
    if product.requires_selling_plan and selected_selling_plan == blank
      assign selected_selling_plan = product.selected_or_first_available_selling_plan_allocation.selling_plan | default: product.selling_plan_groups[0].selling_plans[0]
    endif

    assign is_sub_selected = false
    if selected_selling_plan
      assign is_sub_selected = true
      assign selected_selling_plan_id = selected_selling_plan.id
      assign selected_selling_plan_group_id = selected_selling_plan.group_id
    endif

    # We use the first selling plan group (most products have only one)
    assign spg = product.selling_plan_groups[0]

    # Use the selected selling plan for price, fall back to the first plan
    assign active_plan = selected_selling_plan | default: spg.selling_plans[0]
    assign sub_plan_fallback = spg.selling_plans[0]
    assign sub_discount_pct = 0
    assign sub_price = price
    assign price_adjustment = active_plan.price_adjustments[0]

    case price_adjustment.value_type
      when 'percentage'
        assign sub_discount_pct = price_adjustment.value
        assign sub_discount_amount = price | times: sub_discount_pct | divided_by: 100
        assign sub_price = price | minus: sub_discount_amount
      when 'fixed_amount'
        assign sub_discount_amount = price_adjustment.value
        assign sub_price = price | minus: sub_discount_amount
      when 'price'
        assign sub_price = price_adjustment.value
    endcase

    # Build variant URLs for navigation
    capture variant_url_without_plan
      render 'product-url', product: product, variant: current_variant, selling_plan: false
    endcapture

    # Default subscription URL uses the fallback (first) plan for initial click
    capture variant_url_with_plan
      render 'product-url', product: product, variant: current_variant, selling_plan: sub_plan_fallback
    endcapture

    # Hide selectors if there is only one selling plan and no choices
    if product.requires_selling_plan and product.selling_plan_groups.size == 1 and spg.selling_plans.size == 1
      assign subscriptions_class = 'hidden'
    endif

    # Build a JSON map of plan ID → raw option text for JS-side parsing
  %}

  {%- capture plan_raw_json -%}
    {
      {%- for plan in spg.selling_plans -%}
        "{{ plan.id }}": "{{ plan.options[0].value | default: plan.name | escape }}"{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  {%- endcapture -%}

  {% comment %} Pre-render a known price to derive JS money format (plain text, no HTML) {% endcomment %}
  {%- liquid
    if settings.hide_trailing_zeros
      assign money_fmt_sample = 10000 | money_without_trailing_zeros
    else
      assign money_fmt_sample = 10000 | money
    endif
    if settings.show_currency
      assign money_fmt_sample = money_fmt_sample | append: ' ' | append: cart.currency.iso_code
    endif

    # Store-wide discount % (0 when disabled) — applied last, on top of subscription + volume
    assign storewide_pct = 0
    if settings.storewide_discount_enabled and settings.storewide_discount_pct > 0
      assign storewide_pct = settings.storewide_discount_pct
    endif
  -%}

  {% capture content %}
    {% comment %} Subscription block data (plans + pricing + money format) {% endcomment %}
    <script id="sub-data-{{ section.id }}" type="application/json">
      {
        "plans": {{ plan_raw_json }},
        "basePrice": {{ price }},
        "subPct": {{ sub_discount_pct }},
        "subPrice": {{ sub_price }},
        "moneyFmt": {{ money_fmt_sample | json }},
        "weekKeywords": {{ 'boom.subscription.week_keywords' | t | split: ',' | json }},
        "monthKeywords": {{ 'boom.subscription.month_keywords' | t | split: ',' | json }}
      }
    </script>

    <div
      class="{{ subscriptions_class }} flex flex-col gap-y-r3"
      key="{{ selected_selling_plan_id }}"
      x-data="{
        mode: '{{ is_sub_selected | default: false }}' === 'true' ? 'sub' : 'onetime',
        selectedPlanId: '{{ selected_selling_plan_id }}',
        planRaw: {},
        weekKeywords: [],
        monthKeywords: [],
        volBase: {{ price }},
        volPct: 0,
        volQty: 1,
        subPct: {{ sub_discount_pct }},
        storewidePct: {{ storewide_pct }},
        moneyFmt: '',
        bgMonths: ['{{ 'boom.date.month_1' | t }}','{{ 'boom.date.month_2' | t }}','{{ 'boom.date.month_3' | t }}','{{ 'boom.date.month_4' | t }}','{{ 'boom.date.month_5' | t }}','{{ 'boom.date.month_6' | t }}','{{ 'boom.date.month_7' | t }}','{{ 'boom.date.month_8' | t }}','{{ 'boom.date.month_9' | t }}','{{ 'boom.date.month_10' | t }}','{{ 'boom.date.month_11' | t }}','{{ 'boom.date.month_12' | t }}'],
        init() {
          var el = document.getElementById('sub-data-{{ section.id }}');
          if (el) {
            try {
              var data = JSON.parse(el.textContent);
              this.planRaw = data.plans || {};
              this.weekKeywords = data.weekKeywords || [];
              this.monthKeywords = data.monthKeywords || [];
              this.moneyFmt = data.moneyFmt || '';
              this.subPct = data.subPct || 0;
              this.volBase = data.basePrice || {{ price }};
            } catch(e) {}
          }
          if (window.__boomVolume) {
            this.volBase = window.__boomVolume.baseCents || window.__boomVolume.unitCents || this.volBase;
            this.volPct = window.__boomVolume.volPct || 0;
            this.volQty = window.__boomVolume.qty || 1;
          }
          /* Persist effective subPct to window so quantity block can read it */
          window.__boomSubPct = this.mode === 'sub' ? this.subPct : 0;
          /* After every init (including post-morph re-init), notify the
             quantity block of the current subPct so it can re-calculate
             card prices + main price with the correct subscription discount. */
          var pct = window.__boomSubPct;
          var planId = this.mode === 'sub' ? this.selectedPlanId : '';
          window.__boomSubPlan = planId ? parseInt(planId) : 0;
          setTimeout(function() {
            window.dispatchEvent(new CustomEvent('boom:sub-change', { detail: { subPct: pct, sellingPlanId: planId ? parseInt(planId) : 0 } }));
          }, 100);
        },
        /* Per-line total, matching the Shopify cart rounding: selling-plan (subscription)
           % per unit, then volume automatic discount % per unit, each rounded, × qty. */
        lineTotal(baseUnit, volPct, subPct, qty) {
          var unit = baseUnit;
          /* Selling-plan (subscription) adjustment: per unit, rounded */
          if (subPct > 0) unit = Math.round(unit * (100 - subPct) / 100);
          /* Volume automatic discount: per unit (each), floored, to match Shopify */
          if (volPct > 0) unit = unit - Math.floor(unit * volPct / 100);
          var total = unit * qty;
          /* Store-wide is a cart-level across discount: applied once to the line subtotal, floored */
          if (this.storewidePct > 0) total = total - Math.floor(total * this.storewidePct / 100);
          return total;
        },
        /* One-time price WITHOUT the store-wide discount (pre-promo, for the strikethrough) */
        onetimeFull() {
          var unit = this.volBase;
          if (this.volPct > 0) unit = unit - Math.floor(unit * this.volPct / 100);
          return unit * this.volQty;
        },
        /* Total prices for card display */
        get onetimeTotal() { return this.lineTotal(this.volBase, this.volPct, 0, this.volQty); },
        get subTotal() { return this.lineTotal(this.volBase, this.volPct, this.subPct, this.volQty); },
        get compareTotal() { return this.onetimeTotal; },
        /* Money formatting */
        fmtMoney(cents) {
          var amt = (cents / 100).toFixed(2);
          var tpl = this.moneyFmt;
          if (!tpl) return amt;
          if (tpl.indexOf('100,00') > -1) amt = amt.replace('.', ',');
          return tpl.replace(/[\d.,]+/, amt);
        },
        /* Liquid's selling_plan object exposes no delivery interval, so the unit has
           to be read off the plan's display name. The keywords come from the active
           locale (boom.subscription.*_keywords) — the plan name is rendered in that
           same language, so add a store's wording there rather than hardcoding it. */
        matchesUnit(raw, keywords) {
          var hay = raw.toLowerCase();
          return keywords.some(function (kw) {
            kw = String(kw).trim().toLowerCase();
            return kw !== '' && hay.indexOf(kw) > -1;
          });
        },
        parseDays(planId) {
          var raw = this.planRaw[planId] || '';
          var m = raw.match(/(\d+)/);
          var count = m ? parseInt(m[1], 10) : 1;
          if (this.matchesUnit(raw, this.weekKeywords)) return count * 7;
          if (this.matchesUnit(raw, this.monthKeywords)) return count * 30;
          /* No recognised unit: read the number as a plain day count, and treat a
             plan name without any number at all as monthly. */
          return m ? count : 30;
        },
        get nextDeliveryText() {
          var days = this.parseDays(this.selectedPlanId);
          var d = new Date();
          d.setDate(d.getDate() + days);
          return d.getDate() + ' ' + this.bgMonths[d.getMonth()] + ' ' + d.getFullYear();
        },
        notifyQtyBlock() {
          /* Broadcast the effective subscription discount to the quantity block
             and trigger its broadcastVolume after the section morph completes. */
          window.__boomSubPct = this.mode === 'sub' ? this.subPct : 0;
          var _planId = this.mode === 'sub' ? parseInt(this.selectedPlanId) : 0;
          window.__boomSubPlan = _planId;
          window.dispatchEvent(new CustomEvent('boom:sub-change', { detail: { subPct: window.__boomSubPct, sellingPlanId: _planId } }));
          setTimeout(function(){ if(window.__boomBroadcast) window.__boomBroadcast(); }, 600);
          setTimeout(function(){ if(window.__boomBroadcast) window.__boomBroadcast(); }, 1200);
        }
      }"
      @boom:volume-change.window="volBase = $event.detail.baseCents || $event.detail.unitCents || volBase; volPct = $event.detail.volPct || 0; volQty = $event.detail.qty || 1"
    >
      {% comment %} ── Section label ── {% endcomment %}
      {% if block.settings.show_label %}
        <div class="flex items-center gap-x-r2 text-size-control vars-control-sm my-r3">
          <span class="font-bold text-content">
            {{ block.settings.label | default: 'Начин на покупка' }}
          </span>
        </div>
      {% endif %}

      {% comment %} ── Card stack (separate cards with gap, matching quantity block pattern) ── {% endcomment %}
      <div
        class="flex flex-col gap-y-r3"
        :class="{ 'opacity-50 pointer-events-none': $sectionApi.state === 'loading' }"
        role="radiogroup"
        aria-label="{{ block.settings.label | default: 'Начин на покупка' }}"
      >

        {% comment %} ━━ Card: One-time purchase ━━ {% endcomment %}
        {% unless product.requires_selling_plan %}
          <div
            class="border-2 rounded-md cursor-pointer transition-all relative overflow-hidden"
            :style="mode === 'onetime'
              ? 'border-color: var(--content); background: #FFFFFF'
              : 'border-color: var(--line-bold)'"
            @click="mode = 'onetime'; $sectionApi.navigate('{{ variant_url_without_plan | strip }}', '{{ history_mode }}'); notifyQtyBlock()"
          >
            <div class="flex items-center justify-between p-r5">
              <div class="flex items-center gap-x-r4">
                {% comment %} Custom radio indicator (22px/7px, matches quantity-alt: filled outer + white dot when active) {% endcomment %}
                <span class="inline-flex items-center justify-center rounded-full shrink-0 transition-all"
                  :style="mode === 'onetime'
                    ? 'width:22px;height:22px;border:1.5px solid var(--content);background:var(--content)'
                    : 'width:22px;height:22px;border:1.5px solid var(--line-bold);background:#fff'"
                >
                  <span
                    class="rounded-full transition-all duration-200"
                    style="width: 7px; height: 7px; background-color: #fff;"
                    :class="mode === 'onetime' ? 'scale-100 opacity-100' : 'scale-0 opacity-0'"
                  ></span>
                </span>

                <input
                  type="radio"
                  class="sr-only"
                  name="purchase_type_{{ section.id }}"
                  value="onetime"
                  :checked="mode === 'onetime'"
                  @change="mode = 'onetime'; $sectionApi.navigate('{{ variant_url_without_plan | strip }}', '{{ history_mode }}'); notifyQtyBlock()"
                >

                <span class="font-semibold" style="font-size: 15px;">
                  {{ block.settings.onetime_label | default: 'Еднократна покупка' }}
                </span>
              </div>

              <span class="text-right">
                <template x-if="storewidePct > 0">
                  <span>
                    <span class="line-through mr-r2" style="font-size: 13px; color: var(--color-muted, #888);" x-text="fmtMoney(onetimeFull())"></span>
                    <span class="font-bold" style="font-size: 16px; color: var(--sale);" x-text="fmtMoney(onetimeTotal)"></span>
                  </span>
                </template>
                <template x-if="storewidePct === 0">
                  <span class="font-bold" style="font-size: 16px;" x-text="fmtMoney(onetimeTotal)">
                    {% render 'money', price: price %}
                  </span>
                </template>
              </span>
            </div>
          </div>
        {% endunless %}

        {% comment %} ━━ Card: Subscription ━━ {% endcomment %}
        <div
          class="border-2 rounded-md cursor-pointer transition-all relative overflow-hidden"
          :style="mode === 'sub'
            ? 'border-color: var(--sale); background: #FFFFFF'
            : 'border-color: var(--line-bold)'"
        >
          {% comment %} Header (always visible, clickable) {% endcomment %}
          <div
            class="flex items-center justify-between p-r5"
            @click="if (mode !== 'sub') { mode = 'sub'; $sectionApi.navigate('{{ variant_url_with_plan | strip }}', '{{ history_mode }}'); notifyQtyBlock(); }"
          >
            <div class="flex items-center gap-x-r4">
              {% comment %} Custom radio indicator (22px/7px, matches quantity-alt: filled outer + white dot when active) {% endcomment %}
              <span class="inline-flex items-center justify-center rounded-full shrink-0 transition-all"
                :style="mode === 'sub'
                  ? 'width:22px;height:22px;border:1.5px solid var(--sale);background:var(--sale)'
                  : 'width:22px;height:22px;border:1.5px solid var(--line-bold);background:#fff'"
              >
                <span
                  class="rounded-full transition-all duration-200"
                  style="width: 7px; height: 7px; background-color: #fff;"
                  :class="mode === 'sub' ? 'scale-100 opacity-100' : 'scale-0 opacity-0'"
                ></span>
              </span>

              <input
                type="radio"
                class="sr-only"
                name="purchase_type_{{ section.id }}"
                value="sub"
                :checked="mode === 'sub'"
                @change="mode = 'sub'; $sectionApi.navigate('{{ variant_url_with_plan | strip }}', '{{ history_mode }}'); notifyQtyBlock()"
              >

              <span class="flex flex-wrap items-center gap-x-r3">
                <span class="font-semibold" style="font-size: 15px;">
                  {{ block.settings.sub_label | default: 'Абонамент' }}
                </span>
                {% if sub_discount_pct > 0 and block.settings.show_discount_badge %}
                  <span
                    class="inline-block font-bold uppercase tracking-wider"
                    style="
                      font-size: 10px;
                      padding: 3px 9px;
                      border-radius: 999px;
                      background: var(--sale);
                      color: #fff;
                      letter-spacing: 0.04em;
                      vertical-align: middle;
                    "
                  >
                    {{ block.settings.badge_text | default: 'Спести' }} {{ sub_discount_pct }}%
                  </span>
                {% endif %}
              </span>
            </div>

            <span class="text-right">
              <template x-if="subPct > 0">
                <span>
                  <span class="line-through mr-r2" style="font-size: 13px; color: var(--color-muted, #888);" x-text="fmtMoney(compareTotal)"></span>
                  <span class="font-bold" style="font-size: 16px; color: var(--sale);" x-text="fmtMoney(subTotal)"></span>
                </span>
              </template>
              <template x-if="subPct === 0">
                <span class="font-bold" style="font-size: 16px;" x-text="fmtMoney(subTotal)"></span>
              </template>
            </span>
          </div>

          {% comment %} ── Expandable area (shown when sub is active) ── {% endcomment %}
          <div
            x-show="mode === 'sub'"
            x-transition:enter="transition-all duration-300"
            x-transition:enter-start="opacity-0 max-h-0"
            x-transition:enter-end="opacity-100 max-h-[600px]"
            x-transition:leave="transition-all duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            x-cloak
            class="px-r5 pb-r5"
          >
            <div class="pt-r5 flex flex-col" style="border-top: 1px solid var(--line-subtle, #e0e0e0); gap: 16px;">

              {% comment %} ── Frequency selector ── {% endcomment %}
              {% if spg.selling_plans.size > 1 %}
                <div>
                  <div class="flex items-center font-semibold my-r3" style="font-size: 12px; gap: 6px;">
                    <svg class="shrink-0" style="width: 14px; height: 14px;" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="7"/><path d="M8 4v4l3 2"/></svg>
                    {{ block.settings.freq_label | default: 'Честота на доставка' }}
                  </div>

                  <div class="grid grid-cols-3" style="gap: 8px;">
                    {% for plan in spg.selling_plans %}
                      {%- capture plan_url -%}
                        {%- render 'product-url', product: product, variant: current_variant, selling_plan: plan -%}
                      {%- endcapture -%}

                      <button
                        type="button"
                        class="cursor-pointer transition-all text-center border-2 rounded-md py-r6"
                        :style="selectedPlanId == '{{ plan.id }}'
                          ? 'border-color: var(--{{ accent_color_name }}); background: rgba({{ accent_rgb }},0.03)'
                          : 'border-color: var(--line-bold, #e0e0e0)'"
                        @click.stop="selectedPlanId = '{{ plan.id }}'; $sectionApi.navigate('{{ plan_url | strip }}', '{{ history_mode }}'); notifyQtyBlock()"
                      >
                        <div class="font-bold" style="font-size: 16px; margin-bottom: 1px;">{{ plan.name }}</div>
                        {% if block.settings.show_freq_descriptions and plan.description != blank %}
                          <div style="font-size: 11px; color: var(--color-muted, #888);">{{ plan.description }}</div>
                        {% endif %}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                {% comment %} Single plan — just render hidden input {% endcomment %}
                <input type="hidden" name="selling_plan" value="{{ spg.selling_plans[0].id }}" form="{{ product_form_id }}">
              {% endif %}

              {% comment %} ── USP grid ── {% endcomment %}
              {% if block.settings.show_usps %}
                <div class="grid grid-cols-2" style="gap: 8px;">
                  {% for i in (1..4) %}
                    {% liquid
                      assign icon_key = 'usp_icon_' | append: i
                      assign title_key = 'usp_title_' | append: i
                      assign desc_key = 'usp_desc_' | append: i
                      assign usp_icon = block.settings[icon_key]
                      assign usp_title = block.settings[title_key]
                      assign usp_desc = block.settings[desc_key]
                    %}
                    {% if usp_title != blank %}
                      <div class="flex items-start" style="gap: 8px; padding: 10px 12px; background: var(--color-canvas-mix-5, #f5f5f5); border-radius: 8px;">
                        {% if usp_icon != blank %}
                          <span class="shrink-0" style="font-size: 15px; margin-top: 1px;">{{ usp_icon }}</span>
                        {% endif %}
                        <div style="font-size: 12px; line-height: 1.35; font-weight: 500;">
                          <strong style="display: block; margin-bottom: 1px; font-weight: 700;">{{ usp_title }}</strong>
                          {% if usp_desc != blank %}
                            <span style="color: var(--color-muted, #888); font-weight: 400;">{{ usp_desc }}</span>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

                 {% comment %} ── Next delivery date ── {% endcomment %}
              <div class="flex items-center pb-r6" style="gap: 6px; font-size: 13px; color: var(--color-muted, #888);">
                <svg class="shrink-0" style="width: 14px; height: 14px;" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 6.5h12"/><path d="M5.5 1.5v3"/><path d="M10.5 1.5v3"/></svg>
                <span>
                  {{ block.settings.next_delivery_label | default: 'Следващата ти доставка ще бъде на' }}
                  <strong x-text="nextDeliveryText" style="color: var(--content, #3b2121);"></strong>
                </span>
              </div>

              {% comment %} ── Note ── {% endcomment %}
              {% if block.settings.show_note and block.settings.note_text != blank %}
                <div class="flex items-center" style="gap: 6px; font-size: 11px; color: var(--color-muted, #888);">
                  <span class="shrink-0">ℹ️</span>
                  {{ block.settings.note_text }}
                </div>
              {% endif %}

            </div>
          </div>
        </div>

      </div>

      {% comment %} Hidden selling plan input for form submission {% endcomment %}
      <input
        type="hidden"
        name="selling_plan"
        :value="mode === 'sub' ? selectedPlanId : ''"
        form="{{ product_form_id }}"
        data-morph-skip
      >
    </div>
  {% endcapture %}
{%- endif -%}

{% render 'product-block',
  _settings: block.settings,
  content: content,
  attributes: block.shopify_attributes,
  class: 'w-full'
%}

{% schema %}
{
  "name": "Subscription cards (alt)",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show section label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Начин на покупка"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "label": "One-time card label",
      "default": "Еднократна покупка"
    },
    {
      "type": "text",
      "id": "sub_label",
      "label": "Subscription card label",
      "default": "Абонамент"
    },
    {
      "type": "header",
      "content": "Discount badge"
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge prefix",
      "default": "Спести",
      "info": "Shown before the % value, e.g. 'Спести 15%'"
    },
    {
      "type": "header",
      "content": "Frequency selector"
    },
    {
