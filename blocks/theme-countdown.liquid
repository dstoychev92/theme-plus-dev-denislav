<!-- blocks/theme-countdown.liquid -->

{% doc %}
  - Renders one-time, daily, or weekly countdown
{% enddoc %}

<div
  class="flex flex-row justify-content-align entrance-item entrance-standard"
  {{ block.shopify_attributes }}
>
  {% render 'countdown', s: block.settings %}
</div>

{% schema %}
{
	"name": "Countdown",
	"tag": null,
	"settings": [
		{
			"type": "select",
			"id": "schedule",
			"label": "Schedule",
			"default": "repeat",
			"options": [
				{
					"value": "repeat",
					"label": "Repeat"
				},
				{
					"value": "once",
					"label": "Once"
				}
			]
		},
		{
			"type": "select",
			"id": "repeat_frequency",
			"label": "Frequency",
			"default": "weekly",
			"visible_if": "{{ block.settings.schedule == 'repeat' }}",
			"options": [
				{
					"value": "daily",
					"label": "Daily"
				},
				{
					"value": "weekly",
					"label": "Weekly"
				}
			]
		},
		{
			"type": "select",
			"id": "repeat_day",
			"label": "Repeat every",
			"default": "4",
			"visible_if": "{{ block.settings.schedule == 'repeat' and block.settings.repeat_frequency == 'weekly' }}",
			"options": [
				{
					"value": "1",
					"label": "Monday"
				},
				{
					"value": "2",
					"label": "Tuesday"
				},
				{
					"value": "3",
					"label": "Wednesday"
				},
				{
					"value": "4",
					"label": "Thursday"
				},
				{
					"value": "5",
					"label": "Friday"
				},
				{
					"value": "6",
					"label": "Saturday"
				},
				{
					"value": "0",
					"label": "Sunday"
				}
			]
		},
		{
			"type": "text",
			"id": "end_date",
			"label": "End date",
			"info": "YYYY-MM-DD",
			"visible_if": "{{ block.settings.schedule == 'once' }}"
		},
		{
			"type": "text",
			"id": "end_time",
			"label": "At this time",
			"default": "01:00",
			"info": "HH:MM in your [store primary timezone](/admin/settings/general)."
		},
		{
			"type": "select",
			"id": "period",
			"label": "AM/PM",
			"default": "am",
			"options": [
				{
					"value": "am",
					"label": "AM"
				},
				{
					"value": "pm",
					"label": "PM"
				}
			]
		},
		{
			"type": "inline_richtext",
			"id": "end_message",
			"label": "End of timer message",
			"default": "Offer has expired"
		},
		{
			"type": "paragraph",
			"content": "Shows for one hour when the repeat cycle ends",
			"visible_if": "{{ block.settings.schedule == 'repeat' }}"
		},
		{
			"type": "checkbox",
			"id": "hide_on_complete",
			"label": "Hide section after end of timer",
			"default": false,
			"visible_if": "{{ block.settings.schedule == 'once' and block.settings.end_date != blank }}"
		},
		{
			"type": "header",
			"content": "Style"
		},
		{
			"type": "select",
			"id": "word_length",
			"label": "Labels",
			"default": "letter",
			"options": [
				{
					"value": "letter",
					"label": "Letter"
				},
				{
					"value": "short",
					"label": "Short"
				},
				{
					"value": "full",
					"label": "Full"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "leading_zero",
			"label": "Leading zero",
			"default": true,
			"info": "Adds a leading zero to single-digit numbers (e.g., 7 → 07). Seconds are always shown with a leading zero."
		},
		{
			"type": "select",
			"id": "type_preset",
			"label": "Style",
			"default": "p",
			"options": [
				{
					"group": "Headings",
					"value": "h1",
					"label": "Heading 1"
				},
				{
					"group": "Headings",
					"value": "h2",
					"label": "Heading 2"
				},
				{
					"group": "Headings",
					"value": "h3",
					"label": "Heading 3"
				},
				{
					"group": "Headings",
					"value": "h4",
					"label": "Heading 4"
				},
				{
					"group": "Headings",
					"value": "h5",
					"label": "Heading 5"
				},
				{
					"group": "Headings",
					"value": "h6",
					"label": "Heading 6"
				},
				{
					"group": "Content",
					"value": "section",
					"label": "Section title"
				},
				{
					"group": "Content",
					"value": "p",
					"label": "Paragraph"
				},
				{
					"group": "Content",
					"value": "kicker",
					"label": "Kicker"
				},
				{
					"group": "Content",
					"value": "micro",
					"label": "Micro"
				},
				{
					"group": "Elements",
					"value": "btn",
					"label": "Button"
				},
				{
					"group": "Elements",
					"value": "accordion",
					"label": "Accordion"
				},
				{
					"group": "Elements",
					"value": "tab",
					"label": "Tab"
				},
				{
					"group": "Custom",
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ block.settings.type_preset != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 4,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "set_color",
			"label": "Set color",
			"default": false
		},
		{
			"type": "select",
			"id": "color_digit",
			"label": "Digit color",
			"default": "content",
			"visible_if": "{{ block.settings.set_color == true }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom_digit",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color_digit == 'custom' and block.settings.set_color == true }}",
			"label": "Digit custom color"
		},
		{
			"type": "select",
			"id": "color",
			"label": "Label color",
			"default": "muted",
			"visible_if": "{{ block.settings.set_color == true }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color == 'custom' and block.settings.set_color == true }}",
			"label": "Label custom color"
		},
	],
	"presets": [
		{
			"name": "Countdown",
			"category": "Content"
		}
	]
}
{% endschema %}
