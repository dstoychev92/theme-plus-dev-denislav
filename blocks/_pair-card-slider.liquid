<!-- blocks/_pair-card-slider.liquid -->

{% liquid
  # Desktop (always slider)
  assign columns_lg = block.settings.columns_lg | default: block.settings.columns_lg

  # Tablet same as desktop
  assign columns_md = columns_lg

  # Mobile uses theme settings
  assign columns_sm = settings.slider_columns_mobile
%}

{% capture attributes %}
  x-ensemble:carousel
  x-overflow.autoregister
  role="group"
  aria-label="{{ 'other.accessibility.card_carousel' | t }}"
  aria-live="off"

  {{ block.shopify_attributes }}
{% endcapture %}

{% capture style %}
  --card-list-columns-desktop: {{ columns_lg }};
  --card-list-columns-tablet: {{ columns_md }};
  --card-list-columns-mobile: {{ columns_sm }};
{% endcapture %}

{% comment %} Explicit row so a hidden title does not pull the cards out from under the arrows {% endcomment %}
{% capture card_list_class %}
  w-full justify-self-center self-center
  col-start-[--pair-column-content-col-start] col-end-[--pair-column-content-col-end]
  row-start-2 row-end-2
  vars-card-list-pair-desktop-slider
  vars-card-list-pair-tablet-slider
  vars-card-list-pair-mobile-slider
  card-list-layout-slider
  card-list-mobile-layout-slider
{% endcapture %}

{% capture content %}
  <div class="
    h-fit justify-self-center self-center w-full overflow-hidden max-w-screen col-span-full
    grid grid-cols-[--pair-grid-cols] justify-items-center auto-rows-[minmax(0,max-content)]
    gap-y-layout relative
  ">
    <div class="pair-column-title w-full vars-content-align-{{ block.settings.title_placement }} empty:hidden">
      {%- content_for 'block', type: '_section-title', id: 'card-slider-title' -%}
    </div>

    {% capture blocks %}
      {% content_for "blocks" %}
    {% endcapture %}

    {% render 'core-card-slider', items: blocks, class: card_list_class %}

    {% if block.settings.overflow_buttons_visibility != 'never' %}
      {% comment %} inner-start / inner-end sit on the column's content edge, like _pair-card-showcase {% endcomment %}
      {% capture overflow_button_class %}
        self-center row-start-2 row-end-2
        {% case block.settings.overflow_buttons_visibility %}
          {% when 'desktop' %}
            max-md:hidden
          {% when 'mobile' %}
            md:hidden
        {% endcase %}
      {% endcapture %}
      {% capture overflow_button_next_class %}
        {{ overflow_button_class }} col-end-[inner-end] justify-self-end
      {% endcapture %}
      {% capture overflow_button_prev_class %}
        {{ overflow_button_class }} col-start-[inner-start] justify-self-start
      {% endcapture %}

      {% capture overflow_button_prev_attributes %}
        :disabled="!$overflow.start"
        :class="{
          '!opacity-0': !$overflow.start,
        }"
        x-show="$carousel.items.length > 1"
        x-cloak
      {% endcapture %}
      {% capture overflow_button_next_attributes %}
        x-show="$carousel.items.length > 1"
        :disabled="!$overflow.end"
        :class="{
          '!opacity-0': !$overflow.end,
        }"
        x-cloak
      {% endcapture %}

      {% render 'slider-overflow-button', type: 'prev', class: overflow_button_prev_class, background_style: 'soft', attributes: overflow_button_prev_attributes %}
      {% render 'slider-overflow-button', type: 'next', class: overflow_button_next_class, background_style: 'soft', attributes: overflow_button_next_attributes %}
    {% endif %}
  </div>
{% endcapture %}

{% render 'pair-column',
  content: content,
  class: 'pair-column-card-slider pair-column-yields-to-surface',
  style: style,
  attributes: attributes,
  s: block.settings
%}

