<!-- blocks/_cards-articles.liquid -->

{% liquid
  assign limit = block.settings.card_limit
  case block.settings.source
    when 'blog'
      assign articles = block.settings.blog.articles
    when 'article'
      # We don't care about hidden:false but we do need to recast this into an array
      assign articles = block.settings.article | reject: 'hidden', true
  endcase

  if block.settings.set_aspect_ratio
    assign aspect_ratio = block.settings.aspect_ratio
  endif
%}

{% if request.visual_preview_mode %}
  {% render 'placeholder-cards-article',
    limit: 8,
    block_attributes: block.shopify_attributes,
    aspect_ratio: aspect_ratio
  %}
{% elsif articles.size == 0 or articles == blank %}
  {% render 'placeholder-cards-article',
    limit: limit,
    block_attributes: block.shopify_attributes,
    aspect_ratio: aspect_ratio
  %}
{% else %}
  {% for article in articles limit: limit %}
    {% if forloop.first %}
      {% assign attributes = block.shopify_attributes %}
    {% endif %}
    {% render 'card-article',
      size: 'lg',
      article: article,
      show_author: block.settings.show_author,
      show_tags: block.settings.show_tags,
      show_date: block.settings.show_date,
      show_preview: block.settings.show_preview,
      show_link: block.settings.show_link,
      attributes: attributes,
      aspect_ratio: aspect_ratio
    %}
  {% endfor %}
{% endif %}

{% schema %}
{
	"name": "Article cards",
	"tag": null,
	"settings": [
		{
			"type": "select",
			"id": "source",
			"label": "Source",
			"default": "blog",
			"options": [
				{
					"value": "blog",
					"label": "Blog"
				},
				{
					"value": "article",
					"label": "Article"
				}
			]
		},
		{
			"type": "header",
			"content": "Blog"
		},
		{
			"type": "blog",
			"id": "blog",
			"label": "Blog"
		},
		{
			"type": "range",
			"id": "card_limit",
			"min": 1,
			"max": 20,
			"step": 1,
			"label": "Card limit",
			"default": 8
		},
		{
			"type": "header",
			"content": "Article"
		},
		{
			"type": "article",
			"id": "article",
			"label": "Article"
		},
		{
			"type": "header",
			"content": "Aspect ratio"
		},
		{
			"type": "checkbox",
			"id": "set_aspect_ratio",
			"label": "Set aspect ratio",
			"default": false
		},
		{
			"type": "range",
			"id": "aspect_ratio",
			"min": 0.5,
			"max": 3,
			"step": 0.1,
			"unit": ":1",
			"label": "Aspect Ratio",
			"default": 1,
			"visible_if": "{{ block.settings.set_aspect_ratio == true  }}"
		},
		{
			"type": "header",
			"content": "Display"
		},
		{
			"type": "checkbox",
			"id": "show_author",
			"label": "Show author",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_tags",
			"label": "Show tags",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_date",
			"label": "Show date",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_preview",
			"label": "Show article excerpt",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_link",
			"label": "Show read more link",
			"default": true
		}
	],
	"presets": [
		{
			"name": "Article cards",
			"category": "Other"
		}
	]
}
{% endschema %}
