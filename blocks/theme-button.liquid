<!-- blocks/theme-button.liquid -->

{% capture attributes %}
  {{ block.shopify_attributes }}
{% endcapture %}

{% capture class %}
  {% comment %} Disable entrance animations in visual preview mode to prevent "No preview available" error {% endcomment %}
  {% unless request.visual_preview_mode %}
    entrance-item entrance-standard
  {% endunless %}
{% endcapture %}

{% render 'core-button', _settings: block.settings, tag: 'a', attributes: attributes, class: class %}

{% schema %}
{
	"name": "Button",
	"tag": null,
	"settings": [
		{
			"type": "text",
			"id": "text",
			"label": "Text",
			"default": "Button Text"
		},
		{
			"type": "url",
			"id": "href",
			"label": "Link"
		},
		{
			"type": "checkbox",
			"id": "open_in_new_window",
			"label": "Open link in new window",
			"default": false
		},
		{
			"type": "header",
			"content": "Style"
		},
		{
			"type": "select",
			"id": "appearance",
			"label": "Style",
			"default": "solid",
			"options": [
				{
					"value": "solid",
					"label": "Solid"
				},
				{
					"value": "outline",
					"label": "Outline"
				},
				{
					"value": "soft",
					"label": "Soft"
				}
			]
		},
		{
			"type": "select",
			"id": "sizing",
			"label": "Height",
			"default": "lg",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			]
		},
		{
			"type": "select",
			"id": "color",
			"label": "Color",
			"default": "content",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "canvas",
					"label": "Background default"
				},
				{
					"value": "black",
					"label": "Black"
				},
				{
					"value": "white",
					"label": "White"
				}
			]
		},
		{
			"type": "header",
			"content": "Text style",
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_preset",
			"label": "Text style",
			"default": "btn",
			"options": [
				{
					"value": "btn",
					"label": "Button"
				},
				{
					"value": "p",
					"label": "Paragraph"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ block.settings.type_preset != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 4,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Rounding"
		},
		{
			"type": "checkbox",
			"id": "set_rounding",
			"label": "Set rounding",
			"default": false
		},
		{
			"type": "select",
			"id": "rounding_style",
			"label": "Rounding",
			"default": "none",
			"options": [
				{
					"value": "none",
					"label": "0"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "pill",
					"label": "L"
				}
			],
			"visible_if": "{{ block.settings.set_rounding }}"
		},
		{
			"type": "header",
			"content": "Width"
		},
		{
			"type": "checkbox",
			"id": "set_width",
			"label": "Set width",
			"default": false
		},
		{
			"type": "select",
			"id": "width_unit",
			"label": "Unit",
			"default": "percent",
			"options": [
				{
					"value": "percent",
					"label": "Percent"
				},
				{
					"value": "pixel",
					"label": "Pixel"
				}
			],
			"visible_if": "{{ block.settings.set_width == true }}"
		},
		{
			"type": "range",
			"id": "width_px",
			"label": "Width",
			"unit": "px",
			"min": 100,
			"max": 500,
			"step": 5,
			"default": 200,
			"visible_if": "{{ block.settings.set_width == true and block.settings.width_unit == 'pixel' }}"
		},
		{
			"type": "range",
			"id": "width_percent",
			"label": "Width",
			"unit": "%",
			"min": 0,
			"max": 100,
			"step": 5,
			"default": 100,
			"visible_if": "{{ block.settings.set_width == true and block.settings.width_unit == 'percent' }}"
		}
	],
	"presets": [
		{
			"name": "Button",
			"category": "Basic"
		}
	]
}
{% endschema %}
