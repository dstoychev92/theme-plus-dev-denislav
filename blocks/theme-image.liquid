<!-- blocks/theme-image.liquid -->

{% liquid
  assign set_rounding = block.settings.set_rounding
  assign rounding_radius = block.settings.rounding_radius
  assign rounding_radius_custom = block.settings.rounding_radius_custom
  assign image_cover = true
  assign image_id = block.id | append: '-image'

  case block.settings.image_size_mode
    when 'full'
      assign class = 'size-full'
      assign image_class = 'size-full'
      assign image_width = block.settings.image.width
    when 'custom'
      assign class = 'flex justify-content-align'
      assign image_width = block.settings.image.width | default: block.settings.image_max_limit | at_most: block.settings.image_max_limit
      if block.settings.image.src contains '.svg'
        assign image_width = block.settings.image_max_limit
      endif
      if block.settings.set_aspect_ratio
        assign image_cover = true
      else
        assign image_cover = false
      endif
  endcase

  if section.index0 == 0
    assign preload_image = true
  endif

  if block.settings.set_aspect_ratio
    assign aspect_ratio = block.settings.aspect_ratio
  endif

  if block.settings.click_action == 'link' and block.settings.href != blank
    assign has_link = true
  endif

  if block.settings.click_action == 'zoom' and block.settings.image != blank
    assign has_zoom = true
  endif
%}

{% capture image_class %}
  {{ image_class }}

  {% if has_link or has_zoom %}
    group-hover:scale-105 ease-out transition-transform duration-1500
  {% endif %}
{% endcapture %}

<div
  {{ block.shopify_attributes }}
  class="
    keyboard-active:has-[:focus]:ring-focus-outline
    keyboard-active:has-[:focus]:ring-2
    group entrance-item entrance-standard overflow-hidden vars-scheme-dark relative
    {{ class }}
  "
  style="
    {% if set_rounding %}
      {% render 'props-style-radius', rounding_radius: rounding_radius, rounding_radius_custom: rounding_radius_custom %}
    {% else %}
      border-radius: var(--radius-banner-default);
    {% endif %}
  "
>
  {%- if has_zoom -%}
    {% assign msrc = block.settings.image | image_url: width: image_width %}
    {% assign thumb_el_id = '#' | append: image_id %}
    {% render 'photoswipe-image-json', id: block.id, image: block.settings.image, msrc: msrc, thumb_el: thumb_el_id %}
  {%- endif -%}

  {%- if has_link -%}
    <a
      href="{{ block.settings.href }}"
      {% if block.settings.open_in_new_window %}
        target="_blank"
        rel="noopener"
      {% endif %}
    >
  {%- endif -%}

  {%- if has_zoom -%}
    <a
      href="{{ block.settings.image | image_url }}"
      :role="'button'"
      class="cursor-zoom-in"
      aria-label="{{ 'product.gallery.zoom_title' | t }}"
      x-photoswipe:button="{{ block.id }}"
      aria-controls="photoswipe"
      target="_blank"
    >
  {%- endif -%}

  {%- render 'core-image',
    image: block.settings.image,
    id: image_id,
    width: image_width,
    class: image_class,
    preload: preload_image,
    aspect_ratio: aspect_ratio,
    cover: image_cover
  -%}

  {% if has_link and block.settings.open_in_new_window %}
    <span class="sr-only">, {{ 'other.accessibility.opens_in_new_tab' | t }}</span>
  {% endif %}

  {%- if has_link or has_zoom -%}
    </a>
  {%- endif -%}

  {%- if has_zoom -%}
    <span
      class="
        flex flex-center gap-r2 w-row-xs h-row-xs rounded-full
        vars-scheme-light bg-canvas text-content outline outline-1 outline-black/5 shadow
        absolute bottom-r3 left-r3
        pointer-events-none
      "
    >
      {% render 'core-icon', icon: 'fill-corners-out', size: 'sm' %}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
	"name": "Image",
	"tag": null,
	"settings": [
		{
			"type": "image_picker",
			"id": "image",
			"label": "Image"
		},
		{
			"type": "select",
			"id": "click_action",
			"label": "Click Action",
			"default": "link",
			"options": [
				{
					"value": "link",
					"label": "Link"
				},
				{
					"value": "zoom",
					"label": "Zoom"
				}
			],
		},
		{
			"type": "url",
			"id": "href",
			"visible_if": "{{ block.settings.click_action == 'link' }}",
			"label": "Link"
		},
		{
			"type": "checkbox",
			"id": "open_in_new_window",
			"label": "Open link in new window",
			"visible_if": "{{ block.settings.click_action == 'link' }}",
			"default": false
		},
		{
			"type": "header",
			"content": "Size"
		},
		{
			"type": "select",
			"id": "image_size_mode",
			"label": "Width",
			"default": "custom",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "range",
			"id": "image_max_limit",
			"min": 10,
			"max": 1000,
			"step": 10,
			"unit": "px",
			"label": "Custom width",
			"default": 120,
			"visible_if": "{{ block.settings.image_size_mode == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "set_aspect_ratio",
			"label": "Set aspect ratio",
			"default": false
		},
		{
			"type": "range",
			"id": "aspect_ratio",
			"min": 0.5,
			"max": 3,
			"step": 0.1,
			"unit": ":1",
			"label": "Aspect Ratio",
			"default": 1,
			"visible_if": "{{ block.settings.set_aspect_ratio == true  }}"
		},
		{
			"type": "header",
			"content": "Rounding"
		},
		{
			"type": "checkbox",
			"id": "set_rounding",
			"label": "Set rounding",
			"default": false
		},
		{
			"type": "select",
			"id": "rounding_radius",
			"label": "Radius",
			"default": "sm",
			"options": [
				{
					"value": "none",
					"label": "0"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			],
			"visible_if": "{{ block.settings.set_rounding  }}"
		},
		{
			"type": "range",
			"id": "rounding_radius_custom",
			"label": "Radius",
			"unit": "px",
			"min": 0,
			"max": 50,
			"step": 1,
			"default": 20,
			"visible_if": "{{ block.settings.set_rounding and block.settings.rounding_radius == 'custom'  }}"
		},
	],
	"presets": [
		{
			"name": "Image",
			"category": "Basic",
		}
	]
}
{% endschema %}
