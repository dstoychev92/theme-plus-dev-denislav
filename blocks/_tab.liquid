<!-- blocks/_tab.liquid -->

{% doc %}
  - Renders one tab holding other blocks

  @param {number} [block_index] - position among the sibling blocks, counted from 0
  @param {string} [tab_button_class] - classes for the tab button
{% enddoc %}
{% if block.settings.title != blank %}
  {% liquid
    assign set_gap = block.settings.set_gap
    assign gap = block.settings.gap
    assign gap_custom = block.settings.gap_custom

    if block_index == blank
      assign block_index = section.blocks | find_index: 'id', block.id
    endif
  %}

  {% capture class %}
    {% if set_gap %}
      gap-y-layout
    {% else %}
      gap-y-r8
    {% endif %}
  {% endcapture %}

  {% capture attributes %}
    {% if set_gap %}
      style="{% render 'props-style-gap', gap: gap, gap_custom: gap_custom, apply: false %}"
    {% endif %}
    {{ block.shopify_attributes }}
  {% endcapture %}

  {% if block_index != blank %}
    {% capture tab_style %}
      --stagger-order: {{ block_index }};
    {% endcapture %}
  {% endif %}

  <div
    class="flex flex-col text-content text-content-align items-content-align transition duration-400 no-children-entrance {{ class }}"
    role="tabpanel"
    x-tabs:tabpanel
    :data-state="$tab.isSelected ? 'active' : 'inactive'"
    :data-tab-index="$tab.index"
    {% if request.design_mode %}
      @shopify:block:select="$tab.select()"
    {% endif %}
    {{ attributes }}
  >
    {% comment %} This tab is cloned into the tab list element using javascript {% endcomment %}
    <template data-tab-template>
      {% render 'core-tab',
        type: 'button',
        label: block.settings.title,
        class: tab_button_class,
        style: tab_style
      %}
    </template>

    {% content_for 'blocks' %}
  </div>
{% endif %}

{% schema %}
{
	"name": "Tab",
	"tag": null,
	"settings": [
		{
			"type": "text",
			"id": "title",
			"label": "Title",
			"default": "Tab"
		},
		{
			"type": "header",
			"content": "Gap"
		},
		{
			"type": "checkbox",
			"id": "set_gap",
			"label": "Set gap",
			"default": false
		},
		{
			"type": "select",
			"id": "gap",
			"label": "Gap",
			"default": "md",
			"visible_if": "{{ block.settings.set_gap }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom",
			"label": "Custom gap",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.gap == 'custom'  and block.settings.set_gap }}"
		},
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "@theme"
		},
		{
			"type": "_callout"
		},
		{
			"type": "_callout-group"
		},
		{
			"type": "_grid-editorial"
		},
		{
			"type": "_grid-auto"
		},
		{
			"type": "_card-showcase"
		},
		{
			"type": "_form-contact"
		},
		{
			"type": "_marquee"
		},
		{
			"type": "_accordion-group"
		},
	],
	"presets": [
		{
			"name": "Tab",
			"blocks": [
				{
					"type": "theme-richtext",
					"settings": {
						"text": "<p>This tab is your playground. Keep it simple with plain text, or go wild with buttons, images, and layouts.</p>"
					}
				}
			]
		}
	]
}
{% endschema %}

