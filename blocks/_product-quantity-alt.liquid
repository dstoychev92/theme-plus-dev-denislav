      "default": true
    },
    {
      "type": "product",
      "id": "gift_product_3",
      "label": "Gift unlocked at qty ≥ 3",
      "info": "Auto-added to cart on qty 3 and 4"
    },
    {
      "type": "product",
      "id": "gift_product_4",
      "label": "Additional gift unlocked at qty ≥ 4",
      "info": "Auto-added to cart on qty 4 (stacks with the qty ≥ 3 gift)"
    },
    {
      "type": "text",
      "id": "gifts_panel_header",
      "label": "Gifts panel header",
      "default": "С твоята поръчка получаваш"
    },
    {
      "type": "text",
      "id": "gift_singular_label",
      "label": "Gift word (singular)",
      "default": "подарък"
    },
    {
      "type": "text",
      "id": "gift_plural_label",
      "label": "Gift word (plural, 2-4)",
      "default": "подаръка"
    },
    {
      "type": "text",
      "id": "gift_free_label",
      "label": "Gift tag (right side of each row)",
      "default": "Подарък"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
