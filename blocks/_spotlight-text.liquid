<!-- blocks/_spotlight-text.liquid -->

{% doc %}
  - Renders highlighted text split into words for scroll animation

  Private, only offered by section-text-spotlight.
{% enddoc %}

{% capture attributes %}
  {{ block.shopify_attributes }}
{% endcapture %}

{% capture split_text_attributes %}
  data-scroll-stagger-item
{% endcapture %}

{% capture class %}
  *:auto-stagger-animations-[--entrance-animation-stagger]
{% endcapture %}

{% render 'inline-highlight-text',
  s: block.settings,
  attributes: attributes,
  split_text_attributes: split_text_attributes,
  class: class
%}

{% schema %}
{
	"name": "Spotlight text",
	"tag": null,
	"settings": [
		{
			"type": "inline_richtext",
			"id": "text",
			"label": "Text",
			"default": "<em><strong>Grab</strong></em> your customer's <em><strong>attention</strong></em> with <em><strong>spotlight text</strong></em>"
		},
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "checkbox",
			"id": "enable_typography",
			"label": "Set typography",
			"default": false
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "heading",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.enable_typography == true }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 9,
			"visible_if": "{{ block.settings.enable_typography == true }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.enable_typography == true }}"
		},
		{
			"type": "header",
			"content": "Color"
		},
		{
			"type": "checkbox",
			"id": "set_color",
			"label": "Set color",
			"default": false
		},
		{
			"type": "select",
			"id": "color",
			"label": "Color",
			"default": "content",
			"visible_if": "{{ block.settings.set_color == true  }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color == 'custom' and block.settings.set_color == true  }}",
			"label": "Custom color"
		},
		{
			"type": "header",
			"content": "Outline"
		},
		{
			"type": "checkbox",
			"id": "outline_text",
			"label": "Outline text",
			"default": false
		},
		{
			"type": "paragraph",
			"content": "Outline text may not render well with all font families and can reduce readability at small sizes.",
			"visible_if": "{{ block.settings.outline_text == true }}"
		},
		{
			"type": "header",
			"content": "Background highlight",
			"info": "Use italic and bold together to create a background highlight.",
			"visible_if": "{{ block.settings.highlight_toggle == 'auto' }}"
		},
		{
			"type": "header",
			"content": "Background highlight",
			"visible_if": "{{ block.settings.highlight_toggle == 'full' or block.settings.highlight_toggle == 'none' }}"
		},
		{
			"type": "select",
			"id": "highlight_toggle",
			"label": "Background highlight",
			"default": "auto",
			"options": [
				{
					"value": "none",
					"label": "None"
				},
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "auto",
					"label": "Auto"
				}
			]
		},
		{
			"type": "color",
			"alpha": true,
			"id": "highlight_color",
			"label": "Color",
			"default": "#77777730",
			"visible_if": "{{ block.settings.highlight_toggle != 'none' }}"
		},
		{
			"type": "select",
			"id": "highlight_appearance",
			"label": "Style",
			"default": "partial",
			"options": [
				{
					"value": "full",
					"label": "Full background"
				},
				{
					"value": "partial",
					"label": "Thick line"
				},
				{
					"value": "underline",
					"label": "Line"
				}
			],
			"visible_if": "{{ block.settings.highlight_toggle != 'none' }}"
		},
	],
	"presets": [
		{
			"name": "Spotlight text",
			"category": "Basic"
		}
	]
}
{% endschema %}
