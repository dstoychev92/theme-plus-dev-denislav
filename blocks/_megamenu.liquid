<!-- blocks/_megamenu.liquid -->

{% liquid
  assign title = block.settings.title
  assign menu_id = title | downcase | strip_html | escape | handleize

  assign enable_placeholders = false
  assign unassigned_megamenu = false
  assign has_content = false

  if block.blocks.size > 0
    assign has_content = true
  endif

  if settings.enable_placeholders or request.design_mode
    assign possible_parent_links = section.settings.linklist.links | map: 'title'
    assign matching_parent_link = null

    # Find the matching parent link by downcasing and escaping the titles of all of them and comparing them to the title of the megamenu
    for parent_link in possible_parent_links
      assign parent_menu_id = parent_link | downcase | strip_html | escape | handleize
      if parent_menu_id == menu_id
        assign matching_parent_link = parent_link
        break
      endif
    endfor

    assign enable_placeholders = true

    # If the megamenu has no title or the matching parent link is blank, it is unassigned and we will show a placeholder
    if matching_parent_link == null or title == blank
      assign unassigned_megamenu = true
    endif

    # If current megamenu is unassigned, we will use a placeholder menu id that will still allow this megamenu to
    # open when the block for it is selected in the theme editor
    if unassigned_megamenu
      assign menu_id = 'placeholder'
    endif
  endif

  assign unique_menu_id = section.id | append: '-' | append: menu_id

  assign linklist = section.settings.linklist

  # Find the parent link that matches the megamenu title
  assign parent_link = null
  for link in linklist.links
    assign link_menu_id = link.title | downcase | strip_html | escape | handleize
    if link_menu_id == menu_id
      assign parent_link = link
      break
    endif
  endfor
%}

{% capture megamenu %}
  {% capture attributes %}
    {% if request.design_mode %}
      @shopify:block:select="
        if ($event.target != $el) {
          $event.target.scrollIntoView()
        }
        selectFromThemeEditor()
      "
      @shopify:section:select.window="
        if ($wasSelectedSection && !$isSelectedSection) {
          deselectFromThemeEditor()
        }
      "
    {% endif %}
    {{ block.shopify_attributes }}
  {% endcapture %}

  {% if unassigned_megamenu and request.design_mode %}
    <div class="relative">
      <div class="absolute inset-0 z-50 p-r10 flex flex-col flex-center">
        <p class="type-p text-r6 text-center max-w-[500px]">
          {% if title == blank %}
            {{ 'header.megamenu.placeholder.unassigned_title' | t }}
          {% else %}
            {{ 'header.megamenu.placeholder.not_found_title' | t: title: title }}
          {% endif %}
        </p>
        <p class="type-p text-r6 text-center max-w-[500px]">
          {% assign parent_links_string = possible_parent_links | join: ', ' %}
          {{ 'header.megamenu.placeholder.parent_links' | t: parent_links: parent_links_string }}
        </p>
      </div>
      {% capture content %}
        {% render 'placeholder-cards-product', limit: 4, attributes: block.shopify_attributes %}
      {% endcapture %}
      {% render 'header-megamenu-grid', _settings: block.settings, attributes: attributes, content: content, class: 'z-0 opacity-40' %}
    </div>
  {% else %}
    {% capture content %}
      {% if block.settings.show_section_links == true %}
        {% liquid
          assign has_content = true

          if parent_link.links.size == 0 and block.blocks.size == 0
            assign has_content = false
          endif
        %}
        {% if has_content %}
          {% render 'header-megamenu-linklist',
            parent_link: parent_link,
            attributes: block.shopify_attributes,
            _settings: block.settings
          %}
        {% endif %}
      {% endif %}

      {% content_for 'blocks' %}
    {% endcapture %}
    {% render 'header-megamenu-grid', _settings: block.settings, attributes: attributes, content: content %}
  {% endif %}
{% endcapture %}

{% if has_content or enable_placeholders %}
  <template data-custom-megamenu="{{ unique_menu_id }}">
    {{ megamenu }}
  </template>
{% endif %}

