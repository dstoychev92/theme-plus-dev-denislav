		},
		{
			"type": "theme-icon"
		},
		{
			"type": "theme-link"
		},
		{
			"type": "theme-liquid-code"
		},
		{
			"type": "theme-social-links"
		},
		{
			"type": "theme-spacer"
		},
		{
			"type": "theme-richtext"
		},
		{
			"type": "theme-video-button"
		},
		{
			"type": "_product-title"
		},
		{
			"type": "_product-price"
		},
		{
			"type": "_product-rating"
		},
		{
			"type": "_product-stock-status"
		},
		{
			"type": "_product-sku"
		},
		{
			"type": "_product-quantity"
		},
		{
			"type": "_product-sharing"
		},
		{
			"type": "_product-group-flex"
		},
		{
			"type": "_product-group-row"
		},
		{
			"type": "_product-group-inline"
		},
		{
			"type": "_product-group-grid"
		},
		{
			"type": "_product-group-frame"
		},
		{
			"type": "_product-group-target"
		},
	],
	"presets": [
		{
			"name": "Grid item",
			"blocks": []
		}
	]
}
