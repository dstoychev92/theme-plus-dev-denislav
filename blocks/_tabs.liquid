<!-- blocks/_tabs.liquid -->

{% render 'core-tabs', _settings: block.settings, blocks: block.blocks, attributes: block.shopify_attributes %}

{% schema %}
{
	"name": "Tabs",
	"tag": null,
	"settings": [
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "checkbox",
			"id": "enable_typography",
			"label": "Set typography",
			"default": false
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.enable_typography == true }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 4,
			"visible_if": "{{ block.settings.enable_typography == true }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.enable_typography == true }}"
		},
		{
			"type": "header",
			"content": "Spacing"
		},
		{
			"type": "checkbox",
			"id": "set_gap_tab_x",
			"label": "Set tab spacing",
			"default": false
		},
		{
			"type": "select",
			"id": "gap_tab_x",
			"label": "Tab",
			"default": "sm",
			"visible_if": "{{ block.settings.set_gap_tab_x }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom_tab_x",
			"label": "Custom",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.gap_tab_x == 'custom'  and block.settings.set_gap_tab_x }}"
		},
		{
			"type": "checkbox",
			"id": "set_gap_tab_y",
			"label": "Set vertical gap",
			"default": false
		},
		{
			"type": "select",
			"id": "gap_tab_y",
			"label": "Vertical gap",
			"default": "sm",
			"visible_if": "{{ block.settings.set_gap_tab_y }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom_tab_y",
			"label": "Custom",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.gap_tab_y == 'custom'  and block.settings.set_gap_tab_y }}"
		},
	],
	"blocks": [
		{
			"type": "_tab"
		}
	],
	"presets": [
		{
			"name": "Tabs",
			"category": "Interactive",
			"blocks": [
				{
					"type": "_tab",
					"settings": {
						"title": "Returns"
					},
					"blocks": [
						{
							"type": "theme-richtext",
							"settings": {
								"text": "<p>Free returns within 30 days, no questions asked.  We believe in our products and we stand behind them.  We will return any of our items within 30 days just mail them back with your purchase receipt.</p>"
							}
						}
					]
				},
				{
					"type": "_tab",
					"settings": {
						"title": "Security"
					},
					"blocks": [
						{
							"type": "theme-richtext",
							"settings": {
								"text": "<p>We accept all major credit cards.  All of our transactions are handled on a secure server using bank-grade encryption.  Payments can be handled through trusted third parties like Shopify Pay, Apple Pay, and PayPal.</p>"
							}
						}
					]
				},
				{
					"type": "_tab",
					"settings": {
						"title": "Support"
					},
					"blocks": [
						{
							"type": "theme-richtext",
							"settings": {
								"text": "<p>Let us know what you think of your items.  If you are not satisfied your purchase can be replaced at any time or returned after 30 days. All of our products come with a 30 day free return and one year manufacturers guarantee against defects.</p>"
							}
						}
					]
				}
			]
		}
	]
}
{% endschema %}

