<!-- blocks/_megamenu-media-column.liquid -->

{% liquid
  assign col_span_lg = block.settings.col_span_lg
  assign col_span_md = block.settings.col_span_md
%}

{% capture content %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture style %}
  --col-span-lg: {{ col_span_lg }};
  --col-span-md: {{ col_span_md }};
{% endcapture %}

{% capture grid_class %}
  lg:col-span-[--col-span-lg] col-span-[--col-span-md]
  animate-delay-[calc(var(--header-menu-flyout-enter-duration)/2)]
{% endcapture %}

{% if block.blocks.size == 1 %}
  <div
    {{ block.shopify_attributes }}
    class="contents lg:*:col-span-[--col-span-lg] *:col-span-[--col-span-md]"
    style="{{ style }}"
  >
    {{ content }}
  </div>
{% else %}
  {% render 'card-grid',
    items: content,
    columns_lg: col_span_lg,
    columns_md: col_span_md,
    style: style,
    class: grid_class,
    attributes: block.shopify_attributes
  %}
{% endif %}

{% schema %}
{
	"name": "Media",
	"tag": null,
	"settings": [
		{
			"type": "header",
			"content": "Columns"
		},
		{
			"type": "range",
			"id": "col_span_lg",
			"label": "Desktop",
			"min": 1,
			"max": 6,
			"default": 1
		},
		{
			"type": "range",
			"id": "col_span_md",
			"label": "Tablet",
			"min": 1,
			"max": 6,
			"default": 1
		}
	],
	"blocks": [
		{
			"type": "_tile"
		},
		{
			"type": "_card-product"
		},
		{
			"type": "_card-collection"
		},
		{
			"type": "_card-custom"
		},
		{
			"type": "_grid-group-frame"
		}
	],
	"presets": [
		{
			"name": "Media column"
		}
	]
}
{% endschema %}
