<!-- blocks/theme-icon.liquid -->

{% doc %}
  - Renders core icon, art icon, or image with optional link

  Preset widths scale with the surrounding text. Custom width is in pixels.
{% enddoc %}

{% liquid
  assign icon_set = block.settings.icon_set
  assign image_limit = 24

  # Unified sizing: em-based presets, r-scaled custom px
  if block.settings.set_width
    case block.settings.icon_width
      when 'xs'
        assign icon_width = 'var(--icon-em-xs)'
      when 'sm'
        assign icon_width = 'var(--icon-em-sm)'
      when 'md'
        assign icon_width = 'var(--icon-em-md)'
      when 'lg'
        assign icon_width = 'var(--icon-em-lg)'
        assign image_limit = 30
      when 'custom'
        assign icon_width = 'calc(' | append: block.settings.icon_width_custom | append: 'px * var(--r-multiplier))'
        assign image_limit = block.settings.icon_width_custom
    endcase
  else
    assign icon_width = 'var(--icon-em-md)'
  endif

  if icon_set == 'image'
    # Request 2x for CDN so em/r-scaled images stay sharp
    assign image_src_width = image_limit | times: 2
    unless block.settings.image.src contains '.svg'
      assign image_src_width = block.settings.image.width | default: image_src_width | at_most: image_src_width
    endunless
  endif
%}

{% # Note: Icon block preset sizes are em-based (scale with surrounding text), custom is pixel-based %}
{% capture style %}
  --icon-width: {{ icon_width }};

  {% if icon_set != 'image' and block.settings.set_color and block.settings.color == 'custom' %}
    --color-custom-text: {{ block.settings.color_custom }};
  {% endif %}

  {% if icon_set == 'art' and block.settings.set_color and block.settings.color == 'custom' and block.settings.color_shade != blank %}
    --icon-color-shade: {{ block.settings.color_shade }};
  {% endif %}

  {% render 'props-style-offset', s: block.settings %}
{% endcapture %}

{% capture class %}
  inline-block align-middle wraps-inline-graphics
  {% if icon_set != 'image' and block.settings.set_color %}
    text-{{ block.settings.color | default: 'content' }}
  {% else %}
    text-content
  {% endif %}
  entrance-item entrance-standard entrance-draw
{% endcapture %}

<div {{ block.shopify_attributes }} class="{{ class }}" style="{{ style }}">
  {%- if block.settings.href != blank -%}
    <a
      href="{{ block.settings.href }}"
      {% if block.settings.open_in_new_window %}
        target="_blank"
        rel="noopener"
      {% endif %}
    >
  {%- endif -%}

  {% # Icon %}
  {% if icon_set == 'image' %}
    <span class="block w-icon">
      {%- render 'core-image', image: block.settings.image, width: image_src_width -%}
    </span>
  {% elsif icon_set == 'core' %}
    {%- render 'core-icon', icon: block.settings.icon_list_core, stroke_weight: block.settings.stroke_weight -%}
  {% elsif icon_set == 'art' %}
    {% liquid
      assign art_icon_class = ''
      if block.settings.set_color and block.settings.color == 'custom' and block.settings.color_shade != blank
        assign art_icon_class = 'icon-shade-custom'
      endif
    %}
    {%- render 'core-icon',
      icon: block.settings.icon_list_art,
      stroke_weight: block.settings.stroke_weight,
      class: art_icon_class
    -%}
  {% endif %}

  {% if block.settings.open_in_new_window %}
    <span class="sr-only">, {{ 'other.accessibility.opens_in_new_tab' | t }}</span>
  {% endif %}

  {%- if block.settings.href != blank -%}
    </a>
  {%- endif -%}
</div>

