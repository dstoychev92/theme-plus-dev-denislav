<!-- blocks/_toolbar-countdown.liquid -->

{% doc %}
  - Renders one-time, daily, or weekly countdown in the header toolbar

  Private, only offered by header-toolbar.
{% enddoc %}

{% render 'countdown', s: block.settings, class: 'self-center', attributes: block.shopify_attributes %}

{% schema %}
{
	"name": "Countdown",
	"tag": null,
	"settings": [
		{
			"type": "select",
			"id": "schedule",
			"label": "Schedule",
			"default": "repeat",
			"options": [
				{
					"value": "repeat",
					"label": "Repeat"
				},
				{
					"value": "once",
					"label": "Once"
				}
			]
		},
		{
			"type": "select",
			"id": "repeat_frequency",
			"label": "Frequency",
			"default": "weekly",
			"visible_if": "{{ block.settings.schedule == 'repeat' }}",
			"options": [
				{
					"value": "daily",
					"label": "Daily"
				},
				{
					"value": "weekly",
					"label": "Weekly"
				}
			]
		},
		{
			"type": "select",
			"id": "repeat_day",
			"label": "Repeat every",
			"default": "4",
			"visible_if": "{{ block.settings.schedule == 'repeat' and block.settings.repeat_frequency == 'weekly' }}",
			"options": [
				{
					"value": "1",
					"label": "Monday"
				},
				{
					"value": "2",
					"label": "Tuesday"
				},
				{
					"value": "3",
					"label": "Wednesday"
				},
				{
					"value": "4",
					"label": "Thursday"
				},
				{
					"value": "5",
					"label": "Friday"
				},
				{
					"value": "6",
					"label": "Saturday"
				},
				{
					"value": "0",
					"label": "Sunday"
				}
			]
		},
		{
			"type": "text",
			"id": "end_date",
			"label": "End date",
			"info": "YYYY-MM-DD",
			"visible_if": "{{ block.settings.schedule == 'once' }}"
		},
		{
			"type": "text",
			"id": "end_time",
			"label": "At this time",
			"default": "01:00",
			"info": "HH:MM in your [store primary timezone](/admin/settings/general)."
		},
		{
			"type": "select",
			"id": "period",
			"label": "AM/PM",
			"default": "am",
			"options": [
				{
					"value": "am",
					"label": "AM"
				},
				{
					"value": "pm",
					"label": "PM"
				}
			]
		},
		{
			"type": "inline_richtext",
			"id": "end_message",
			"label": "End of timer message",
			"default": "Offer has expired"
		},
		{
			"type": "paragraph",
			"content": "Shows for one hour when the repeat cycle ends",
			"visible_if": "{{ block.settings.schedule == 'repeat' }}"
		},
		{
			"type": "checkbox",
			"id": "hide_on_complete",
			"label": "Hide block after end of timer",
			"default": false,
			"visible_if": "{{ block.settings.schedule == 'once' and block.settings.end_date != blank }}"
		},
		{
			"type": "header",
			"content": "Style"
		},
		{
			"type": "select",
			"id": "word_length",
			"label": "Labels",
			"default": "letter",
			"options": [
				{
					"value": "letter",
					"label": "Letter"
				},
				{
					"value": "short",
					"label": "Short"
				},
				{
					"value": "full",
					"label": "Full"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "leading_zero",
			"label": "Leading zero",
			"default": true,
			"info": "Adds a leading zero to single-digit numbers (e.g., 7 → 07). Seconds are always shown with a leading zero."
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "set_color",
			"label": "Set color",
			"default": false
		},
		{
			"type": "select",
			"id": "color_digit",
			"label": "Digit color",
			"default": "content",
			"visible_if": "{{ block.settings.set_color == true }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom_digit",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color_digit == 'custom' and block.settings.set_color == true }}",
			"label": "Digit custom color"
		},
		{
			"type": "select",
			"id": "color",
			"label": "Label color",
			"default": "muted",
			"visible_if": "{{ block.settings.set_color == true }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color == 'custom' and block.settings.set_color == true }}",
			"label": "Label custom color"
		},
	],
	"presets": [
		{
			"name": "Countdown"
		}
	]
}
{% endschema %}
