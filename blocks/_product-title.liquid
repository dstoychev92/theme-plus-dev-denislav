					"label": "Heading 1"
				},
				{
					"group": "Headings",
					"value": "h2",
					"label": "Heading 2"
				},
				{
					"group": "Headings",
					"value": "h3",
					"label": "Heading 3"
				},
				{
					"group": "Headings",
					"value": "h4",
					"label": "Heading 4"
				},
				{
					"group": "Headings",
					"value": "h5",
					"label": "Heading 5"
				},
				{
					"group": "Headings",
					"value": "h6",
					"label": "Heading 6"
				},
				{
					"group": "Content",
					"value": "section",
					"label": "Section title"
				},
				{
					"group": "Content",
					"value": "p",
					"label": "Paragraph"
				},
				{
					"group": "Content",
					"value": "kicker",
					"label": "Kicker"
				},
				{
					"group": "Content",
					"value": "micro",
					"label": "Micro"
				},
				{
					"group": "Elements",
					"value": "btn",
					"label": "Button"
				},
				{
					"group": "Elements",
