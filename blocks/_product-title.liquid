					"label": "Tab"
				},
				{
					"group": "Custom",
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ block.settings.type_preset != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "heading",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 9,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Color"
		},
		{
			"type": "checkbox",
			"id": "set_color",
			"label": "Set color",
			"default": false
		},
		{
			"type": "select",
			"id": "color",
			"label": "Color",
			"default": "content",
			"visible_if": "{{ block.settings.set_color == true  }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "muted",
					"label": "Text muted"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color == 'custom' and block.settings.set_color == true  }}",
			"label": "Custom color"
		},
		{
			"type": "header",
			"content": "Tag",
			"visible_if": "{{ settings.show_tag_settings == true }}"
		},
		{
			"type": "checkbox",
			"id": "set_heading_tag",
			"label": "Set HTML tag",
			"visible_if": "{{ settings.show_tag_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "HTML tag",
			"info": "Override the style preset with a specific HTML tag",
			"default": "h1",
			"visible_if": "{{ settings.show_tag_settings == true and block.settings.set_heading_tag == true }}",
			"options": [
				{
					"value": "p",
					"label": "p"
				},
				{
					"value": "h1",
					"label": "h1"
				},
				{
					"value": "h2",
					"label": "h2"
				},
				{
					"value": "h3",
					"label": "h3"
				},
				{
					"value": "h4",
					"label": "h4"
				},
				{
					"value": "h5",
					"label": "h5"
				},
				{
					"value": "h6",
					"label": "h6"
				}
			]
		},
	],
	"presets": [
		{
			"name": "Product title",
			"category": "Additional product info"
		}
	]
}
{% endschema %}
