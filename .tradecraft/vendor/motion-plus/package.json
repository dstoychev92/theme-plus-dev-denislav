{
  "name": "motion-plus",
  "version": "2.11.2",
  "description": "A collection of Motion functions and components, exclusive to Motion+ members.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/es/index.mjs",
      "default": "./dist/cjs/index.js"
    },
    "./react": {
      "types": "./dist/react-entry.d.ts",
      "require": "./dist/cjs/react-entry.js",
      "import": "./dist/es/react-entry.mjs",
      "default": "./dist/cjs/react-entry.js"
    },
    "./animate-activity": {
      "types": "./dist/animate-activity.d.ts",
      "require": "./dist/cjs/animate-activity.js",
      "import": "./dist/es/animate-activity.mjs",
      "default": "./dist/cjs/animate-activity.js"
    },
    "./animate-layout": {
      "types": "./dist/animate-layout.d.ts",
      "require": "./dist/cjs/animate-layout.js",
      "import": "./dist/es/animate-layout.mjs",
      "default": "./dist/cjs/animate-layout.js"
    },
    "./animate-view": {
      "types": "./dist/animate-view.d.ts",
      "require": "./dist/cjs/animate-view.js",
      "import": "./dist/es/animate-view.mjs",
      "default": "./dist/cjs/animate-view.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "motion": "12.36.0",
    "motion-dom": "12.36.0",
    "motion-plus-dom": "2.12.0",
    "motion-utils": "12.39.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
