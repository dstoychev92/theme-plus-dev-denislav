{
  "name": "analog",
  "version": "1.1.0-beta.3",
  "repository": "git@github.com:groupthought/method-monorepo.git",
  "author": "Groupthought",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "build": "tradecraft-build build",
    "dev": "tradecraft-build watch",
    "deploy": "tradecraft-build deploy",
    "pull": "tradecraft-build pull",
    "zip": "NODE_ENV=production tradecraft-build zip --ignore-path=.zipignore",
    "check:types": "tsc --noEmit",
    "format": "prettier --write '**/*.{ts,liquid,css,js,json}'",
    "lint": "eslint --max-warnings 0 src/**/*.ts",
    "size": "size-limit --silent --json",
    "svg": "pnpm run svg:clean && pnpm run svg:strip && pnpm run svg:art-icons",
    "svg:rename": "for f in icons/Icons/icon=*.svg; do [ -f \"$f\" ] && mv \"$f\" \"${f/icon=/}\"; done",
    "svg:clean": "rm -rf icons-compressed && svgo -r -f icons/ -o icons-compressed --config=bin/svgo.config.js",
    "svg:strip": "bash bin/strip_svg icons-compressed src/static/icons-autogenerated",
    "svg:art-icons": "bash bin/generate-art-icons.sh"
  },
  "devDependencies": {
    "@csstools/css-parser-algorithms": "3.0.5",
    "@csstools/css-tokenizer": "3.0.4",
    "@groupthought/tradecraft-build": "3.4.1",
    "@playwright/test": "1.62.1",
    "@shopify/events": "0.0.0",
    "@shopify/prettier-plugin-liquid": "1.10.3",
    "@shopify/theme-currency": "4.1.1",
    "@size-limit/preset-app": "9.0.0",
    "@tailwindcss/container-queries": "0.1.1",
    "@types/alpinejs": "3.13.5",
    "@types/alpinejs__focus": "3.13.4",
    "@types/lodash.ismatch": "4.4.9",
    "@types/lodash.merge": "4.6.9",
    "@types/node": "20.19.43",
    "@types/vimeo__player": "2.18.3",
    "@types/youtube-player": "5.5.11",
    "ansi-colors": "4.1.3",
    "autoprefixer": "10.4.14",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-compat": "4.1.4",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-prettier": "5.0.0",
    "fishery": "2.4.0",
    "husky": "8.0.3",
    "jsonc-parser": "3.3.1",
    "liquidjs": "10.19.0",
    "lodash.ismatch": "4.4.0",
    "lodash.merge": "4.6.2",
    "patch-package": "8.0.1",
    "pinst": "3.0.0",
    "postcss": "8.4.23",
    "postcss-import": "15.1.0",
    "postcss-media-minmax": "5.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.5.2",
    "rolldown": "1.2.3",
    "rollup-plugin-visualizer": "5.12.0",
    "size-limit": "9.0.0",
    "svgo": "3.3.3",
    "tailwind-scrollbar-hide": "1.3.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-quantity-queries": "0.1.0",
    "typescript": "5.4.5",
    "vitest": "4.1.10",
    "wait-on": "7.2.0",
    "yalc": "1.0.0-pre.53",
    "@typescript-eslint/parser": "5.62.0"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.15.11",
    "@alpinejs/focus": "3.15.11",
    "@alpinejs/intersect": "3.15.11",
    "@alpinejs/morph": "3.15.11",
    "@alpinejs/persist": "3.15.11",
    "@alpinejs/resize": "3.15.11",
    "@floating-ui/dom": "1.7.6",
    "@groupthought/tradecraft-ui": "26.5.3",
    "@oddbird/popover-polyfill": "0.6.1",
    "alpinejs": "3.15.11",
    "motion": "12.36.0",
    "motion-plus": "2.11.2",
    "photoswipe": "5.4.4",
    "photoswipe-video-plugin": "1.0.2",
    "tabbable": "6.4.0"
  },
  "size-limit": [
    {
      "path": "dist/assets/theme.*.js",
      "limit": "1000 kb",
      "running": false
    },
    {
      "path": "dist/assets/vendor.*.js",
      "limit": "1000 kb",
      "running": false
    },
    {
      "path": "dist/assets/theme.css",
      "limit": "100 kb",
      "running": false
    }
  ],
  "browserslist": [
    "last 4 Safari major versions",
    "last 5 Chrome major versions",
    "last 5 Firefox major versions",
    "last 4 Edge major versions",
    "last 4 iOS major versions",
    "last 5 ChromeAndroid major versions",
    "last 4 Samsung major versions"
  ]
}
