<!-- blocks/_product-option-selectors.liquid -->

{% doc %}
  - Renders the product option selectors as buttons or a select

  @param {string} [block_attributes] - attributes for this block instance
  @param {string} [block_class] - classes for this block instance
{% enddoc %}

{% liquid
  assign product = closest.product
  assign input_type = block.settings.input_type

  if product == blank and request.visual_preview_mode
    assign product = collections.all.products.first
  endif
%}

{% unless product.has_only_default_variant %}
  {% liquid
    assign has_rounding_override = false
    if block.settings.set_rounding_button or block.settings.set_rounding_select
      assign has_rounding_override = true
    endif
  %}

  {% capture rounding_style %}
    {% if block.settings.set_rounding_button %}
      --radius-btn: var(--radius-{{ block.settings.rounding_style_button }});
    {% endif %}
    {% if block.settings.set_rounding_select %}
      --radius-form-field: var(--radius-{{ block.settings.rounding_style_select }});
    {% endif %}
  {% endcapture %}

  {% capture content %}
    {%- capture product_select_product -%}
      {%- render 'product-select-payload', part: 'product', product: product -%}
    {%- endcapture -%}
    <div
      class="{{ block_class }} flex flex-col gap-y-r10"
      {% if has_rounding_override %}style="{{ rounding_style }}"{% endif %}
      {{ block_attributes }}
      data-test-id="variant-option-fields"
      {% comment %} Read by $standardEvents.productSelect, once for every option value below {% endcomment %}
      data-product-select-product="{{ product_select_product | strip | escape }}"
    >
      {% for option in product.options_with_values %}
        {% liquid
          # Use 'select' over 'options' for long inputs
          assign longest_value = 0
          for value in option.values
            if value.size > longest_value
              assign longest_value = value.size
            endif
          endfor

          if input_type == 'auto' and longest_value > 16
            assign input_type = 'select'
          endif

          assign is_swatch_option = false

          if option.values.first.swatch != null
            assign is_swatch_option = true
          elsif settings.custom_swatch_names != blank
            assign group_name_down = option.name | downcase | strip
            assign custom_swatch_list = settings.custom_swatch_names | downcase | replace: ' ,', ',' | replace: ', ', ',' | split: ','
            if custom_swatch_list contains group_name_down
              assign is_swatch_option = true
            endif
          endif

          # No match (wrong label, or position past the last option) hides the trigger
          # silently — intentional so one template can serve products with varying options.
          assign show_info_popup = false
          if block.settings.info_popup_page != blank
            if block.settings.info_popup_match_mode == 'position'
              if forloop.index == block.settings.info_popup_match_position
                assign show_info_popup = true
              endif
            else
              assign option_name_down = option.name | downcase | strip
              assign match_list = block.settings.info_popup_match_labels | downcase | replace: ' ,', ',' | replace: ', ', ',' | split: ','
              if match_list contains option_name_down
                assign show_info_popup = true
              endif
            endif
          endif
        %}

        {% comment %} Use div with role group instead of fieldset to avoid fieldset styling difficulties {% endcomment %}
        <div
          role="group"
          @mouseleave="hoverValue = null"
          x-data="
            {
              hoverValue: null
            }
          "
          aria-label="{{ option.name | escape_once }}"
        >
          <div class="
            {% render 'props-class-type-preset', s: block.settings, settings_suffix: 'indicator' %}
            mb-r5 flex-row-center justify-content-align gap-x-r5
          ">
            <span class="font-bold">{{ option.name }}</span>
            <span role="presentation" class="block w-px h-[12px] border-r border-line-bold"></span>
            {%# Value rides a data attribute since a quote in it (Men's, or an inch mark) breaks the expression %}
            <span
              data-selected-value="{{ option.selected_value.name | escape_once }}"
              x-html="hoverValue || $el.dataset.selectedValue"
            >
              {{- option.selected_value.name -}}
            </span>

            {% if show_info_popup %}
              {% liquid
                if block.settings.info_popup_text == 'custom'
                  assign info_popup_label = block.settings.info_popup_text_custom
                else
                  assign info_popup_label = block.settings.info_popup_page.title
                endif
              %}

              {% capture info_popup_link_slot %}
                {% render 'core-icon',
                  icon: block.settings.info_popup_icon,
                  size: 'md',
                  class: 'me-r2 opacity-60 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity'
                %}
                {% if info_popup_label != blank %}
                  <span>{{ info_popup_label }}</span>
                {% endif %}
              {% endcapture %}

              {% capture info_popup_content %}
                <h3 class="type-h3">{{ block.settings.info_popup_page.title }}</h3>
                <div class="prose" tabindex="0">{{ block.settings.info_popup_page.content }}</div>
              {% endcapture %}

              {% unless block.settings.info_popup_alignment == 'right' %}
                <span role="presentation" class="block w-px h-[12px] border-r border-line-bold"></span>
              {% endunless %}

              {% comment %}
                The popup's content — a whole page, often a large size chart — teleports to
                the body and gets processed only when this starts up, and the link that opens
                it is inside this element, so the first hover, focus, or tap wakes it before
                that interaction reaches the link.
              {% endcomment %}
              <div
                x-dialog.modal
                data-lazy-alpine
                data-lazy-alpine-on="interact"
                class="inline-flex {% if block.settings.info_popup_alignment == 'right' %}ms-auto{% endif %}"
              >
                {% render 'core-link',
                  text_slot: info_popup_link_slot,
                  color: block.settings.color_info_popup,
                  appearance: 'clean',
                  tag: 'button',
                  settings_suffix: 'indicator',
                  s: block.settings,
                  attributes: 'x-dialog:button'
                %}

                <template x-teleport="body">
                  {% render 'dialog', modal: true, content: info_popup_content, scrollable: true, content_class: '[&_table]:whitespace-nowrap' %}
                </template>
              </div>
            {% endif %}
          </div>

          {% if input_type == 'select' and is_swatch_option == false %}
            {% capture select_class %}
              {% render 'props-class-type-preset', s: block.settings, settings_suffix: 'select' %}
              [--control-font-size:--font-size-calc]
              [--input-font-size:--font-size-calc]
            {% endcapture %}
            {% render 'product-form-option-select', product: product, option: option, history: section.settings.enable_history, select_size: block.settings.variant_select_row_height, class: select_class %}
          {% else %}
            {% capture buttons_class %}{% render 'props-class-type-preset', s: block.settings, settings_suffix: 'button' %}{% endcapture %}
            {% render 'product-form-option-buttons', product: product, option: option, is_swatch_option: is_swatch_option, history: section.settings.enable_history, swatch_size: block.settings.swatch_option_sizing, option_size: block.settings.variant_button_row_height, class: buttons_class %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endcapture %}
{% endunless %}

{% render 'product-block',
  s: block.settings,
  content: content,
  attributes: block.shopify_attributes,
  class: 'w-full'
%}

