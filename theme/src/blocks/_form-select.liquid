{% doc %}
  - Renders contact form select holding _form-select-item blocks

  Sits inside _form-contact. The label handle is the contact[] key, so a cleared label falls
  back to the block id.
{% enddoc %}

{% liquid
  # A cleared label must not produce contact[]
  assign label = block.settings.label
  assign label_handle = label | handleize
  if label_handle == blank
    assign label_handle = 'field-' | append: block.id
  endif
  assign id = label_handle | append: '-' | append: block.id
  assign name = 'contact[' | append: label_handle | append: ']'
%}

{% capture blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'field-custom-select',
  name: name,
  id: id,
  label: label,
  size: block.settings.sizing,
  options: blocks,
  class: 'min-w-[150px]'
%}

{% schema %}
{
  "name": "Select group",
  "tag": null,
  "settings": [
    [% json 'schema/form-input-setting.jsonc', default: "Select" %]
  ],
  "blocks": [
    {
      "type": "_form-select-item"
    }
  ],
  "presets": [
    {
      "name": "Select group",
      "blocks": [
        {
          "type": "_form-select-item",
          "settings": {
            "label": "Select item 1"
          }
        },
        {
          "type": "_form-select-item",
          "settings": {
            "label": "Select item 2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
