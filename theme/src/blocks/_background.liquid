<!-- blocks/_background.liquid -->

{% doc %}
  - Renders background layer holding background blocks

  Sits inside _pair-pro-banner or the password section. Use _section-background inside section-pro-banner.
{% enddoc %}

{% assign target_device = block.settings.target_device %}

{% capture blocks %}
  {% content_for "blocks" %}
{% endcapture %}

{% capture class %}
  {% render 'props-class-target-device', target_device: target_device %}
{% endcapture %}

{% render 'core-background',
  content: blocks,
  s: block.settings,
  class: class,
  attributes: block.shopify_attributes
%}

{% schema %}
{
	"name": "Background layer",
	"tag": null,
	"settings": [
		{
			"type": "header",
			"content": "Overlay"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"label": "Opacity",
			"min": 0,
			"max": 100,
			"step": 1,
			"default": 8
		},
		{
			"type": "color",
			"id": "overlay_color",
			"label": "Color",
			"default": "#000000"
		},
		{
			"type": "header",
			"content": "Parallax"
		},
		{
			"type": "checkbox",
			"id": "set_parallax",
			"label": "Set parallax amount",
			"default": false
		},
		{
			"type": "range",
			"id": "parallax",
			"min": -100,
			"max": 100,
			"step": 2,
			"label": "Parallax amount",
			"default": 0,
			"info": "Positive values move the background in the opposite direction of the scroll direction. Negative values move the background in the same direction as the scroll direction.",
			"visible_if": "{{ block.settings.set_parallax }}"
		},
		{
			"type": "header",
			"content": "Limit by screen size",
			"info": "Optional: use a different background for mobile and desktop"
		},
		{
			"type": "select",
			"label": "Show on",
			"id": "target_device",
			"default": "both",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				},
				{
					"value": "both",
					"label": "Both"
				}
			]
		},
	],
	"blocks": [
		{
			"type": "_background-pattern-text"
		},
		{
			"type": "_background-collage-image"
		},
		{
			"type": "_background-image"
		},
		{
			"type": "_background-split"
		},
		{
			"type": "_background-marquee"
		}
	],
	"presets": [
		{
			"name": "Background layer"
		}
	]
}
{% endschema %}
