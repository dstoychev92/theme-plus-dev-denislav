<!-- blocks/_background-pattern-text.liquid -->

{% doc %}
  - Renders text repeated as an outlined pattern across a background layer

  Sits inside _background or _section-background. Every nth repetition fills with the text color when highlight is on.
{% enddoc %}

{% liquid
  assign text_color = block.settings.text_color
  assign text_size = block.settings.text_size
  assign text = block.settings.text
  assign gap_x = block.settings.gap_x
  assign gap_y = block.settings.gap_y

  # Number of times to repeat text. Should be enough for most cases, but can be adjusted if needed.
  assign repetitions = 500
  assign enable_highlight = block.settings.enable_highlight
  assign highlight_repeat = block.settings.highlight_repeat
%}

{% if enable_highlight %}
  {% style %}
    .{{ block.id }}-repetition:nth-child({{ highlight_repeat }}n) {
      --text-stroke-fill-color: var(--text-color)
    }
  {% endstyle %}
{% endif %}

<div class="absolute inset-0 pointer-events-none overflow-hidden" {{ block.shopify_attributes }}>
  <div
    class="
      pointer-events-none
      font-family-{{ block.settings.font_family }}
      font-bold uppercase pointer-events-none select-none
      h-full flex flex-row flex-wrap
      *:flex *:flex-center *:text-[color:--text-color] *:text-stroke *:text-stroke-[color:--text-color] *:h-[0.8em]
    "
    style="
      --text-color: {{ text_color }};
      column-gap: {{ gap_x }}px;
      row-gap: {{ gap_y }}px;
      font-size: {{ text_size }}px;
      {% comment %} Dont resize the pattern text container until the window is massive, and ensure the container stays bigger than the window {% endcomment %}
      width: max(2000px, 130vw)
    "
  >
    {% for num in (1..repetitions) %}
      <span class="{{ block.id }}-repetition">
        {{ text }}
      </span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
	"name": "Pattern text",
	"tag": null,
	"settings": [
		{
			"type": "text",
			"id": "text",
			"label": "Text",
			"default": "SALE"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text color",
			"alpha": true,
			"default": "#000"
		},
		{
			"type": "select",
			"id": "font_family",
			"label": "Font",
			"default": "accent",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			]
		},
		{
			"type": "range",
			"id": "text_size",
			"label": "Size",
			"min": 50,
			"max": 120,
			"step": 5,
			"default": 70,
			"unit": "px"
		},
		{
			"type": "header",
			"content": "Spacing"
		},
		{
			"type": "range",
			"id": "gap_y",
			"label": "Vertical gap",
			"min": 0,
			"max": 100,
			"step": 5,
			"default": 10,
			"unit": "px"
		},
		{
			"type": "range",
			"id": "gap_x",
			"label": "Horizontal gap",
			"min": 0,
			"max": 100,
			"step": 5,
			"default": 10,
			"unit": "px"
		},
		{
			"type": "header",
			"content": "Highlight"
		},
		{
			"type": "checkbox",
			"id": "enable_highlight",
			"label": "Enable highlight",
			"default": true
		},
		{
			"type": "range",
			"id": "highlight_repeat",
			"label": "Repeat after",
			"min": 1,
			"max": 10,
			"step": 1,
			"default": 5
		}
	],
	"presets": [
		{
			"name": "Pattern text"
		}
	]
}
{% endschema %}
