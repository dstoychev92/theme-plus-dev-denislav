		{
			"type": "header",
			"content": "Style"
		},
		{
			"type": "select",
			"id": "appearance",
			"label": "Style",
			"default": "fill",
			"options": [
				{
					"value": "fill",
					"label": "Fill"
				},
				{
					"value": "stroke",
					"label": "Stroke"
				},
				{
					"value": "soft",
					"label": "Soft"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "color",
			"label": "Color",
			"default": "content",
			"visible_if": "{{ block.settings.appearance != 'custom' }}",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ block.settings.color == 'custom' and block.settings.appearance != 'custom' }}",
			"label": "Custom color"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text color",
			"default": "#FFFFFF",
			"visible_if": "{{ block.settings.appearance == 'fill' and block.settings.color == 'custom' }}"
		},
		{
			"type": "color",
			"id": "custom_bg_color",
			"label": "Background color",
			"default": "#f4a482",
			"alpha": true,
			"visible_if": "{{ block.settings.appearance == 'custom' }}"
		},
		{
			"type": "color",
			"id": "custom_text_color",
			"label": "Text color",
			"default": "#1a1a1a",
			"visible_if": "{{ block.settings.appearance == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "set_border",
			"label": "Set border",
			"default": false,
			"visible_if": "{{ block.settings.appearance == 'custom' }}"
		},
		{
			"type": "color",
			"id": "custom_border_color",
			"label": "Border color",
			"default": "#1a1a1a",
			"alpha": true,
			"visible_if": "{{ block.settings.appearance == 'custom' and block.settings.set_border }}"
		},
		{
			"type": "checkbox",
			"id": "background_blur",
			"label": "Blur background",
			"default": false,
			"visible_if": "{{ block.settings.appearance != 'fill' }}"
		},
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "select",
			"id": "type_preset",
			"label": "Text style",
			"default": "p",
			"options": [
				{
					"group": "Headings",
					"value": "h1",
					"label": "Heading 1"
				},
				{
					"group": "Headings",
					"value": "h2",
					"label": "Heading 2"
				},
				{
					"group": "Headings",
					"value": "h3",
					"label": "Heading 3"
				},
				{
					"group": "Headings",
					"value": "h4",
					"label": "Heading 4"
				},
				{
					"group": "Headings",
					"value": "h5",
					"label": "Heading 5"
				},
				{
					"group": "Headings",
					"value": "h6",
					"label": "Heading 6"
				},
				{
					"group": "Content",
					"value": "section",
					"label": "Section title"
				},
				{
					"group": "Content",
					"value": "p",
					"label": "Paragraph"
				},
				{
					"group": "Content",
					"value": "kicker",
					"label": "Kicker"
				},
				{
					"group": "Content",
					"value": "micro",
					"label": "Micro"
				},
				{
					"group": "Elements",
					"value": "btn",
					"label": "Button"
				},
				{
					"group": "Elements",
					"value": "accordion",
					"label": "Accordion"
				},
				{
					"group": "Elements",
					"value": "tab",
					"label": "Tab"
