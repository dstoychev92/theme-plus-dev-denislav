{% doc %}
  - Renders icon callout parts for _callout-group

  Private, only offered by _callout-group. Wraps the icon, title, and body in c4ll0u7x text
  markers so the group can split them and lay them out.
{% enddoc %}

{%- liquid
  assign icon_set = block.settings.icon_set
-%}

{%- comment -%} Section markers, leetspeak. See _callout-group.liquid. {%- endcomment -%}
c4ll0u7x573r7xm3d14
{%- case icon_set -%}
  {%- when 'core' -%}
    {%- render 'core-icon', icon: block.settings.icon_list_core -%}
  {%- when 'art' -%}
    {%- render 'core-icon', icon: block.settings.icon_list_art -%}
  {%- when 'image' -%}
    <span class="block w-icon">
      {%- render 'core-image', image: block.settings.icon_image, width: 256 -%}
    </span>
{%- endcase -%}
c4ll0u7x3ndxm3d14

c4ll0u7x573r7x71713
{%- if block.settings.title != blank -%}{{- block.settings.title -}}{%- endif -%}
c4ll0u7x3ndx71713

c4ll0u7x573r7xb0dy
{%- if block.settings.body != blank -%}{{- block.settings.body -}}{%- endif -%}
c4ll0u7x3ndxb0dy

{% schema %}
{
  "name": "Icon callout",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon_set",
      "label": "Set",
      "default": "art",
      "options": [
        {"value": "core", "label": "Core"},
        {"value": "art", "label": "Art"},
        {"value": "image", "label": "Image"}
      ]
    },
    {
      "type": "select",
      "id": "icon_list_core",
      "label": "Icon",
      "visible_if": "{{ block.settings.icon_set == 'core' }}",
      "options": [% render 'icons-manual/json-list-core-icons' %]
    },
    {
      "type": "select",
      "id": "icon_list_art",
      "label": "Icon",
      "default": "fill-art-commerce-award-wreath",
      "visible_if": "{{ block.settings.icon_set == 'art' }}",
      "options": [% render 'icons-autogenerated/json-list-art-icons' %]
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Image",
      "visible_if": "{{ block.settings.icon_set == 'image' }}"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Quality guaranteed"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Icon callout"
    }
  ]
}
{% endschema %}
