<!-- blocks/_card-product.liquid -->

{% doc %}
  - Renders one product card
{% enddoc %}

{% liquid
  assign product = block.settings.product
  assign enable_placeholder_product = false

  if settings.placeholder_mode or request.design_mode
    assign enable_placeholder_product = true
  endif
%}

{% if product == blank and enable_placeholder_product %}
  {% render 'card-product', size: 'lg', placeholder: true, attributes: block.shopify_attributes %}
{% else %}
  {% render 'card-product', size: 'lg', product: product, attributes: block.shopify_attributes %}
{% endif %}

{% schema %}
{
	"name": "Product card",
	"tag": null,
	"settings": [
		{
			"type": "product",
			"id": "product",
			"label": "Product"
		}
	],
	"presets": [
		{
			"name": "Product card",
			"category": "Featured card"
		}
	]
}
{% endschema %}
