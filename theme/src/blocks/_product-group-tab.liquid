		},
		{
			"type": "theme-form-newsletter"
		},
		{
			"type": "theme-text"
		},
		{
			"type": "theme-image"
		},
		{
			"type": "theme-video"
		},
		{
			"type": "theme-icon"
		},
		{
			"type": "theme-link"
		},
		{
			"type": "theme-liquid-code"
		},
		{
			"type": "theme-social-links"
		},
		{
			"type": "theme-spacer"
		},
		{
			"type": "theme-richtext"
		},
		{
			"type": "theme-video-button"
		},
		{
			"type": "_product-title"
		},
		{
			"type": "_product-price"
		},
		{
			"type": "_product-description"
		},
		{
			"type": "_product-disclosures"
		},
		{
			"type": "_product-pickup"
		},
		{
			"type": "_product-rating"
		},
		{
			"type": "_product-sku"
		},
		{
			"type": "_product-stock-status"
		},
		{
			"type": "_product-option-selectors"
		},
		{
			"type": "_product-option-siblings"
		},
		{
			"type": "_product-subscription"
		},
		{
			"type": "_product-quantity"
		},
		{
			"type": "_product-add-buttons"
		},
		{
			"type": "_product-upsell"
		},
		{
			"type": "_product-complementary"
		},
		{
			"type": "_product-sharing"
		},
		{
			"type": "_product-group-frame"
		},
