<!-- blocks/_grid-auto-item.liquid -->

{% doc %}
  - Renders auto grid item holding other blocks

  @param {string} [block_class] - classes for this block instance
  @param {string} [block_style] - inline styles for this block instance
{% enddoc %}

{% liquid
  assign size = block.settings.size

  case size
    when 'featured'
      assign col_base = 2
      assign row_base = 2
    when 'wide'
      assign col_base = 2
      assign row_base = 1
    when 'tall'
      assign col_base = 1
      assign row_base = 2
    when 'custom'
      assign col_base = block.settings.custom_col_span | default: 1
      assign row_base = block.settings.custom_row_span | default: 1
    else
      assign col_base = 1
      assign row_base = 1
  endcase

  assign col_lg = 'span ' | append: col_base
  assign row_lg = 'span ' | append: row_base
  assign col_md = col_lg
  assign row_md = row_lg
  assign col_sm = col_lg
  assign row_sm = row_lg

  if size == 'custom'
    if block.settings.set_tablet_span
      assign n = block.settings.custom_col_span_tablet | default: 1
      assign col_md = 'span ' | append: n
      assign n = block.settings.custom_row_span_tablet | default: 1
      assign row_md = 'span ' | append: n
    endif
    if block.settings.set_mobile_span
      assign n = block.settings.custom_col_span_mobile | default: 1
      assign col_sm = 'span ' | append: n
      assign n = block.settings.custom_row_span_mobile | default: 1
      assign row_sm = 'span ' | append: n
    endif
  endif

  assign auto_collapse_mobile = false
  case size
    when 'featured', 'wide', 'tall'
      assign auto_collapse_mobile = true
  endcase
  if auto_collapse_mobile
    assign col_sm = 'auto'
    assign row_sm = 'auto'
  endif

  assign justify_self = 'auto'
  assign align_self = 'auto'
  assign content_align = 'center'
  if block.settings.set_layout
    assign justify_self = block.settings.justify_self | default: 'auto'
    assign align_self = block.settings.align_self | default: 'auto'
    assign content_align = block.settings.content_align
  endif

  assign enable_layout_container = true
  case justify_self
    when 'start', 'center', 'end'
      assign enable_layout_container = false
  endcase
%}

<div
  class="
    flex flex-col gap-layout relative {% if enable_layout_container %}cq-width{% else %}cq-width-unsafe{% endif %}
    text-content-align items-content-align vars-content-align-{{ content_align }}
    [grid-column:var(--grid-slot-col-lg)]
    [grid-row:var(--grid-slot-row-lg)]
    max-lg:[grid-column:var(--grid-slot-col-md)]
    max-lg:[grid-row:var(--grid-slot-row-md)]
    max-md:[grid-column:var(--grid-slot-col-sm)]
    max-md:[grid-row:var(--grid-slot-row-sm)]
    {% render 'props-class-show-on', s: block.settings %}
    {{ block_class }}
  "
  style="
    {%- if block.settings.set_layout -%}
      {% render 'props-style-gap', s: block.settings %}
    {%- endif -%}
    --grid-slot-col-lg: {{ col_lg }};
    --grid-slot-row-lg: {{ row_lg }};
    --grid-slot-col-md: {{ col_md }};
    --grid-slot-row-md: {{ row_md }};
    --grid-slot-col-sm: {{ col_sm }};
    --grid-slot-row-sm: {{ row_sm }};
    justify-self: {{ justify_self }};
    align-self: {{ align_self }};
    {{ block_style }}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

