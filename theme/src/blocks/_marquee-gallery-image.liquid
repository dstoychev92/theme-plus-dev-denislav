{% schema %}
{
	"name": "Gallery image",
	"tag": null,
	"settings": [
		{
			"type": "image_picker",
			"id": "image",
			"label": "Image"
		},
		{
			"type": "url",
			"id": "href",
			"label": "Link"
		},
		{
			"type": "checkbox",
			"id": "open_in_new_window",
			"label": "Open link in new window",
			"default": false
		},
	],
	"presets": [
		{
			"name": "Gallery image"
		}
	]
}
{% endschema %}
