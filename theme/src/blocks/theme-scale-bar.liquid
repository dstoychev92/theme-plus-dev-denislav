<!-- blocks/theme-scale-bar.liquid -->

{% liquid
  assign s = block.settings
  assign label = s.label
  assign value = s.value
  assign segments = s.segments | default: 3

  # One segment or a range such as 3-8, so a number or text metafield can drive it
  assign highlight = s.highlight | strip | replace: '–', '-' | replace: ' ', ''
  assign highlight_parts = highlight | split: '-'
  # plus: 0 turns a non-numeric value into 0, which fails the range check below
  assign highlight_from = highlight_parts.first | plus: 0 | round
  assign highlight_to = highlight_parts.last | plus: 0 | round

  if highlight_from > highlight_to
    assign swap = highlight_from
    assign highlight_from = highlight_to
    assign highlight_to = swap
  endif

  assign highlight_to = highlight_to | at_most: segments

  assign has_highlight = false
  if highlight_from >= 1 and highlight_from <= segments
    assign has_highlight = true
  endif

  # Segment 0 and segment count + 1 never render, so a missing fade matches nothing
  assign fade_before = 0
  assign fade_after = 0
  if has_highlight and s.enable_fade
    assign fade_before = highlight_from | minus: 1
    assign fade_after = highlight_to | plus: 1
  endif

  assign is_empty = false
  if label == blank and value == blank and has_highlight == false
    assign is_empty = true
  endif

  assign color_highlight = s.color_highlight | default: 'primary'
  if color_highlight == 'custom'
    assign highlight_color = s.color_custom_highlight
  else
    assign highlight_color = 'var(--' | append: color_highlight | append: ')'
  endif

  # A custom track color carries its own alpha, so the opacity setting applies to tokens only
  assign color_track = s.color_track | default: 'content'
  if color_track == 'custom'
    assign track_color = s.color_custom_track
    assign track_opacity = 100
  else
    assign track_color = 'var(--' | append: color_track | append: ')'
    assign track_opacity = s.opacity_track | default: 15
  endif
%}

{% capture class %}
  flex flex-col gap-y-r3 w-full
  {% comment %} Disable entrance animations in visual preview mode to prevent "No preview available" error {% endcomment %}
  {% unless request.visual_preview_mode %}
    entrance-item entrance-standard
  {% endunless %}
{% endcapture %}

{% capture style %}
  --scale-highlight: {{ highlight_color }};
  --scale-track: {{ track_color }};
  --scale-track-opacity: {{ track_opacity }}%;
  --scale-thickness: {{ s.thickness | default: 3 }}px;
{% endcapture %}

{% capture position_text %}
  {% if highlight_from == highlight_to %}
    {{ 'other.accessibility.scale_position' | t: position: highlight_from, total: segments }}
  {% else %}
    {{ 'other.accessibility.scale_position_range' | t: from: highlight_from, to: highlight_to, total: segments }}
  {% endif %}
{% endcapture %}

<div
  class="{{ class | strip }}"
  style="{{ style | strip }}"
  data-test-id="scale-bar"
  {% if is_empty %}
    hidden
  {% endif %}
  {{ block.shopify_attributes }}
>
  {% if label != blank or value != blank %}
    <div class="flex-row-center justify-content-align gap-x-r5">
      {% render 'core-text-preset', s: s, settings_suffix: 'label', tag: 'span', text: label, class: 'inline-richtext' %}
      {% if label != blank and value != blank %}
        <span role="presentation" class="block w-px h-[12px] border-r border-line-bold"></span>
      {% endif %}
      {% render 'core-text-preset', s: s, settings_suffix: 'value', tag: 'span', text: value, class: 'inline-richtext' %}
    </div>
  {% endif %}

  {% comment %} The visible label and value carry the meaning, and the sr-only text below names the position {% endcomment %}
  <div class="flex gap-x-r2 w-full" aria-hidden="true">
    {% for index in (1..segments) %}
      {% if has_highlight and index >= highlight_from and index <= highlight_to %}
        <span class="flex-1 rounded-sm h-[--scale-thickness] bg-[--scale-highlight]" data-active="true"></span>
      {% elsif index == fade_before or index == fade_after %}
        <span class="flex-1 rounded-sm h-[--scale-thickness] bg-[--scale-highlight] opacity-50" data-fade="true"></span>
      {% else %}
        <span class="flex-1 rounded-sm h-[--scale-thickness] bg-[--scale-track] opacity-[--scale-track-opacity]"></span>
      {% endif %}
    {% endfor %}
  </div>

  {% if has_highlight %}
    <span class="sr-only">{{ position_text | strip }}</span>
  {% endif %}
</div>

