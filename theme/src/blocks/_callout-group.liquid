<!-- blocks/_callout-group.liquid -->

{% doc %}
  - Renders callout grid holding _callout-icon, _callout-number, and _callout blocks

  Splits each _callout-icon and _callout-number child on the c4ll0u7x text markers the child
  prints, then renders the parts through core-callout with this block's settings. A _callout
  child prints no markers and renders as is. Search c4ll0u7x to find every marker.
{% enddoc %}

{%- liquid
  # Media width (px value for icon children)
  assign media_px = 32
  case block.settings.media_width
    when 'xs'
      assign media_px = 12
    when 'sm'
      assign media_px = 20
    when 'md'
      assign media_px = 32
    when 'lg'
      assign media_px = 50
    when 'custom'
      assign media_px = block.settings.media_width_custom
  endcase

  assign icon_width = 'calc(' | append: media_px | append: 'px * var(--r-multiplier))'
-%}

{%- comment -%} ── Number type class (pre-computed, shared across all number children) ── {%- endcomment -%}
{%- capture number_type_class -%}
  {%- render 'props-class-type-preset', s: block.settings, settings_suffix: 'number' -%}
{%- endcapture -%}

{%- comment -%} Callout color, gated by set_color_scheme in the schema and color_enabled in core-callout {%- endcomment -%}
{%- capture callout_color_style -%}
  {%- if block.settings.set_color_scheme and block.settings.set_color_callout and block.settings.color_callout == 'custom' -%}
    --color-custom-text: {{ block.settings.color_custom_callout }};
  {%- endif -%}
{%- endcapture -%}

{%- capture callout_color_class -%}
  {%- if block.settings.set_color_scheme and block.settings.set_color_callout -%}
    text-{{ block.settings.color_callout | default: 'content' }}
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} ── Grid gap ── {%- endcomment -%}
{%- capture grid_style -%}
  {%- render 'props-style-gap', gap: block.settings.gap_grid, gap_custom: block.settings.gap_custom_grid -%}
{%- endcapture -%}

{%- liquid
  assign set_border = block.settings.set_border
  assign set_color_scheme = block.settings.set_color_scheme
  assign set_rounding = block.settings.set_rounding | default: false

  assign allow_rounding = false
  if set_border
    assign allow_rounding = true
  elsif set_color_scheme and block.settings.background != 'transparent'
    assign allow_rounding = true
  endif
-%}

{%- comment -%} ── Frame styles (applied to each item) ── {%- endcomment -%}
{%- capture frame_style -%}
  {%- if set_color_scheme or set_border or block.settings.set_padding -%}
    {%- render 'props-style-padding', s: block.settings -%}
  {%- endif -%}
  {%- if set_color_scheme -%}
    {%- render 'props-style-background', s: block.settings -%}
  {%- endif -%}
  {%- if set_border -%}
    {%- render 'props-style-border', s: block.settings -%}
  {%- endif -%}
  {%- if set_rounding and allow_rounding -%}
    {%- render 'props-style-radius', s: block.settings -%}
  {%- elsif allow_rounding -%}
    border-radius: var(--radius-card);
  {%- endif -%}
{%- endcapture -%}

{%- capture frame_class -%}
  {%- if set_color_scheme -%}
    {%- render 'props-class-background', s: block.settings -%}
  {%- endif -%}
  {%- if set_border -%}
    border-solid
  {%- endif -%}
  {%- if allow_rounding -%}
    overflow-hidden
  {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  Iterate children, split markers, render via core-callout

  Markers look like that on purpose. If it was english it could be accidentailly translated or added to output.
  It's leetspeak. Stop pretending you didn't know. Search `c4ll0u7x` to find every related marker across the system.
{%- endcomment -%}
{%- capture items -%}
  {%- for child in block.blocks -%}
    {%- capture content -%}{%- render child -%}{%- endcapture -%}

    {%- if content contains 'c4ll0u7x573r7xm3d14' -%}
      {%- comment -%} Marker-based child (_callout-icon, _callout-number) {%- endcomment -%}
      {%- assign child_media = content | split: 'c4ll0u7x573r7xm3d14' | last | split: 'c4ll0u7x3ndxm3d14' | first -%}
      {%- assign child_title = content | split: 'c4ll0u7x573r7x71713' | last | split: 'c4ll0u7x3ndx71713' | first -%}
      {%- assign child_body = content | split: 'c4ll0u7x573r7xb0dy' | last | split: 'c4ll0u7x3ndxb0dy' | first -%}


      {%- comment -%} Detect child type from marker {%- endcomment -%}
      {%- assign is_number_child = false -%}
      {%- if content contains 'c4ll0u7x7yp3xnumb3r' -%}
        {%- assign is_number_child = true -%}
      {%- endif -%}

      {%- comment -%} Wrap media with icon sizing or number type class {%- endcomment -%}
      {%- capture wrapped_media -%}
        {%- if child_media != blank -%}
          {%- if is_number_child -%}
            <div class="{{ number_type_class }}">
              {{- child_media -}}
            </div>
          {%- else -%}
            <div style="--icon-width: {{ icon_width }};">
              {{- child_media -}}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}

      {%- comment -%} Determine media type for core-callout {%- endcomment -%}
      {%- assign child_media_type = 'icon' -%}
      {%- if is_number_child -%}
        {%- assign child_media_type = 'number' -%}
      {%- endif -%}

      <div class="min-w-0 {{ frame_class }}" style="{{ frame_style }}">
        {%- render 'core-callout',
          media: wrapped_media,
          title_text: child_title,
          body_text: child_body,
          media_type: child_media_type,
          media_px: media_px,
          callout_color_class: callout_color_class,
          callout_color_style: callout_color_style,
          color_enabled: block.settings.set_color_scheme,
          s: block.settings,
          attributes: child.shopify_attributes
        -%}
      </div>
    {%- else -%}
      {%- comment -%} Escape hatch: no markers, render as-is (e.g. _callout) {%- endcomment -%}
      {%- if frame_class != blank or frame_style != blank -%}
        <div class="min-w-0 {{ frame_class }}" style="{{ frame_style }}">
          {{- content -}}
        </div>
      {%- else -%}
        {{- content -}}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%} ── Outer grid ── {%- endcomment -%}
<div
  class="
    w-full grid gap-layout
    [--card-grid-cols:--card-grid-cols-sm]
    md:[--card-grid-cols:--card-grid-cols-md]
    lg:[--card-grid-cols:--card-grid-cols-lg]
    grid-cols-[repeat(var(--card-grid-cols),minmax(0,1fr))]
    entrance-container *:auto-set-stagger-order
  "
  style="
    --card-grid-cols-sm: {{ block.settings.columns_sm | default: 1 }};
    --card-grid-cols-md: {{ block.settings.columns_md | default: 2 }};
    --card-grid-cols-lg: {{ block.settings.columns_lg | default: 3 }};
    {{ grid_style }}
  "
  {{ block.shopify_attributes }}
>
  {{- items -}}
</div>

