{% doc %}
  - Renders pair column with card grid, or slider on mobile

  Private, only offered by section-pair. The title is the static _section-title block with id card-grid-title.
{% enddoc %}

{% liquid
  # Desktop (always grid)
  assign columns_lg = block.settings.columns_lg | default: 2

  # Tablet: always visible slider
  assign columns_md = block.settings.columns_md | default: columns_lg

  # Mobile: allow select between slider and grid
  assign layout_mobile = block.settings.layout_mobile | default: 'slider'
  if layout_mobile == 'slider'
    assign columns_sm = settings.slider_columns_mobile
  else
    assign columns_sm = block.settings.columns_sm_grid | default: 2
  endif
%}

{% capture attributes %}
  x-ensemble:carousel
  x-overflow.autoregister

  {{ block.shopify_attributes }}
{% endcapture %}

{% capture style %}
  --card-list-columns-desktop: {{ columns_lg }};
  --card-list-columns-tablet: {{ columns_md }};
  --card-list-columns-mobile: {{ columns_sm }};
{% endcapture %}

{% capture card_list_class %}
  vars-card-list-pair-desktop-grid
  vars-card-list-pair-tablet-grid
  vars-card-list-pair-mobile-{{ layout_mobile }}
  card-list-layout-grid
  {% if layout_mobile == 'grid' %}
    card-list-mobile-layout-grid
  {% else %}
    card-list-mobile-layout-slider
  {% endif %}
{% endcapture %}

{% capture content %}
  {% comment %} Hardcoded gap because card grid has gap settings that would awkwardly set gap-y-layout {% endcomment %}
  <div class="flex grid-cols-[--pair-grid-cols] flex-col gap-y-r6 relative">
    <div class="pair-column-title vars-content-align-{{ block.settings.title_placement }} empty:hidden">
      {%- content_for 'block', type: '_section-title', id: 'card-grid-title' -%}
    </div>

    {% capture blocks %}
      {% content_for "blocks" %}
    {% endcapture %}

    {% render 'core-card-slider', items: blocks, class: card_list_class %}

    {% if block.settings.layout_mobile == 'slider' and block.settings.overflow_buttons_visibility != 'never' %}
      {% capture overflow_button_class %}
        !absolute top-1/2 -translate-y-1/2
        {% case block.settings.overflow_buttons_visibility %}
          {% when 'desktop' %}
            max-md:hidden
          {% when 'mobile' %}
            md:hidden
        {% endcase %}
      {% endcapture %}
      {% capture overflow_button_next_class %}
        {{ overflow_button_class }} end-[var(--pair-pe)]
      {% endcapture %}
      {% capture overflow_button_prev_class %}
        {{ overflow_button_class }} start-[var(--pair-ps)]
      {% endcapture %}

      {% capture overflow_button_prev_attributes %}
        :disabled="!$overflow.start"
        :class="{
          '!opacity-0': !$overflow.start,
        }"
        :data-overflow-start-amount="$overflow.start"
        x-show="$carousel.items.length > 1"
        x-cloak
      {% endcapture %}
      {% capture overflow_button_next_attributes %}
        x-show="$carousel.items.length > 1"
        :disabled="!$overflow.end"
        :data-overflow-end-amount="$overflow.end"
        :class="{
          '!opacity-0': !$overflow.end,
        }"
        x-cloak
      {% endcapture %}

      {% render 'slider-overflow-button', type: 'prev', class: overflow_button_prev_class, background_style: 'soft', attributes: overflow_button_prev_attributes %}
      {% render 'slider-overflow-button', type: 'next', class: overflow_button_next_class, background_style: 'soft', attributes: overflow_button_next_attributes %}
    {% endif %}
  </div>
{% endcapture %}

{% render 'pair-column',
  content: content,
  class: 'pair-column-card-grid pair-column-yields-to-surface',
  style: style,
  attributes: attributes,
  s: block.settings
%}

{% schema %}
{
  "name": "Card grid",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "columns_lg",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_md",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet",
      "default": 2
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile layout",
      "default": "slider",
      "options": [
        {"value": "slider", "label": "Carousel"},
        {"value": "grid", "label": "Grid"}
      ]
    },
    {
      "type": "select",
      "label": "Overflow buttons",
      "id": "overflow_buttons_visibility",
      "visible_if": "{{ block.settings.layout_mobile == 'slider' }}",
      "default": "mobile",
      "options": [
        {"value": "mobile", "label": "Mobile"},
        {"value": "never", "label": "Never"}
      ]
    },
    {
      "type": "select",
      "id": "columns_sm_grid",
      "label": "Mobile columns",
      "default": "2",
      "visible_if": "{{ block.settings.layout_mobile == 'grid' }}",
      "options": [
        {"value": "1", "label": "1"},
        {"value": "2", "label": "2"}
      ]
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text_alignment",
      "id": "title_placement",
      "label": "Title alignment",
      "default": "center"
    },
    [% json 'schema/color-settings-column-solid.jsonc', default_background: 'tint' %]
    {
      "type": "header",
      "content": "Border"
    },
    [% json 'schema/border-settings.jsonc' %]
    {
      "type": "header",
      "content": "Rounding",
      "visible_if": "{{ block.settings.set_color_scheme or block.settings.set_border }}"
    },
    [% json 'schema/rounding-large.jsonc', conditional: 'block.settings.set_color_scheme or block.settings.set_border' %]

    [% json 'schema/buffer-spacing.jsonc' %]

    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "checkbox",
      "id": "set_gap",
      "label": "Set gap",
      "default": false
    },
    [% json 'schema/grid-gap-setting.jsonc', default_gap: 'md', conditional: 'block.settings.set_gap' %]

    {
      "type": "header",
      "content": "Height"
    },
    [% json 'schema/pair-column-height-setting.jsonc' %]

  ],
  "blocks": [
    [% json 'schema/blocks-card-list.jsonc' %]
  ],
  "presets": [
    {
      "name": "Card grid",
      "category": "Grid",
      "settings": {
        "columns_lg": 2,
        "layout_mobile": "slider"
      },
      "blocks": [
        {
          "id": "card-grid-title",
          "type": "_section-title",
          "static": true,
          "settings": {
            "text": "Featured Products"
          }
        },
        {
          "type": "_cards-products",
          "settings": {
            "source": "collection",
            "card_limit": 4
          }
        }
      ]
    }
  ]
}
{% endschema %}
