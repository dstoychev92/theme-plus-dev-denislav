<!-- blocks/theme-text.liquid -->

{% doc %}
  - Renders inline text with type preset
{% enddoc %}

{% liquid
  assign limit_width = block.settings.limit_width
  assign max_width = block.settings.max_width
%}



{% liquid
  if settings.show_tag_settings and block.settings.set_heading_tag
    assign tag = block.settings.heading_tag | default: 'h2'
  else
    # Make an educated guess at the correct tag semantics based on the type preset
    assign tag = block.settings.type_preset | default: 'p'
    assign tag = tag | replace: 'kicker', 'h3' | replace: 'micro', 'p' | replace: 'section', 'h2' | replace: 'custom', 'p'
    if tag != 'p' and tag != 'h2' and tag != 'h3' and tag != 'h4' and tag != 'h5' and tag != 'h6'
      assign tag = 'p'
    endif
  endif
%}


{% capture style %}
  {% if block.settings.set_color and block.settings.color == 'custom' %}
    --color-custom-text: {{ block.settings.color_custom }};
  {% endif %}

  {% if limit_width %}
    {% render 'props-style-max-width', max_width: max_width %}
  {% endif %}
{% endcapture %}

{% capture class %}
  {% if block.settings.set_color %}
    text-{{ block.settings.color | default: 'content' }}
  {% else %}
    text-default
  {% endif %}
  inline-richtext

  {% comment %} Disable entrance animations in visual preview mode to prevent "No preview available" error {% endcomment %}
  {% unless request.visual_preview_mode %}
    entrance-item entrance-standard
  {% endunless %}
{% endcapture %}

<div class="{{ class }}" style="{{ style }}" {{ block.shopify_attributes }}>
  {% render 'core-text-preset', tag: tag, s: block.settings %}
</div>

{% schema %}
{
