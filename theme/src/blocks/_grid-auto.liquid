			"content": "Dense"
		},
		{
			"type": "checkbox",
			"id": "enable_dense_fill",
			"label": "Dense rearrangement",
			"default": false,
			"info": "Moves small items up to fill empty cells left by wide, tall, or featured slots"
		}
	],
	"blocks": [
		{
			"type": "@theme"
		},
		{
			"type": "@app"
		},
		{
