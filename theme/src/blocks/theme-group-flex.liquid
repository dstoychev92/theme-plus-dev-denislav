<!-- blocks/theme-group-flex.liquid -->

{% doc %}
  - Renders flex row or column holding flex items
{% enddoc %}{% liquid
  assign direction = block.settings.direction
  assign wrap = block.settings.wrap
  assign full_width = block.settings.full_width

  if direction == 'row' or direction == 'row-reverse'
    assign justify = block.settings.justify_row
    assign align = block.settings.align_row
  else
    assign justify = block.settings.justify_column
    assign align = block.settings.align_column
  endif

  assign align_content = block.settings.align_content

  assign gap = block.settings.gap
  assign gap_custom = block.settings.gap_custom
  case gap
    when 'sm'
      assign gap_x_md = 'var(--root-space-sm)'
      assign gap_y_md = 'var(--raw-space-sm)'
    when 'md'
      assign gap_x_md = 'var(--root-space-md)'
      assign gap_y_md = 'var(--raw-space-md)'
    when 'lg'
      assign gap_x_md = 'var(--root-space-lg)'
      assign gap_y_md = 'var(--raw-space-lg)'
    when 'custom'
      assign gap_x_md = 'calc(' | append: gap_custom | append: 'px * var(--r-multiplier))'
      assign gap_y_md = 'calc(' | append: gap_custom | append: 'px)'
  endcase

  assign set_breakpoint = block.settings.set_breakpoint

  if set_breakpoint
    assign breakpoint_value = block.settings.breakpoint | default: 'md'
    if breakpoint_value == 'lg'
      assign bp_prefix = 'max-lg'
    else
      assign bp_prefix = 'max-md'
    endif

    assign direction_mobile = block.settings.direction_mobile
    assign wrap_mobile = block.settings.wrap_mobile
    assign full_width_mobile = block.settings.full_width_mobile

    if direction_mobile == 'row' or direction_mobile == 'row-reverse'
      assign justify_mobile = block.settings.justify_row_mobile
      assign align_mobile = block.settings.align_row_mobile
    else
      assign justify_mobile = block.settings.justify_column_mobile
      assign align_mobile = block.settings.align_column_mobile
    endif
    assign align_content_mobile = block.settings.align_content_mobile

    assign gap_m = block.settings.gap_mobile
    assign gap_custom_m = block.settings.gap_custom_mobile
    case gap_m
      when 'sm'
        assign gap_x_sm = 'var(--root-space-sm)'
        assign gap_y_sm = 'var(--raw-space-sm)'
      when 'md'
        assign gap_x_sm = 'var(--root-space-md)'
        assign gap_y_sm = 'var(--raw-space-md)'
      when 'lg'
        assign gap_x_sm = 'var(--root-space-lg)'
        assign gap_y_sm = 'var(--raw-space-lg)'
      when 'custom'
        assign gap_x_sm = 'calc(' | append: gap_custom_m | append: 'px * var(--r-multiplier))'
        assign gap_y_sm = 'calc(' | append: gap_custom_m | append: 'px)'
    endcase
  endif
%}

<div
  class="
    flex
    vars-content-align-{{ block.settings.text_alignment }} text-content-align items-content-align
    {% if full_width %}w-full{% endif %}
    [--flex-direction:var(--flex-direction-md)]
    [--flex-wrap:var(--flex-wrap-md)]
    [--justify-content:var(--justify-content-md)]
    [--align-items:var(--align-items-md)]
    [--align-content:var(--align-content-md)]
    [--layout-gutter-x:var(--layout-gutter-x-md)]
    [--layout-gutter-y:var(--layout-gutter-y-md)]
    {% comment %}
      Both max-md: and max-lg: variants are written literally so Tailwind's
      static class scan compiles both rules. Liquid picks which set to emit.
    {% endcomment %}
    {% if set_breakpoint and bp_prefix == 'max-md' %}
      max-md:[--flex-direction:var(--flex-direction-sm)]
      max-md:[--flex-wrap:var(--flex-wrap-sm)]
      max-md:[--justify-content:var(--justify-content-sm)]
      max-md:[--align-items:var(--align-items-sm)]
      max-md:[--align-content:var(--align-content-sm)]
      max-md:[--layout-gutter-x:var(--layout-gutter-x-sm)]
      max-md:[--layout-gutter-y:var(--layout-gutter-y-sm)]
      {% if full_width_mobile and full_width == false %}
        max-md:w-full
      {% elsif full_width_mobile == false and full_width %}
        max-md:w-auto
      {% endif %}
    {% elsif set_breakpoint and bp_prefix == 'max-lg' %}
      max-lg:[--flex-direction:var(--flex-direction-sm)]
      max-lg:[--flex-wrap:var(--flex-wrap-sm)]
      max-lg:[--justify-content:var(--justify-content-sm)]
      max-lg:[--align-items:var(--align-items-sm)]
      max-lg:[--align-content:var(--align-content-sm)]
      max-lg:[--layout-gutter-x:var(--layout-gutter-x-sm)]
      max-lg:[--layout-gutter-y:var(--layout-gutter-y-sm)]
      {% if full_width_mobile and full_width == false %}
        max-lg:w-full
      {% elsif full_width_mobile == false and full_width %}
        max-lg:w-auto
      {% endif %}
    {% endif %}

    {% comment %} Disable entrance animations in visual preview mode to prevent "No preview available" error {% endcomment %}
    {% unless request.visual_preview_mode %}
      entrance-item entrance-standard no-children-entrance
    {% endunless %}
  "
  style="
    --flex-direction-md: {{ direction }};
    --flex-wrap-md: {{ wrap }};
    --justify-content-md: {{ justify }};
    --align-items-md: {{ align }};
    --align-content-md: {{ align_content }};
    --layout-gutter-x-md: {{ gap_x_md }};
    --layout-gutter-y-md: {{ gap_y_md }};
    {% if set_breakpoint %}
      --flex-direction-sm: {{ direction_mobile }};
      --flex-wrap-sm: {{ wrap_mobile }};
      --justify-content-sm: {{ justify_mobile }};
      --align-items-sm: {{ align_mobile }};
      --align-content-sm: {{ align_content_mobile }};
      --layout-gutter-x-sm: {{ gap_x_sm }};
      --layout-gutter-y-sm: {{ gap_y_sm }};
    {% endif %}
    --layout-gutter: var(--layout-gutter-x);
    flex-direction: var(--flex-direction);
    flex-wrap: var(--flex-wrap);
    justify-content: var(--justify-content);
    align-items: var(--align-items);
    align-content: var(--align-content);
    column-gap: var(--layout-gutter-x);
    row-gap: var(--layout-gutter-y);
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

