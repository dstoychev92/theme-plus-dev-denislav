<!-- blocks/_inline-spacer.liquid -->

{% doc %}
  - Renders inline gap or line break

  Sits in an inline text flow such as theme-group-text or section-text-spotlight. Break to new
  line turns the gap vertical.
{% enddoc %}

{% liquid
  assign break_newline = block.settings.break_newline | default: false
  assign spacer_padding = block.settings.spacer_padding | default: 0
  assign target_device = block.settings.target_device | default: 'both'
%}

{% capture class %}
  {% comment %}
    We can't use the snippet, because we need !important to override the inline "display" styles
    {% render 'props-class-target-device', target_device: target_device %}
  {% endcomment %}
  {% case target_device %}
    {% when 'mobile' %}
      md:!hidden
    {% when 'desktop' %}
      max-md:!hidden
  {% endcase %}
{% endcapture %}

{% capture attributes %}
  {{ block.shopify_attributes }}
{% endcapture %}

{% capture style %}
  --spacer-size:{{- spacer_padding -}}px;
  {%- if break_newline -%}
    display: block;
    {% # All elements should have at least 1px width and height in order to appear in the visual preview window %}
    width: 1px;
    height: calc(var(--spacer-size) * var(--r-multiplier));
  {% else %}
    display: inline-block;
    width: calc(var(--spacer-size) * var(--r-multiplier));
    height: 1px;
  {%- endif -%}
{% endcapture %}

<span
  style="{{ style | strip }}"
  class="{{ class | strip }}"
  {{ attributes }}
>
</span>

{% schema %}
{
	"name": "Spacer",
	"tag": null,
	"settings": [
		{
			"type": "range",
			"id": "spacer_padding",
			"min": 0,
			"max": 500,
			"step": 5,
			"unit": "px",
			"label": "Size",
			"default": 20
		},
		{
			"type": "checkbox",
			"id": "break_newline",
			"label": "Break to new line",
			"default": false
		},
		{
			"type": "header",
			"content": "Limit by screen size"
		},
		{
			"type": "select",
			"label": "Show on",
			"id": "target_device",
			"default": "both",
			"options": [
				{
					"value": "mobile",
					"label": "Mobile"
				},
				{
					"value": "desktop",
					"label": "Desktop"
				},
				{
					"value": "both",
					"label": "Both"
				}
			]
		},
	],
	"presets": [
		{
			"name": "Spacer",
			"category": "Layout"
		}
	]
}
{% endschema %}
