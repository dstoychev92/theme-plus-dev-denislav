{% doc %}
  - Renders hotspot dot opening a product card

  Sits inside _pair-hotspots.
{% enddoc %}

{% render 'hotspot-product',
  product: block.settings.product,
  s: block.settings,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Product",
  "tag": null,
  "settings": [
    [% json 'schema/position-settings.jsonc', optional_mobile: true %]
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "blocks": [
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
