					"label": "Tab"
				},
				{
					"group": "Custom",
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ block.settings.type_preset != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font",
			"label": "Font",
			"default": "heading",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 10,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ block.settings.type_preset == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Gap"
		},
		{
			"type": "checkbox",
			"id": "set_gap",
			"label": "Set gap",
			"default": false
		},
		{
			"type": "select",
			"id": "gap",
			"label": "Gap",
			"default": "sm",
			"visible_if": "{{ block.settings.set_gap }}",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom",
			"label": "Custom gap",
			"default": 0,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.gap == 'custom'  and block.settings.set_gap }}"
		},
		{
			"type": "header",
			"content": "Width"
		},
		{
			"type": "checkbox",
			"id": "limit_width",
			"label": "Limit width",
			"default": false
		},
		{
			"type": "range",
			"id": "max_width",
			"label": "Limit",
			"unit": "px",
			"min": 100,
			"max": 1100,
			"step": 10,
			"default": 500,
			"visible_if": "{{ block.settings.limit_width == true }}"
		},
		{
			"type": "header",
			"content": "Columns"
		},
		{
			"type": "checkbox",
			"id": "set_column_alignment",
			"label": "Set columns",
			"default": false
		},
		{
			"type": "select",
			"id": "column_style",
			"label": "Column style",
			"visible_if": "{{ block.settings.set_column_alignment }}",
			"default": "count",
			"options": [
				{
					"value": "count",
					"label": "Count"
				},
				{
					"value": "pixels",
					"label": "Pixels"
				}
			]
		},
		{
			"type": "range",
			"id": "column_count",
			"label": "Column count",
			"visible_if": "{{ block.settings.set_column_alignment and block.settings.column_style == 'count' }}",
			"min": 1,
			"max": 4,
			"default": 2,
			"step": 1
		},
		{
			"type": "range",
			"id": "column_width_px",
			"label": "Column width",
			"visible_if": "{{ block.settings.set_column_alignment and block.settings.column_style == 'pixels' }}",
			"unit": "px",
			"min": 100,
			"max": 1000,
			"default": 400,
			"step": 20
		},
		{
			"type": "header",
			"content": "Alignment"
		},
		{
			"type": "checkbox",
			"id": "set_alignment",
			"label": "Set alignment",
			"default": false
		},
		{
			"type": "text_alignment",
			"id": "text_alignment",
			"label": "Text alignment",
			"visible_if": "{{ block.settings.set_alignment }}",
			"default": "center"
		},
		{
			"type": "select",
			"id": "inline_block_alignment",
			"label": "Graphic alignment",
			"info": "Image, decoration, icon, etc.",
			"visible_if": "{{ block.settings.set_alignment }}",
			"default": "middle",
			"options": [
				{
					"value": "middle",
					"label": "Center"
				},
				{
					"value": "baseline",
					"label": "Baseline"
				}
			]
		},
		{
			"type": "header",
			"content": "Tag",
			"visible_if": "{{ settings.show_tag_settings == true }}"
		},
		{
			"type": "checkbox",
			"id": "set_heading_tag",
			"label": "Set HTML tag",
			"visible_if": "{{ settings.show_tag_settings == true }}",
			"default": false
		},
		{
			"type": "select",
			"id": "heading_tag",
			"label": "HTML tag",
			"info": "Override the style preset with a specific HTML tag",
			"default": "h2",
			"visible_if": "{{ settings.show_tag_settings == true and block.settings.set_heading_tag == true }}",
			"options": [
				{
					"value": "p",
					"label": "p"
				},
				{
					"value": "h1",
					"label": "h1"
				},
				{
					"value": "h2",
					"label": "h2"
				},
				{
					"value": "h3",
					"label": "h3"
				},
				{
					"value": "h4",
					"label": "h4"
				},
				{
					"value": "h5",
					"label": "h5"
				},
				{
					"value": "h6",
					"label": "h6"
				}
			]
		},
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "_inline-group-target"
		},
		{
			"type": "_inline-text"
		},
		{
			"type": "_inline-spacer"
		},
		{
			"type": "_inline-image"
		},
		{
			"type": "theme-decoration"
		},
		{
			"type": "theme-icon"
		},
	],
	"presets": [
		{
			"name": "Text group",
			"category": "Layout",
			"blocks": [
				{
					"type": "_inline-text",
					"settings": {
						"text": "Primary title",
						"set_color": false,
						"color": "content",
