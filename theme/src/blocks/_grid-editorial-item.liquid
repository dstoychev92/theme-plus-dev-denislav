<!-- blocks/_grid-editorial-item.liquid -->

{% doc %}
  - Renders editorial grid item holding other blocks

  @param {string} [block_class] - classes for this block instance
  @param {string} [block_style] - inline styles for this block instance
{% enddoc %}

{% liquid
  if block.settings.set_parallax
    assign parallax = block.settings.parallax | default: 0
    assign parallax_direction = block.settings.parallax_direction | default: 'vertical'
  endif

  assign col_start = block.settings.col_start
  assign col_end = block.settings.col_end
  assign row_start = block.settings.row_start

  assign row_span = 1
  if block.settings.set_row_span
    assign row_span = block.settings.row_span
  endif

  assign col_start_sm = block.settings.col_start_sm
  assign col_end_sm = block.settings.col_end_sm
  assign row_start_sm = block.settings.row_start_sm

  assign row_span_sm = 1
  if block.settings.set_row_span_sm
    assign row_span_sm = block.settings.row_span_sm
  endif

  assign set_grid_mobile = block.settings.set_grid_mobile
  if block.settings.target_device == 'mobile'
    assign set_grid_mobile = true
  endif

  assign col_start_md = block.settings.col_start_md
  assign col_end_md = block.settings.col_end_md
  assign row_start_md = block.settings.row_start_md

  assign row_span_md = 1
  if block.settings.set_row_span_md
    assign row_span_md = block.settings.row_span_md
  endif

  assign content_align = 'left'

  if block.settings.set_layout
    assign content_align = block.settings.content_align
    assign gap = block.settings.gap | default: false, allow_false: true
  endif
%}

{%- if request.visual_preview_mode and block.settings.visual_preview_pro -%}
  {%- render 'grid-editorial-item-preview', s: block.settings, attributes: block.shopify_attributes -%}
{%- else -%}
  <div
    class="
      flex flex-col gap-layout w-full h-full relative cq-width
      text-content-align items-content-align
      {% if content_align %}
        vars-content-align-{{ content_align }}
      {% endif %}

      [--col-start:var(--col-start-lg)]
      [--col-end:var(--col-end-lg)]
      [--row-start:var(--row-start-lg)]
      [--row-span:var(--row-span-lg)]

      {% if set_grid_mobile == true %}
        max-md:[--col-start:var(--col-start-sm)]
        max-md:[--col-end:var(--col-end-sm)]
        max-md:[--row-start:var(--row-start-sm)]
        max-md:[--row-span:var(--row-span-sm)]
      {% endif %}

      {% if block.settings.set_grid_tablet == true %}
        md:max-lg:[--col-start:var(--col-start-md)]
        md:max-lg:[--col-end:var(--col-end-md)]
        md:max-lg:[--row-start:var(--row-start-md)]
        md:max-lg:[--row-span:var(--row-span-md)]
      {% endif %}

      {% if parallax != blank and parallax != 0 %}
        will-change-transform
      {% endif %}

      {% render 'props-class-target-device', s: block.settings %}

      {{ block_class }}
    "

    style="
      {%- if gap -%}
        {% render 'props-style-gap', s: block.settings %}
      {%- endif -%}
      --col-start-lg: {{col_start}};
      --col-end-lg: {{col_end | plus: 1}};
      --row-start-lg: {{row_start}};
      --row-span-lg: {{row_span}};

      {% if set_grid_mobile == true %}
        --col-start-sm: {{col_start_sm}};
        --col-end-sm: {{col_end_sm | plus: 1}};
        --row-start-sm: {{row_start_sm}};
        --row-span-sm: {{row_span_sm}};
      {% endif %}

      {% if block.settings.set_grid_tablet == true %}
        --col-start-md: {{col_start_md}};
        --col-end-md: {{col_end_md | plus: 1}};
        --row-start-md: {{row_start_md}};
        --row-span-md: {{row_span_md}};
      {% endif %}

      grid-column: var(--col-start,auto) / var(--col-end,auto);
      grid-row: var(--row-start,auto) / span var(--row-span,auto);

      {% comment %} Allow short & long image tiles in 12-column grid when tile block aspect ratio is unset {% endcomment %}
      --tile-min-aspect-ratio:10;
      --image-min-aspect-ratio:10;

      {{ block_style }}
    "

    {% if request.design_mode %}
      :class="
        {
          '!opacity-100': $containsSelectedBlock || $isSelectedBlock,
        }
      "
    {% endif %}

    {% if parallax != blank and parallax != 0 %}
      x-parallax:element.{{ parallax_direction }}.distance.{{ parallax }}%
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {% content_for 'blocks' %}
  </div>
{%- endif -%}

