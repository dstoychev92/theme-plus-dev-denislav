<!-- blocks/_product-option-siblings.liquid -->

{% doc %}
  - Renders swatches linking to sibling products

  @param {string} [block_attributes] - attributes for this block instance
  @param {string} [block_class] - classes for this block instance
{% enddoc %}

{% liquid
  assign product = closest.product

  if product == blank and request.visual_preview_mode
    assign product = collections.all.products.first
  endif

  assign history = section.settings.enable_history
  assign swatch_size = block.settings.swatch_option_sizing
  assign default_label = 'product.sibling_label' | t

  if block.settings.set_custom_list
    assign siblings = block.settings.custom_list
  elsif settings.metafield_siblings != blank
    assign siblings_metafield_namespace = settings.metafield_siblings | split: '.' | first
    assign siblings_metafield_key = settings.metafield_siblings | split: '.' | last
    assign siblings_metafield = product.metafields[siblings_metafield_namespace][siblings_metafield_key]

    assign siblings = null | sort
    assign sibling_label = default_label

    case siblings_metafield.type
      when 'single_line_text_field'
        # Metafield is set to a collection handle. This is the legacy way to define siblings and not the preferable way.
        assign collection_handle = siblings_metafield.value
        assign siblings_collection = collections[collection_handle]
        assign siblings = siblings_collection.products
      when 'metaobject_reference'
        # Metafield is set to a metaobject which has a field that is a list of products
        assign siblings_metaobject = siblings_metafield.value

        assign product_list_field_name = settings.metafield_siblings_inner_name | default: 'products'

        assign siblings = siblings_metaobject[product_list_field_name].value
    endcase
  endif

  # Allow custom label even if custom sibings are not set
  if block.settings.set_custom_label
    assign sibling_label = block.settings.custom_label
  else
    assign sibling_label = default_label
  endif

  # Some metafield types return a size property, others return a count property so we need to handle both
  assign siblings_size_count = siblings.size | default: siblings.count
%}

{% if siblings_size_count > 0 %}
  {% capture content %}
    <div
      style="{% render 'props-style-gap', s: block.settings, apply: false %}"
      class="{{ block_class }} flex flex-col gap-y-r10"
    >
      {% liquid
        assign selected_sibling_label = null
        assign match_product = siblings | where: "id", product.id

        if match_product != blank
          assign selected_sibling_label = product.title

          if settings.metafield_sibling_label != blank and settings.enable_sibling_custom_swatch == true
            assign sibling_label_metafield_namespace = settings.metafield_sibling_label | split: '.' | first
            assign sibling_label_metafield_key = settings.metafield_sibling_label | split: '.' | last
            assign sibling_label_metafield = product.metafields[sibling_label_metafield_namespace][sibling_label_metafield_key]
            if sibling_label_metafield != blank
              assign selected_sibling_label = sibling_label_metafield.value
            endif
          elsif product.metafields.shopify['color-pattern']
            assign swatch_metafield = product.metafields.shopify['color-pattern'].value | first
            assign selected_sibling_label = swatch_metafield.label.value
          endif
        endif

        # Helpers for the sibling label liquid logic
        if sibling_label == ''
          assign sibling_label = null
        endif
        assign starting_opacity = 'opacity-0'
        if sibling_label and selected_sibling_label
          assign starting_opacity = 'opacity-100'
        endif
      %}

      {% comment %} Use div with role group instead of fieldset to avoid fieldset styling difficulties {% endcomment %}
      <div
        role="group"
        @mouseleave="hoverValue = null"
        x-data="
          {
            hoverValue: null,
          }
        "
        aria-label="{{ sibling_label | default: default_label | default: 'Color' | escape_once }}"
      >
        <div class="mb-r5 flex-row-center justify-content-align gap-x-r5 type-p type-resize-sm">
          {% if sibling_label %}
            <span class="font-bold">{{ sibling_label }}</span>
          {% endif %}
          {%# This line has to dissapear if there is no current or over value %}
          <span
            role="presentation"
            class="block w-px h-[12px] border-r border-line-bold {{ starting_opacity }}"
            data-selected-label="{{ selected_sibling_label | escape_once }}"
            :class="hoverValue || $el.dataset.selectedLabel != '' ? 'opacity-100' : 'opacity-0'"
          ></span>
          {%# Label rides a data attribute since a quote in the title or metafield would break the expression %}
          <span
            data-selected-label="{{ selected_sibling_label | escape_once }}"
            x-html="hoverValue || $el.dataset.selectedLabel"
          >
            {{ selected_sibling_label }}
          </span>
        </div>
        <ul
          class="group w-full flex flex-row justify-content-align flex-wrap gap-layout"
          x-roving-tab
          x-roving-tab:list
          role="toolbar"
          aria-label="{{ sibling_label | escape_once }}"
        >
          {% for sibling in siblings %}
            {% liquid
              assign selected = false

              if sibling.id == product.id
                assign selected = true
              endif

              assign swatch_label = sibling.title

              if settings.metafield_sibling_label != blank and settings.enable_sibling_custom_swatch == true
                assign sibling_label_metafield_namespace = settings.metafield_sibling_label | split: '.' | first
                assign sibling_label_metafield_key = settings.metafield_sibling_label | split: '.' | last
                assign sibling_label_metafield = sibling.metafields[sibling_label_metafield_namespace][sibling_label_metafield_key]
                if sibling_label_metafield != blank
                  assign swatch_label = sibling_label_metafield.value
                endif
              elsif sibling.metafields.shopify['color-pattern']
                assign swatch_metafield = sibling.metafields.shopify['color-pattern'].value | first
                assign swatch_label = swatch_metafield.label.value
              endif

              assign sibling_focus_key = 'sibling-' | append: sibling.id
            %}

            {% capture sibling_url %}
              {% render 'product-sibling-url',
                product: product,
                sibling: sibling,
                preserve_selected_options: true
              %}
            {% endcapture %}
            {% assign sibling_url = sibling_url | strip %}

            {% capture option_item_attributes %}
              data-swatch-label="{{ swatch_label | escape_once }}"
              @mouseenter="if (!$media.matches.touch) { hoverValue = $el.dataset.swatchLabel }"
            {% endcapture %}

            {% capture swatch_attributes %}
              {% comment %} Unfortunatly we can't use the fancy sibling update if the sibling and product have different template suffixes since section rendering API will return sibling with the wrong template {% endcomment %}
              {% if sibling.template_suffix == product.template_suffix %}
                data-preload-url="{{- sibling_url -}}"
                data-sibling-handle="{{ sibling.handle | escape_once }}"
                @focus.once="
                  $sectionApi.load({baseUrl: $el.dataset.preloadUrl, abortPending: false, waitForIdle: false, priority: 'high'});
                "
                @pointerenter.once="
                  $sectionApi.load({baseUrl: $el.dataset.preloadUrl, abortPending: false, waitForIdle: false, priority: 'high'});
                "

                @link:pending="
                  await $yieldToMain();
                  $dispatch('theme:sibling:change', { siblingId: {{ sibling.id }}, productId: {{ product.id }}, sectionId: '{{ section.id }}', url: $el.dataset.preloadUrl, handle: $el.dataset.siblingHandle })
                "
                :data-swatch-active="$asyncLink.state === 'pending'"

                {% comment %} Disable default navigation behaviour of link and instead update the product form via section rendering API when clicked {% endcomment %}
                {% if history %}
                  x-section-api:link.replace
                {% else %}
                  x-section-api:link.nopush
                {% endif %}
              {% endif %}
            {% endcapture %}

            <li key="{{ sibling.id }}" role="none" class="relative group/swatch-link flex-none has-[:focus]:z-10" {{ option_item_attributes }}>
              {% render 'product-sibling-swatch',
                size: swatch_size,
                sibling: sibling,
                selected: selected,
                tag: 'link',
                url: sibling_url,
                attributes: swatch_attributes,
                selection_id: sibling.id,
                focus_key: sibling_focus_key
              %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endcapture %}
{% endif %}

{% capture attributes %}
  x-selection-group
  data-selected-id="{{ product.id }}"
  :data-selection-loading="$sectionApi.isDelayedLoading"
  x-preloader
  {{ block_attributes }}
{% endcapture %}

{% render 'product-block', s: block.settings, content: content, attributes: attributes, class: 'w-full' %}

{% schema %}
{
	"name": "Linked products",
	"tag": null,
	"settings": [
		{
			"type": "header",
			"content": "Sibling swatch options",
		},
		{
			"type": "select",
			"id": "swatch_option_sizing",
			"label": "Size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			]
		},
		{
			"type": "select",
			"id": "gap",
			"label": "Gap",
			"default": "sm",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "range",
			"id": "gap_custom",
			"label": "Custom gap",
			"default": 10,
			"min": 0,
			"max": 80,
			"step": 2,
			"unit": "px",
			"visible_if": "{{ block.settings.gap == 'custom'  }}"
		},
		{
			"type": "header",
			"content": "Custom label"
		},
		{
			"type": "checkbox",
			"id": "set_custom_label",
			"label": "Set custom label",
			"default": false
		},
		{
			"type": "text",
			"id": "custom_label",
			"label": "Custom label",
			"visible_if": "{{ block.settings.set_custom_label == true }}"
		},
		{
			"type": "header",
			"content": "Custom sibling list",
			"info": "Defaults to the [product siblings metafield](/editor?context=theme&category=Metafields) in global settings"
		},
		{
			"type": "checkbox",
			"id": "set_custom_list",
			"label": "Set custom sibling list",
			"default": false
		},
		{
			"type": "product_list",
			"id": "custom_list",
			"label": "Siblings",
			"info": "Select the siblings to display"
		}
	],
	"presets": [
		{
			"name": "Linked products",
			"category": "Add to cart"
		}
	]
}
{% endschema %}
