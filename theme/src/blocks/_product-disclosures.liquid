{% doc %}
  - Renders product disclosures as accordion items

  Reads closest.product.metafields.shopify.disclosure and shows only the disclosures scoped to the product page.
{% enddoc %}

{% liquid
  assign product = closest.product
  assign disclosures = product.metafields.shopify.disclosure.value

  assign enable_placeholder = false
  if settings.placeholder_mode or request.design_mode or request.visual_preview_mode
    assign enable_placeholder = true
  endif

  assign id_base = section.id | append: '-' | append: block.id | append: '-disclosure-'
%}

{% capture items %}
  {% if disclosures != blank %}
    {% for disclosure in disclosures %}
      {% comment %} Merchants scope each disclosure to surfaces in the admin; the other surface values are 'cart' and 'checkout' {% endcomment %}
      {% unless disclosure.display_preferences.value.surfaces contains 'product_page' %}
        {% continue %}
      {% endunless %}

      {% liquid
        assign item_expanded = false
        if block.settings.expand and forloop.first
          assign item_expanded = true
        endif

        assign symbol = nil
        if block.settings.show_symbol
          assign symbol = disclosure.symbol.value
        endif

        assign item_id = id_base | append: forloop.index0
        assign title = disclosure.title.value
      %}

      {% capture item_content %}
        <div class="prose type-resize-all-{{ block.settings.richtext_size }}">
          {{ disclosure.content | metafield_tag }}
        </div>
      {% endcapture %}

      {% render 'product-disclosure-item',
        content: item_content,
        expanded: item_expanded,
        id: item_id,
        s: block.settings,
        symbol: symbol,
        title: title
      %}
    {% endfor %}
  {% elsif enable_placeholder %}
    {% assign placeholder_title = 'product.placeholder.disclosure_title' | t %}
    {% capture placeholder_content %}
      <div class="prose type-resize-all-{{ block.settings.richtext_size }}">
        <p>{{ 'product.placeholder.disclosure_content' | t }}</p>
      </div>
    {% endcapture %}

    {% for placeholder_index in (1..2) %}
      {% liquid
        assign item_expanded = false
        if block.settings.expand and forloop.first
          assign item_expanded = true
        endif

        assign item_id = id_base | append: 'placeholder-' | append: forloop.index0
      %}

      {% render 'product-disclosure-item',
        content: placeholder_content,
        expanded: item_expanded,
        id: item_id,
        s: block.settings,
        title: placeholder_title
      %}
    {% endfor %}
  {% endif %}
{% endcapture %}
{% comment %} Strip so an empty capture stays blank for the product-block hidden check {% endcomment %}
{% assign items = items | strip %}

{% capture class %}
  group/accordions flex flex-col w-full
  {% if block.settings.show_top_border %}
    border-t border-t-line-subtle
  {% endif %}
{% endcapture %}

{% capture attributes %}
  {% comment %}
    Use the section- variant so expanded state survives theme editor section
    morphing — bare x-disclosure-group keeps its state in component-local
    x-data, which gets destroyed on morph.
  {% endcomment %}
  {% if block.settings.multiple %}
    x-section-disclosure-group.multiple
  {% else %}
    x-section-disclosure-group
  {% endif %}
  data-test-id="product-disclosures"
  {% if block.settings.show_number %}
    data-has-counter
  {% endif %}
  {% if block.settings.show_open_close_icon %}
    data-has-icon
  {% endif %}
  {% if block.settings.enable_muted_title %}
    data-muted-title
  {% endif %}
  {{ block.shopify_attributes }}
{% endcapture %}

{% comment %} Pass the reset through the style parameter, since product-block always emits a style attribute and the browser drops a second one from attributes {% endcomment %}
{% capture style %}
  {% if block.settings.show_number %}
    counter-reset: accordion-group
  {% endif %}
{% endcapture %}

{% render 'product-block',
  s: block.settings,
  content: items,
  class: class,
  style: style,
  attributes: attributes
%}

{% schema %}
{
  "name": "Product disclosures",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the disclosures added to a product in the Shopify admin. Only disclosures set to display on the product page appear."
    },
    {
      "type": "paragraph",
      "content": "A product without disclosures hides this block on the live store and shows placeholders in the theme editor."
    },
    {
      "type": "checkbox",
      "id": "show_symbol",
      "label": "Show symbol",
      "default": true,
      "info": "Show the disclosure symbol before the title"
    },
    {
      "type": "checkbox",
      "id": "expand",
      "label": "Expand first disclosure",
      "default": false
    },

    [% json 'schema/accordion-group-settings.jsonc' %]

    {
      "type": "header",
      "content": "Title"
    },
    [% json 'schema/type-preset.jsonc', default_preset: 'accordion' %]
    [% json 'schema/type-custom.jsonc', resize: true %]
    {
      "type": "header",
      "content": "Content"
    },
    [% json 'schema/type-richtext-resize-all-setting.jsonc', default: 'md' %]
  ],
  "presets": [
    {
      "name": "Product disclosures",
      "category": "Additional product info"
    }
  ]
}
{% endschema %}
