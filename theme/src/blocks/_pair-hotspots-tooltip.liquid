{% doc %}
  - Renders hotspot dot opening a tooltip holding other blocks

  Sits inside _pair-hotspots.
{% enddoc %}

{% capture popover_content %}
  {% content_for "blocks" %}
{% endcapture %}

{% capture attributes %}
  {{ block.shopify_attributes }}
{% endcapture %}

{% render 'hotspot-tooltip', content: popover_content, s: block.settings, attributes: attributes %}

{% schema %}
{
  "name": "Text tooltip",
  "tag": null,
  "settings": [
    [% json 'schema/position-settings.jsonc', optional_mobile: true %]
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Text tooltip",
      "blocks": [
        {
          "type": "theme-text",
          "settings": {
            "text": "A closer look",
            "type_preset": "h5"
          }
        },
        {
          "type": "theme-richtext",
          "settings": {
            "text": "<p>Thoughtful details, made to notice.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
