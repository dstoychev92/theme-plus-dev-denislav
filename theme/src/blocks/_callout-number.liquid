{%- if show_discount -%}
  {%- comment -%} ── Discount display: big symbol + small "off" ── {%- endcomment -%}
  {%- assign number_digits = number_digits_str | split: '' -%}
  <div
    class="flex items-start leading-[1] whitespace-nowrap"
    {%- if block.settings.enable_animation and number_digits_str != blank -%}
      x-data="{ triggered: false }"
      x-intersect.once="setTimeout(() => triggered = true, 400)"
    {%- endif -%}
  >
    {%- if block.settings.enable_animation and number_digits_str != blank -%}
      {%- for digit in number_digits -%}
        <span
          class="relative overflow-hidden edge-mask edge-mask-y inline-block w-[1ch]"
          x-animated-wheel.reverse
          data-spins="{{ forloop.index0 | plus: 3 }}"
        >
          <span
            class="w-[1ch] inline-block will-change-contents text-center"
            :class="{ 'opacity-0': $animatedWheel.isTrackVisible }"
            x-animated-wheel:input
            x-data="{ value: 0 }"
            x-effect="if (triggered) setTimeout(() => { $animatedWheel.updatePosition(0, {{ digit }}); value = {{ digit }} }, {{ forloop.index0 | times: 80 }})"
            x-text="String(value)"
            data-min="0"
            data-max="9"
            data-step="1"
            :data-value="value"
            >0</span
          >
          <div
            x-animated-wheel:track
            x-cloak
            class="absolute h-fit inset-0 block pointer-events-none whitespace-pre-line will-change-transform"
            aria-hidden="true"
          ></div>
        </span>
      {%- endfor -%}
    {%- else -%}
      <span>{{- number_digits_str -}}</span>
    {%- endif -%}

    {%- if block.settings.discount_style == 'percentage' -%}
      <span class="flex flex-col items-center leading-none self-start">
        <span class="text-[.55em]">%</span>
        <span class="text-[.35em] uppercase tracking-wider">off</span>
      </span>
    {%- elsif block.settings.discount_style == 'dollar' -%}
      <span class="flex flex-col items-center leading-none self-start">
        <span class="text-[.55em]">$</span>
        <span class="text-[.35em] uppercase tracking-wider">off</span>
      </span>
    {%- endif -%}
  </div>

{%- elsif block.settings.enable_animation and number_digits_str != blank -%}
  {%- comment -%} ── Animated number with prefix/suffix ── {%- endcomment -%}
  {%- assign number_digits = number_digits_str | split: '' -%}
  <div
    class="flex items-baseline leading-[1]"
    x-data="{ triggered: false }"
    x-intersect.once="setTimeout(() => triggered = true, 400)"
  >
    {%- if number_prefix != blank -%}
      <span class="whitespace-pre">{{ number_prefix }}</span>
    {%- endif -%}
    {%- for digit in number_digits -%}
      <span
        class="relative overflow-hidden edge-mask edge-mask-y inline-block w-[1ch]"
        x-animated-wheel.reverse
        data-spins="{{ forloop.index0 | plus: 3 }}"
      >
        <span
          class="w-[1ch] inline-block will-change-contents text-center"
          :class="{ 'opacity-0': $animatedWheel.isTrackVisible }"
          x-animated-wheel:input
          x-data="{ value: 0 }"
          x-effect="if (triggered) setTimeout(() => { $animatedWheel.updatePosition(0, {{ digit }}); value = {{ digit }} }, {{ forloop.index0 | times: 80 }})"
          x-text="String(value)"
          data-min="0"
          data-max="9"
          data-step="1"
          :data-value="value"
          >0</span
        >
        <div
          x-animated-wheel:track
          x-cloak
          class="absolute h-fit inset-0 block pointer-events-none whitespace-pre-line will-change-transform"
          aria-hidden="true"
        ></div>
      </span>
    {%- endfor -%}
    {%- if number_suffix != blank -%}
      <span class="whitespace-pre">{{ number_suffix }}</span>
    {%- endif -%}
  </div>

{%- else -%}
  <span class="leading-[1]">
    {{- block.settings.number_value -}}
  </span>
{%- endif -%}
