{% schema %}
{
	"name": "Number callout",
	"tag": null,
	"settings": [
		{
			"type": "text",
			"id": "number_value",
			"label": "Value",
			"default": "100+",
			"info": "First group of digits will animate"
		},
		{
			"type": "checkbox",
			"id": "enable_animation",
			"label": "Animate scroll",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "show_discount",
			"label": "Show as discount",
			"default": false
		},
		{
			"type": "select",
			"id": "discount_style",
			"label": "Discount style",
			"default": "percentage",
			"options": [
				{
					"value": "percentage",
					"label": "% off"
				},
				{
					"value": "dollar",
					"label": "$ off"
				}
			],
			"visible_if": "{{ block.settings.show_discount }}"
		},
		{
			"type": "inline_richtext",
			"id": "title",
			"label": "Title",
			"default": "Happy customers"
		},
		{
			"type": "richtext",
			"id": "body",
			"label": "Text"
		}
	],
	"presets": [
		{
			"name": "Number callout"
		},
		{
			"name": "Percent discount",
			"category": "Preset: Number callout",
			"settings": {
				"number_value": "50",
				"show_discount": true,
				"title": "Members save"
			}
		},
		{
			"name": "Dollar discount",
			"category": "Preset: Number callout",
			"settings": {
				"number_value": "10",
				"show_discount": true,
				"discount_style": "dollar",
				"title": "Members save"
			}
		}
	]
}
{% endschema %}
