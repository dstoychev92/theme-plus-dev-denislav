{% doc %}
  - Renders the section title

  @param {string} [block_attributes] - attributes for this block instance
{% enddoc %}

{%- if block.settings.text != blank or block.blocks.size > 0 -%}
  {% liquid
    assign tag = 'h2'
    if settings.show_tag_settings and block.settings.set_heading_tag
      assign tag = block.settings.heading_tag | default: 'h2'
    endif
  %}

  {% capture style %}
    {% if block.settings.set_spacing %}
      padding-bottom: {{ block.settings.buffer_bottom }}px;
      {% render 'props-style-gap', s: block.settings, vars: false, apply: false %}
      row-gap: var(--custom-gutter-y);
    {% else %}
      row-gap: var(--root-space-sm);
    {% endif %}
    {% if block.settings.set_color and block.settings.color == 'custom' %}
      --color-custom-text: {{ block.settings.color_custom }};
    {% endif %}
  {% endcapture %}

  {% capture text_class %}
    {% if block.settings.set_color %}
      text-{{ block.settings.color | default: 'content' }}
    {% else %}
      text-default
    {% endif %}
    inline-richtext
    entrance-item entrance-standard
  {% endcapture %}

  <header
    style="{{ style }}"
    {{ block_attributes }}
    class="
      flex flex-col w-full
      justify-self-content-align
      items-content-align text-content-align
      entrance-container *:auto-set-stagger-order
    "
    {{ block.shopify_attributes }}
  >
    {% render 'core-text-preset', tag: tag, class: text_class, s: block.settings %}
    {% content_for 'blocks' %}
  </header>
{%- endif -%}

{%- schema -%}
{
  "name": "Section title",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    },
    [% json 'schema/type-preset.jsonc', default_preset: 'section', label: 'Title style' %]
    [% json 'schema/type-custom.jsonc', resize: true, resize_label: 'Title size', default_font: 'heading', default_size: '8' %]
    {
      "type": "header",
      "content": "Color"
    },
    [% json 'schema/color-dropdown.jsonc', optional: true, custom: true, muted: true %]
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "set_spacing",
      "label": "Set spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "buffer_bottom",
      "label": "Padding bottom",
      "visible_if": "{{ block.settings.set_spacing }}",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
    },
    [% json 'schema/grid-gap-setting.jsonc', default_gap: 'sm', gap_label: 'Vertical gap for blocks', conditional: 'block.settings.set_spacing', info: 'Applies when blocks are added to the section title' %]

    [% json 'schema/seo-settings.jsonc' %]
  ],
  "blocks": [
    {
      "type": "_section-title-row"
    },
    {
      "type": "_section-title-inline"
    },
    {
      "type": "theme-text"
    },
    {
      "type": "theme-richtext"
    },
    {
      "type": "theme-spacer"
    },
    {
      "type": "theme-decoration"
    }
  ],
  "presets": [
    {
      "name": "Section title",
      "category": "Layout",
      "settings": {
        "text": "Section title"
      },
      "blocks": [
        {
          "type": "theme-decoration"
        }
      ]
    }
  ]
}
{%- endschema -%}
