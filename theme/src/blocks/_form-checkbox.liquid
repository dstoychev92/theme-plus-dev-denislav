{% doc %}
  - Renders contact form checkbox

  Sits inside _form-contact. The label handle is the contact[] key, so a cleared label falls
  back to the block id.
{% enddoc %}

{% liquid
  # A cleared label must not produce contact[]
  assign label_handle = block.settings.label | handleize
  if label_handle == blank
    assign label_handle = 'field-' | append: block.id
  endif
  assign id = label_handle | append: '-' | append: block.id
  assign name = 'contact[' | append: label_handle | append: ']'
%}

<div {{ block.shopify_attributes }}>
  {% render 'field-checkbox',
    name: name,
    id: id,
    label: block.settings.label,
    disabled: block.settings.disabled,
    checked: block.settings.checked,
    size: block.settings.sizing
  %}
</div>

{% schema %}
{
  "name": "Checkbox",
  "tag": null,
  "settings": [
    [% json 'schema/form-input-setting.jsonc', default: "Checkbox" %]
    {
      "type": "checkbox",
      "id": "checked",
      "label": "Checked",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "disabled",
      "label": "Disabled",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Checkbox"
    }
  ]
}
{% endschema %}
