{% doc %}
  - Renders pair column with uploaded or external video

  Private, only offered by section-pair. Preloads the video when the section is first on the page.
{% enddoc %}

{% liquid
  assign video_source = block.settings.video_source
  assign video = block.settings.video
  assign video_link = block.settings.video_link
  assign autoplay = block.settings.autoplay
  assign loop = block.settings.loop

  if section.index0 == 0
    assign preload = true
  endif

  # Section height mode: cap the player at the section height, since its in-flow
  # aspect ratio would otherwise put a floor under the column
  if section.settings.height_mode == 'section'
    assign video_class = 'pair-media-fit-height'
  endif
%}

{% capture content %}
  {% case video_source %}
    {% when 'uploaded' %}
      {% render 'core-video',
        video: video,
        id: block.id,
        class: video_class,
        preload: preload,
        autoplay: autoplay,
        loop: loop,
        show_custom_controls: true,
        controls: true
      %}

    {% when 'external_video' %}
      {% render 'video-external', video_type: video_link.type, video_id: video_link.id, class: video_class %}
  {% endcase %}
{% endcapture %}

{% capture attributes %}
  id="{{ block.id }}"
  data-test-id="pair-video"
  {{ block.shopify_attributes }}
{% endcapture %}

{% render 'pair-column',
  s: block.settings,
  content: content,
  class: 'pair-media',
  attributes: attributes,
  is_media_block: true
%}

{% schema %}
{
  "name": "Video",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "video_source",
      "label": "Type",
      "default": "uploaded",
      "options": [
        {"value": "uploaded", "label": "Uploaded"},
        {"value": "external_video", "label": "External URL"},
      ]
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.video_source == 'uploaded' }}"
    },
    {
      "type": "video_url",
      "id": "video_link",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Streaming video source from YouTube or Vimeo.",
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "visible_if": "{{ block.settings.video_source == 'external_video' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Autoplay videos are muted by default",
      "visible_if": "{{ block.settings.autoplay == true }}",
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    [% json 'schema/color-settings-image.jsonc' %]
    {
      "type": "header",
      "content": "Border"
    },
    [% json 'schema/border-settings.jsonc' %]
    {
      "type": "header",
      "content": "Rounding"
    },
    [% json 'schema/rounding-large.jsonc' %]
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Video",
      "category": "Media",
      "blocks": []
    }
  ]
}
{% endschema %}
