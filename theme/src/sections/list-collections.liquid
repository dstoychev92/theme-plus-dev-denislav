{% capture header %}
  {% content_for 'block', type: '_section-title', id: 'section-title' %}
{% endcapture %}

{% paginate collections by section.settings.limit %}
  {%- capture collection_items -%}
    {%- for collection in collections -%}
      {% content_for 'block', type: '_card-collection', id: 'collection-card', closest.collection: collection %}
    {%- endfor -%}
  {%- endcapture -%}
  {% if paginate.pages > 1 %}
    {% capture footer %}
      {% render 'pagination', paginate: paginate, class: 'w-full' %}
    {% endcapture %}
  {% endif %}
{% endpaginate %}

{% capture attributes %}
  @theme:section:navigate.window="
    if ($event.detail.sectionId != '{{ section.id }}') return
    await $yieldToMain()
    $scrollIntoView()
  "
  :class="
    {
      'opacity-50 pointer-events-none': $sectionApi.state == 'loading'
    }
  "
{% endcapture %}

{% render 'core-section-card-list',
  s: section.settings,
  layout_mobile: 'grid',
  columns_sm: section.settings.columns_sm,
  attributes: attributes,
  list_items: collection_items,
  list_attributes: 'x-ref="paginationResults"',
  header: header,
  footer: footer
%}

{% schema %}
{
  "name": "Collection list",
  "class": "section-list-collections",
  "settings": [
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "columns_lg",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_md",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Tablet",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_sm",
      "label": "Mobile",
      "default": "2",
      "options": [
        {"value": "1", "label": "1"},
        {"value": "2", "label": "2"}
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Collections per page",
      "default": 24
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text_alignment",
      "id": "title_placement",
      "label": "Title alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    [% json 'schema/section-content-width-setting.jsonc' %]
    [% json 'schema/section-padding-settings.jsonc' %]
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "id": "section-title",
          "type": "_section-title",
          "static": true,
          "settings": {
            "text": "All Collections",
            "type_preset": "h2"
          }
        },
        {
          "id": "collection-card",
          "static": true,
          "type": "_card-collection"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["list-collections"]
  }
}
{% endschema %}
