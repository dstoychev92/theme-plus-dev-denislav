<!-- sections/password.liquid -->

{% capture header %}
  <header class="flex items-center justify-between sm:flex-row flex-col gap-r7 px-root-buffer py-r7 vars-{{ section.settings.color_scheme.id }}">
    {% liquid
      assign alt_default = section.settings.logo.alt | default: shop.name | strip_html | escape_once
      assign logo_width = section.settings.logo_max_limit | times: 1
    %}
    <div>
      {% if section.settings.logo != blank %}
        {% render 'core-image',
          image: section.settings.logo,
          width: logo_width,
          alt_default: alt_default,
          fetchpriority: 'high',
          placeholder: false,
          preload: true
        %}
      {% else %}
        <div
          class="
            text-center font-family-heading
            bg-canvas text-content uppercase px-[1em] py-[0.5em]
            whitespace-normal leading-none
          "
          style="font-size: min(calc(var(--font-r5) * var(--font-family-adjust) * var(--caps-adjust)), 20cqw)"
        >
          {{ shop.name }}
        </div>
      {% endif %}
    </div>

    {%- capture form_content -%}
      {%- assign password_form_heading = 'page.password.password_form_heading' | t -%}
      {% render 'core-text-preset',
        text: password_form_heading,
        class: 'inline-richtext text-center',
        default_type_preset: 'kicker'
      %}

      {% if shop.password_message != blank %}
        <p class="text-muted text-center text-r3 font-family-body max-w-[300px] mx-auto">
          {{ shop.password_message }}
        </p>
      {% endif %}

      {% form 'storefront_password', class: 'flex flex-col w-full gap-y-r8' %}
        {% if form.errors %}
          <div
            x-effect="$dialog.open();"
            class="flex items-center gap-r4 vars-scheme-error p-r4 rounded-sm bg-canvas/5 text-content text-r3 text-start"
          >
            <span class="sr-only">{{ 'other.accessibility.error' | t }}</span>
            {% render 'core-icon', icon: 'fill-circle-alert', class: 'shrink-0 text-content' %}
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        {% assign label_input = 'page.password.store_password' | t %}
        {% render 'field-input', label: label_input, type: 'password', name: 'password' %}

        {% assign label_button = 'page.password.password_submit_button' | t %}
        {% render 'core-button', type: 'submit', sizing: 'md', appearance: 'stroke', color: 'content', label: label_button %}
      {% endform %}
    {%- endcapture -%}

    <div
      x-dialog.modal
      x-scroll-lock="$dialog.isOpen"
    >
      {%- assign label = 'page.password.password_modal_button' | t -%}
      {% render 'core-button',
        label: label,
        color: 'content',
        appearance: 'stroke',
        sizing: 'lg',
        attributes: 'x-dialog:button'
      %}

      {% capture dialog_class %}
        vars-{{ section.settings.overlay_color_scheme.id }}
      {% endcapture %}

      {% if section.settings.overlay_backdrop_color != blank %}
        {% assign dialog_backdrop_bg_class = 'backdrop:bg-[--backdrop-color]' %}
        {% capture dialog_attributes %}
          style="--backdrop-color: {{ section.settings.overlay_backdrop_color }}"
        {% endcapture %}
      {% endif %}

      <template x-teleport="body">
        {% render 'dialog', modal: true, content: form_content, scrollable: true, dialog_class: dialog_class, content_class: '[--dialog-width:500px]', modal_backdrop_bg_class: dialog_backdrop_bg_class, attributes: dialog_attributes %}
      </template>
    </div>
  </header>
{% endcapture %}

{% capture footer %}
  <footer class="px-root-buffer py-r7 vars-{{ section.settings.color_scheme.id }}">
    <p class="password-login text-muted text-r3 text-center flex flex-center sm:flex-row flex-col gap-r7">
      <a
        href="https://www.shopify.com"
        target="_blank"
        rel="nofollow"
      >
        {{ 'page.password.powered_by_shopify' | t }}
        <span class="sr-only">, {{ 'other.accessibility.opens_in_new_tab' | t }}</span>
      </a>
      <span class="hidden sm:inline-block w-r4">|</span>
      {{ 'page.password.admin_link_before' | t }}
      <a
        href="/admin/themes"
        rel="nofollow"
        class="link-line"
      >
        {{ 'page.password.admin_link_text' | t }}
      </a>
    </p>
  </footer>
{% endcapture %}

{% capture framed_content %}
  {% content_for "block", id: "content-password", type: "theme-group-frame" %}
{% endcapture %}

{% capture content_block %}
  {{ header }}
  {% render 'core-placement-grid', content: framed_content, vertical_placement: 'middle', horizontal_placement: 'center', class: 'py-lg' %}
  {{ footer }}
{% endcapture %}

{% capture bg_blocks %}
  {% content_for "blocks" %}
{% endcapture %}

{% capture bg_class %}
  vars-custom-height-screen
  min-h-[--custom-height]
{% endcapture %}

{% capture content %}
  {% render 'core-section-content', content: content_block, s: section.settings %}
  {% render 'core-section-background', content: bg_blocks, s: section.settings, class: bg_class %}
{% endcapture %}

{% render 'core-section-wrapper',
  s: section.settings,
  lazy_alpine: false,
  content: content,
  color_scheme: section.settings.color_scheme,
  padding: false,
  background_color: section.settings.color_scheme.settings.color_canvas,
  contain_section: false,
  content_width: 'full',
  photoswipe: false
%}

{% comment %} Make overscroll match background {% endcomment %}
<style>
  :root {
    background-color: {{ section.settings.color_scheme.settings.color_canvas }};
  }
</style>

{% schema %}
{
	"name": "Password",
	"class": "section-password",
	"tag": "section",
	"settings": [
		{
			"type": "image_picker",
			"id": "logo",
			"label": "Image"
		},
		{
			"type": "range",
			"id": "logo_max_limit",
			"label": "Logo width",
			"min": 5,
			"max": 495,
			"step": 5,
			"unit": "px",
			"default": 120
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-opposite"
		},
		{
			"type": "header",
			"content": "Password popup"
		},
		{
			"type": "color_scheme",
			"id": "overlay_color_scheme",
			"label": "Popup colors",
			"default": "scheme-opposite"
		},
		{
			"type": "color",
			"id": "overlay_backdrop_color",
			"label": "Backdrop color",
			"alpha": true,
			"default": "#ffffff"
		}
	],
	"blocks": [
		{
			"type": "_background"
		}
	]
}
{% endschema %}
