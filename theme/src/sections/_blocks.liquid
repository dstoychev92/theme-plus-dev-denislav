{% comment %}
  Wrapper section for AI-generated theme blocks (e.g. via Sidekick).
  Shopify automatically wraps generated blocks in this section — it cannot
  be added manually by merchants. Must accept @theme and @app block types,
  include presets, use {% content_for 'blocks' %}, and omit `templates`.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/ai-generated-theme-blocks
{% endcomment %}

{% capture blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture style %}
  --section-content-col-start: section-start;
  --section-content-col-end: section-end;
{% endcapture %}

{% capture wrapped_blocks %}
  <div
    class="
      flex flex-col h-full
    "
  >
    {{ blocks }}
  </div>
{% endcapture %}

{% render 'core-section', s: section.settings, content: wrapped_blocks, style: style %}

{% schema %}
{
  "name": "Blocks",
  "class": "section-blocks",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "checkbox",
      "id": "contain_section",
      "label": "Contain section",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "visible_if": "{{ section.settings.contain_section }}",
      "default": "page",
      "options": [
        {"value": "full", "label": "Full"},
        {"value": "page", "label": "Page"}
      ]
    },
    [% json 'schema/section-padding-settings.jsonc' %]
    {
      "type": "header",
      "content": "Appearance"
    },
    [% json 'schema/color-settings-section-solid.jsonc' %]
  ],
  "blocks": [
    {
      "type": "@theme",
    },
    {
      "type": "@app",
    }
  ],
  "presets": [
    {
      "name": "Custom",
      "category": "Utility"
    }
  ],
  "disabled_on": {
    "groups": ["header", "custom.overlays", "custom.drawers"]
  }
}
{% endschema %}
