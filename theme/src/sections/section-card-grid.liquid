{% comment %}
  Section: Card Grid
  Static grid layout for product, collection, or article cards — all cards
  visible at once (no scrolling).

  Same block types as card-slider (_section-title, _cards-products,
  _cards-collections, _cards-articles) but renders in a grid rather than a
  carousel. Column count is configurable per breakpoint.

  Better for SEO than sliders since all content is visible. Cards stack into
  fewer columns on mobile. Content width can be full-bleed or page-contained.

  Gap uses the standard preset+custom pattern (sm/md/lg/custom).
{% endcomment %}

{% capture header %}
  {% content_for 'block', type: '_section-title', id: 'header' %}
{% endcapture %}

{% capture list_items %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'core-section-card-list',
  s: section.settings,
  list_items: list_items,
  header: header,
  layout_desktop: 'grid',
  layout_tablet: 'grid',
  class: 'entrance-container'
%}

{% schema %}
{
  "name": "Card grid",
  "class": "section-card-grid",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Columns"
    },
    [% json 'schema/section-card-grid-settings.jsonc' %]
    {
      "type": "header",
      "content": "Section layout"
