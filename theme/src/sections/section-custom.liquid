			]
		},
		{
			"name": "Contact",
			"category": "Try: Forms",
			"settings": {
				"content_width": "custom",
				"content_width_custom": 65,
				"gap": "sm"
			},
			"blocks": [
				{
					"type": "theme-text",
					"settings": {
						"text": "Get in touch"
					}
				},
				{
					"type": "theme-decoration"
				},
				{
					"type": "_form-contact",
					"blocks": [
						{
							"type": "_form-input-name",
							"settings": {
								"label": "Name"
							}
