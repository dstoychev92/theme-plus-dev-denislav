			"category": "Try: Build trust",
			"blocks": [
				{
					"type": "_section-title",
					"settings": {
						"text": "Common Questions"
					}
				},
				{
					"type": "_tabs",
					"blocks": [
						{
							"type": "_tab",
							"settings": {
								"title": "Returns"
							},
							"blocks": [
								{
									"type": "theme-richtext",
									"settings": {
										"text": "<p>Explain how returns or exchanges work and how customers can start one. Link to your return policy for the full details.</p>"
									}
								}
							]
						},
						{
							"type": "_tab",
							"settings": {
								"title": "Security"
							},
							"blocks": [
								{
