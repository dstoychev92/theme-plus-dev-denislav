{% capture header %}
  {% content_for 'block', type: '_section-title', id: 'header', block_attributes: 'data-render-region="section-title"' %}
{% endcapture %}

{% assign tabs = '' %}
{% assign tab_panels = '' %}
{% for block in section.blocks %}
  {% capture tabs %}
    {{ tabs }}
    <template x-clone="tabTemplates[{{ forloop.index0 }}]"></template>
  {% endcapture %}

  {% capture tab_panels %}
    {{ tab_panels }}
    {% render block %}
  {% endcapture %}
{% endfor %}

{% if header != blank and section.blocks.size != 1 %}
  {% capture title_row_content %}
    {{ header }}
  {% endcapture %}
{% endif %}

{% if section.blocks.size > 1 %}
  {% comment %}
    The related and recent tabs hide while they have no cards. The tablist hides with a single
    visible tab, so the shopper never sees one lone tab.
  {% endcomment %}
  {% capture header_area_content %}
    {% capture tablist_attributes %}
      x-show="$sectionRelated.visibleTabCount > 1"
    {% endcapture %}
    {% render 'core-tablist', tabs: tabs, s: section.settings, class: 'z-20 self-center', attributes: tablist_attributes %}
  {% endcapture %}
{% else %}
  {% capture header_area_content %}
    {{ header }}
  {% endcapture %}
{% endif %}

{% capture attributes %}
  data-lazy-alpine
  data-lazy-alpine-module="@theme/section-related"
  x-section-related="{{ product.id }}"
  x-tabs
  x-data="{
    sidePrevInView: false,
    sideNextInView: false,
    get overflowButtonPlacement() {
      return (this.sidePrevInView && this.sideNextInView) ? 'side' : 'top'
    },
    get tabTemplates() {
      const templates = Array.from($el.querySelectorAll('[data-tab-template]'));
      return templates.sort((a, b) => {
        const indexA = parseInt(a.getAttribute('data-tab-template') ?? '0', 10);
        const indexB = parseInt(b.getAttribute('data-tab-template') ?? '0', 10);
        return indexA - indexB;
      });
    }
  }"
  {% if section.blocks.size > 1 %}
    {% comment %} Drop the tablist row from the grid when the tablist hides. The tab panels hide the section at zero. {% endcomment %}
    :class="{
      'vars-section-grid-layout-card-list-rows': $sectionRelated.visibleTabCount === 1
    }"
  {% endif %}
{% endcapture %}

{% render 'core-section-card-slider-tabs-layout',
  s: section.settings,
  title_row_content: title_row_content,
  header_area_content: header_area_content,
  tab_panels: tab_panels,
  attributes: attributes,
  tab_count: section.blocks.size
%}

{% schema %}
{
  "name": "Related products",
  "class": "section-related no-sibling-autoupdate",
  "tag": "section",
  "settings": [
    [% json 'schema/section-card-slider-settings.jsonc' %]
    {
      "type": "header",
      "content": "Section layout"
    },
    [% json 'schema/section-content-width-setting.jsonc', disable_mobile_width: true %]
    [% json 'schema/section-padding-settings.jsonc' %]
    {
      "type": "header",
      "content": "Content layout"
    },
    {
      "type": "text_alignment",
      "id": "title_placement",
      "label": "Title alignment",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "set_gap_tab_x",
      "label": "Set tab spacing",
      "default": false
    },
    [% json 'schema/grid-gap-setting.jsonc', default_gap: 'sm', gap_label: 'Tab', gap_custom_label: 'Custom', id_suffix: 'tab_x', context: 'section.settings.', conditional: 'section.settings.set_gap_tab_x' %]

    {
      "type": "checkbox",
      "id": "set_gap_tab_y",
      "label": "Set vertical gap",
      "default": false
    },
    [% json 'schema/grid-gap-setting.jsonc', default_gap: 'sm', gap_label: 'Vertical gap', gap_custom_label: 'Custom', id_suffix: 'tab_y', context: 'section.settings.', conditional: 'section.settings.set_gap_tab_y' %]

    {
      "type": "header",
      "content": "Appearance"
    },
    [% json 'schema/color-settings-section-solid.jsonc' %]
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "checkbox",
      "id": "enable_typography",
      "label": "Set tab typography",
      "default": false
    },
    [% assign conditional = 'section.settings.enable_typography == true' %]
    [% json 'schema/type-custom.jsonc', default_font: 'body', default_size: '4', conditional: conditional %]
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "set_pagination_style",
      "label": "Set button style",
      "default": false
    },
    {
      "type": "select",
      "id": "slider_control_style",
      "label": "Style",
      "default": "soft",
      "options": [
        {"value": "fill", "label": "Fill"},
        {"value": "stroke", "label": "Stroke"},
        {"value": "soft", "label": "Soft"},
        {"value": "bare", "label": "∅"}
      ],
      "visible_if": "{{ section.settings.set_pagination_style }}"
    },
    [% json 'schema/progress-bar-visibility-setting.jsonc' %]
    [% json 'schema/section-target-device-settings.jsonc' %]
  ],
  "blocks": [
    {
      "type": "_related-tab-related-products"
    },
    {
      "type": "_related-tab-recent-products"
    },
    {
      "type": "_cards-tab"
    }
  ],
  "presets": [
    {
      "name": "Related products",
      "category": "Grid",
      "blocks": [
        {
          "id": "header",
          "type": "_section-title",
          "static": true,
          "settings": {
            "text": "You may also like"
          }
        },
        {
          "type": "_related-tab-related-products"
        },
        {
          "type": "_related-tab-recent-products"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
