{% liquid
  assign enable_footer_payment = section.settings.enable_footer_payment
  assign enable_footer_social = section.settings.enable_footer_social
%}

{%- capture content -%}
  <div class="flex flex-col gap-lg md:gap-md">
    <div
      class="
        {% render 'props-class-type-preset', s: section.settings %}
        flex flex-col-reverse gap-lg
        md:flex-row md:items-center md:justify-between
      "
    >
      {% comment %} Copyright and Linklist {% endcomment %}
      <div class="flex flex-wrap gap-x-r5 gap-y-r4 text-content">
        <span>
          &copy; {{ shop.name | link_to: routes.root_url }} {{ 'now' | date: "%Y" }}
        </span>

        {% for link in linklists[section.settings.footer_secondary_linklist].links %}
          {% render 'core-link', href: link.url, text: link.title, appearance: 'clean', type_preset: 'apply' %}
        {% endfor %}

        {% comment %} A store with POS gets two links: `<a …>POS</a> and <a …>Ecommerce by Shopify</a>` {% endcomment %}
        {% assign powered_by_parts = powered_by_link | split: '</a>' %}
        {% capture powered_by_link %}
          {%- for part in powered_by_parts -%}
            {%- unless part contains 'href="' -%}
              {{- part -}}
              {%- continue -%}
            {%- endunless -%}
            {%- assign part_start = part | slice: 0, 2 -%}
            {%- if part_start != '<a' -%}
              {{- part | split: '<a' | first -}}
            {%- endif -%}
            {%- assign powered_by_href = part | split: 'href="' | last | split: '"' | first -%}
            {%- assign powered_by_text = part | split: '>' | last -%}
            {% comment %} new_window carries target="_blank", rel="noopener" and the screen-reader
              "opens in a new tab" note together {% endcomment %}
            {%- render 'core-link', href: powered_by_href, text: powered_by_text, appearance: 'clean', type_preset: 'apply', new_window: true -%}
          {%- endfor -%}
        {% endcapture %}

        <!-- Remove the following line to delete Powered by Shopify from your footer -->
        <span data-powered-link>{{ powered_by_link }}</span>
        <!-- Stop deleting here -->
      </div>

      {% comment %} Locale/Currency selectors {% endcomment %}
      {% if section.settings.show_language or section.settings.show_country %}
        {% assign localization_popup_class = 'min-w-fit max-w-screen' %}
        {% capture localization_select_class %}
          border border-line-subtle type-apply
          h-control px-control keyboard-active:focus-within:border-focus-outline
          max-md:w-full min-w-[150px]
          rounded-form-field
        {% endcapture %}

        {%- form 'localization', id: 'localization-form-subfooter', class: 'flex shrink-0' -%}
          <div class="
            flex flex-col gap-r6 md:flex-row md:flex-nowrap overflow-hidden max-md:w-full
            [--control-height:--row-md]
            [--control-padding:theme(space.r6)]
            [--control-font-size:var(--font-size-calc)]
            "
          >
            {% if section.settings.show_language %}
              {%- if localization.available_languages.size > 1 -%}
                {%- render 'localization-locale-select',
                  placement: 'top',
                  offset: '10px',
                  size: false,
                  flip: false,
                  language_style: section.settings.language_style,
                  button_class: localization_select_class,
                  popup_class: localization_popup_class
                -%}
              {%- endif -%}
            {%- endif -%}
            {% if section.settings.show_country %}
              {%- if localization.available_countries.size > 1 -%}
                {% render 'localization-country-select',
                  placement: 'top',
                  offset: '10px',
                  size: false,
                  flip: false,
                  currency_display_style: section.settings.currency_display_style,
                  country_display_style: section.settings.country_display_style,
                  button_class: localization_select_class,
                  popup_class: localization_popup_class
                %}
              {%- endif -%}
            {%- endif -%}
          </div>
        {% endform %}
      {% endif %}
    </div>

    {% if enable_footer_payment or enable_footer_social %}
      <div
        class="
          flex flex-wrap gap-lg
          md:flex-row md:items-center md:justify-between
        "
      >
        {% comment %} Payment icons {% endcomment %}
        {% if enable_footer_payment %}
          {% unless shop.enabled_payment_types == empty %}
            <div class="flex flex-wrap gap-r3">
              {% for type in shop.enabled_payment_types %}
                <span>
                  {{ type | payment_type_svg_tag }}
                  <span class="sr-only">{{ type | capitalize | replace: '_', ' ' }}</span>
                </span>
              {% endfor %}
            </div>
          {% endunless %}
        {% endif %}

        {% comment %} Social icons {% endcomment %}
        {%- if enable_footer_social -%}
          {% capture social_style %}
            {% render 'props-style-gap', s: section.settings %}
          {% endcapture %}
          {% render 'social-icons',
            size: section.settings.social_sizing,
            custom_width: section.settings.social_width_custom,
            gap_class: 'gap-layout',
            style: social_style,
            class: 'md:justify-end'
          %}
        {%- endif -%}
      </div>
    {% endif %}
  </div>
{%- endcapture -%}

{%- render 'core-section', s: section.settings, content: content, photoswipe: false -%}

{% schema %}
{
  "name": "Subfooter",
  "class": "section-footer-sub",
  "settings": [
    [% json 'schema/color-settings-section-solid.jsonc', default_color_scheme: 'scheme-opposite' %]
    [% json 'schema/type-preset.jsonc', default_preset: 'p', label: 'Text style', context: 'section.settings.' %]
    [% json 'schema/type-custom.jsonc', resize: true, default_resize: 'sm', default_font: 'body', default_size: '3', context: 'section.settings.' %]
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "link_list",
      "id": "footer_secondary_linklist",
      "label": "Link list",
      "info": "This menu won't show dropdown items"
    },
    {
      "type": "header",
      "content": "Payment types"
    },
    {
      "type": "checkbox",
      "id": "enable_footer_payment",
      "label": "Show payment types"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "checkbox",
      "id": "enable_footer_social",
      "label": "Show social icons"
    },
    {
      "type": "select",
      "id": "social_sizing",
      "label": "Icon size",
      "default": "md",
      "visible_if": "{{ section.settings.enable_footer_social == true }}",
      "options": [
        {"value": "sm", "label": "S"},
        {"value": "md", "label": "M"},
        {"value": "lg", "label": "L"},
        {"value": "custom", "label": "⋯"}
      ]
    },
    {
      "type": "range",
      "id": "social_width_custom",
      "label": "Custom width",
      "unit": "px",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 20,
      "visible_if": "{{ section.settings.enable_footer_social == true and section.settings.social_sizing == 'custom' }}"
    },
    [% json 'schema/grid-gap-setting.jsonc', context: 'section.settings.', default_gap: 'md', conditional: "section.settings.enable_footer_social == true" %]
    [% json 'schema/localization-locale-settings.jsonc' %]
    [% json 'schema/localization-country-settings.jsonc' %]
    {
      "type": "header",
      "content": "Layout"
    },
    [% json 'schema/section-padding-settings.jsonc', default_padding_top: 40, default_padding_bottom: 40 %]
    {
      "type": "select",
      "id": "content_width",
      "label": "Width",
      "default": "full",
      "options": [
        {"value": "full", "label": "Full"},
        {"value": "page", "label": "Page"}
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
