<!-- sections/cart-classic.liquid -->

{% assign form_id = 'cart-' | append: section.id %}

{%- capture cart_items -%}
  {% render 'cart-list', form_id: form_id, show_quantity_selector: section.settings.show_quantity_selector, show_disclosures: section.settings.show_disclosures, quantity_size: section.settings.quantity_sizing, class: 'border border-line-subtle rounded-sm overflow-hidden' %}
{%- endcapture -%}

{% comment %} Cart total price should always show cents and currency {% endcomment %}
{%- capture total_price -%}
  {% render 'money', price: cart.total_price, show_currency: true, hide_trailing_zeros: false %}
{%- endcapture -%}

{%- capture checkbox -%}
  {% render 'cart-checkbox', form_id: form_id %}
{%- endcapture -%}

{% capture checkout_button %}
  <noscript>
    {%- assign update_cart_label = 'cart.update_cart_button' | t -%}
    {%- render 'core-button',
      type: 'submit',
      form: form_id,
      appearance: 'stroke',
      color: 'content',
      sizing: 'lg',
      label: update_cart_label
    -%}
  </noscript>

  {% assign checkout_label = 'cart.check_out_button' | t %}
  {% render 'core-button',
    content: checkout_label,
    type: 'submit',
    name: 'checkout',
    form: form_id,
    appearance: section.settings.appearance_checkout_button,
    color: section.settings.color_checkout_button,
    color_custom: section.settings.color_custom_checkout_button,
    text_color: section.settings.text_color_checkout_button,
    custom_gradient_from: section.settings.custom_gradient_from_checkout_button,
    custom_gradient_to: section.settings.custom_gradient_to_checkout_button,
    type_preset: section.settings.type_preset_checkout_button,
    type_resize: section.settings.type_resize_checkout_button,
    type_size: section.settings.type_size_checkout_button,
    type_font: section.settings.type_font_checkout_button,
    type_uppercase: section.settings.type_uppercase_checkout_button,
    height: 'lg',
    class: '[--control-padding:theme(space.r6)] group-has-[:invalid]:opacity-50 [--control-height:--row-lg]',
  %}
{% endcapture %}

{% if section.settings.show_additional_buttons %}
  {% capture additional_buttons %}
    {% render 'cart-additional-buttons-block' %}
  {% endcapture %}
{% endif %}

{% assign app_blocks = '' %}
{%- capture reorderable_blocks -%}
  {%- for block in section.blocks -%}
    {% case block.type %}
      {% when 'cart_upsell' %}
        {% comment %} We need to do this capture to prevent an empty <div> from rendering when there are no upsells {% endcomment %}
        {%- capture cart_upsell -%}
          {% render 'cart-upsell-block', block: block, attributes: block.shopify_attributes %}
        {%- endcapture -%}
        {% if cart_upsell != blank %}
          <div class="py-r6">
            {{ cart_upsell }}
          </div>
        {% endif %}

      {% when 'customer_notes' %}
        {% liquid
          assign accordion_class = 'py-r6'
          if block.settings.accordion
            assign accordion_class = 'border-b border-y-line-subtle'
          endif
        %}
        {% capture accordion_attributes %}
          data-card-accordion
          {{ block.shopify_attributes }}
        {% endcapture %}
        {% render 'cart-customer-notes-block', block: block, class: accordion_class, attributes: accordion_attributes %}

      {% when 'shipping_estimate' %}
        {% liquid
          assign accordion_class = 'py-r6'
          if block.settings.accordion
            assign accordion_class = 'border-b border-y-line-subtle'
          endif
        %}
        {% capture accordion_attributes %}
          data-card-accordion
          {{ block.shopify_attributes }}
        {% endcapture %}
        {% render 'cart-shipping-estimate-block', block: block, id: form_id, class: accordion_class, attributes: accordion_attributes %}

      {% when 'payment_icons' %}
        <div class="py-r6">
          {% render 'cart-payment-icons-block', block: block, attributes: block.shopify_attributes %}
        </div>

      {% when 'message_custom' %}
        <div class="py-r6">
          {% render 'cart-message-custom-block', block: block, attributes: block.shopify_attributes %}
        </div>

      {% when 'liquid_code' %}
        {% render 'liquid-code-block', block: block, attributes: block.shopify_attributes %}

      {% when '@app' %}
        {%- capture app_blocks -%}
          {{ app_blocks }}
          {% render block %}
        {%- endcapture -%}
    {% endcase %}
  {%- endfor -%}
{%- endcapture -%}

{% capture subtotal %}
  <div>
    {% if section.settings.show_cart_review %}
      {% render 'cart-summary' %}
    {% endif %}
    {% if section.settings.show_tax_message %}
      <p class="text-r3 pt-r4 text-muted italic">
        {% render 'taxes-included-cart' %}
      </p>
    {% endif %}
  </div>
{% endcapture %}

{%- capture content -%}
  {% comment %} Cart with items {% endcomment %}
  {% if cart.item_count > 0 %}
    <div class="col-section-content pb-r12">
      {% comment %} Header {% endcomment %}
      <div
        class="pb-r8 grid grid-cols-1 items-center gap-r8 lg:gap-r10 lg:grid-cols-6"
        style="padding-top: calc(30px * var(--r-multiplier));"
      >
        <div role="alert" class="sr-only">
          {% # t escapes interpolated params, so strip the money markup before it reaches the filter %}
          {% assign total_price_text = total_price | strip_html | strip %}
          {{ 'cart.item_count' | t: count: cart.item_count }},
          {{ 'cart.total_price' | t: total: total_price_text }}
        </div>

        <div class="flex justify-between items-center gap-r8 lg:col-span-4">
          <h1 class="type-h2">{{ 'cart.title' | t }}</h1>

          {% assign continue_browsing_label = section.settings.continue_browsing_label %}
          {% if continue_browsing_label != blank %}
            {% assign continue_browsing_href = section.settings.continue_browsing_link | default: routes.all_products_collection_url %}
            {%- render 'core-button',
              tag: 'a',
              href: continue_browsing_href,
              sizing: 'xs',
              appearance: 'bare',
              color: 'content',
              class: 'gap-x-r4',
              label: continue_browsing_label,
              new_window: section.settings.continue_browsing_open_in_new_window,
              end_icon: 'stroke-arrow-up-right',
              end_icon_class: 'w-r5 h-r5 !scale-100'
            -%}
          {% endif %}
        </div>

        <div class="lg:col-span-2">
          {% if section.settings.set_free_shipping_message %}
            {% render 'cart-shipping-message',
              class: 'p-r6 border border-line-subtle rounded-sm bg-canvas',
              s: section.settings
            %}
          {% endif %}
        </div>
      </div>

      {% comment %} Body {% endcomment %}
      <div
        class="grid grid-cols-1 gap-r10 lg:grid-cols-6"
      >
        {% comment %} Content {% endcomment %}
        <div class="flex flex-col gap-r11 lg:gap-r12 lg:col-span-4">
          {{ cart_items }}

          <div class="grid grid-cols-1 gap-r10 md:grid-cols-11">
            <div class="md:col-span-5">
              {{ app_blocks }}
            </div>
          </div>
        </div>

        {% comment %} Sidebar {% endcomment %}
        <div class="flex flex-col gap-y-r6 lg:col-span-2">
          <div class="group flex flex-col gap-y-r6 p-r6 border border-line-subtle rounded-sm bg-canvas">
            {{ subtotal }}
            {{ checkbox }}

            <div class="flex flex-col gap-r5">
              {{ checkout_button }}
              {{ additional_buttons }}
            </div>
          </div>

          <div>
            {{ reorderable_blocks }}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} Empty Cart {% endcomment %}
  {% if cart.item_count == 0 %}
    <div class="col-fullbleed">
      <div class="py-r14 flex flex-1 flex-center bg-primary text-center">
        <h3 class="type-h2 text-primary-contrast">{{ 'cart.no_items_in_cart' | t }}</h3>
      </div>

      <div class="relative py-r13 w-full max-w-[500px] mx-auto text-r5 text-center">
        <p class="mb-r5">{{ 'cart.no_items_links_title' | t }}</p>

        <ul class="flex flex-col gap-y-r7 p-r8 md:p-r9 md:gap-y-r8">
          {% if section.settings.empty_cart_buttons != blank and section.settings.empty_cart_buttons.links.size > 0 %}
            {% for link in section.settings.empty_cart_buttons.links %}
              <li>
                {% render 'core-button',
                  label: link.title,
                  tag: 'a',
                  href: link.url,
                  appearance: 'stroke',
                  color: 'content',
                  sizing: 'md',
                  class: 'w-full [--control-padding:theme(space.r5)]'
                %}
              </li>
            {% endfor %}
          {% else %}
            {% for collection in collections limit: 5 %}
              <li>
                {% render 'core-button',
                  label: collection.title,
                  tag: 'a',
                  href: collection.url,
                  appearance: 'stroke',
                  color: 'content',
                  sizing: 'md',
                  class: 'w-full [--control-padding:theme(space.r5)]'
                %}
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    </div>
  {% endif %}
{%- endcapture -%}

{% capture section_attributes %}
  x-cart-api-section="section-api"
  x-view-event
  data-view-event-payload="{{ cart | standard_event_data: 'view' | escape }}"
{% endcapture %}

{% render 'core-section-wrapper',
  s: section.settings,
  content: content,
  class: 'transition-opacity',
  attributes: section_attributes,
  padding: false,
  photoswipe: false,
  lazy_alpine: false
%}

{% schema %}
{
	"name": "Cart",
	"class": "section-cart",
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme"
		},
		{
			"type": "select",
			"id": "background",
			"label": "Background",
			"default": "canvas",
			"options": [
				{
					"value": "canvas",
					"label": "Default"
				},
				{
					"value": "tint",
					"label": "Tint"
				},
				{
					"value": "custom",
					"label": "⋯"
				}
			]
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background color",
			"default": "#f2f2f2",
			"alpha": false,
			"visible_if": "{{ section.settings.background == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "content_width",
			"label": "Width",
			"default": "full",
			"options": [
				{
					"value": "full",
					"label": "Full"
				},
				{
					"value": "page",
					"label": "Page"
				}
			]
		},
		{
			"type": "header",
			"content": "Empty cart"
		},
		{
			"type": "link_list",
			"id": "empty_cart_buttons",
			"label": "Empty cart links",
			"info": "Defaults to a list of all collections"
		},
		{
			"type": "header",
			"content": "Back to store link"
		},
		{
			"type": "text",
			"id": "continue_browsing_label",
			"label": "Text",
			"default": "Continue shopping"
		},
		{
			"type": "url",
			"id": "continue_browsing_link",
			"label": "Link"
		},
		{
			"type": "checkbox",
			"id": "continue_browsing_open_in_new_window",
			"label": "Open link in new window",
			"default": false
		},
		{
			"type": "header",
			"content": "Free shipping message"
		},
		{
			"type": "checkbox",
			"id": "set_free_shipping_message",
			"label": "Show free shipping message",
			"default": false
		},
		{
			"type": "text",
			"id": "free_shipping_limit",
			"label": "Minimum spend for free shipping",
			"default": "100",
			"info": "Enter a round number in your store currency without symbols or letters. Analog automatically converts it for buyers using another currency. [Learn more](https://groupthought.com/link/analog/v1/docs/free-shipping)",
			"visible_if": "{{ section.settings.set_free_shipping_message == true }}"
		},
		{
			"type": "checkbox",
			"id": "enable_shipping_limit_conversion",
			"label": "Convert metafield limit",
			"info": "Turn on only when this market's metafield uses your store currency. Analog converts it for the buyer. Select a market from the editor menu before changing this setting. [Learn more](https://groupthought.com/link/analog/v1/docs/free-shipping)",
			"default": false,
			"visible_if": "{{ section.settings.set_free_shipping_message == true and settings.metafield_free_shipping_limit != blank }}"
		},
		{
			"type": "inline_richtext",
			"id": "free_shipping_progress_message",
			"label": "Progress message",
			"info": "Use ||amount|| to display progress towards free shipping",
			"default": "You are ||amount|| away from free shipping.",
			"visible_if": "{{ section.settings.set_free_shipping_message == true }}"
		},
		{
			"type": "inline_richtext",
			"id": "free_shipping_success_message",
			"label": "Success message",
			"info": "Shown when threshold is met",
			"default": "Congratulations! Your order qualifies for free shipping",
			"visible_if": "{{ section.settings.set_free_shipping_message == true }}"
		},
		{
			"type": "header",
			"content": "Cart items"
		},
		{
			"type": "checkbox",
			"id": "show_quantity_selector",
			"label": "Show quantity selector",
			"default": true
		},
		{
			"type": "select",
			"id": "quantity_sizing",
			"label": "Quantity size",
			"default": "md",
			"options": [
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				}
			],
			"visible_if": "{{ section.settings.show_quantity_selector == true }}"
		},
		{
			"type": "checkbox",
			"id": "show_disclosures",
			"label": "Show product disclosures",
			"info": "Show disclosures set to display in the cart under each item",
			"default": true
		},
		{
			"type": "header",
			"content": "Cart review"
		},
		{
			"type": "checkbox",
			"id": "show_cart_review",
			"label": "Show cart review",
			"info": "Show a summary of the total price and discounts.",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_tax_message",
			"label": "Show shipping and taxes message",
			"info": "Let your customers know if shipping and taxes are calculated at checkout",
			"default": true
		},
		{
			"type": "header",
			"content": "Checkbox"
		},
		{
			"type": "checkbox",
			"id": "show_checkbox",
			"label": "Show checkbox",
			"default": true
		},
		{
			"type": "richtext",
			"id": "checkbox_label",
			"label": "Label",
			"default": "<p>I agree to terms and conditions</p>",
			"visible_if": "{{ section.settings.show_checkbox == true }}"
		},
		{
			"type": "select",
			"id": "richtext_size_checkbox",
			"label": "Text size",
			"default": "md",
			"visible_if": "{{ section.settings.show_checkbox == true }}",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "checkbox_required",
			"label": "Required",
			"default": true,
			"visible_if": "{{ section.settings.show_checkbox == true }}"
		},
		{
			"type": "header",
			"content": "Checkout button"
		},
		{
			"type": "select",
			"id": "appearance_checkout_button",
			"label": "Style",
			"default": "fill",
			"options": [
				{
					"value": "fill",
					"label": "Fill"
				},
				{
					"value": "stroke",
					"label": "Stroke"
				},
				{
					"value": "soft",
					"label": "Soft"
				}
			]
		},
		{
			"type": "select",
			"id": "color_checkout_button",
			"label": "Color",
			"default": "primary",
			"options": [
				{
					"value": "content",
					"label": "Text default"
				},
				{
					"value": "primary",
					"label": "Primary accent"
				},
				{
					"value": "secondary",
					"label": "Link accent"
				},
				{
					"value": "sale",
					"label": "Sale"
				},
				{
					"value": "canvas",
					"label": "Background default"
				},
				{
					"value": "black",
					"label": "Black"
				},
				{
					"value": "white",
					"label": "White"
				},
				{
					"value": "custom",
					"label": "Custom"
				},
				{
					"value": "custom_gradient",
					"label": "Custom gradient"
				}
			]
		},
		{
			"type": "color",
			"id": "color_custom_checkout_button",
			"alpha": true,
			"default": "#000000",
			"visible_if": "{{ section.settings.color_checkout_button == 'custom' }}",
			"label": "Custom color"
		},
		{
			"type": "color",
			"id": "custom_gradient_from_checkout_button",
			"alpha": true,
			"default": "#009C9C",
			"visible_if": "{{ section.settings.color_checkout_button == 'custom_gradient' and section.settings.appearance_checkout_button == 'fill' }}",
			"label": "Gradient color 1"
		},
		{
			"type": "color",
			"id": "custom_gradient_to_checkout_button",
			"alpha": true,
			"default": "#6600D9",
			"visible_if": "{{ section.settings.color_checkout_button == 'custom_gradient' and section.settings.appearance_checkout_button == 'fill' }}",
			"label": "Gradient color 2"
		},
		{
			"type": "color",
			"id": "text_color_checkout_button",
			"label": "Text color",
			"default": "#FFFFFF",
			"visible_if": "{{ section.settings.appearance_checkout_button == 'fill' and section.settings.color_checkout_button == 'custom' or section.settings.color_checkout_button == 'custom_gradient' }}"
		},
		{
			"type": "paragraph",
			"content": "Custom gradients only apply to fill buttons",
			"visible_if": "{{ section.settings.color_checkout_button == 'custom_gradient' and section.settings.appearance_checkout_button != 'fill' }}"
		},
		{
			"type": "header",
			"content": "Text style",
			"visible_if": "{{ section.settings.type_preset_checkout_button == 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_preset_checkout_button",
			"label": "Text style",
			"default": "btn",
			"options": [
				{
					"group": "Headings",
					"value": "h1",
					"label": "Heading 1"
				},
				{
					"group": "Headings",
					"value": "h2",
					"label": "Heading 2"
				},
				{
					"group": "Headings",
					"value": "h3",
					"label": "Heading 3"
				},
				{
					"group": "Headings",
					"value": "h4",
					"label": "Heading 4"
				},
				{
					"group": "Headings",
					"value": "h5",
					"label": "Heading 5"
				},
				{
					"group": "Headings",
					"value": "h6",
					"label": "Heading 6"
				},
				{
					"group": "Content",
					"value": "section",
					"label": "Section title"
				},
				{
					"group": "Content",
					"value": "p",
					"label": "Paragraph"
				},
				{
					"group": "Content",
					"value": "kicker",
					"label": "Kicker"
				},
				{
					"group": "Content",
					"value": "micro",
					"label": "Micro"
				},
				{
					"group": "Elements",
					"value": "btn",
					"label": "Button"
				},
				{
					"group": "Elements",
					"value": "accordion",
					"label": "Accordion"
				},
				{
					"group": "Elements",
					"value": "tab",
					"label": "Tab"
				},
				{
					"group": "Custom",
					"value": "custom",
					"label": "Custom"
				}
			]
		},
		{
			"type": "select",
			"id": "type_resize_checkout_button",
			"label": "Text size",
			"default": "md",
			"options": [
				{
					"value": "xs",
					"label": "XS"
				},
				{
					"value": "sm",
					"label": "S"
				},
				{
					"value": "md",
					"label": "M"
				},
				{
					"value": "lg",
					"label": "L"
				},
				{
					"value": "xl",
					"label": "XL"
				}
			],
			"visible_if": "{{ section.settings.type_preset_checkout_button != 'custom' }}"
		},
		{
			"type": "select",
			"id": "type_font_checkout_button",
			"label": "Font",
			"default": "body",
			"options": [
				{
					"value": "heading",
					"label": "Heading"
				},
				{
					"value": "subheading",
					"label": "Subheading"
				},
				{
					"value": "accent",
					"label": "Accent"
				},
				{
					"value": "body",
					"label": "Body"
				}
			],
			"visible_if": "{{ section.settings.type_preset_checkout_button == 'custom' }}"
		},
		{
			"type": "range",
			"id": "type_size_checkout_button",
			"label": "Size",
			"min": 1,
			"max": 15,
			"step": 1,
			"default": 4,
			"visible_if": "{{ section.settings.type_preset_checkout_button == 'custom' }}"
		},
		{
			"type": "checkbox",
			"id": "type_uppercase_checkout_button",
			"label": "Uppercase",
			"default": false,
			"visible_if": "{{ section.settings.type_preset_checkout_button == 'custom' }}"
		},
		{
			"type": "header",
			"content": "Accelerated checkout buttons"
		},
		{
			"type": "checkbox",
