{% assign form_id = 'cart-' | append: section.id %}

{%- capture cart_items -%}
  {% render 'cart-list', form_id: form_id, show_quantity_selector: section.settings.show_quantity_selector, show_disclosures: section.settings.show_disclosures, quantity_size: section.settings.quantity_sizing, class: 'border border-line-subtle rounded-sm overflow-hidden' %}
{%- endcapture -%}

{% comment %} Cart total price should always show cents and currency {% endcomment %}
{%- capture total_price -%}
  {% render 'money', price: cart.total_price, show_currency: true, hide_trailing_zeros: false %}
{%- endcapture -%}

{%- capture checkbox -%}
  {% render 'cart-checkbox', form_id: form_id %}
{%- endcapture -%}

{% capture checkout_button %}
  <noscript>
    {%- assign update_cart_label = 'cart.update_cart_button' | t -%}
    {%- render 'core-button',
      type: 'submit',
      form: form_id,
      appearance: 'stroke',
      color: 'content',
      sizing: 'lg',
      label: update_cart_label
    -%}
  </noscript>

  {% assign checkout_label = 'cart.check_out_button' | t %}
  {% render 'core-button',
    content: checkout_label,
    type: 'submit',
    name: 'checkout',
    form: form_id,
    appearance: section.settings.appearance_checkout_button,
    color: section.settings.color_checkout_button,
    color_custom: section.settings.color_custom_checkout_button,
    text_color: section.settings.text_color_checkout_button,
    custom_gradient_from: section.settings.custom_gradient_from_checkout_button,
    custom_gradient_to: section.settings.custom_gradient_to_checkout_button,
    type_preset: section.settings.type_preset_checkout_button,
    type_resize: section.settings.type_resize_checkout_button,
    type_size: section.settings.type_size_checkout_button,
    type_font: section.settings.type_font_checkout_button,
    type_uppercase: section.settings.type_uppercase_checkout_button,
    height: 'lg',
    class: '[--control-padding:theme(space.r6)] group-has-[:invalid]:opacity-50 [--control-height:--row-lg]',
  %}
{% endcapture %}

{% if section.settings.show_additional_buttons %}
  {% capture additional_buttons %}
    {% render 'cart-additional-buttons-block' %}
  {% endcapture %}
{% endif %}

{% assign app_blocks = '' %}
{%- capture reorderable_blocks -%}
  {%- for block in section.blocks -%}
    {% case block.type %}
      {% when 'cart_upsell' %}
        {% comment %} We need to do this capture to prevent an empty <div> from rendering when there are no upsells {% endcomment %}
        {%- capture cart_upsell -%}
          {% render 'cart-upsell-block', block: block, attributes: block.shopify_attributes %}
        {%- endcapture -%}
        {% if cart_upsell != blank %}
          <div class="py-r6">
            {{ cart_upsell }}
          </div>
        {% endif %}

      {% when 'customer_notes' %}
        {% liquid
          assign accordion_class = 'py-r6'
          if block.settings.accordion
            assign accordion_class = 'border-b border-y-line-subtle'
          endif
        %}
        {% capture accordion_attributes %}
          data-card-accordion
          {{ block.shopify_attributes }}
        {% endcapture %}
        {% render 'cart-customer-notes-block', block: block, class: accordion_class, attributes: accordion_attributes %}

      {% when 'shipping_estimate' %}
        {% liquid
          assign accordion_class = 'py-r6'
          if block.settings.accordion
            assign accordion_class = 'border-b border-y-line-subtle'
          endif
        %}
        {% capture accordion_attributes %}
          data-card-accordion
          {{ block.shopify_attributes }}
        {% endcapture %}
        {% render 'cart-shipping-estimate-block', block: block, id: form_id, class: accordion_class, attributes: accordion_attributes %}

      {% when 'payment_icons' %}
        <div class="py-r6">
          {% render 'cart-payment-icons-block', block: block, attributes: block.shopify_attributes %}
        </div>

      {% when 'message_custom' %}
        <div class="py-r6">
          {% render 'cart-message-custom-block', block: block, attributes: block.shopify_attributes %}
        </div>

      {% when 'liquid_code' %}
        {% render 'liquid-code-block', block: block, attributes: block.shopify_attributes %}

      {% when '@app' %}
        {%- capture app_blocks -%}
          {{ app_blocks }}
          {% render block %}
        {%- endcapture -%}
    {% endcase %}
  {%- endfor -%}
{%- endcapture -%}

{% capture subtotal %}
  <div>
    {% if section.settings.show_cart_review %}
      {% render 'cart-summary' %}
    {% endif %}
    {% if section.settings.show_tax_message %}
      <p class="text-r3 pt-r4 text-muted italic">
        {% render 'taxes-included-cart' %}
      </p>
    {% endif %}
  </div>
{% endcapture %}

{%- capture content -%}
  {% comment %} Cart with items {% endcomment %}
  {% if cart.item_count > 0 %}
    <div class="col-section-content pb-r12">
      {% comment %} Header {% endcomment %}
      <div
        class="pb-r8 grid grid-cols-1 items-center gap-r8 lg:gap-r10 lg:grid-cols-6"
        style="padding-top: calc(30px * var(--r-multiplier));"
      >
        <div role="alert" class="sr-only">
          {% # t escapes interpolated params, so strip the money markup before it reaches the filter %}
          {% assign total_price_text = total_price | strip_html | strip %}
          {{ 'cart.item_count' | t: count: cart.item_count }},
          {{ 'cart.total_price' | t: total: total_price_text }}
        </div>

        <div class="flex justify-between items-center gap-r8 lg:col-span-4">
          <h1 class="type-h2">{{ 'cart.title' | t }}</h1>

          {% assign continue_browsing_label = section.settings.continue_browsing_label %}
          {% if continue_browsing_label != blank %}
            {% assign continue_browsing_href = section.settings.continue_browsing_link | default: routes.all_products_collection_url %}
            {%- render 'core-button',
              tag: 'a',
              href: continue_browsing_href,
              sizing: 'xs',
              appearance: 'bare',
              color: 'content',
              class: 'gap-x-r4',
              label: continue_browsing_label,
              new_window: section.settings.continue_browsing_open_in_new_window,
              end_icon: 'stroke-arrow-up-right',
              end_icon_class: 'w-r5 h-r5 !scale-100'
            -%}
          {% endif %}
        </div>

        <div class="lg:col-span-2">
          {% if section.settings.set_free_shipping_message %}
            {% render 'cart-shipping-message',
              class: 'p-r6 border border-line-subtle rounded-sm bg-canvas',
              s: section.settings
            %}
          {% endif %}
        </div>
      </div>

      {% comment %} Body {% endcomment %}
      <div
        class="grid grid-cols-1 gap-r10 lg:grid-cols-6"
      >
        {% comment %} Content {% endcomment %}
        <div class="flex flex-col gap-r11 lg:gap-r12 lg:col-span-4">
          {{ cart_items }}

          <div class="grid grid-cols-1 gap-r10 md:grid-cols-11">
            <div class="md:col-span-5">
              {{ app_blocks }}
            </div>
          </div>
        </div>

        {% comment %} Sidebar {% endcomment %}
        <div class="flex flex-col gap-y-r6 lg:col-span-2">
          <div class="group flex flex-col gap-y-r6 p-r6 border border-line-subtle rounded-sm bg-canvas">
            {{ subtotal }}
            {{ checkbox }}

            <div class="flex flex-col gap-r5">
              {{ checkout_button }}
              {{ additional_buttons }}
            </div>
          </div>

          <div>
            {{ reorderable_blocks }}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %} Empty Cart {% endcomment %}
  {% if cart.item_count == 0 %}
    <div class="col-fullbleed">
      <div class="py-r14 flex flex-1 flex-center bg-primary text-center">
        <h3 class="type-h2 text-primary-contrast">{{ 'cart.no_items_in_cart' | t }}</h3>
      </div>

      <div class="relative py-r13 w-full max-w-[500px] mx-auto text-r5 text-center">
        <p class="mb-r5">{{ 'cart.no_items_links_title' | t }}</p>

        <ul class="flex flex-col gap-y-r7 p-r8 md:p-r9 md:gap-y-r8">
          {% if section.settings.empty_cart_buttons != blank and section.settings.empty_cart_buttons.links.size > 0 %}
            {% for link in section.settings.empty_cart_buttons.links %}
              <li>
                {% render 'core-button',
                  label: link.title,
                  tag: 'a',
                  href: link.url,
                  appearance: 'stroke',
                  color: 'content',
                  sizing: 'md',
                  class: 'w-full [--control-padding:theme(space.r5)]'
                %}
              </li>
            {% endfor %}
          {% else %}
            {% for collection in collections limit: 5 %}
              <li>
                {% render 'core-button',
                  label: collection.title,
                  tag: 'a',
                  href: collection.url,
                  appearance: 'stroke',
                  color: 'content',
                  sizing: 'md',
                  class: 'w-full [--control-padding:theme(space.r5)]'
                %}
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    </div>
  {% endif %}
{%- endcapture -%}

{% capture section_attributes %}
  x-cart-api-section="section-api"
  x-view-event
  data-view-event-payload="{{ cart | standard_event_data: 'view' | escape }}"
{% endcapture %}

{% render 'core-section-wrapper',
  s: section.settings,
  content: content,
  class: 'transition-opacity',
  attributes: section_attributes,
  padding: false,
  photoswipe: false,
  lazy_alpine: false
%}

{% schema %}
{
  "name": "Cart",
  "class": "section-cart",
  "settings": [
    [% json 'schema/color-settings-section-solid.jsonc' %]
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Width",
      "default": "full",
      "options": [
        {"value": "full", "label": "Full"},
        {"value": "page", "label": "Page"}
      ]
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "link_list",
      "id": "empty_cart_buttons",
      "label": "Empty cart links",
      "info": "Defaults to a list of all collections"
    },
    {
      "type": "header",
      "content": "Back to store link"
    },
    [% json 'schema/link-settings.jsonc', text_id: "continue_browsing_label", default_text_content: "Continue shopping", href_id: "continue_browsing_link", open_in_new_window_id: "continue_browsing_open_in_new_window" %]
    {
      "type": "header",
      "content": "Free shipping message"
    },
    [% json 'schema/cart-shipping-message-settings.jsonc' %]
    {
      "type": "header",
      "content": "Cart items"
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "select",
      "id": "quantity_sizing",
      "label": "Quantity size",
      "default": "md",
      "options": [
        {"value": "sm", "label": "S"},
        {"value": "md", "label": "M"},
        {"value": "lg", "label": "L"}
      ],
      "visible_if": "{{ section.settings.show_quantity_selector == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_disclosures",
      "label": "Show product disclosures",
      "info": "Show disclosures set to display in the cart under each item",
      "default": true
    },
    {
      "type": "header",
      "content": "Cart review"
    },
    {
      "type": "checkbox",
      "id": "show_cart_review",
      "label": "Show cart review",
      "info": "Show a summary of the total price and discounts.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_message",
      "label": "Show shipping and taxes message",
      "info": "Let your customers know if shipping and taxes are calculated at checkout",
      "default": true
    },
    {
      "type": "header",
      "content": "Checkbox"
    },
    {
      "type": "checkbox",
      "id": "show_checkbox",
      "label": "Show checkbox",
      "default": true
    },
    {
      "type": "richtext",
      "id": "checkbox_label",
      "label": "Label",
      "default": "<p>I agree to terms and conditions</p>",
      "visible_if": "{{ section.settings.show_checkbox == true }}"
    },
    [% json 'schema/type-richtext-resize-all-setting.jsonc', id: 'richtext_size_checkbox', label: 'Text size', default: 'md', conditional: "section.settings.show_checkbox == true" %]
    {
      "type": "checkbox",
      "id": "checkbox_required",
      "label": "Required",
      "default": true,
      "visible_if": "{{ section.settings.show_checkbox == true }}"
    },
    {
      "type": "header",
      "content": "Checkout button"
    },
    [% json 'schema/button-appearance-setting.jsonc', id: 'appearance_checkout_button' %]
    [% json 'schema/color-dropdown.jsonc', id_suffix: 'checkout_button', overlay_colors: true, default_color: 'primary', custom: true, custom_gradient: true, gradient_fill_only: true, context: "section.settings." %]
    [% json 'schema/button-custom-color-settings.jsonc', id_suffix: 'checkout_button', context: "section.settings." %]
    [% json 'schema/type-preset.jsonc', default_preset: 'btn', label: 'Text style', conditional_heading: 'Text style', id_suffix: 'checkout_button', context: "section.settings." %]
    [% json 'schema/type-custom.jsonc', resize: true, id_suffix: 'checkout_button', context: "section.settings." %]
    {
      "type": "header",
      "content": "Accelerated checkout buttons"
    },
    {
      "type": "checkbox",
      "id": "show_additional_buttons",
      "label": "Show buttons",
      "info": "Show Shop Pay, Apple Pay, Google Pay and other express checkout buttons. [Learn more](https://help.shopify.com/manual/online-store/dynamic-checkout)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "message_custom",
      "name": "Custom message",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "cart_custom_message_text",
          "label": "Message text",
          "default": "Use code <strong>TENOFF</strong> at checkout for 10% off"
        }
      ]
    },
    {
      "type": "cart_upsell",
      "name": "Cart upsell",
      "settings": [
        {
          "type": "paragraph",
          "content": "Products are removed from the upsell list once added to the cart."
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Label",
          "default": "Top picks"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Products",
          "info": "Choose the products shown by this block. [Learn more](https://groupthought.com/link/analog/v1/docs/upsell-products)"
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Product limit",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "include_line_item_upsells",
          "label": "Prioritize paired upsells",
          "default": false,
          "info": "Show paired upsells for products in the cart before 'Products'. [Learn more](https://groupthought.com/link/analog/v1/docs/upsell-products)",
          "visible_if": "{{ settings.metafield_upsell_list != blank }}"
        },
        {
          "type": "checkbox",
          "id": "prioritize_shipping_upsell",
          "label": "Promote a shipping upsell product",
          "default": false,
          "info": "If free shipping limit is not yet met, promote the cheapest upsell product that will bring the total price to the free shipping threshold to the first position in the upsell list."
        },
      ]
    },
    {
      "type": "shipping_estimate",
      "name": "Shipping estimate",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Customers enter their location and receive a price estimate in the cart."
        },
        {
          "type": "checkbox",
          "id": "accordion",
          "label": "Show in an accordion",
          "default": false
        },
        {
          "type": "header",
          "content": "Submit button"
        },
        [% json 'schema/button-appearance-setting.jsonc', default_appearance: 'stroke' %]
        [% json 'schema/size-setting.jsonc', size_label: 'Padding', default_size: 'md' %]
        [% json 'schema/color-dropdown.jsonc', overlay_colors: true, default_color: 'primary' %]
        [% json 'schema/type-preset.jsonc', default_preset: 'btn', label: 'Text style', conditional_heading: 'Text style' %]
        [% json 'schema/type-custom.jsonc', resize: true %]
      ]
    },
    {
      "type": "customer_notes",
      "name": "Customer notes",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "accordion",
          "label": "Show in an accordion",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Special instructions for seller",
          "info": "Collect information from your customers"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Textarea label",
          "default": "Instructions"
        }
      ]
    },
    {
      "type": "payment_icons",
      "name": "Payment icons",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Show icons for the payment methods you accept."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "We accept"
        }
      ]
    },
    {
      "type": "liquid_code",
      "name": "Custom liquid",
      "settings": [
        [% json 'schema/liquid-code-settings.jsonc' %]
      ]
    }
  ]
}
{% endschema %}
