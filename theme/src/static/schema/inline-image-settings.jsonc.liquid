[
  {
    "type": "image_picker",
    "id": "image",
    "label": "Image"
  },
  {
    "type": "range",
    "id": "image_scaling",
    "min": 50,
    "max": 200,
    "step": 10,
    "label": "Height",
    "default": 100,
    "unit": "%",
    "info": "Relative to the surrounding text"
  },
  [% json 'schema/clip-mask-settings.jsonc' %]
  {
    "type": "range",
    "id": "aspect_ratio",
    "min": 0.5,
    "max": 3,
    "step": 0.1,
    "unit": ":1",
    "label": "Aspect ratio",
    "default": 1,
    "visible_if": "{{ block.settings.crop_image == true }}"
  },
  [% unless link == false %]
    [% json 'schema/link-settings.jsonc', label: false %]
  [% endunless %]
]