[
  {
    "type": "select",
    "label": "[= label | default: 'Progress bar' =]",
    "id": "[= id | default: 'progress_bar_visibility' =]",
    "default": "[= default_value | default: 'desktop' =]",
    "options": [
      {"value": "mobile", "label": "Mobile"},
      {"value": "desktop", "label": "Desktop"},
      {"value": "both", "label": "Both"},
      {"value": "never", "label": "Never"}
    ],
    [% if conditional %]
      "visible_if": "{{ [= conditional =] }}"
    [% endif %]
  }
]

