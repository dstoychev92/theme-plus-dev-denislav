[% assign context = context | default: 'block.settings.' %]
[% assign conditional = context | append: 'logo' | append: " != blank" %]
[% assign inverse_conditional = context | append: 'logo' | append: " == blank" %]

[
  {
    "type": "paragraph",
    "content": "The transparent header detects the darkness of the section beneath. The colors switch between the light mode and dark mode palettes in your global settings. Your default logo is assumed to be dark.",
    "visible_if": "{{ section.settings.transparent == true and [= conditional =] }}"
  },

  {
    "type": "image_picker",
    "id": "transparent_white_logo",
    "label": "White logo",
    "visible_if": "{{ section.settings.transparent == true and [= conditional =] }}"
  }

  {
    "type": "paragraph",
    "content": "This will be used for dark section overlays. If you do not select a white logo, default logo will be used.",
    "visible_if": "{{ section.settings.transparent == true and [= conditional =] }}"
  },
]
