[
  {
    "type": "checkbox",
    "id": "set_border",
    "label": "Set border",
    "default": false,
    "visible_if": "{{ section.settings.contain_section }}"
  },
  {
    "type": "range",
    "id": "border_width",
    "label": "Thickness",
    "unit": "px",
    "min": 0,
    "max": 10,
    "step": 1,
    "default": 1,
    "visible_if": "{{ section.settings.contain_section and section.settings.set_border }}"
  },
  {
    "type": "color",
    "id": "border_color",
    "label": "Color",
    "alpha": true,
    "default": "#000000",
    "visible_if": "{{ section.settings.contain_section and section.settings.set_border }}"
  }
]
