[% if id_suffix %]
  [% assign _id_suffix = id_suffix | prepend: '_' %]
[% endif %]
[
  {
    "type": "checkbox",
    "id": "set_aspect_ratio[= _id_suffix =]",
    "label": "Set aspect ratio",
    [% if conditional %]
      "visible_if": "{{ [= conditional =] }}",
    [% endif %]
    "default": false
  },
  {
    "type": "range",
    "id": "aspect_ratio[= _id_suffix =]",
    "min": 0.5,
    "max": [= aspect_ratio_max | default: 3 =],
    "step": 0.1,
    "unit": ":1",
    "label": "Aspect ratio",
    "default": 1,
    "visible_if": "{{ block.settings.set_aspect_ratio[= _id_suffix =] == true [% if conditional %] and [= conditional =][% endif %] }}"
  }
]