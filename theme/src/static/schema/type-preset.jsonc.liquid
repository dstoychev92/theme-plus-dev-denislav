[% if id_suffix %]
 [% assign _id_suffix = id_suffix | prepend: '_' %]
[% endif %]
[% assign context = context | default: 'block.settings.' %]
[
  [% if conditional_heading and conditional_heading != '' %]
    {
      "type": "header",
      "content": "[= conditional_heading =]",
      "visible_if": "{{ [= context =]type_preset[= _id_suffix =] == 'custom' }}"
    },
  [% endif %]
  {
    "type": "select",
    "id": "type_preset[= _id_suffix =]",
    "label": "[= label | default: 'Style' =]",
    "default": "[= default_preset | default: 'p' =]",
    [% if select_conditional %]
      "visible_if": "{{ [= select_conditional =] }}",
    [% endif %]
    "options": [
      [= prepend_options =]
      [% unless replace_options %]
        {"group": "Headings", "value": "h1", "label": "Heading 1"},
        {"group": "Headings", "value": "h2", "label": "Heading 2"},
        {"group": "Headings", "value": "h3", "label": "Heading 3"},
        {"group": "Headings", "value": "h4", "label": "Heading 4"},
        {"group": "Headings", "value": "h5", "label": "Heading 5"},
        {"group": "Headings", "value": "h6", "label": "Heading 6"},
        {"group": "Content", "value": "section", "label": "Section title"},
        {"group": "Content", "value": "p", "label": "Paragraph"},
        {"group": "Content", "value": "kicker", "label": "Kicker"},
        {"group": "Content", "value": "micro", "label": "Micro"},
        {"group": "Elements", "value": "btn", "label": "Button"},
        {"group": "Elements", "value": "accordion", "label": "Accordion"},
        {"group": "Elements", "value": "tab", "label": "Tab"},
        {"group": "Custom", "value": "custom", "label": "Custom"}
      [% else %]
        [= replace_options =]
        [% unless replace_options contains 'custom' %]
          {"value": "custom", "label": "⋯"}
        [% endunless %]
      [% endunless %]
    ]
  },
]
