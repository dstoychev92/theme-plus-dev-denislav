[
  {
    "type": "checkbox",
    "id": "set_offset",
    "label": "Set offset",
    "default": false
  },
  {
    "type": "select",
    "id": "offset_unit",
    "label": "Unit",
    "visible_if": "{{ block.settings.set_offset }}",
    "default": "pixel",
    "options": [
      {"value": "pixel", "label": "Pixel"},
      {"value": "percent", "label": "Percentage"}
    ]
  },
  {
    "type": "range",
    "id": "offset_pixels_y",
    "label": "Y ↕",
    "default": 0,
    "min": -100,
    "max": 100,
    "step": 2,
    "unit": "px",
    "visible_if": "{{ block.settings.set_offset and block.settings.offset_unit == 'pixel' }}"
  },
  {
    "type": "range",
    "id": "offset_pixels_x",
    "label": "X ↔",
    "default": 0,
    "min": -100,
    "max": 100,
    "step": 2,
    "unit": "px",
    "visible_if": "{{ block.settings.set_offset and block.settings.offset_unit == 'pixel' }}"
  },
  {
    "type": "range",
    "id": "offset_percent_y",
    "label": "Y ↕",
    "default": 0,
    "min": -100,
    "max": 100,
    "step": 2,
    "unit": "%",
    "visible_if": "{{ block.settings.set_offset and block.settings.offset_unit == 'percent' }}"
  },
  {
    "type": "range",
    "id": "offset_percent_x",
    "label": "X ↔",
    "default": 0,
    "min": -100,
    "max": 100,
    "step": 2,
    "unit": "%",
    "visible_if": "{{ block.settings.set_offset and block.settings.offset_unit == 'percent' }}"
  }
]