[% assign context = context | default: 'block.settings.' %]
[
  [% unless height_toggle == false %]
    {
      "type": "checkbox",
      "id": "set_height",
      "label": "Set height",
      "default": [= height_toggle_default | default: true, allow_false: true =]
    },
  [% endunless %]
  {
    "type": "select",
    "id": "height",
    "label": "Height",
    "default": "[= default_height | default: 'screen-one-half' =]",
    [% unless height_toggle == false %]
      "visible_if": "{{ [= context =]set_height == true }}",
    [% endunless %]
    "options": [
      [% if content_height == true %]
        {"value": "content", "label": "Content height"},
      [% endif %]
      [% unless image_height == false %]
        {"value": "image", "label": "[= image_height_label | default: 'Image height' =]"},
      [% endunless %]
      {"value": "screen", "label": "Full screen height"},
      {"value": "screen-five-sixths", "label": "Five sixths screen"},
      {"value": "screen-three-quarters", "label": "Three quarters screen"},
      {"value": "screen-one-half", "label": "One half screen"},
      {"value": "screen-one-third", "label": "One third screen"},
      {"value": "screen-one-quarter", "label": "One quarter screen"},
      {"value": "custom", "label": "Custom"},
    ]
  },
  {
    "type": "select",
    "id": "custom_height_type",
    "label": "Height type",
    "default": "[= default_custom_height_type | default: 'percentage' =]",
    "options": [
      {"value": "percentage", "label": "%"},
      {"value": "px", "label": "px"},
    ],
    "visible_if": "{{ [% unless height_toggle == false %][= context =]set_height == true and [% endunless %][= context =]height == 'custom' }}"
  },
  {
    "type": "range",
    "id": "custom_height_percentage",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "%",
    "label": "Custom height",
    "default": 33,
    "visible_if": "{{ [% unless height_toggle == false %][= context =]set_height == true and [% endunless %][= context =]height == 'custom' and [= context =]custom_height_type == 'percentage' }}",
    "info": "Percentage of screen height"
  },
  {
    "type": "range",
    "id": "custom_height_px",
    "min": 0,
    "max": 1000,
    "step": 50,
    "unit": "px",
    "label": "Custom height",
    "default": 350,
    "visible_if": "{{ [% unless height_toggle == false %][= context =]set_height == true and [% endunless %][= context =]height == 'custom' and [= context =]custom_height_type == 'px' }}"
  }

  [% unless height_mobile == false %]
    {
      "type": "checkbox",
      "id": "set_height_mobile",
      "label": "Set mobile height",
      "default": [= height_default_mobile | default: false =]
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Mobile height",
      "default": "[= default_height_mobile | default: 'screen-one-half' =]",
      "visible_if": "{{ [= context =]set_height_mobile == true }}",
      "options": [
        [% if content_height_mobile == true %]
          {"value": "content", "label": "Content height"},
        [% endif %]
        [% if image_height_mobile == true %]
          {"value": "image", "label": "[= image_height_label_mobile | default: image_height_label | default: 'Image height' =]"},
        [% endif %]
        {"value": "screen", "label": "Full screen height"},
        {"value": "screen-five-sixths", "label": "Five sixths screen"},
        {"value": "screen-three-quarters", "label": "Three quarters screen"},
        {"value": "screen-one-half", "label": "One half screen"},
        {"value": "screen-one-third", "label": "One third screen"},
        {"value": "screen-one-quarter", "label": "One quarter screen"},
        {"value": "custom", "label": "Custom"},
      ]
    },
    {
      "type": "select",
      "id": "custom_height_type_mobile",
      "label": "Mobile height type",
      "default": "[= default_custom_height_type_mobile | default: 'percentage' =]",
      "options": [
        {"value": "percentage", "label": "%"},
        {"value": "px", "label": "px"},
      ],
      "visible_if": "{{ [% unless height_mobile == false %][= context =]set_height_mobile == true and [% endunless %][= context =]height_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_height_percentage_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile custom height",
      "default": 33,
      "visible_if": "{{ [% unless height_mobile == false %][= context =]set_height_mobile == true and [% endunless %][= context =]height_mobile == 'custom' and [= context =]custom_height_type_mobile == 'percentage' }}"
    },
    {
      "type": "range",
      "id": "custom_height_px_mobile",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Mobile custom height",
      "default": 350,
      "visible_if": "{{ [% unless height_mobile == false %][= context =]set_height_mobile == true and [% endunless %][= context =]height_mobile == 'custom' and [= context =]custom_height_type_mobile == 'px' }}"
    },
  [% endunless %]
]
