{% doc %}
  - Prints oklch and fallback variables for one scheme color

  @param {color} color
  @param {string} color_name - name used in the variable, such as 'canvas'
  @param {color} [contrast_color] - color that reads against it
  @param {string} scheme_id - id prefix for the variables
{% enddoc %}

--{{ scheme_id }}-{{ color_name }}-oklch: {{ color.oklch }};
{% if contrast_color -%}
  --{{ scheme_id }}-{{ color_name }}-contrast-oklch: {{ contrast_color.oklch }};
{%- endif %}
/* oklch-fallback */
--{{ scheme_id }}-{{ color_name }}-fallback: {{ color.rgb }};
{% if contrast_color -%}
  --{{ scheme_id }}-{{ color_name }}-contrast-fallback: {{ contrast_color.rgb }};
{%- endif %}
