{% doc %}
  - Renders the shop logo, or the shop name as text

  @param {string} [attributes]
  @param {block} [block]
  @param {string} [class] - The classes
  @param {object} [s] - settings object
  @param {string} [target_device] - 'mobile' or 'desktop', defaults to s.target_device
{% enddoc %}

{% liquid
  assign logo = s.logo
  assign transparent_white_logo = s.transparent_white_logo
  assign logo_max_width = s.logo_max_limit | times: 1
  assign logo_font_size = s.logo_font_size
  assign target_device = target_device | default: s.target_device
%}

{% if logo %}
  {% capture class %}
    keyboard-focus:outline-offset-[-2px]
    {% comment %} Scale down logo with screen size {% endcomment %}
    [--header-logo-dynamic-width:calc(max(min(50vw,100%,var(--header-logo-max-width)),75px))]
    w-[--header-logo-dynamic-width]
    {{ class }}
  {% endcapture %}
  {% capture attributes %}
    style="--header-logo-max-width: {{ logo_max_width }}px"
    {{ attributes }}
  {% endcapture %}
{% endif %}

<a
  data-target-device="{{ target_device }}"
  class="
    pt-[var(--section-pt)] pb-[var(--section-pb)] grid-stack place-items-center relative flex-none
    {% render 'props-class-target-device', target_device: target_device %}
    {{ class }}
  "
  href="{{ routes.root_url }}"
  aria-label="{{ shop.name }}"
  {{ attributes }}
  {{ block.shopify_attributes }}
>
  {% capture logo_class %}
    h-auto
  {% endcapture %}
  {% if logo != blank %}
    {% if transparent_white_logo != null %}
      {% assign transparent_white_logo_alt_default = transparent_white_logo.alt
        | default: shop.name
        | strip_html
        | escape_once
      %}
      {% capture transparent_white_logo_class %}
        {{ logo_class }}
        opacity-[--header-transparent-white-logo-opacity,0.0]
      {% endcapture %}

      {% render 'core-image',
        image: transparent_white_logo,
        width: logo_max_width,
        alt_default: transparent_white_logo_alt_default,
        fetchpriority: 'high',
        placeholder: false,
        loading: 'eager',
        class: transparent_white_logo_class,
        aria_hidden: true
      %}
    {% endif %}

    {% assign alt_default = logo.alt | default: shop.name | strip_html | escape_once %}
    {% capture logo_class %}
      {{ logo_class }}

      {% if transparent_white_logo != null %}
        transition-opacity duration-500
        {% if s.color_scheme.settings.color_content.lightness < 50 %}
          opacity-[calc(1-var(--header-transparent-white-logo-opacity,0.0))]
        {% else %}
          opacity-[calc(1-var(--header-transparent-white-logo-opacity,1.0))]
        {% endif %}
      {% endif %}
    {% endcapture %}

    {% render 'core-image',
      image: logo,
      width: logo_max_width,
      alt_default: alt_default,
      fetchpriority: 'high',
      placeholder: false,
      loading: 'eager',
      class: logo_class
    %}
  {% else %}
    <span
      class="
        {% if s.enable_logo_background %}
          bg-content text-canvas px-[1em]
        {% else %}
          text-content
        {% endif %}
        font-family-heading text-center
        uppercase py-[0.5em]
        whitespace-normal leading-none
      "
      style="font-size: min(calc(var(--font-r{{ logo_font_size }}) * var(--font-family-adjust) * var(--caps-adjust)), 3vw)"
    >
      {{ shop.name }}
    </span>
  {% endif %}
</a>
