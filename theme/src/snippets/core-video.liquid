{% doc %}
  - Renders video player or Shopify placeholder

  @param [aspect_ratio] - CSS aspect-ratio, defaults to video.aspect_ratio, then '16 / 9'
  @param {string} [attributes]
  @param {boolean} [autoplay] - plays muted, looped, and inline on load with no play button, defaults to false
  @param {string} [class] - The classes
  @param {boolean} [controls] - native controls, defaults to true, or false when autoplay or show_custom_controls is set
  @param {boolean} [cover] - crops poster image to fill, defaults to true
  @param {string} [height] - height attribute for the video element
  @param {string} [id] - id prefix for the container and video
  @param {boolean} [is_product_video] - fires enter and leave intersects only when the whole video is in view
  @param {boolean} [loop]
  @param {boolean} [muted]
  @param {string} [on_load_video] - Alpine expression for @theme:video:init
  @param [placeholder] - placeholder_svg_tag name, or false for none, defaults to 'image'
  @param {string} [play_button_class] - classes for the play button
  @param {boolean} [preload]
  @param {boolean} [show_custom_controls] - turns native controls off by default, for controls the caller renders
  @param {string} [style] - inline styles
  @param {video} [video]
  @param {string} [video_class] - classes for the video element
  @param {string} [video_container_id] - aria-controls target for the play button, defaults to id plus '-video-container'
  @param {string} [width] - width attribute for the video element
{% enddoc %}

{% assign placeholder = placeholder | default: 'image', allow_false: true %}
{% assign autoplay = autoplay | default: false %}

{% liquid
  # Both the video and the placeholder need the ratio, so resolve it before either branch
  assign aspect_ratio = aspect_ratio | default: video.aspect_ratio | default: '16 / 9'

  # These ids are interpolated inside the play_button capture below, so they
  # must be assigned before the capture runs
  if video
    assign video_id = id | append: '-video'
    assign default_video_container_id = id | append: '-video-container'
    assign video_container_id = video_container_id | default: default_video_container_id
    assign play_button_controls_id = video_container_id
  elsif placeholder
    assign placeholder_id = id | append: '-placeholder'
    assign video_id = placeholder_id
    assign play_button_controls_id = placeholder_id
  endif
%}

{% capture play_button %}
  {% assign play_aria_label = 'other.accessibility.play' | t %}

  {% comment %} Custom icon path to handle the shadow because "filter: drop-shadow()" does not work on Safari {% endcomment %}
  {% capture icon_path_with_shadow %}
    <defs>
      <filter id="core-video-dropshadow-{{- video_id -}}" width="150%" height="150%" x="-50%" y="-50%" filterUnits="userSpaceOnUse">
        <feDropShadow dx="0" dy="0" flood-color="#000" flood-opacity="0.125" stdDeviation="1"/>
      </filter>
    </defs>
    {%- case 'fill-play-circle' -%}
      [% render 'icons-autogenerated/fill-paths' %]
    {%- else -%}
      Missing icon: fill-play-circle
    {%- endcase -%}
  {% endcapture %}

  {% capture icon_attributes %}
    filter="url(#core-video-dropshadow-{{- video_id -}})"
  {% endcapture %}

  <button
    {% if video %}
      x-show="$video.showPlayButton"
    {% else %}
      x-show="showPlayButton"
    {% endif %}
    {% if autoplay == true %}
      x-cloak
    {% endif %}
    {% if video %}
      @click="$video.handlePlayButtonClick()"
    {% else %}
      @click="handlePlayButtonClick"
    {% endif %}
    class="absolute inset-0 z-10 flex flex-center transition-colors cursor-pointer group/play-button {{ play_button_class }}"
    aria-label="{{ play_aria_label }}"
    aria-controls="{{ play_button_controls_id }}"
  >
    {% render 'core-icon',
      paths: icon_path_with_shadow,
      class: '[--icon-size:64px] rounded-full fill-content group-focus-visible/play-button:outline group-focus-visible/play-button:outline-2 group-focus-visible/play-button:outline-offset-1 group-focus-visible/play-button:outline-content',
      attributes: icon_attributes
    %}
  </button>
{% endcapture %}

{% if video %}
  {% liquid
    assign loop = loop | default: false
    assign muted = muted | default: false
    assign show_custom_controls = show_custom_controls | default: false
    assign is_product_video = is_product_video | default: false

    if is_product_video
      # Product videos should trigger the intersection only when the whole video is in view
      assign intersect_trigger_modifier = '.full'
    endif

    if preload == true
      if autoplay
        # Let the browser decide; typically it will download enough (or all) of the video to allow smooth playback
        assign video_preload = 'auto'
      else
        # Fetch only the metadata (duration, dimensions, first frame) but not the full video
        assign video_preload = 'metadata'
      endif
    endif

    # Muted failsafe - should always be true or false
    if muted != null and muted != false
      assign muted = true
    endif

    # Autoplay videos must be muted, looped, and play inline
    if autoplay
      assign muted = true
      assign playsinline = 'playsinline'
      assign loop = true
      assign autoplay_modifier = '.autoplay'
    endif

    # Set controls attribute if not explicitly set
    if controls == null
      if show_custom_controls == true or autoplay == true
        assign controls = false
      else
        assign controls = true
      endif
    endif
  %}

  {% capture video_class %}
    relative size-full object-cover
    {{ video_class }}
  {% endcapture %}

  {% capture style %}
    --aspect-ratio: {{ aspect_ratio }};
    {{ style }}
  {% endcapture %}

  <div
    class="aspect-[--aspect-ratio] {{ class }}"
    id="{{ default_video_container_id }}"
    x-video{{ autoplay_modifier }}
    {% if on_load_video %}
      @theme:video:init="{{ on_load_video }}"
    {% endif %}
    style="{{ style }}"
    {{ attributes }}
  >
    <div class="relative h-full overflow-hidden">
      <div
        class="relative h-full bg-black"
        :class="{ '[&>img]:hidden': $video.hidePosterImage }"
      >
        {% render 'core-image',
          cover: cover,
          image: video.preview_image,
          class: 'absolute top-0 left-0 size-full pointer-events-none',
          preload: preload
        %}

        <div
          class="h-full"
          x-intersect.once="$video.handleIntersect()"
          x-intersect:enter{{ intersect_trigger_modifier }}="$video.handleEnter()"
          x-intersect:leave{{ intersect_trigger_modifier }}="$video.handleLeave()"
        >
          <template x-if="$video.shouldRenderVideo">
            {% # poster: nil omits the attribute, since false renders poster="false" and the browser requests /false %}
            {{
              video
              | video_tag:
                id: video_id,
                controls: controls,
                poster: nil,
                preload: video_preload,
                playsinline: playsinline,
                muted: muted,
                loop: loop,
                class: video_class,
                width: width,
                height: height,
                x-ref: 'video'
            }}
          </template>
        </div>

        {% unless autoplay %}
          {{ play_button }}
        {% endunless %}
      </div>
    </div>
  </div>
{% elsif placeholder %}
  {% assign class = class | append: ' aspect-[--aspect-ratio]' %}
  <div
    class="{{ class }}"
    style="--aspect-ratio: {{ aspect_ratio }}; {{ style }}"
    x-data="
      {
        showPlayButton: true,
        handlePlayButtonClick() {}
      }
    "
    {{ attributes }}
  >
    <div class="relative h-full overflow-hidden">
      {% render 'image-placeholder', placeholder: placeholder, class: 'size-full' %}

      {% unless autoplay %}
        {{ play_button }}
      {% endunless %}
    </div>
  </div>
{% endif %}
