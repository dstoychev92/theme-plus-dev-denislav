{% doc %}
  - Renders horizontal card carousel

  Use card-grid when cards stay in a grid at all screen sizes.

  @param {string} [attributes]
  @param {boolean} [autoregister] - false leaves item registration to caller
  @param {string} [class] - The classes
  @param {string} items - rendered card markup
  @param {string} [style] - inline styles
{% enddoc %}

{% liquid
  assign autoregister = autoregister | default: true, allow_false: true
%}

<card-list
  x-carousel:viewport
  x-overflow:viewport
  class="block overflow-clip apply-card-list-vars vars-layout-gutter-card max-w-[--max-width] {{ class }}"
  style="{{ style }}"
  {{ attributes }}
>
  <card-list-track
    {% if autoregister %}
      x-carousel:track.autoregister
      x-overflow:container
    {% else %}
      x-carousel:track
    {% endif %}

    x-eager-load-images

    class="
      {% # No will-change, backface-visibility, or translate3d on the track or its items, since a composited scroll clip rounds away a 1px card border that ends on a fractional pixel %}
      grid min-w-full relative scrollbar-hide h-min
      *:[scroll-snap-align:var(--snap-align)]
      *:auto-set-stagger-order
      overscroll-x-contain snap-x snap-mandatory
      gap-layout px-[--scroll-padding]
      [overflow-x:var(--overflow-x)]
      overflow-y-hidden
      scroll-p-[--scroll-padding]
    "
    style="
      grid-auto-columns: var(--grid-auto-columns);
      grid-auto-flow: var(--grid-auto-flow);
      grid-template-rows: var(--grid-template-rows);
      grid-template-columns: var(--grid-template-columns);
    "
  >
    {{ items }}
  </card-list-track>
</card-list>
