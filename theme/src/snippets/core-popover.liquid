{% doc %}
  - Renders a popover and the button that opens it

  @param {string} [attributes]
  @param {string} button - the rendered trigger
  @param {string} [class] - The classes
  @param {string} content
  @param {string} [float_options] - options passed to the float plugin
  @param {string} [max_width] - popover max width
  @param {number} [offset] - gap from the trigger in pixels
  @param {string} [popover_class] - classes for the popover
  @param {string} [popover_options] - options passed to the popover plugin
  @param {string} [position] - placement relative to the trigger
  @param {boolean} [show_arrow] - renders the pointer arrow
  @param [size] - popover size
  @param {string} [style] - inline styles
{% enddoc %}

{%- liquid
  assign show_arrow = show_arrow | default: true, allow_false: true
  assign size = size | default: 'sm', allow_false: true
  assign position = position | default: 'bottom'
  assign offset = offset | default: 5
  assign max_width = max_width | default: '300px'

  capture popover_class
    case size
      when 'lg'
        echo 'px-r6 py-r4 text-r4'
      when 'sm'
        echo 'px-r5 py-r5 text-r1'
    endcase

    if popover_class
      echo ' ' | append: popover_class
    endif
  endcapture
-%}

<div
  x-popup="{{ popover_options }}"
  class="contents {{ class }}"
  style="{{ style }}"
  {{ attributes }}
>
  {% comment %} Button {% endcomment %}
  {{ button }}

  {% comment %} Panel {% endcomment %}
  <div
    class="
      absolute z-30 rounded-sm bg-[--popover-bg-color] text-content
      shadow ring-1 ring-[color:var(--popover-border-color)]
      w-max no-children-entrance
      {{ popover_class }}
    "
    style="
      max-width: {{ max_width }};
      --popover-bg-color: var(--canvas);
      --popover-border-color: var(--content-alpha-5);
    "
    x-popup:popup.transform3d.{{- position -}}.offset.{{- offset -}}px.flip.shift.update.pad.5px="{{ float_options }}"
    :data-open="$popup.isOpen"
    x-cloak
  >
    {% comment %} Arrow {% endcomment %}
    {% if show_arrow %}
      <div
        x-popup:arrow
        class="
          h-r6 w-r6 overflow-hidden
          before:absolute
          before:left-1/2 before:top-r5
          before:h-r5 before:w-r5 before:-translate-x-1/2 before:rotate-45 before:skew-x-3
          before:skew-y-3 before:bg-[--popover-bg-color] before:shadow before:ring-1
          before:ring-[color:var(--popover-border-color)]
        "
      ></div>
    {% endif %}

    {{ content }}
  </div>
</div>
