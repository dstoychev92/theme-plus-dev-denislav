{% doc %}
  Thin wrapper for props-class-type-preset, defaults to p tag. Can use s or individual properties.

  @param {string} [attributes]
  @param {string} [class]
  @param {string} [default_type_preset]
  @param {string} [s] - settings object
  @param {boolean} [settings_suffix]
  @param {string} [style]
  @param {string} [tag]
  @param {string} [text]
  @param {string} [type_font]
  @param {string} [type_preset]
  @param {string} [type_resize]
  @param {string} [type_size]
  @param {string} [type_uppercase]
{% enddoc %}
{% liquid
  if settings_suffix
    assign id_suffix = settings_suffix | prepend: '_'
  endif

  assign text_id = 'text' | append: id_suffix
  assign text = text | default: s[text_id]

  assign tag = tag | default: 'p'
%}

{% if text != blank %}
  <{{ tag }}
    class="
      {% render 'props-class-type-preset',
        s: s,
        id_suffix: id_suffix,
        settings_suffix: settings_suffix,
        default_type_preset: default_type_preset,
        type_preset: type_preset,
        type_size: type_size,
        type_font: type_font,
        type_resize: type_resize,
        type_uppercase: type_uppercase
      %}
      {{ class }}
    "
    style="{{ style }}"
    {{ attributes }}
  >
    {{ text }}
  </{{ tag }}>
{% endif %}
