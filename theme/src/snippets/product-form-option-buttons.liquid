{% doc %}
  - Renders one product option as text buttons or swatches

  Reads block.settings for the gap. Writes hoverValue into the enclosing Alpine scope, which
  the caller defines. Needs an x-section-api scope for the option links.

  @param {block} [block]
  @param {string} [class] - The classes
  @param {boolean} [history] - replaces the browser URL on selection
  @param {boolean} [is_swatch_option] - renders swatches instead of text buttons
  @param {product_option} option
  @param {string} option_size - suffix for --row-*, 'xs' to 'xl'
  @param {product} product
  @param {string} [swatch_size] - 'xs' to 'xl'
{% enddoc %}

{% liquid
  if is_swatch_option
    assign gap = block.settings.gap_swatch
    assign gap_custom = block.settings.gap_custom_swatch
  else
    assign gap = block.settings.gap_button
    assign gap_custom = block.settings.gap_custom_button
  endif

  # Logic to determine layout mode
  assign longest_value = 0
  assign shortest_value = 100
  assign total_chars = 0

  for value in option.values
    if value.size > longest_value
      assign longest_value = value.size
    endif

    if value.size < shortest_value
      assign shortest_value = value.size
    endif

    assign total_chars = total_chars | plus: value.size
  endfor

  assign layout_mode = 'flex'
  assign compact_grid = false

  unless is_swatch_option
    # Display in grid mode in cases where the values are similar in length and all quite short
    # Otherwise display in flex mode where the values are all different in length and/or are long
    assign chars_diff = longest_value | minus: shortest_value
    if chars_diff < 5 and longest_value < 6
      assign layout_mode = 'grid'

      # When labels are few and very short, drop the wide cell floor so all pills can fit on one row
      assign values_count = option.values.size
      if values_count >= 4 and values_count <= 6 and total_chars <= 12 and longest_value <= 4
        assign compact_grid = true
      endif
    endif
  endunless

  if layout_mode == 'flex'
    assign values_size = option.values.size
    assign cols_desktop_max = values_size | at_most: 4 | at_least: 2
    assign remainder_desktop = values_size | modulo: cols_desktop_max
    if remainder_desktop == 1 and cols_desktop_max > 2
      assign cols_desktop = cols_desktop_max | minus: 1
    else
      assign cols_desktop = cols_desktop_max
    endif
  endif
%}

<ul
  class="
    group w-full justify-content-align gap-layout
    {% if layout_mode == "grid" %}
      grid grid-cols-[--grid-cols]
    {% else %}
      flex flex-row flex-wrap
      [--option-cols:var(--option-cols-mobile)] md:[--option-cols:var(--option-cols-desktop)]
    {% endif %}
    {{ class }}
  "
  style="
    {% render 'props-style-gap', gap: gap, gap_custom: gap_custom %}
    --option-size: var(--row-{{- option_size -}});
    --option-min-width: max(calc(var(--option-size) * 1.25), 4em, calc({{ longest_value }}ch + var(--option-size) / 2));
    {% if gap == 'custom' and gap_custom == 0 %}
      {% comment %}
        Collapsed borders: 0.5px insets on adjacent buttons meet edge-to-edge to
        form shared 1px gridlines; the outset ring on the group matches the perimeter.
      {% endcomment %}
      --radius-btn: 0px;
      --btn-stroke-border-width: 0.5px;
      box-shadow: 0 0 0 0.5px oklch(var(--stain-oklch) / var(--btn-stroke-border-opacity, 100%));
    {% endif %}
    {% if layout_mode == "grid" %}
      {% if compact_grid %}
        {% comment %} auto-fit collapses empty tracks so 4+ pills expand to fill the full row when they fit {% endcomment %}
        --grid-cols: repeat(auto-fit, minmax(var(--option-min-width), 1fr));
      {% else %}
        --grid-cols: repeat(auto-fill, minmax(max(calc(var(--option-size)), calc(6em + 4px)), 1fr));
      {% endif %}
    {% else %}
      --option-cols-mobile: 2;
      --option-cols-desktop: {{ cols_desktop }};
      --option-basis: calc(100% / var(--option-cols) - var(--layout-gutter-x) / var(--option-cols) * (var(--option-cols) - 1));
    {% endif %}
  "
  x-roving-tab
  x-roving-tab:list
  role="toolbar"
  aria-label="{{ option.name | escape_once }}"
  x-preloader.interact.intersect
  x-selection-group
  data-selected-id="{{ option.selected_value.id }}"
  :data-selection-loading="$sectionApi.isDelayedLoading"
>
  {% for value in option.values %}
    {% liquid
      assign available = value.available
    %}

    {%- capture option_url -%}
      {%- render 'product-option-value-url', option: option, product: product, value: value -%}
    {%- endcapture -%}

    {% capture option_item_attributes %}
      data-option-value="{{ value.name | escape_once }}"
      @mouseenter="if (!$media.matches.touch) { hoverValue = $el.dataset.optionValue }"
    {% endcapture %}

    {% capture option_value_attributes %}
      {% if is_swatch_option %}
        data-swatch-control
        :data-swatch-active="$asyncLink.state === 'pending'"
      {% endif %}
      data-preload-url="{{- option_url -}}"
      data-available="{{ available }}"

      {% render 'product-option-value-events', part: 'attributes', product: product, value: value %}
      @link:pending="
        await $yieldToMain();
        {% render 'product-option-value-events', part: 'handler', product: product, value: value %}
      "

      {% comment %} Disable default navigation behaviour of link and instead update the product form via section rendering API when clicked {% endcomment %}
      {% if history %}
        x-section-api:link.replace
      {% else %}
        x-section-api:link.nopush
      {% endif %}

    {% endcapture %}

    {% capture option_title %}{{ value.name }}{% if available == false %} - {{ 'product.accessibility.sold_out_or_unavailable_title' | t }}{% endif %}{% endcapture %}
    {% capture option_label %}{{ value.name }}{% if available == false %} - {{ 'product.accessibility.sold_out_or_unavailable_aria' | t }}{% endif %}{% endcapture %}

    {% if is_swatch_option %}
      <li
        key="{{ value.id }}"
        class="relative group/swatch-link flex-none max-w-full has-[:focus]:z-10"
        role="none"
        {{ option_item_attributes }}
      >
        {% render 'product-option-value-swatch',
          value: value,
          url: option_url,
          available: available,
          selected: value.selected,
          selection_id: value.id,
          focus_key: value.id,
          label: option_label,
          title: option_title,
          size: swatch_size,
          attributes: option_value_attributes
        %}
      </li>
    {% else %}
      <li
        key="{{ value.id }}"
        class="max-w-full basis-[--option-basis]"
        role="none"
        {{ option_item_attributes }}
      >
        <a
          href="{{- option_url -}}"
          data-selection-id="{{ value.id }}"
          data-selection-target
          data-selected="{{ value.selected }}"
          {% comment %} Stable identity for focus restoration across morphs — the aria-label can't serve as one because it mutates with availability {% endcomment %}
          data-preserve-focus-key="{{ value.id }}"
          {% if value.selected %}
            aria-current="true"
          {% endif %}
          title="{{ option_title | escape_once }}"
          aria-label="{{ option_label | escape_once }}"
          {{ option_value_attributes }}
          class="
            product-option-button btn vars-btn-stroke vars-btn-content
            data-[selected=true]:vars-btn-fill
            [&[data-available=false]:not([data-selected=true])]:text-muted
            flex flex-center cursor-pointer whitespace-nowrap
            min-w-[--option-min-width] min-h-[--option-size]
            px-[calc(var(--option-size)/4)] py-r5 max-w-full
            relative z-10 focus-visible:z-30
          "
        >
          {% comment %} Strikethrough {% endcomment %}
          <svg
            role="presentation"
            class="pointer-events-none absolute inset-0 z-20 h-full p-r3 m-auto opacity-0 [[data-available=false]_&]:opacity-100"
            viewBox="0 0 38 38"
          >
            <path
              d="M38 0 L0 38"
              fill="none"
              stroke-width="3"
              vector-effect="non-scaling-stroke"
              stroke-linecap="round"
              class="stroke-canvas [[data-selected=true]_&]:stroke-content"
            />
            <path
              d="M38 0 L0 38"
              fill="none"
              stroke-width="1"
              vector-effect="non-scaling-stroke"
              stroke-linecap="round"
              class="stroke-content [[data-selected=true]_&]:stroke-canvas"
            />
          </svg>
          <span class="truncate">{{- value.name -}}</span>
        </a>
      </li>
    {% endif %}
  {% endfor %}
</ul>

{% comment %}
  Styles for this file live in src/css/product-option-buttons.css. Shopify serves stylesheet-tag CSS per page, and a
  Section API region update drops the inline copy, so the theme bundle must carry these rules.
{% endcomment %}
