{% doc %}
  - Renders extra small card layout

  Title renders as markup, so predictive search highlights survive.

  @param {string} [aria_label] - card aria-label
  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [content] - content replacing title and details
  @param {string} [details] - content below title
  @param {string} [icon] - icon shown without image or media
  @param {image} [image]
  @param [media] - media markup used instead of image, false hides the media box
  @param {string} [style] - inline styles
  @param {string} [title]
  @param [url] - card URL, turns title and media into links
{% enddoc %}

{% liquid
  assign url = url | default: false
  assign tag = 'div'
  assign alt_default = title | strip_html | escape_once
%}

{% if url != false %}
  {% assign tag = 'a' %}
  {% capture href %}href="{{ url }}"{% endcapture %}
{% endif %}

<card-xs
  role="article"
  class="vars-card-xs flex gap-x-r4 w-full [word-break:break-word] {% if url != false %}cursor-pointer{% endif %} {{ class }}"
  style="{{ style }}"
  {% if aria_label %}
    aria-label="{{ aria_label | strip_html | escape_once }}"
  {% endif %}
  {% if url != false %}
    x-link-area data-interactive
  {% endif %}
  {{ attributes }}
>
  {% comment %} Allow media to be hidden when passing 'false' {% endcomment %}
  {% if media != false %}
    <{{ tag }}
      {{ href }}
      class="flex size-r9 shrink-0 flex-center overflow-hidden rounded-[--card-xs-media-radius]"
    >
      {% if media %}
        {{ media }}
      {% elsif image %}
        {%- render 'core-image',
          cover: true,
          image: image,
          alt_default: alt_default,
          sizes: '32px',
          class: 'size-full relative'
        -%}
      {% elsif icon %}
        <div class="flex size-full flex-none flex-center bg-content-mix-5">
          {% render 'core-icon', icon: icon, size: 'md' %}
        </div>
      {% else %}
        {% render 'image-filler', size_class: 'size-full' %}
      {% endif %}
    </{{ tag }}>
  {% endif %}

  <div class="grow flex gap-r4 self-center text-r4">
    {% if content %}
      {{ content }}
    {% else %}
      {%- if title -%}
        {% # title may contain <mark> tags from predictive search highlighting — don't strip_html here %}
        <{{ tag }} {{ href }} class="flex self-center">{{ title }}</{{ tag }}>
      {%- endif -%}

      {%- if details -%}
        <div class="self-start shrink-0 inline-block max-w-1/2 px-r3 py-r1 border border-solid border-line rounded-full text-r3 truncate">
          {{ details }}
        </div>
      {%- endif -%}
    {% endif %}
  </div>
</card-xs>
