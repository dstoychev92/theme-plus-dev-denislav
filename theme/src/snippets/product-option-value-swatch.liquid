{% doc %}
  - Renders one product option value as swatch link

  Falls back to the shopify--color-pattern metaobject matching the value name when value.swatch
  is empty.

  @param {string} [attributes]
  @param {boolean} available
  @param {string} [class] - The classes
  @param {number} [custom_size] - swatch size in pixels
  @param [focus_key] - defaults to selection_id
  @param {string} [label] - defaults to value.name
  @param {boolean} selected
  @param {number} [selection_id] - defaults to value.id
  @param {string} [size] - 'xs' to 'xl'
  @param {string} [swatch_attributes]
  @param {string} [swatch_class]
  @param {string} [title]
  @param {string} url
  @param {product_option_value} value
{% enddoc %}

{% liquid
  assign swatch_object = value.swatch
  if swatch_object == null
    assign swatch_handle = value.name | handleize
    assign swatch_object = metaobjects['shopify--color-pattern'][swatch_handle]
  endif

  assign label = label | default: value.name
  assign selection_id = selection_id | default: value.id
  assign focus_key = focus_key | default: selection_id
%}

{% capture resolved_swatch_attributes %}
  data-selection-target
  role="presentation"
  aria-hidden="true"
  {{ swatch_attributes }}
{% endcapture %}

{% capture content %}
  {% render 'swatch',
    image: swatch_object.image,
    color: swatch_object.color,
    available: available,
    selected: selected,
    size: size,
    custom_size: custom_size,
    class: swatch_class,
    attributes: resolved_swatch_attributes
  %}
{% endcapture %}

{% render 'swatch-link',
  content: content,
  url: url,
  label: label,
  title: title,
  selected: selected,
  selection_id: selection_id,
  focus_key: focus_key,
  class: class,
  attributes: attributes
%}
