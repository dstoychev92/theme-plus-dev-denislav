{% doc %}
  - Renders slider arrows and dots, lines, or counter pagination

  Reads $carousel and $overflow from an enclosing x-carousel and x-overflow scope.

  @param {string} [background_style] - 'bare', 'fill', 'stroke' or 'soft', defaults to settings.slider_control_style when set, then 'bare'
  @param {string} [class] - The classes
  @param {boolean} [hide_arrows] - true renders pagination only, defaults to false
  @param {string} [pagination_style] - 'dots', 'lines' or 'counter', defaults to settings.carousel_pagination_style
{% enddoc %}

{% liquid
  assign slider_control_style = background_style
  unless slider_control_style
    if settings.set_slider_control_style
      assign slider_control_style = settings.slider_control_style
    else
      assign slider_control_style = 'bare'
    endif
  endunless
  assign pagination_style = pagination_style | default: settings.carousel_pagination_style
  assign hide_arrows = hide_arrows | default: false, allow_false: true

  if slider_control_style == 'fill'
    assign indicator_color = 'bg-canvas'
    assign indicator_color_active = '!bg-canvas'
    assign indicator_track = 'bg-canvas-mix-50 opacity-70'
  else
    assign indicator_color = 'bg-content'
    assign indicator_color_active = '!bg-content'
    assign indicator_track = 'bg-content-mix-50 opacity-70'
  endif
%}

{% capture class %}
  {{ class }}
  slider-control vars-btn-content vars-btn-{{ slider_control_style }}
{% endcapture %}

{% capture icon_class %}
  rtl:rotate-180
{% endcapture %}

{% capture prev_button %}
  {% unless hide_arrows %}
    <button
      aria-label="{{ 'other.accessibility.prev' | t }}"
      class="px-r5 transition hover:opacity-50"
      disabled
      :disabled="!$overflow.start"
      :class="
        {
          'opacity-50 hover:bg-transparent': !$overflow.start,
          'opacity-100': $overflow.start
        }
      "
      x-carousel:prev
    >
      {% render 'core-icon', icon: 'stroke-chevron-left', class: icon_class %}
    </button>
  {% endunless %}
{% endcapture %}

{% capture next_button %}
  {% unless hide_arrows %}
    <button
      aria-label="{{ 'other.accessibility.next' | t }}"
      class="px-r5 transition hover:opacity-50"
      :disabled="!$overflow.end"
      :class="
        {
          'opacity-50 hover:bg-transparent': !$overflow.end,
          'opacity-100': $overflow.end
        }
      "
      x-carousel:next
    >
      {% render 'core-icon', icon: 'stroke-chevron-right', class: icon_class %}
    </button>
  {% endunless %}
{% endcapture %}

{% liquid
  if pagination_style == 'dots' or pagination_style == 'lines'
    assign container_flex_class = 'flex items-center'
  else
    assign container_flex_class = 'flex'
  endif
%}

<div
  class="
    {% if hide_arrows %}
      {{ container_flex_class }} justify-center
    {% else %}
      {{ container_flex_class }}
    {% endif %}
    min-h-row-sm rounded-pill mt-r4 text-r2
    {{ class }}
  "
  :class="
    {
      'opacity-0': $carousel.isEnabled == false,
    }
  "
  x-cloak
  x-transition.opacity
  x-show="$carousel.items.length > 1"
>
  {{ prev_button }}

  {% case pagination_style %}
    {% when 'dots' %}
      <div
        class="
          flex items-center gap-x-r5 rounded-pill h-row-sm py-r3
          {% if hide_arrows %}px-r6{% endif %}
          {% unless hide_arrows %}{% else %}justify-center{% endunless %}
        "
        role="presentation"
      >
        <template x-for="(_, index) in $carousel.items.length">
          <div
            class="rounded-full size-r2 {{ indicator_track }} opacity-70 transition-opacity duration-400"
            :key="index"
            :class="
              {
                '{{ indicator_color_active }} !opacity-100': $carousel.centeredIndex == index,
              }
            "
          ></div>
        </template>
      </div>
    {% when 'lines' %}
      <div
        class="
          flex items-center gap-x-r1 rounded-pill h-row-sm py-r3
          {% if hide_arrows %}px-r6{% endif %}
          {% unless hide_arrows %}{% else %}justify-center{% endunless %}
        "
        role="presentation"
        x-data="
          {
            lastCenteredIndex: null,
            init() {
              this.$watch('$carousel.centeredIndex', (centeredIndex, previousCenteredIndex) => {
                this.lastCenteredIndex = previousCenteredIndex
              })
            }
          }
        "
        :data-prev-centered-index="lastCenteredIndex"
        :data-current-centered-index="$carousel.centeredIndex"
      >
        <template x-for="(_, index) in $carousel.items.length">
          <button
            class="relative rounded-sm w-r9 h-r1 hit-area-y-r5"
            @click="$carousel.scrollTo(index)"
            :aria-label="index + 1"
            :key="index"
            x-data="
              {
                get wasLastItem() {
                  return lastCenteredIndex == index;
                },
                get isCurrentItem() {
                  return $carousel.centeredIndex == index;
                },
                get goingRight() {
                  return lastCenteredIndex < $carousel.centeredIndex;
                },
                get goingLeft() {
                  return lastCenteredIndex > $carousel.centeredIndex;
                },
              }
            "
          >
            {% comment %} Background {% endcomment %}
            <span class="block size-full absolute top-0 left-0 {{ indicator_track }}"> </span>
            {% comment %} Active segment {% endcomment %}
            <span
              class="relative block h-full {{ indicator_color }} scale-x-0 transition-none"
              :class="
                {
                  '!scale-x-100': isCurrentItem,
                  'origin-right !transition !duration-200': wasLastItem && goingRight,
                  'origin-left !transition !duration-200': wasLastItem && goingLeft,
                  'origin-right !transition !scale-x-100 !duration-200': isCurrentItem && goingLeft,
                  'origin-left !transition !scale-x-100 !duration-200': isCurrentItem && goingRight
                }
              "
            ></span>
          </button>
        </template>
      </div>
    {% else %}
      <div aria-live="polite" class="self-center flex items-baseline gap-x-r2 {% if hide_arrows %}px-r5{% endif %}">
        <span class="font-family-body font-bold" x-text="$carousel.centeredIndex + 1">1</span>
        <span class="font-family-body italic opacity-70">
          {{- 'product.gallery.index_indicator_separator' | t -}}
        </span>
        <span class="font-family-body font-bold" x-text="$carousel.items.length">1</span>
      </div>
  {% endcase %}

  {{ next_button }}
</div>
