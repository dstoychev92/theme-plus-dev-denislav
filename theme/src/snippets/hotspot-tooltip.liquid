{% doc %}
  - Renders positioned hotspot dot with its popover tooltip

  Render it inside hotspots, which provides the $hotspots scope and the hotspotsContainerEl ref.

  @param {string} [attributes] - attributes for the dot button
  @param {block} [block]
  @param {string} [class] - The classes
  @param {string} content
  @param {object} [s] - settings object
  @param {section} [section]
  @param {string} [style] - inline styles
{% enddoc %}

{% capture wrapper_attributes %}
  x-init="$hotspots.register($el)"

  x-data="{
    get index() {
      return $hotspots.indexOf($el)
    },
    get isSelected() {
      return $hotspots.isSelected(this.index)
    },
    set isSelected(value) {
      if (value) {
        $hotspots.select(this.index)
      } else if ($hotspots.isSelected(this.index)) {
        $hotspots.deselect(this.index)
      }
    },
  }"

  {% if request.design_mode %}
    @shopify:block:select="isSelected = true"
    @shopify:block:deselect="isSelected = false"
  {% endif %}
{% endcapture %}

{% capture dot_attributes %}
  id="{{section.id}}-{{ block.id }}-hotspot"
  x-custom-cursor:snap-point
  x-popup:button
  :aria-selected="isSelected"
  aria-label="{{ 'other.accessibility.hotspot' | t }}"

  @click.stop.prevent="isSelected = true;"
  x-hover:start="isSelected = true"
  x-hover:end="isSelected = false"

  {{ attributes }}
{% endcapture %}

{% capture float_options %}
  {
    get rootBoundary() {
      return $refs.hotspotsContainerEl
    }
  }
{% endcapture %}

{% capture dot %}
  <div
    class="{% render 'props-class-float', s: s %}"
    style="{% render 'props-style-float', s: s, z_index: 10 %}"
  >
    {% render 'hotspot-dot',
      attributes: dot_attributes,
      class: 'cursor-[initial]'
    %}
  </div>
{% endcapture %}

{% capture popover_attributes %}
  {{ wrapper_attributes }}
{% endcapture %}

{% capture popover_options %}
  {
    get isOpen() {
      return isSelected
    },
    set isOpen(value) {
      isSelected = value
    }
  }
{% endcapture %}

{% render 'core-popover',
  button: dot,
  content: content,
  class: class,
  style: style,
  popover_options: popover_options,
  float_options: float_options,
  attributes: popover_attributes
%}
