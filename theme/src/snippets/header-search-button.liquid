{% doc %}
  - Renders search button and its predictive search flyout

  @param {block} [block]
  @param {string} [button_class] - classes for the button
  @param {string} [class] - The classes
  @param {string} [icon_type_class] - classes for the icon
  @param {string} [id] - base for the search form id, built from the section, target device, and block when absent
  @param {string} [label_style] - 'icon', 'text', or 'both', defaults to s.label_style
  @param {object} [s] - settings object
  @param {section} [section]
  @param {string} [target_device] - 'mobile' or 'desktop', defaults to s.target_device
{% enddoc %}

{% liquid
  assign target_device = target_device | default: s.target_device
  assign default_id = section.id | append: '-' | append: target_device | append: '-' | append: block.id | append: '-predictive-search-flyout'
  assign id = id | default: default_id
  assign search_form_id = id | append: '-form'
  assign search_content = 'search.header_label' | t
  assign button_attributes = 'x-popover:button'
  assign label_style = label_style | default: s.label_style
%}

{% capture class %}
  h-full flex items-center
  {% render 'props-class-target-device', target_device: target_device %}
  {{ class }}
{% endcapture %}

{% capture button_class %}
  keyboard-focus:outline-offset-[-2px] hit-area-x-[calc(var(--header-row-gap-x)/2)]
  focus-group-item
  {{ button_class }}
{% endcapture %}

<div
  class="{{ class }}"
  x-popover
  {% comment %}
    When this button is device-gated (desktop-only or mobile-only), the other viewport still
    renders the markup. Skip Alpine there; on the viewport that shows it, start immediately
    so the first tap is not waiting on a dead popover.
  {% endcomment %}
  {% if target_device == 'desktop' or target_device == 'mobile' %}
    data-lazy-alpine="{{ target_device }}"
    data-lazy-alpine-on="immediate"
  {% endif %}
>
  {% render 'header-link',
    aria_label: search_content,
    href: routes.search_url,
    label: search_content,
    icon: 'stroke-header-search',
    class: button_class,
    attributes: button_attributes,
    s: s,
    label_style: label_style,
    icon_type_class: icon_type_class
  %}

  {% comment %} Full height flyout on mobile, but auto height on desktop {% endcomment %}
  {% render 'predictive-search-flyout',
    menu_id: id,
    search_form_id: search_form_id,
    color_scheme: section.settings.color_scheme
  %}
</div>
