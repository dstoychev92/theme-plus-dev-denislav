{% doc %}
  - Renders generated stroke or fill icon

  Add a 24x24 SVG to icons/stroke or icons/fill, then run pnpm svg.

  @param {string} [attr] - unused
  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [icon] - family and name, such as 'stroke-chevron-right'
  @param {string} [paths] - SVG paths used instead of icon name
  @param {string} [size] - 'xs', 'sm', 'md', 'lg', or 'xl'
  @param {string} [stroke_weight] - 'light', 'regular' or 'bold'
  @param {string} [stroke_width_custom] - CSS length overriding grade and complexity rules
  @param {string} [style] - inline styles
  @param {string} [svg_class] - classes for SVG element
  @param {string} [viewbox] - SVG viewBox, defaults to '0 0 24 24'
  @param {string} [width] - CSS value for --icon-width
{% enddoc %}

{%- liquid
  assign viewbox = viewbox | default: '0 0 24 24'
  assign attr = attr | default: ''
  assign icon = icon | strip
-%}

{% capture class %}
  w-icon block

  {% if size %}
    {% case size %}
      {% when 'xs' %}
        vars-icon-size-xs
      {% when 'sm' %}
        vars-icon-size-sm
      {% when 'md' %}
        vars-icon-size-md
      {% when 'lg' %}
        vars-icon-size-lg
      {% when 'xl' %}
        vars-icon-size-xl
    {% endcase %}
  {% endif %}

  {% if stroke_weight %}
    {% case stroke_weight %}
      {% when 'light' %}
        vars-icon-grade-light
      {% when 'regular' %}
        vars-icon-grade-regular
      {% when 'bold' %}
        vars-icon-grade-bold
    {% endcase %}
  {% endif %}

  {{ class }}
{% endcapture %}

{% capture style %}
  {% if width != blank %}
    --icon-width: {{ width }};
  {% endif %}

  {% if stroke_width_custom != blank %}
    --icon-stroke-width: {{ stroke_width_custom }};
  {% endif %}

  {{ style }}
{% endcapture %}

{% capture svg_class %}

  {% # Use the icon names to set up the color classes and the types that we loop over %}
  {% if icon contains 'fill-' %}
    icon-fill
  {% endif %}

  {% if icon contains 'stroke-' %}
    icon-stroke

    {% if icon contains 'art-' or icon contains 'header-' %}
      icon-stroke-complexity-high
    {% elsif icon contains 'arrow-' or icon contains 'bare-' or icon contains 'chevron-' %}
      icon-stroke-complexity-low
    {% else %}
      icon-stroke-complexity-medium
    {% endif %}
  {% endif %}

  {{ svg_class }}
{% endcapture %}

{% unless paths %}
  {%- capture paths -%}
    {%- case icon -%}
      [% render 'icons-autogenerated/fill-paths' %]
      [% render 'icons-autogenerated/stroke-paths' %]
      {%- else -%}
        Missing icon: {{ icon }}
    {%- endcase -%}
  {%- endcapture -%}
{% endunless %}

<span
  class="{{ class }}"
  style="{{ style }}"
  {{ attributes }}
>
  <span class="block @container">
    <svg
      viewBox="{{ viewbox }}"
      aria-hidden="true"
      data-icon="{{ icon }}"
      class="icon icon-{{ icon }} {{ svg_class }}"
    >
      {{ paths }}
    </svg>
  </span>
</span>
