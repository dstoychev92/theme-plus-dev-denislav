{% doc %}
  - Renders gap, with optional divider line, between toolbar items

  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {object} [s] - settings object
  @param {boolean} [show_line] - renders the divider line, defaults to s.show_line then false
  @param {number} [spacer_end] - end gap in pixels when spacer_x is not set, defaults to s.spacer_end
  @param {number} [spacer_start] - start gap in pixels when spacer_x is not set, defaults to s.spacer_start
  @param {number} [spacer_x] - total gap in pixels, split evenly on both sides, defaults to s.spacer_x
  @param {string} [style] - inline styles
{% enddoc %}

{% liquid
  assign show_line = show_line | default: s.show_line | default: false, allow_false: true

  assign spacer_x = spacer_x | default: s.spacer_x, allow_false: true
  assign spacer_start = spacer_start | default: s.spacer_start, allow_false: true
  assign spacer_end = spacer_end | default: s.spacer_end, allow_false: true
%}

{% capture style %}
  {%- if spacer_x -%}
    --spacer-ps:{{- spacer_x | divided_by: 2 -}}px;
    --spacer-pe:{{- spacer_x | divided_by: 2 -}}px;
  {% else %}
    --spacer-ps:{%- if spacer_start == false or spacer_start == 0 -%}0{%- else -%}{{- spacer_start -}}px{%- endif -%};
    --spacer-pe:{%- if spacer_end == false or spacer_end == 0 -%}0{%- else -%}{{- spacer_end -}}px{%- endif -%};
  {%- endif -%}
  padding-inline-start: calc(var(--spacer-ps) * var(--r-multiplier));
  padding-inline-end: calc(var(--spacer-pe) * var(--r-multiplier));
  {{ style }}
{% endcapture %}

<div
  class="flex flex-center h-full {{ class | strip }}"
  style="{{ style | strip }}"
  {{ attributes }}
>
  {%- if show_line -%}
    <div class="flex-1 h-1/2 min-h-[1em] w-px bg-line"></div>
  {%- endif -%}
</div>
