{% doc %}
  - Renders selling plan price with compare-at, discount, and unit price

  Prints nothing unless the plan lowers the variant price.

  @param {boolean} [has_subscription_discount] - plan carries a discount
  @param {product} product
  @param {object} [s] - settings object
  @param {selling_plan} [selected_selling_plan]
  @param {variant} [variant] - price source, defaults to product.selected_or_first_available_variant
{% enddoc %}

{%- liquid
  assign variant = variant | default: product.selected_or_first_available_variant
  assign show_compare_at_price = s.show_compare_at_price | default: true, allow_false: true
  assign show_discount_amount = s.show_discount_amount | default: true, allow_false: true

  # Initialize plan_discount_amount to avoid undefined variable bug
  assign plan_discount_amount = 0
-%}

{% if has_subscription_discount and selected_selling_plan and variant != blank %}
  {%- liquid
    # Calculate subscription discount against variant.price
    assign compare_at_price = variant.price
    assign price_adjustment = selected_selling_plan.price_adjustments[0]
    case price_adjustment.value_type
      when 'percentage'
        assign plan_discount_amount = variant.price | times: price_adjustment.value | divided_by: 100
        assign price = variant.price | minus: plan_discount_amount
      when 'fixed_amount'
        assign plan_discount_amount = price_adjustment.value
        assign price = variant.price | minus: plan_discount_amount
      when 'price'
        assign price = price_adjustment.value
        assign plan_discount_amount = variant.price | minus: price
    endcase

    assign price_style = 'color: var(--sale-color);'
    assign unit_price = variant.unit_price
  -%}

  {% if plan_discount_amount > 0 and price < variant.price %}
    {% # Only show if the subscription offers a discount below variant.price %}
    <subscription-price
      class="flex-row-center flex-wrap gap-r6 justify-content-align"
      aria-live="polite"
    >
      {% comment %} Price {% endcomment %}
      <span data-test-id="subscription-price">
        {% if price == 0 %}
          {% capture price_content %}
            {{ 'other.free' | t }}
          {% endcapture %}
        {% elsif price %}
          {% capture price_content %}
            {% render 'money', price: price, style: price_style %}
          {% endcapture %}
        {% endif %}

        {% render 'core-text-preset', s: s, tag: 'div', text: price_content %}
      </span>

      {% comment %} Strike through compare-at price {% endcomment %}
      {% if show_compare_at_price %}
        <span
          class="line-through text-muted font-normal"
          data-test-id="product-compare-price"
        >
          <span class="sr-only">{{ 'product.accessibility.item_on_sale_compare_at' | t }}</span>
          {% capture compare_at_price_content %}
            {% render 'money', price: compare_at_price, show_currency: false %}
          {% endcapture %}
          {% render 'core-text-preset', s: s, tag: 'div', text: compare_at_price_content %}
        </span>
      {% endif %}

      {% if show_discount_amount %}
        {% assign discount_text = null %}

        {% if price_adjustment.value_type == 'percentage' %}
          {% assign discount_text = price_adjustment.value | floor | append: '%' %}
        {% endif %}

        {% if price_adjustment.value_type == 'fixed_amount' or price_adjustment.value_type == 'price' %}
          {%- capture discount_text -%}
            {% render 'money', price: plan_discount_amount, show_currency: false %}
          {%- endcapture -%}
        {% endif %}

        {% if discount_text %}
          {% assign translation = 'product.discount_amount_html' | t: amount: discount_text %}
          {% render 'core-text-preset',
            s: s,
            tag: 'div',
            text: translation,
            type_resize: 'xs',
            class: 'text-[color:var(--sale-color)]'
          %}
        {% endif %}
      {% endif %}

      {% comment %} Subscription discounts are always labeled {% endcomment %}
      {% assign sale_label = 'product.subscription' | t %}
      {% render 'core-text-preset',
        s: s,
        tag: 'div',
        text: sale_label,
        type_resize: 'xs',
        class: 'text-[color:var(--sale-color)]'
      %}

      {% if unit_price != blank %}
        {% capture unit_price_content %}
          {%- render 'price-per-unit', product: product, variant: variant, ignore_selling_plan: false -%}
        {% endcapture %}
        {% assign unit_price_size = s.type_size | minus: 3 | at_least: 1 %}
        {% render 'core-text-preset',
          s: s,
          tag: 'div',
          text: unit_price_content,
          class: 'flex items-center text-muted',
          type_font: 'badge',
          type_resize: 'xs',
          type_size: unit_price_size
        %}
      {% endif %}
    </subscription-price>
  {% endif %}
{% endif %}
