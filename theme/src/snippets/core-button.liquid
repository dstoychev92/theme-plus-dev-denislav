<!-- [autocomment] -->

{% doc %}
  - Renders button, link, or labeled input with color, appearance, and size variables

  content replaces the start icon, label, and end icon. Tag 'input' renders a visually hidden
  input with a label that holds the content.

  @param {string} [appearance] - 'fill', 'stroke', 'soft', 'bare', or 'none', defaults to s.appearance, then 'fill'
  @param {string} [aria_label]
  @param {string} [attributes]
  @param {boolean} [checked]
  @param {string} [class] - The classes
  @param {string} [color] - vars-btn-* suffix such as 'primary' or 'content', or 'custom' or 'custom_gradient', defaults to s.color, then 'primary'
  @param {string} [color_custom] - CSS color when color is 'custom', defaults to s.color_custom
  @param {string} [content] - rendered markup
  @param {string} [custom_gradient_from] - defaults to s.custom_gradient_from
  @param {string} [custom_gradient_to] - defaults to s.custom_gradient_to
  @param {boolean} [disabled]
  @param {string} [end_icon] - core-icon name after the label
  @param {string} [end_icon_class] - classes for the end icon
  @param {string} [form]
  @param {string} [height] - vars-btn-height-* suffix, replaced by sizing when set_width is on
  @param {boolean} [hide_label_on_mobile] - hides the label on mobile so only the icons show. It stays in the accessible name, so pair it with a start_icon or end_icon
  @param {string} [hover_effect] - 'glow' or false, defaults to 'glow'
  @param {string} [href] - defaults to s.href
  @param {string} [icon] - start_icon fallback
  @param {string} [icon_size] - core-icon size for both icons
  @param {string} [id]
  @param {string} [label] - defaults to s.text
  @param {string} [label_attributes] - attributes for the label span
  @param {string} [label_class] - classes for the label span
  @param {string} [label_style] - inline styles for the label span
  @param {string} [name]
  @param {boolean} [new_window] - opens href in a new tab, defaults to s.open_in_new_window
  @param {string} [role]
  @param [rounding] - vars-btn-rounding-* suffix, defaults to s.rounding_style when s.set_rounding is on
  @param {object} [s] - settings object
  @param {boolean} [set_width] - applies width_unit, width_px, and width_percent, defaults to s.set_width, then false
  @param {string} [settings_suffix] - suffix picking a settings group for props-class-type-preset
  @param {string} [sizing] - vars-btn-* size suffix such as 'sm', defaults to s.sizing, then 'md'
  @param {string} [start_icon] - core-icon name before the label, defaults to icon
  @param {string} [start_icon_class] - classes for the start icon
  @param {string} [tag] - 'button', 'a', or 'input', defaults to 'button'
  @param {string} [text_color] - defaults to s.text_color
  @param {string} [title]
  @param {string} [type] - type attribute for 'button' and 'input', defaults to 'button'
  @param {string} [type_font]
  @param {string} [type_preset]
  @param {string} [type_resize]
  @param {string} [type_size]
  @param {boolean} [type_uppercase]
  @param {string} [value]
  @param {number} [width_percent] - min-width percent when width_unit is 'percent', defaults to s.width_percent
  @param {number} [width_px] - min-width in pixels when width_unit is 'pixel', defaults to s.width_px
  @param {string} [width_unit] - 'pixel' or 'percent', defaults to s.width_unit
  @param {boolean} [wrap] - lets the label wrap, defaults to false
{% enddoc %}
{% liquid
  assign type = type | default: 'button'
  assign label = label | default: s.text
  assign color = color | default: s.color, allow_false: true | default: 'primary', allow_false: true
  assign color_custom = color_custom | default: s.color_custom
  assign text_color = text_color | default: s.text_color
  assign custom_gradient_from = custom_gradient_from | default: s.custom_gradient_from
  assign custom_gradient_to = custom_gradient_to | default: s.custom_gradient_to
  assign appearance = appearance | default: s.appearance, allow_false: true | default: 'fill', allow_false: true
  assign href = href | default: s.href
  assign new_window = new_window | default: s.open_in_new_window | default: null

  assign hover_effect = hover_effect | default: 'glow', allow_false: true

  # width settings
  assign sizing = sizing | default: s.sizing, allow_false: true | default: 'md', allow_false: true

  assign set_width = set_width | default: s.set_width | default: false

  if set_width
    # if width is set, pass sizing into height instead
    assign height = sizing | default: 'md'
    assign sizing = false

    assign width_unit = width_unit | default: s.width_unit
    assign width_px = width_px | default: s.width_px
    assign width_percent = width_percent | default: s.width_percent
  endif

  if set_width and width_unit == 'percent' and width_percent == 100
    assign flex_class = 'flex'
  else
    assign flex_class = 'inline-flex'
  endif

  if s.set_rounding
    assign rounding = rounding | default: s.rounding_style
  endif

  assign start_icon = start_icon | default: icon | default: false
  assign end_icon = end_icon | default: false

  assign tag = tag | default: 'button'
  assign wrap = wrap | default: false

  assign hide_label_on_mobile = hide_label_on_mobile | default: false
%}

{% capture style %}
  {% if set_width %}
    {% if width_unit == 'pixel' %}
      min-width: {{ width_px }}px;
      max-width: max-content;
    {% elsif width_unit == 'percent' %}
      min-width: {{ width_percent }}%;
    {% endif %}
  {% endif %}
  {% render 'props-style-button-color',
    color: color,
    color_custom: color_custom,
    text_color: text_color,
    custom_gradient_from: custom_gradient_from,
    custom_gradient_to: custom_gradient_to,
    appearance: appearance
  %}
{% endcapture %}

{% capture class %}
  {% render 'props-class-type-preset',
    default_type_preset: 'btn',
    settings_suffix: settings_suffix,
    s: s,
    type_preset: type_preset,
    type_size: type_size,
    type_font: type_font,
    type_resize: type_resize,
    type_uppercase: type_uppercase
  %}

  {% if sizing %}
    vars-btn-{{ sizing }}
  {% endif %}
  {% if color and color != 'custom' and color != 'custom_gradient' %}
    vars-btn-{{ color }}
  {% endif %}
  {% if height %}
    vars-btn-height-{{ height }}
  {% endif %}
  {% if rounding %}
    vars-btn-rounding-{{ rounding }}
  {% endif %}
  {% if appearance %}
    vars-btn-{{ appearance }}
  {% endif %}
  {{ flex_class }}
  {% if hover_effect == 'glow' %}hover-effect-bg-highlight{% endif %}
  {% if appearance == 'fill' and color == 'custom_gradient' %}btn-gradient{% endif %}
  {% unless wrap %}whitespace-nowrap{% endunless %}
  {{ class }}

  {% comment %} Button bg color, text color, and border color are all parameterized with dependent classes like vars-btn-fill, vars-btn-primary, etc responsible for setting appropriate variables {% endcomment %}
  btn group disabled:opacity-50 has-[:disabled]:opacity-50 flex-center gap-x-r4 select-none relative *:pointer-events-none hover-effect-target
{% endcapture %}

{% capture attributes %}
  {% if aria_label %}
    aria-label="{{ aria_label }}"
  {% endif %}
  {% if name %}
    name="{{ name }}"
  {% endif %}
  {% if value %}
    value="{{ value }}"
  {% endif %}
  {% if title %}
    title="{{ title }}"
  {% endif %}
  {% if checked %}
    checked
  {% endif %}
  {% if disabled %}
    disabled
  {% endif %}
  {% if style %}
    style="{{ style }}"
  {% endif %}
  x-cursor-position
  {% if appearance == 'fill' and color == 'custom_gradient' %}x-gradient-follow{% endif %}
  data-hide-custom-cursor
  {{ attributes }}
{% endcapture %}

{% capture label_content %}
  <span
    {% comment %}
      max-md:!sr-only rather than max-md:hidden since a screen reader still needs the label,
      and !important because sr-only's own position/size lose to the base classes here
    {% endcomment %}
    class="z-10 relative flex flex-center h-[--btn-height] pointer-events-none ty-type-center {% if hide_label_on_mobile %}max-md:!sr-only{% endif %} {{ label_class }}"
    {% if label_style %}
      style="{{ label_style }}"
    {% endif %}
    {% if label_attributes %}
      {{ label_attributes }}
    {% endif %}
  >
    {% if hover_effect == 'glow' %}
      <span aria-hidden="true" class="z-10 absolute inset-0 flex flex-center h-full pointer-events-none ty-type-center hover-effect-text-highlight">
        {{ label }}
      </span>
    {% endif %}
    {{ label }}
  </span>
{% endcapture %}

{% liquid
  if content == null
    capture content
      if start_icon != blank
        assign start_icon_class = start_icon_class | append: ' shrink-0'
        render 'core-icon', icon: start_icon, class: start_icon_class, size: icon_size
      endif
      if label != blank
        echo label_content
      endif
      if end_icon != blank
        assign end_icon_class = end_icon_class | append: ' shrink-0'
        render 'core-icon', icon: end_icon, class: end_icon_class, size: icon_size
      endif
    endcapture
  endif
%}

{% case tag %}
  {% when 'button' %}
    <button
      type="{{ type }}"
      {% if id %}
        id="{{ id }}"
      {% endif %}
      {% if form %}
        form="{{ form }}"
      {% endif %}
      {% if role and role != 'button' %}
        role="{{ role }}"
      {% endif %}
      class="{{ class }}"
      {{ attributes }}
    >
      {{ content }}
    </button>
  {% when 'a' %}
    <a
      href="{{ href }}"
      {% if new_window %}
        target="_blank"
        rel="noopener"
      {% endif %}
      class="cursor-pointer {{ class }}"
      {% if id %}
        id="{{ id }}"
      {% endif %}
      {% if role %}
        role="{{ role }}"
      {% endif %}
      {{ attributes }}
    >
      {{ content }}

      {% if new_window %}
        <span class="sr-only">, {{ 'other.accessibility.opens_in_new_tab' | t }}</span>
      {% endif %}
    </a>
  {% when 'input' %}
    {% assign dynamic_id = id | default: name | default: 'button' %}
    <div
      class="relative {{ class }}"
      x-id="['{{ dynamic_id }}']"
    >
      <input
        type="{{ type }}"
        class="sr-only"
        {% if role %}
          role="{{ role }}"
        {% endif %}
        {% if form %}
          form="{{ form }}"
        {% endif %}
        {% if id %}
          id="{{ id }}"
        {% endif %}
        :id="$id('{{ dynamic_id }}')"
        {{ attributes }}
      >
      <label
        class="cursor-pointer after:absolute after:inset-0"
        {% if id %}
          for="{{ id }}"
        {% endif %}
        :for="$id('{{ dynamic_id }}')"
        tabindex="0"
        {% comment %} click() instead of setting checked since a bare property write fires no change event and cannot uncheck a checkbox {% endcomment %}
        @keydown.space.prevent="$el.previousElementSibling.click()"
        @keydown.enter.prevent="$el.previousElementSibling.click()"
      >
        {{ content }}
      </label>
    </div>
{% endcase %}
