{% doc %}
  - Renders one image on a large product card

  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [fetchpriority]
  @param {image} image
  @param {string} [image_class] - classes for loading placeholder
  @param {string} [image_sizes] - defaults to image-grid-sizes
  @param {string} [image_widths] - defaults to image-grid-widths
  @param {string} [loading] - 'lazy' adds the loading placeholder
  @param {boolean} [placeholder] - renders the loading placeholder under a lazy image, defaults to true
  @param {product} [product] - product.title is the fallback alt text
{% enddoc %}

{%- liquid
  if placeholder == blank
    assign placeholder = true
  endif

  assign cover = false

  case settings.product_card_image_fit
    when 'scale'
      assign cover = false
    when 'crop'
      assign cover = true
    when 'uneven'
      assign cover = true
  endcase
-%}

{%- liquid
  if image_sizes == blank
    capture image_sizes
      render 'image-grid-sizes'
    endcapture
  endif
  if image_widths == blank
    capture image_widths
      render 'image-grid-widths'
    endcapture
  endif
-%}

<div
  class="{{ class }}"
  data-test-id="product-card-image"
  {{ attributes }}
>
  {% comment %} alt_default ensures the alt attribute exists; the wrapping product link's aria-label is the real accessible name. {% endcomment %}
  {% render 'core-image',
    cover: cover,
    image: image,
    alt_default: product.title,
    sizes: image_sizes,
    widths: image_widths,
    class: 'size-full relative z-10',
    x-ref: 'productCardImage',
    loading: loading,
    fetchpriority: fetchpriority
  %}

  {% if placeholder and loading == 'lazy' %}
    {% render 'image-loading-placeholder',
      cover: cover,
      image: image,
      wrapper_class: 'absolute inset-0 z-0 size-full',
      class: image_class
    %}
  {% endif %}
</div>
