        <path d="M6.196 2.5c-.54 0-1.058.215-1.44.597l-2.16 2.16a2.036 2.036 0 0 0 0 2.88l1.562 1.56L6.96 12.5 3.6 15.86l-1.004 1.004a2.035 2.035 0 0 0 0 2.88l2.16 2.16a2.037 2.037 0 0 0 2.88 0L12 17.54l4.364 4.364a2.037 2.037 0 0 0 2.88 0l2.16-2.16a2.04 2.04 0 0 0 0-2.88L17.04 12.5l4.364-4.364a2.037 2.037 0 0 0 0-2.88l-2.16-2.16a2.036 2.036 0 0 0-2.88 0L12 7.46 7.636 3.097a2.04 2.04 0 0 0-1.44-.596"/>


        {%- else -%}
          Missing icon: {{ icon }}
      {%- endcase -%}
    {% endcapture %}

    {% capture icon_attributes %}
      filter="url(#video-button-dropshadow-{{- id -}})"
    {% endcapture %}

    {% render 'core-icon',
      paths: icon_path_with_shadow,
      class: '[--icon-size:--btn-height] fill-btn transition',
      attributes: icon_attributes
    %}
  </a>

  {% capture content_class %}
    {% comment %}
      "!bg-transparent" fixes a bug where an extra 1px background might appear at the bottom of the video on weird screen sizes,
      because we use aspect-ratio to properly size the video and it isn't always a nice number. We don't want that 1px to be visible
    {% endcomment %}
    !bg-transparent !shadow-none
    aspect-[--aspect-ratio] h-full justify-center
    [--dialog-width:auto] [--dialog-max-width:100%] [--dialog-padding:0]
  {% endcapture %}

  <template x-teleport="body">
    {% render 'dialog',
      modal: true,
      content: video_content,
      scrollable: false,
      content_class: content_class,
      content_style: content_style
    %}
  </template>
</div>
