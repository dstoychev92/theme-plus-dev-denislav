{% doc %}
  - Renders style tags with the color scheme custom properties

  @param {string} [scheme_classes] - CSS placed before the generated scheme class rules
  @param {string} [scheme_vars] - custom properties placed before the generated scheme variables
{% enddoc %}

<!-- Color -->

{% liquid
  assign mix_names = '5,10,20,30,40,50' | split: ','
  assign mixes_light_mode = '3,8,20,30,40,50' | split: ','
  assign mixes_dark_mode = '23,24.5,26.9,30.3,45,50' | split: ','
  assign scheme_class_names = ''
%}

{% for scheme in settings.color_scheme_group %}
  {% liquid
    assign is_dark_color_scheme = false

    if scheme.settings.color_canvas.lightness < 50
      assign is_dark_color_scheme = true
    endif

    # Dark mode color mixes are slightly different
    # to create deeper blacks on LCD screens
    assign mix_blends = mixes_light_mode

    if is_dark_color_scheme
      assign mix_blends = mixes_dark_mode
    endif

    # Transparent header muted alpha: when the header is transparent, muted text
    # (e.g. toolbar countdown labels) becomes semi-transparent content color instead.
    # Alpha is the lightness ratio of muted vs content, boosted 1.3x for legibility.
    assign content_distance = scheme.settings.color_content.lightness | minus: scheme.settings.color_canvas.lightness | plus: 0.0
    assign transparent_muted_alpha = scheme.settings.color_muted.lightness | minus: scheme.settings.color_canvas.lightness | times: 1.3 | divided_by: content_distance | at_least: 0.5 | at_most: 1.0 | round: 2
  %}

  {%- capture scheme_class_names -%}
    {{ scheme_class_names }} .vars-{{ scheme.id }},
  {%- endcapture -%}

  {% capture scheme_classes %}
    {{ scheme_classes }}
    .vars-{{ scheme.id }} {
      {% render 'head-color-scheme-class-vars', scheme_id: scheme.id %}
    }

    {% if scheme.settings.color_canvas.rgb == '255 255 255' %}
      .vars-{{ scheme.id }} .vars-btn-fill.vars-btn-canvas {
        --btn-text-hover-color: var(--primary);
      }
    {% else %}
      .vars-{{ scheme.id }} .vars-btn-fill.vars-btn-canvas {
        --btn-text-hover-color: inherit;
      }
    {% endif %}

    {% if scheme.settings.color_content.rgb == '255 255 255' %}
      .vars-{{ scheme.id }} .vars-btn-fill.vars-btn-content {
        --btn-text-hover-color: var(--primary);
      }
    {% else %}
      .vars-{{ scheme.id }} .vars-btn-fill.vars-btn-content {
        --btn-text-hover-color: inherit;
      }
    {% endif %}
  {% endcapture %}

  {%- capture scheme_vars -%}
    {{- scheme_vars -}}
    {%- render 'head-color-scheme-color-vars', scheme_id: scheme.id, color_name: 'canvas', color: scheme.settings.color_canvas, contrast_color: scheme.settings.color_content -%}
    {%- render 'head-color-scheme-color-vars', scheme_id: scheme.id, color_name: 'content', color: scheme.settings.color_content, contrast_color: scheme.settings.color_canvas -%}
    {%- render 'head-color-scheme-color-vars', scheme_id: scheme.id, color_name: 'primary', color: scheme.settings.color_primary, contrast_color: scheme.settings.color_primary_contrast -%}
    {%- render 'head-color-scheme-color-vars', scheme_id: scheme.id, color_name: 'secondary', color: scheme.settings.color_secondary, contrast_color: scheme.settings.color_canvas -%}
    {%- render 'head-color-scheme-color-vars', scheme_id: scheme.id, color_name: 'muted', color: scheme.settings.color_muted, contrast_color: scheme.settings.color_canvas -%}
    {%- render 'head-color-scheme-color-vars', scheme_id: scheme.id, color_name: 'sale', color: scheme.settings.color_sale, contrast_color: scheme.settings.color_canvas -%}

    --{{ scheme.id }}-shadow-oklch: {{ scheme.settings.color_content.oklch }};
    --{{ scheme.id }}-shadow-fallback: {{ scheme.settings.color_content.rgb }};

    {% if is_dark_color_scheme %}
      --{{ scheme.id }}-shadow-oklch: 0% 0 0;
      --{{ scheme.id }}-shadow-fallback: 0 0 0;
    {% endif %}

    {%- for mix_name in mix_names -%}
    --{{ scheme.id }}-mix-{{ mix_name }}: {{ mix_blends[forloop.index0] }}%;
    {%- if scheme == settings.color_scheme_light -%}
    --scheme-light-mix-{{ mix_name }}: var(--{{ scheme.id }}-mix-{{ mix_name }});
    {%- endif %}
    {%- if scheme == settings.color_scheme_dark -%}
    --scheme-dark-mix-{{ mix_name }}: var(--{{ scheme.id }}-mix-{{ mix_name }});
    {%- endif %}
    {%- endfor -%}

    {%- if scheme == settings.color_scheme_light %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-light', color_name: 'canvas', color: scheme.settings.color_canvas, contrast_color: scheme.settings.color_content %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-light', color_name: 'content', color: scheme.settings.color_content, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-light', color_name: 'primary', color: scheme.settings.color_primary, contrast_color: scheme.settings.color_primary_contrast %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-light', color_name: 'secondary', color: scheme.settings.color_secondary, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-light', color_name: 'muted', color: scheme.settings.color_muted, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-light', color_name: 'sale', color: scheme.settings.color_sale, contrast_color: scheme.settings.color_canvas %}
    --scheme-light-shadow-oklch: var(--{{ scheme.id }}-shadow-oklch);
    --scheme-light-shadow-fallback: var(--{{ scheme.id }}-shadow-fallback);
    --scheme-light-muted-alpha: var(--{{ scheme.id }}-muted-alpha);
    --scheme-light-line-alpha-subtle: {{ mix_blends[1] | divided_by: 100.0  }};
    --scheme-light-line-alpha: {{ mix_blends[2] | divided_by: 100.0 }};
    --scheme-light-line-alpha-bold:{{ mix_blends[3] | divided_by: 100.0 }};
    {% endif %}

    {%- if scheme == settings.color_scheme_dark %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-dark', color_name: 'canvas', color: scheme.settings.color_canvas, contrast_color: scheme.settings.color_content %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-dark', color_name: 'content', color: scheme.settings.color_content, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-dark', color_name: 'primary', color: scheme.settings.color_primary, contrast_color: scheme.settings.color_primary_contrast %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-dark', color_name: 'secondary', color: scheme.settings.color_secondary, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-dark', color_name: 'muted', color: scheme.settings.color_muted, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-dark', color_name: 'sale', color: scheme.settings.color_sale, contrast_color: scheme.settings.color_canvas %}
    --scheme-dark-shadow-oklch: var(--{{ scheme.id }}-shadow-oklch);
    --scheme-dark-shadow-fallback: var(--{{ scheme.id }}-shadow-fallback);
    --scheme-dark-muted-alpha: var(--{{ scheme.id }}-muted-alpha);
    --scheme-dark-line-alpha-subtle: {{ mix_blends[1] | divided_by: 100.0  }};
    --scheme-dark-line-alpha: {{ mix_blends[2] | divided_by: 100.0 }};
    --scheme-dark-line-alpha-bold:{{ mix_blends[3] | divided_by: 100.0 }};
    {% endif %}

    {%- if scheme == settings.color_scheme_error %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-error', color_name: 'canvas', color: scheme.settings.color_canvas, contrast_color: scheme.settings.color_content %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-error', color_name: 'content', color: scheme.settings.color_content, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-error', color_name: 'primary', color: scheme.settings.color_primary, contrast_color: scheme.settings.color_primary_contrast %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-error', color_name: 'secondary', color: scheme.settings.color_secondary, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-error', color_name: 'muted', color: scheme.settings.color_muted, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-error', color_name: 'sale', color: scheme.settings.color_sale, contrast_color: scheme.settings.color_canvas %}
    --scheme-error-shadow-oklch: var(--{{ scheme.id }}-shadow-oklch);
    --scheme-error-shadow-fallback: var(--{{ scheme.id }}-shadow-fallback);
    {% endif %}

    {%- if scheme == settings.color_scheme_success %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-success', color_name: 'canvas', color: scheme.settings.color_canvas, contrast_color: scheme.settings.color_content %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-success', color_name: 'content', color: scheme.settings.color_content, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-success', color_name: 'primary', color: scheme.settings.color_primary, contrast_color: scheme.settings.color_primary_contrast %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-success', color_name: 'secondary', color: scheme.settings.color_secondary, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-success', color_name: 'muted', color: scheme.settings.color_muted, contrast_color: scheme.settings.color_canvas %}
    {% render 'head-color-scheme-color-vars', scheme_id: 'scheme-success', color_name: 'sale', color: scheme.settings.color_sale, contrast_color: scheme.settings.color_canvas %}
    --scheme-success-shadow-oklch: var(--{{ scheme.id }}-shadow-oklch);
    --scheme-success-shadow-fallback: var(--{{ scheme.id }}-shadow-fallback);
    {% endif %}

    --{{ scheme.id }}-muted-alpha: {{ transparent_muted_alpha }};
    --{{ scheme.id }}-line-alpha-subtle: {{ mix_blends[1] | divided_by: 100.0  }};
    --{{ scheme.id }}-line-alpha: {{ mix_blends[2] | divided_by: 100.0 }};
    --{{ scheme.id }}-line-alpha-bold:{{ mix_blends[3] | divided_by: 100.0 }};

  {%- endcapture -%}
{% endfor %}

{% style %}
  :root {
    /* Scheme color vars */
    {{ scheme_vars }}

    /* Black & white color vars */
    --black-oklch: 0% 0 0;
    --black: oklch(var(--black-oklch));
    --black-contrast-oklch: 100% 0 0;
    --black-contrast: oklch(var(--black-contrast-oklch));
    --white-oklch: 100% 0 0;
    --white-contrast-oklch: 0% 0 0;
    --white: oklch(var(--white-oklch));
    --white-contrast: oklch(var(--white-contrast-oklch));

    --error-oklch: var(--scheme-error-primary-oklch);
    --error: oklch(var(--error-oklch));
    --error-contrast-oklch: var(--scheme-error-primary-contrast-oklch);
    --error-contrast: oklch(var(--error-contrast-oklch));
    --success-oklch: var(--scheme-success-primary-oklch);
    --success: oklch(var(--success-oklch));
    --success-contrast-oklch: var(--scheme-success-primary-contrast-oklch);
    --success-contrast: oklch(var(--success-contrast-oklch));

    {% comment %} Root-level color defaults {% endcomment %}
    --badge-bg-color-card: {{ settings.card_badge_color_bg }};
    --badge-text-color-card: {{ settings.card_badge_color_text }};

    /* oklch-fallback */
    --black-fallback: 0 0 0;
    --black-contrast-fallback: 255 255 255;
    --white-fallback: 255 255 255;
    --white-contrast-fallback: 0 0 0;
    --error-fallback: var(--scheme-error-primary-fallback);
    --error-contrast-fallback: var(--scheme-error-primary-contrast-fallback);
    --success-fallback: var(--scheme-success-primary-fallback);
    --success-contrast-fallback: var(--scheme-success-primary-contrast-fallback);
  }
{% endstyle %}

{% style %}
  {{ scheme_classes }}

  {% capture success_scheme_classes %}
    .vars-scheme-success, .vars-scheme-success-if-valid:has(*:user-valid), .vars-scheme-success-if-valid:user-valid
  {% endcapture %}

  {% capture error_scheme_classes %}
    .vars-scheme-error, .vars-scheme-error-if-invalid:has(*:user-invalid:not(:placeholder-shown)), .vars-scheme-error-if-invalid:user-invalid:not(:placeholder-shown)
  {% endcapture %}

  {{ success_scheme_classes }} {
    {% render 'head-color-scheme-class-vars', scheme_id: 'scheme-success' %}
  }
  {{ error_scheme_classes }} {
    {% render 'head-color-scheme-class-vars', scheme_id: 'scheme-error' %}
  }

  {% comment %}
    Limited set of helper vars for use in non-tailwind CSS, expand as needed.
    Solid colors only. For alpha mixes, use the unwrapped oklch values.
  {% endcomment %}
  .vars-scheme-light, .vars-scheme-dark, {{ error_scheme_classes }}, {{ success_scheme_classes }}, {{- scheme_class_names | replace_last: ',', '' }} {
    --content: oklch(var(--content-oklch));
    --canvas: oklch(var(--canvas-oklch));
    --primary: oklch(var(--primary-oklch));
    --primary-contrast: oklch(var(--primary-contrast-oklch));
    --secondary: oklch(var(--secondary-oklch));
    --content-mix-5: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-5,5%), oklch(var(--canvas-oklch)));
    --content-mix-10: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-10,10%), oklch(var(--canvas-oklch)));
    --content-mix-20: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-20,20%), oklch(var(--canvas-oklch)));
    --content-mix-30: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-30,30%), oklch(var(--canvas-oklch)));
    --content-mix-40: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-40,40%), oklch(var(--canvas-oklch)));
    --content-mix-50: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-50,50%), oklch(var(--canvas-oklch)));
    --content-mix-60: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-60,60%), oklch(var(--canvas-oklch)));
    --content-mix-70: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-70,70%), oklch(var(--canvas-oklch)));
    --content-mix-80: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-80,80%), oklch(var(--canvas-oklch)));
    --content-mix-90: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-90,90%), oklch(var(--canvas-oklch)));
    --content-mix-95: color-mix(in oklch, oklch(var(--content-oklch)) var(--mix-95,95%), oklch(var(--canvas-oklch)));

    --focus-outline-color: var(--content);

    --muted: oklch(var(--muted-oklch));
    --muted-subtle: color-mix(in oklch, oklch(var(--muted-oklch)) var(--mix-50, 50%), oklch(var(--content-oklch)));

    --sale: oklch(var(--sale-oklch));

    --line-subtle: color-mix(in oklch, oklch(var(--content-oklch)) calc(var(--line-alpha-subtle) * 100%), oklch(var(--canvas-oklch)));
    --line: color-mix(in oklch, oklch(var(--content-oklch)) calc(var(--line-alpha) * 100%), oklch(var(--canvas-oklch)));
    --line-bold: color-mix(in oklch, oklch(var(--content-oklch)) calc(var(--line-alpha-bold) * 100%), oklch(var(--canvas-oklch)));

    {% comment %} Alpha tokens — use instead of inline oklch(var(--X-oklch) / N%) {% endcomment %}
    --content-alpha-3: oklch(var(--content-oklch) / 3%);
    --content-alpha-5: oklch(var(--content-oklch) / 5%);
    --content-alpha-10: oklch(var(--content-oklch) / 10%);
    --content-alpha-20: oklch(var(--content-oklch) / 20%);
    --content-alpha-50: oklch(var(--content-oklch) / 50%);
    --canvas-alpha-20: oklch(var(--canvas-oklch) / 20%);
    --canvas-alpha-30: oklch(var(--canvas-oklch) / 30%);

    {% comment %} Scheme-level color defaults {% endcomment %}
    --badge-text-color: var(--content);
    --badge-bg-color: var(--content-mix-10);

    --sale-color: var(--sale);
    --sale-color-bg: color-mix(in oklch, oklch(var(--sale-oklch)) var(--mix-10, 10%), oklch(var(--canvas-oklch)));
  }

  /* oklch-fallback */
  @supports not (color: oklch(0% 0 0)) {
    :root {
      --black: rgb(var(--black-fallback));
      --black-contrast: rgb(var(--black-contrast-fallback));
      --white: rgb(var(--white-fallback));
      --white-contrast: rgb(var(--white-contrast-fallback));
      --error: rgb(var(--error-fallback));
      --error-contrast: rgb(var(--error-contrast-fallback));
      --success: rgb(var(--success-fallback));
      --success-contrast: rgb(var(--success-contrast-fallback));
    }
    .vars-scheme-light, .vars-scheme-dark, {{ error_scheme_classes }}, {{ success_scheme_classes }}, {{- scheme_class_names | replace_last: ',', '' }} {
      --content: rgb(var(--content-fallback));
      --canvas: rgb(var(--canvas-fallback));
      --primary: rgb(var(--primary-fallback));
      --primary-contrast: rgb(var(--primary-contrast-fallback));
      --secondary: rgb(var(--secondary-fallback));
      --content-mix-5: rgb(var(--content-fallback) / var(--mix-5, 5%));
      --content-mix-10: rgb(var(--content-fallback) / var(--mix-10, 10%));
      --content-mix-20: rgb(var(--content-fallback) / var(--mix-20, 20%));
      --content-mix-30: rgb(var(--content-fallback) / var(--mix-30, 30%));
      --content-mix-40: rgb(var(--content-fallback) / var(--mix-40, 40%));
      --content-mix-50: rgb(var(--content-fallback) / var(--mix-50, 50%));
      --content-mix-60: rgb(var(--content-fallback) / var(--mix-60, 60%));
      --content-mix-70: rgb(var(--content-fallback) / var(--mix-70, 70%));
      --content-mix-80: rgb(var(--content-fallback) / var(--mix-80, 80%));
      --content-mix-90: rgb(var(--content-fallback) / var(--mix-90, 90%));
      --content-mix-95: rgb(var(--content-fallback) / var(--mix-95, 95%));
      --muted: rgb(var(--muted-fallback));
      --muted-subtle: rgb(var(--muted-fallback));
      --sale: rgb(var(--sale-fallback));
      --sale-color: rgb(var(--sale-fallback));
      --sale-color-bg: rgb(var(--sale-fallback) / var(--mix-10, 10%));
      --line-subtle: rgb(var(--content-fallback) / var(--line-alpha-subtle));
      --line: rgb(var(--content-fallback) / var(--line-alpha));
      --line-bold: rgb(var(--content-fallback) / var(--line-alpha-bold));
      --content-alpha-3: rgb(var(--content-fallback) / 3%);
      --content-alpha-5: rgb(var(--content-fallback) / 5%);
      --content-alpha-10: rgb(var(--content-fallback) / 10%);
      --content-alpha-20: rgb(var(--content-fallback) / 20%);
      --content-alpha-50: rgb(var(--content-fallback) / 50%);
      --canvas-alpha-20: rgb(var(--canvas-fallback) / 20%);
      --canvas-alpha-30: rgb(var(--canvas-fallback) / 30%);
    }
  }
{% endstyle %}
