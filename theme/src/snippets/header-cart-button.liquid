{% doc %}
  - Renders header cart link with item count

  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [icon_type_class] - classes for the icon
  @param {string} [label_style] - 'icon', 'text' or 'both', defaults to s.label_style
  @param {object} [s] - settings object
  @param {section} [section]
{% enddoc %}

{% liquid
  assign label_style = label_style | default: s.label_style
  assign display_count = cart.item_count
  assign button_label = 'cart.view_cart' | t

  assign is_cart_page = false

  if routes.cart_url == request.path
    assign is_cart_page = true
  endif

  if cart.item_count >= 100
    assign display_count = '99+'
  endif
%}

{% capture action_attributes %}
  {% case settings.cart_button_action %}
    {% when "show_drawer" %}
      {% unless is_cart_page %}
        role="button"
        @click.stop.prevent="$dispatch('theme:cart-drawer:open', { type: 'drawer' })"
        aria-haspopup="dialog"
        :aria-expanded="$store.drawer.isOpen && $store.drawer.type === 'cart'"
      {% endunless %}
    {% when "navigate_page" %}
  {% endcase %}
{% endcapture %}

{% capture badge %}
  {% case label_style %}
    {% when 'both' %}
      {% if cart.item_count > 0 %}
        ({{ display_count }})
      {% endif %}
    {% when 'text' %}
      {% if cart.item_count > 0 %}
        ({{ display_count }})
      {% endif %}
    {% when 'icon' %}
      {% if cart.item_count > 0 %}
        {% assign class = class | append: ' [--color-cart-indicator:theme(colors.primary.DEFAULT)]' %}
      {% endif %}
  {% endcase %}
{% endcapture %}

{% capture class %}
  keyboard-focus:outline-offset-[-2px]
  focus-group-item hit-area-x-[calc(var(--header-row-gap-x)/2)] {{ class }}
  {% if cart.item_count > 0 %}
    [--color-cart-indicator:theme(colors.primary.DEFAULT)]
  {% endif %}

  {% case settings.cart_button_action %}
    {% when "show_drawer" %}
      {% unless is_cart_page %}
        transition-opacity duration-200
        aria-expanded:opacity-25
      {% endunless %}
    {% when "navigate_page" %}
  {% endcase %}
{% endcapture %}

{% capture content %}
  {%- if label_style != 'icon' -%}
    {{"cart.title" | t}}
  {% endif %}
  {{ badge }}
{% endcapture %}

{% capture attributes %}
  id="header-cart-button-{{ section.id }}"
  x-init="window.headerCartButton = $el"

  {{ action_attributes }}
  {{ attributes }}
{% endcapture %}

{%- capture cart_icon -%}
  stroke-header-{{- settings.cart_icon -}}
{%- endcapture -%}

{% render 'header-link',
  href: routes.cart_url,
  icon: cart_icon,
  s: s,
  label: content,
  aria_label: button_label,
  class: class,
  attributes: attributes,
  icon_type_class: icon_type_class
%}
