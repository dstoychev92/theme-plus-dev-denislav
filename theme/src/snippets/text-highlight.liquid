{% doc %}
  - Renders highlighted text

  @param {boolean} [animate] - false skips the wipe-in animation, defaults to true
  @param {string} [appearance] - 'full', 'partial' or 'underline', defaults to s.highlight_appearance, then 'full'
  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [color] - highlight color, defaults to s.highlight_color, then 'transparent'
  @param {object} [s] - settings object
  @param {string} [style] - inline styles
  @param {string} text
{% enddoc %}

{% liquid
  assign text = text | strip
  assign appearance = appearance | default: s.highlight_appearance | default: 'full'
  assign color = color | default: s.highlight_color | default: 'transparent'
  assign animate = animate | default: true, allow_false: true
%}

<span
  class="
    {{ class }}
    {% if animate %}
       animate-highlight-wipe-in
       !paused intersected:!running
    {% endif %}

    {% case appearance -%}
      {% when 'full' -%}
        highlight
      {% when 'partial' -%}
        highlight-partial
      {% when 'underline' -%}
        highlight-underline
    {%- endcase -%}
  "
  style="
    {{ style }}
    --highlight-color: {{ color }};
  "
  {{ attributes }}
>
  {{- text | strip -}}
</span>
