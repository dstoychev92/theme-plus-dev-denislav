{% doc %}
  - Renders color or image swatch

  Selection and availability render through data-selected, data-available, and data-shape. Bind
  data-selected through attributes when selection changes after load.

  @param {string} [attributes]
  @param {boolean} [available] - false uses unavailable mask, defaults to true
  @param {string} [class] - The classes
  @param {string} [color] - CSS color. Near-black and near-white values adjust for visibility
  @param {number} [custom_size] - size in pixels, overrides size
  @param {image} [image] - image used instead of color
  @param {boolean} [selected] - true uses selected mask, defaults to false
  @param {string} [shape] - 'circle' or 'square', defaults to settings.swatch_shape, then 'circle'
  @param [size] - 'xs', 'sm', 'md', 'lg' or 'xl', or false to skip --swatch-size, defaults to 'xs'
  @param {string} [svg_attributes] - attributes for SVG element
{% enddoc %}

{% comment %} Sanitize color value to standard hex output for reliable contrast filters {% endcomment %}
{% assign swatch_brightness = color | color_brightness %}
{% capture color %}{{color}}{% endcapture %}

{% liquid
  assign size = size | default: 'xs', allow_false: true
  assign shape = shape | default: settings.swatch_shape | default: 'circle'

  if available == null
    assign available = true
  endif

  if selected == null
    assign selected = false
  endif

  # Check swatch color contrast against black and white and adjust if necessary
  # TODO use CSS color-contrast() function once widely available
  # https://developer.mozilla.org/en-US/docs/Web/CSS/color_value/color-contrast

  assign black_contrast = color | color_contrast: '#000000'
  assign white_contrast = color | color_contrast: '#FFFFFF'

  if black_contrast <= 1.0
    # Adjust black swatches to a dark grey in case background is black
    assign color = color | color_lighten: 20
  elsif white_contrast <= 1.0
    # Adjust white swatches to a light grey in case background is white
    assign color = color | color_darken: 10
  endif

  assign swatch_pending_contrast_color = '#FFFFFF'
  assign swatch_pending_contrast_percentage = 50
  if color != blank
    if swatch_brightness > 128
      assign swatch_pending_contrast_color = '#000000'
      assign swatch_pending_contrast_percentage = 70
    endif
  endif

  if size == 'xs'
    assign swatch_size = 'var(--row-xs)'
  elsif size == 'sm'
    assign swatch_size = 'var(--row-sm)'
  elsif size == 'md'
    assign swatch_size = 'var(--row-md)'
  elsif size == 'lg'
    assign swatch_size = 'var(--row-lg)'
  elsif size == 'xl'
    assign swatch_size = 'var(--row-xl)'
  endif

  if custom_size != blank
    assign swatch_size = custom_size | append: 'px'
  endif
%}

<span
  style="
    {% if image %}
      --swatch-pending-color: rgb(0 0 0 / 0.4);
      {% if color != blank %}
        --swatch-color: {{ color }};
      {% endif %}
    {% elsif color != blank %}
      --swatch-color: {{ color }};
      --swatch-pending-color: color-mix(in oklch, var(--swatch-color) {{ swatch_pending_contrast_percentage }}%, {{ swatch_pending_contrast_color }});
    {% else %}
      --swatch-pending-color: rgb(0 0 0 / 0.5);
    {% endif %}
    {% if size %}
      --swatch-size: var(--swatch-force-size, {{ swatch_size }});
    {% endif %}
  "
  data-test-id="swatch"
  {% comment %}
    transform-gpu forces Safari onto a composite layer so the swatch pixel-snaps at whole-pixel boundaries;
    without it, sub-pixel y-positioning inflates the SVG content bounding box and the mask clips top/bottom of the shape.
  {% endcomment %}
  class="swatch group/swatch block size-[--swatch-size] transform-gpu transition-[filter] {{ class }}"
  data-selected="{{ selected }}"
  data-available="{{ available }}"
  data-color="{{ color }}"
  data-shape="{{ shape }}"
  {{ attributes }}
>
  {% assign viewbox_size = 38 %}
  {% capture swatch_content %}
    {% if image %}
      {% comment %} Image swatch, with placeholder {% endcomment %}
      <image href="{{ image | image_url: width: 2 }}" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" />
      <image href="{{ image | image_url: width: 120 }}" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" />
    {% else %}
      <rect x="0" y="0" width="100%" height="100%" stroke-width="0" class="stroke-none fill-[--swatch-color]" />
    {% endif %}
  {% endcapture %}
  <svg
    class="size-full"
    viewBox="0 0 {{ viewbox_size }} {{ viewbox_size }}"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    {{ svg_attributes }}
  >
    <g class="swatch-selection-ring" aria-hidden="true">{{ swatch_content }}</g>
    <g class="swatch-content">{{ swatch_content }}</g>

    {% comment %}
      These strokes sit directly over the selected swatch's outer band. Animating stroke-dashoffset
      moves the highlight around either perimeter without rotating the square itself.
    {% endcomment %}
    <g
      class="swatch-pending-ring"
      data-swatch-pending-shape="{{ shape }}"
      aria-hidden="true"
      fill="none"
      stroke="var(--swatch-pending-color)"
      stroke-width="2.8"
    >
      {% if shape == 'square' %}
        <rect data-swatch-pending-track x="1.4" y="1.4" width="35.2" height="35.2" />
        <rect data-swatch-pending-trail x="1.4" y="1.4" width="35.2" height="35.2" pathLength="100" />
      {% else %}
        <circle data-swatch-pending-track cx="19" cy="19" r="17.6" />
        <circle data-swatch-pending-trail cx="19" cy="19" r="17.6" pathLength="100" />
      {% endif %}
    </g>
  </svg>
</span>

{% comment %}
  Styles for this file live in src/css/swatch.css. Shopify serves stylesheet-tag CSS per page, and a
  Section API region update drops the inline copy, so the theme bundle must carry these rules.
{% endcomment %}
