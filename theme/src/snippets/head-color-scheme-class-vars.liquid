{% doc %}
  - Prints the scheme variables one color scheme class sets

  @param {string} [scheme_id] - id of the scheme the variables point at
{% enddoc %}

--canvas-oklch: var(--{{ scheme_id }}-canvas-oklch);
--canvas-contrast-oklch: var(--{{ scheme_id }}-canvas-contrast-oklch);

--content-oklch: var(--{{ scheme_id }}-content-oklch);
--content-contrast-oklch: var(--{{ scheme_id }}-content-contrast-oklch);

--shadow-oklch: var(--{{ scheme_id }}-shadow-oklch);

--muted-oklch: var(--{{ scheme_id }}-muted-oklch);
--muted-contrast-oklch: var(--{{ scheme_id }}-muted-contrast-oklch);
--muted-alpha: var(--{{ scheme_id }}-muted-alpha);

--primary-oklch: var(--{{ scheme_id }}-primary-oklch);
--primary-contrast-oklch: var(--{{ scheme_id }}-primary-contrast-oklch);

--secondary-oklch: var(--{{ scheme_id }}-secondary-oklch);
--secondary-contrast-oklch: var(--{{ scheme_id }}-secondary-contrast-oklch);

--sale-oklch: var(--{{ scheme_id }}-sale-oklch);
--sale-contrast-oklch: var(--{{ scheme_id }}-sale-contrast-oklch);

--mix-5: var(--{{ scheme_id }}-mix-5);
--mix-10: var(--{{ scheme_id }}-mix-10);
--mix-20: var(--{{ scheme_id }}-mix-20);
--mix-30: var(--{{ scheme_id }}-mix-30);
--mix-40: var(--{{ scheme_id }}-mix-40);
--mix-50: var(--{{ scheme_id }}-mix-50);
--mix-60: var(--{{ scheme_id }}-mix-60);
--mix-70: var(--{{ scheme_id }}-mix-70);
--mix-80: var(--{{ scheme_id }}-mix-80);
--mix-90: var(--{{ scheme_id }}-mix-90);
--mix-95: var(--{{ scheme_id }}-mix-95);

--line-alpha-subtle: var(--{{ scheme_id }}-line-alpha-subtle);
--line-alpha: var(--{{ scheme_id }}-line-alpha);
--line-alpha-bold: var(--{{ scheme_id }}-line-alpha-bold);

/* oklch-fallback */
--canvas-fallback: var(--{{ scheme_id }}-canvas-fallback);
--canvas-contrast-fallback: var(--{{ scheme_id }}-canvas-contrast-fallback);
--content-fallback: var(--{{ scheme_id }}-content-fallback);
--content-contrast-fallback: var(--{{ scheme_id }}-content-contrast-fallback);
--shadow-fallback: var(--{{ scheme_id }}-shadow-fallback);
--muted-fallback: var(--{{ scheme_id }}-muted-fallback);
--muted-contrast-fallback: var(--{{ scheme_id }}-muted-contrast-fallback);
--primary-fallback: var(--{{ scheme_id }}-primary-fallback);
--primary-contrast-fallback: var(--{{ scheme_id }}-primary-contrast-fallback);
--secondary-fallback: var(--{{ scheme_id }}-secondary-fallback);
--secondary-contrast-fallback: var(--{{ scheme_id }}-secondary-contrast-fallback);
--sale-fallback: var(--{{ scheme_id }}-sale-fallback);
--sale-contrast-fallback: var(--{{ scheme_id }}-sale-contrast-fallback);
