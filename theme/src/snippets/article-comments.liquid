{% doc %}
  - Renders the article comment list and its form

  @param {article} [article]
  @param {comment} [comment]
{% enddoc %}

<div>
  {% assign comment_form_id = 'comment-form-' | append: article.id %}
  {% assign comment_date_format = 'other.date_formats.month_day_year_at_time' | t %}

  {% paginate article.comments by 5 %}
    {% if article.comments_count > 0 %}
      <div
        class="flex flex-col gap-y-r8"
        x-ref="paginationResults"
        @theme:section:navigate.window="
          if ($event.detail.sectionId != '{{ section.id }}') return
          await $yieldToMain()
          $scrollIntoView()
        "
      >
        <h3 class="type-h3">{{ 'blog.comments.comments_with_count' | t: count: article.comments_count }}</h3>

        {% for existing_comment in article.comments %}
          {% assign comment_datetime = existing_comment.created_at | date: '%Y-%m-%dT%H:%M:%S%:z' %}
          {% assign comment_display_date = existing_comment.created_at | date: comment_date_format %}

          <div class="flex flex-col gap-r5">
            <div>
              <p class="type-h6">{{ existing_comment.author }}</p>
              <time class="block text-r2 text-muted" datetime="{{ comment_datetime }}">
                {{- comment_display_date -}}
              </time>
            </div>

            <div class="text-r4">{{ existing_comment.content }}</div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        {% render 'pagination', paginate: paginate, class: 'pt-r8 w-full' %}
      {% endif %}

      <hr class="border-line-subtle {% if paginate.pages > 1 %}mt-r6{% else %}mt-r10{% endif %} mb-r10">
    {% endif %}

    <div class="flex flex-col gap-y-r8">
      <div>
        <h3 class="type-h3">{{ 'blog.comments.title' | t }}</h3>

        {% if blog.moderated? %}
          <p class="mt-r2 text-r5">{{ 'blog.comments.moderated' | t }}</p>
        {% endif %}
      </div>

      {% form 'new_comment', article, class: 'flex flex-col gap-layout-gutter' %}
        {% assign status_message_class = 'bg-content/5 p-r5 text-r2 text-content' %}

        {%- if form.errors -%}
          <div class="vars-scheme-error {{ status_message_class }}" role="alert">
            <span>{{ 'other.form.error_heading' | t }}</span>

            <ul class="list-disc pl-r5">
              {%- for field in form.errors -%}
                {%- assign error_field_id = comment_form_id | append: '-' | append: field -%}
                <li>
                  <a href="#{{ error_field_id }}" class="text-r2 link-line">
                    {% case field %}
                      {% when 'author' %}
                        {{ 'blog.comments.name' | t }}
                      {% when 'body' %}
                        {{ 'blog.comments.comment' | t }}
                      {% else %}
                        {{ form.errors.translated_fields[field] | capitalize }}
                    {% endcase %}

                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif form.posted_successfully? -%}
          {% assign post_message = 'blog.comments.success' | t %}
          {% if blog.moderated? and comment.status == 'unapproved' %}
            {% assign post_message = 'blog.comments.success_moderated' | t %}
          {% endif %}

          <div class="vars-scheme-success {{ status_message_class }}" role="status" aria-live="polite">
            <p>{{ post_message }}</p>
          </div>
        {%- endif -%}

        <div class="grid grid-cols-1 gap-layout-gutter md:grid-cols-2">
          {%- liquid
            assign field_name_id = comment_form_id | append: '-author'
            assign field_email_id = comment_form_id | append: '-email'

            assign field_name_label = 'blog.comments.name' | t
            assign field_name_error = ''
            assign field_email_label = 'blog.comments.email' | t
            assign field_email_error = ''

            if form.errors contains 'author'
              assign field_name_error = field_name_label | append: ' ' | append: form.errors.messages.author | append: '.'
            endif

            if form.errors contains 'email'
              assign field_email_error = field_email_label | append: ' ' | append: form.errors.messages.email | append: '.'
            endif
          %}

          {% capture field_name_attributes %}
            autocomplete="name"
            aria-required="true"
            required
          {% endcapture %}

          {% capture field_email_attributes %}
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            required
          {% endcapture %}

          {%- render 'field-input',
            id: field_name_id,
            label: field_name_label,
            name: 'comment[author]',
            value: form.author,
            input_attributes: field_name_attributes,
            error_message: field_name_error
          -%}

          {%- render 'field-input',
            id: field_email_id,
            label: field_email_label,
            type: 'email',
            name: 'comment[email]',
            value: form.email,
            input_attributes: field_email_attributes,
            error_message: field_email_error
          -%}
        </div>

        {% liquid
          assign field_body_id = comment_form_id | append: '-body'
          assign field_body_label = 'blog.comments.comment' | t
          assign field_body_error = ''

          if form.errors contains 'body'
            assign field_body_error = field_body_label | append: ' ' | append: form.errors.messages.body | append: '.'
          endif
        %}

        {% capture field_body_attributes %}
          rows="8"
          aria-required="true"
          x-submittable-textarea
          required
        {% endcapture %}

        {% render 'field-textarea',
          id: field_body_id,
          label: field_body_label,
          name: 'comment[body]',
          value: form.body,
          input_attributes: field_body_attributes,
          error_message: field_body_error
        %}

        {% assign submit_value = 'blog.comments.post' | t %}
        {% render 'core-button',
          type: 'submit',
          id: 'comment-submit',
          sizing: 'sm',
          appearance: 'fill',
          color: 'primary',
          label: submit_value,
          class: 'self-start'
        %}

        <div class="text-r1 text-muted link-line-all">
          {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
        </div>
      {% endform %}
    </div>
  {% endpaginate %}
</div>
