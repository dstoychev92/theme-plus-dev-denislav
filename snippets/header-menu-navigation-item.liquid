{%- liquid
  if megamenu_placeholder and request.design_mode
    assign placeholder = true
    assign menu_id = 'placeholder'
    assign menu_item_label = ''
  else
    assign menu_id = link.title | downcase | strip_html | escape | handleize
    assign menu_item_label = link.title | strip_html | escape
  endif

  assign link_label = menu_item_label
  assign menu_label = 'header.accessibility.menu_item' | t: label: menu_item_label
  assign has_sub_links = false

  # Globally unique identifier for this particular menu for this particular link
  # This allows the same custom megamenu to be registered to multiple header links
  assign unique_menu_id = section.id | append: '-' | append: menu_id

  if link.links.size > 1
    assign has_sub_links = true
  endif
-%}

<li
  class="
    group/header-menu-nav-item flex flex-none h-full focus-group-item
    {% if megamenu_placeholder and request.design_mode -%}
      {% comment %} If megamenu_placeholder: true, this menu item is just a placeholder so the mega menu can still show in the theme editor but we dont want a menu item to show {% endcomment %}
      !w-0 !opacity-0 !p-0 overflow-hidden
    {%- endif -%}
  "
  x-id="['header-menu-nav-item', 'header-menu-nav-item-link', 'header-menu-popup', 'header-menu-nav-item-button']"
  :id="$id('header-menu-nav-item')"

  {% if has_sub_links -%}
    x-header-menu-navigation-item.sublinks="{{ unique_menu_id }}"
  {%- else -%}
    x-header-menu-navigation-item="{{ unique_menu_id }}"
  {%- endif -%}
>
  {% comment %} Usage of a list here will cause screen readers to read out "2 items" to indicate that there is both a link _and_ a dropdown button they can tab to {% endcomment %}
  <ul
    class="relative flex-row-center"
    :role="!hasPopup ? 'none' : null"
  >
    {% comment %}
      When the page initially loads, and for links that have no sub links or custom mega popups associated
      with them we render a static link. Once the page loads and we find out the link has a custom mega menu
      we hide
    {% endcomment %}
    <li
      class="
        flex flex-center h-full
        {% if first %}
          pe-[--nav-menu-padding-x]
        {% elsif last %}
          ps-[--nav-menu-padding-x]
        {% else %}
          px-[--nav-menu-padding-x]
        {% endif %}
      "
      :role="!hasPopup ? 'none' : null"
    >
      {% capture link_class %}
        {{ link_class }}
        z-20 relative
        keyboard-focus:outline-offset-[-2px]

        {% # Use hit area not padding because header dropdowns need to align flush with link text %}
        {% if first %}
          hit-area-e-[--nav-menu-padding-x]
        {% elsif last %}
          hit-area-s-[--nav-menu-padding-x]
        {% else %}
          hit-area-x-[--nav-menu-padding-x]
        {% endif %}
      {% endcapture %}

      {% capture link_attributes %}
        :id="$id('header-menu-nav-item-link')"
        {{ link_attributes }}
        x-popup:float-reference
      {% endcapture %}

      {% render 'header-link',
        href: link.url,
        label: menu_item_label,
        attributes: link_attributes,
        class: link_class,
        active: link.active,
        label_style: 'text',
        _settings: _settings
      %}
    </li>

    <li
      class="absolute right-0 flex items-center z-30 h-full pointer-events-none"
      x-show="hasPopup"
    >
      {% comment %}
        This button is mainly for accessibility.It is hidden by default and only shown when the user
        focuses by keyboard. It's then used to open the mega menu or dropdown.
      {% endcomment %}
      <button
        class="
          group flex h-[15px] w-[15px] p-[3px] flex-center bg-canvas
          keyboard-focus:outline-offset-[-2px]
          opacity-0 focus-visible:opacity-100
        "
        x-popover:button
        :id="$id('header-menu-nav-item-button')"
        @keydown.down.stop.prevent="$popover.open"
        @keydown.up.stop.prevent="$popover.close"
        aria-label="{{ menu_label | escape }}"
      >
        {% render 'core-icon',
          icon: 'stroke-chevron-down',
          class: 'w-[8px] h-[8px] transform transition-transform origin-center group-aria-expanded:rotate-180'
        %}
      </button>
    </li>
  </ul>

  {% comment %} Mega menu / dropdown {% endcomment %}

  {% capture popup_attributes %}
    :id="$id('header-menu-popup')"
    :aria-labelledby="$id('header-menu-nav-item-button')"
  {% endcapture %}

  <template x-if="hasCustomMegaMenu">
    {% comment %}
      If this header link has a custom mega menu section associated with it,
      clone the contents of that section el and render them here
    {% endcomment %}
    {% capture megamenu_content %}
      <template x-clone="customMegaMenu"></template>
    {% endcapture %}
    {% render 'header-megamenu-flyout-wrapper',
      menu_id: unique_menu_id,
      menu_type: 'flyout',
      content: megamenu_content,
      content_width: section.settings.content_width,
      attributes: popup_attributes
    %}
  </template>

  <template x-if="!hasCustomMegaMenu && hasSubLinks">
    {% if link.levels > 1 %}
      {% comment %}
        If this header link has no custom mega menu associated with it and it has more
        than one level of sub links then render the default header mega menu which
        just displays a basic nested link list
      {% endcomment %}
      {% capture megamenu_content %}
        {% capture content %}
          {% render 'header-megamenu-linklist', parent_link: link, _settings: section.settings %}
        {% endcapture %}

        {% render 'header-megamenu-grid', attributes: attributes, content: content %}
      {% endcapture %}
      {% render 'header-megamenu-flyout-wrapper',
        menu_id: unique_menu_id,
        menu_type: 'flyout',
        content: megamenu_content,
        content_width: section.settings.content_width,
        attributes: popup_attributes
      %}
    {% else %}
      {% comment %}
        If this header link only one level of sub links then render a simple header
        dropdown menu with the sub links
      {% endcomment %}
      {% render 'header-dropdown',
        menu_id: unique_menu_id,
        link: link,
        attributes: popup_attributes,
        _settings: _settings
      %}
    {% endif %}
  </template>
</li>
