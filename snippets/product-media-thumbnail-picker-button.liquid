{% doc %}
  - Renders prev or next scroll button for the thumbnail picker

  Reads $overflow and $refs.scrollTrack from the enclosing picker.

  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [direction] - 'prev' or 'next', prints nothing when empty
  @param {string} [id] - gallery id, resolved through $id for aria-controls
  @param {string} [orientation] - 'horizontal' or 'vertical', defaults to 'horizontal'
{% enddoc %}

{% liquid
  assign button_size = 32
  assign scroll_by_distance = 100

  assign size_class = 'size-[--picker-btn-size]'

  case orientation
    when 'vertical'
      if direction == 'next'
        assign icon = 'stroke-chevron-down'
        assign position_class = '-translate-x-1/2 left-1/2 bottom-0'
      else
        # defaults to 'prev'
        assign direction = 'prev'
        assign icon = 'stroke-chevron-up'
        assign position_class = '-translate-x-1/2 left-1/2 top-0'
      endif
    else
      # defaults to 'horizontal'
      assign orientation = 'horizontal'
      if direction == 'next'
        assign icon = 'stroke-chevron-right'
        assign position_class = '-translate-y-1/2 top-1/2 right-0'
      else
        # defaults to 'prev'
        assign direction = 'prev'
        assign icon = 'stroke-chevron-left'
        assign position_class = '-translate-y-1/2 top-1/2 left-0'
      endif
  endcase
%}

{% capture attributes %}
  {% if direction == 'prev' %}
    {% comment %} Prev {% endcomment %}
    aria-label="{{ 'other.accessibility.prev' | t }}"
    :class="$overflow.start ? 'flex' : 'hidden'"
    :disabled="!$overflow.start"
    :aria-hidden="!$overflow.start"
    {% if orientation == 'vertical' %}
      @click="$refs.scrollTrack.scrollBy({ top: -{{ scroll_by_distance }}, behavior: 'smooth' })"
    {% else %}
      @click="$refs.scrollTrack.scrollBy({ left: -{{ scroll_by_distance }}, behavior: 'smooth' })"
    {% endif %}
  {% elsif direction == 'next' %}
    {% comment %} Next {% endcomment %}
    aria-label="{{ 'other.accessibility.next' | t }}"
    :class="$overflow.end ? 'flex' : 'hidden'"
    :disabled="!$overflow.end"
    :aria-hidden="!$overflow.end"
    {% if orientation == 'vertical' %}
      @click="$refs.scrollTrack.scrollBy({ top: {{ scroll_by_distance }}, behavior: 'smooth' })"
    {% else %}
      @click="$refs.scrollTrack.scrollBy({ left: {{ scroll_by_distance }}, behavior: 'smooth' })"
    {% endif %}
  {% endif %}
  {{ attributes }}
{% endcapture %}

{% if direction %}
  <button
    class="
      btn-appearance vars-btn-content vars-btn-soft
      absolute z-10 flex flex-center
      {{ size_class }}
      {{ position_class }}
      {{ class }}
    "
    style="--picker-btn-size: {{ button_size }}px"
    :aria-controls="$id('product-media-thumbnail-picker') + ' ' + $id('{{ id }}')"
    x-cloak
    {{ attributes }}
  >
    {% render 'core-icon', icon: icon, class: 'shrink-0' %}
  </button>
{% endif %}
