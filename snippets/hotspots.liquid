<!-- snippets/hotspots.liquid -->



{% doc %}
  - Renders hotspot layer over background image

  Reads section.settings.enable_ensemble to join the section ensemble instead of keeping its own
  list state.

  @param {string} [attributes]
  @param {string} [class] - The classes
  @param [height] - background height mode, defaults to 'image'. false fills the column and the image covers
  @param {string} [hotspot_color] - CSS color for the dots, defaults to s.hotspot_color
  @param {string} hotspots - rendered hotspot markup
  @param {object} [s] - settings object
  @param {section} [section]
{% enddoc %}
{% assign hotspot_color = hotspot_color | default: s.hotspot_color %}

{% assign media_height = height | default: 'image', allow_false: true %}

{% capture hotspots_attributes %}
  x-ref="hotspotsContainerEl"
  {% if section.settings.enable_ensemble %}
    x-ensemble:hotspots
    x-data="{
      ensembleId: 'hotspots',
    }"
    x-init="$ensemble.registerMember(ensembleId, $el)"
  {% else %}
    x-list-state="{
      scope: 'hotspots'
    }"
  {% endif %}
{% endcapture %}

{% capture attributes %}
  role="region"
  aria-label="{{ 'other.accessibility.hotspots' | t }}"
  {{ attributes }}
{% endcapture %}

{% capture class %}
  flex flex-col flex-center overflow-hidden relative
  [--cursor-size:42px]
  {{ class }}
{% endcapture %}

{% capture background %}
  {% render 'core-background-image',
    s: s,
    class: 'z-0',
    placeholder: 'collection-6',
    height: media_height,
    height_mobile: 'image',
    set_height_mobile: true
  %}
{% endcapture %}

{% capture style %}
  --hotspot-color: {{ hotspot_color }}
{% endcapture %}

{% capture custom_cursor %}
  {% comment %} Cursor blur background circle {% endcomment %}
  <div
    x-cloak
    x-custom-cursor:element.mass.20
    class="
      size-fit fixed top-0 left-0 overflow-visible z-20 pointer-events-none
      group-has-[[data-edge]]/hotspots:opacity-0
    "
  >
    <div
      class="
        w-[--cursor-size] h-[--cursor-size]
        touch:hidden
        rounded-full frosted-glass border-highlight
        transition origin-center duration-400 scale-100 rotate-0
        {% if settings.hotspot_style == 'ring' or settings.hotspot_style == 'crosshair' %}
          [mask:radial-gradient(12px,#0000_99%,#000)]
        {% endif %}
      "
      style="
        --frosted-glass-color: var(--hotspot-color,white);
        --border-highlight-color: var(--hotspot-color,white);
      "
      :class="{
        '!scale-0 !opacity-0': $customCursor.isSnapped,
        '!scale-0 !opacity-0': $customCursor.isHidden
      }"
    ></div>
  </div>

  {% comment %} Cursor shape {% endcomment %}
  <svg
    x-cloak
    x-custom-cursor:element.mass.20
    class="
      fixed top-0 left-0 w-[--cursor-size] h-[--cursor-size] overflow-visible z-20 pointer-events-none touch:hidden motion-reduce:hidden
      transition-opacity group-has-[[data-edge]]/hotspots:opacity-0
    "
    viewBox="0 0 52 52"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    :class="{
      'scale-0 opacity-0': $customCursor.isHidden
    }"
  >
    <g transform="scale(1.25)" transform-origin="center center">
    {% case settings.hotspot_style %}
      {% when 'ring' %}
        <g class="transition origin-center duration-400">
          <circle cx="50%" cy="50%" r="20.625" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <circle cx="50%" cy="50%" r="11.625" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
        </g>
      {% when 'crosshair' %}
        <g class="transition origin-center rotate-0 duration-400" :class="{ '!rotate-45': $customCursor.isSnapped }">
          <circle cx="50%" cy="50%" r="20.625" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <circle cx="50%" cy="50%" r="11.625" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>

          <path d="M25.9969 0.455078L25.9969 6.09049" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <path d="M25.996 46.6699L25.996 52.3053" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <path d="M51.9348 26.4102L46.2994 26.4102" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <path d="M5.70734 26.3906L0.0719205 26.3906" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>

          <path d="M26.0005 15.002L26.0005 17.4757" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <path d="M26.0002 35.2832L26.0002 37.757" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <path d="M37.3835 26.3926L34.9098 26.3926" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
          <path d="M17.0964 26.3828L14.6227 26.3828" stroke="var(--hotspot-color, white)" stroke-width="0.75"/>
        </g>
    {% endcase %}
    </g>
  </svg>

  {% comment %} Cursor Dot {% endcomment %}
  <svg
    x-cloak x-custom-cursor:element
    class="
      fixed top-0 left-0 w-[--cursor-size] h-[--cursor-size] z-20 pointer-events-none touch:hidden motion-reduce:hidden
      transition-opacity group-has-[[data-edge]]/hotspots:opacity-0
    "
    viewBox="0 0 42 42"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle cx="50%" cy="50%" r="3" fill-opacity="1.0" fill="var(--hotspot-color, white)"
      :class="{
        'opacity-0': $customCursor.isSnapped || $customCursor.isHidden
      }"
    />
  </svg>
{% endcapture %}

<div
  data-lazy-alpine
  data-lazy-alpine-module="@theme/custom-cursor"
  class="{{ class }}"
  style="{{ style }}"
  {{ attributes }}
>
  <div
    class="
      relative z-10 w-full h-fit grid-stack group/hotspots
      {% unless media_height %}
        md:h-full
      {% endunless %}
    "
    x-custom-cursor
  >
    {{ custom_cursor }}
    <div
      class="z-30 relative overflow-clip entrance-container *:auto-set-stagger-order"
      {{ hotspots_attributes }}
    >
      {{ hotspots }}
    </div>
    {{ background }}
  </div>
</div>
