{% comment %}
  Outputs sale discount text for a product or variant.
  Returns "Sale", "X% off", or "$X off" depending on sale_type setting.
  Outputs nothing if there is no sale.

  Unlike product-form-price this summarizes price for a product or color.
  Color can have multiple variants with different prices, making discount
  amounts unreliable — so it falls back to "Sale".

  No subscription display, compare-at-price, or unit pricing — just the
  badge label text. Styling is handled by the caller.

  {% render 'card-product-sale-summary', product: product, variant: variant %}
{% endcomment %}

{%- liquid
  assign sale_type = sale_type | default: settings.card_badge_sale_type
  assign variant = variant | default: product.selected_or_first_available_variant
  assign product = product | default: variant.product
  assign compare_at_price = variant.compare_at_price
  assign on_sale = false

  if sale_type != 'none' and compare_at_price > variant.price
    assign on_sale = true
  endif

  # Try to compute a specific discount amount.
  # Falls back to "Sale" for: word type, sub-1% discounts,
  # or when prices vary (discount amounts are unreliable).
  assign discount_text = blank

  if on_sale and product.price_varies != true
    if sale_type == 'percentage'
      assign percent_off = compare_at_price | minus: variant.price | times: 100 | divided_by: compare_at_price | floor
      if percent_off > 0
        assign discount_text = percent_off | append: '%'
      endif
    elsif sale_type == 'dollar'
      assign amount_off = compare_at_price | minus: variant.price
      if amount_off > 0
        capture discount_text
          render 'money', price: amount_off, show_currency: false
        endcapture
      endif
    endif
  endif
-%}

{% if on_sale %}
  {% if discount_text != blank %}
    {{ 'product.badge_discount_amount_html' | t: amount: discount_text }}
  {% else %}
    {{ 'product.sale' | t }}
  {% endif %}
{% endif %}
