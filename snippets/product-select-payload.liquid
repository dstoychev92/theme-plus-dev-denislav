{% doc %}
  - Prints JSON for the shopify:product:select standard event

  Read back with JSON.parse from a data attribute, since titles and option values can carry
  quotes that would break an inline Alpine expression. The product is the same for every option
  value, so it goes once on the option group and each value carries only what differs. A
  combined-listing child value carries its own product, since its variant belongs to another product.

  @param {string} [part] - 'product' or 'variant'
  @param {product} [product]
  @param {variant} [variant] - variant the option value points at, for the variant part
{% enddoc %}

{%- if part == 'product' -%}
  {"id": {{ product.id }}, "title": {{ product.title | json }}, "handle": {{ product.handle | json }}}
{%- endif -%}
{%- if part == 'variant' -%}
  {%- comment -%} Liquid money values are in hundredths of the currency unit {%- endcomment -%}
  {%- assign price_amount = variant.price | divided_by: 100.0 -%}
  {
    "selectedOptions": [
      {%- for product_option in product.options_with_values -%}
        {"name": {{ product_option.name | json }}, "value": {{ variant.options[forloop.index0] | json }}}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "variant": {
      "id": {{ variant.id }},
      "title": {{ variant.title | json }},
      "availableForSale": {{ variant.available | json }},
      "price": {"amount": "{{ price_amount }}", "currencyCode": {{ cart.currency.iso_code | json }}}
    }
  }
{%- endif -%}
