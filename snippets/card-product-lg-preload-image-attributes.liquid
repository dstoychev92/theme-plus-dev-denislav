{% doc %}
  - Adds the responsive first image of a card selection to its preload data

  @param {image} image
  @param {string} [image_sizes]
  @param {string} [image_widths]
{% enddoc %}

{% if image != blank %}
  {% liquid
    if image_sizes == blank
      capture image_sizes
        render 'image-grid-sizes'
      endcapture
    endif
    assign image_sizes = image_sizes | strip | strip_newlines | replace: '  ', ' '

    if image_widths == blank
      capture image_widths
        render 'image-grid-widths'
      endcapture
    endif
    assign image_widths = image_widths | strip
    assign widths = image_widths | split: ','
    assign preload_width = widths.last | strip | plus: 0 | at_most: image.width

    capture preload_srcset
      assign previous_candidate_width = 0
      assign has_candidate = false
      for width in widths
        assign candidate_width = width | strip | plus: 0 | at_most: image.width
        if candidate_width != previous_candidate_width
          if has_candidate
            echo ', '
          endif
          echo image | image_url: width: candidate_width
          echo ' '
          echo candidate_width
          echo 'w'
          assign previous_candidate_width = candidate_width
          assign has_candidate = true
        endif
      endfor
    endcapture
  %}
  data-preload-image-src="{{ image | image_url: width: preload_width }}" data-preload-image-srcset="
  {{- preload_srcset | strip | escape -}}
  " data-preload-image-sizes="{{ image_sizes | escape }}"
{% endif %}
