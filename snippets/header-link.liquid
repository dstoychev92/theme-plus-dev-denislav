{% doc %}
  - Renders a header link with an optional icon

  @param {boolean} [active] - marks the link as the current page
  @param {string} [aria_label]
  @param {string} [attributes]
  @param {string} [class] - The classes
  @param {string} [color] - stain color, defaults to s.color then 'content'
  @param {string} [href]
  @param {boolean} [icon] - icon name, or markup
  @param {string} [icon_indicator] - markup layered over the icon, such as the cart count
  @param {string} [icon_type_class] - classes for the icon
  @param {string} [label]
  @param {string} [label_attributes] - attributes for the label
  @param {string} [label_class] - classes for the label
  @param {string} [label_style] - 'icon', 'label' or 'both'
  @param {object} [s] - settings object
  @param {section} [section]
  @param {string} [tag] - defaults to 'a'
  @param {string} [target_device] - 'mobile' or 'desktop', defaults to s.target_device
{% enddoc %}

{% liquid
  assign label_style = label_style | default: s.label_style | default: 'both'
  assign color = color | default: s.color | default: 'content'
  assign href = href | default: s.href
  assign label = label | default: s.label
  assign target_device = target_device | default: s.target_device
  assign tag = tag | default: 'a'

  if label_style == 'both' and icon == blank
    assign label_style = 'text'
  endif

  case color
    when 'primary'
      assign color_class = 'vars-stain-primary'
    when 'secondary'
      assign color_class = 'vars-stain-secondary'
    when 'black'
      assign color_class = 'vars-stain-black'
    when 'white'
      assign color_class = 'vars-stain-white'
    when 'canvas'
      assign color_class = 'vars-stain-canvas'
    when 'content'
      assign color_class = 'vars-stain-content'
    when 'muted'
      assign color_class = 'vars-stain-muted'
    when 'sale'
      assign color_class = 'vars-stain-sale'
    else
      assign color_class = 'vars-stain-content'
  endcase
%}

{% capture attributes %}
  {% if tag == 'a' %}
    href="{{ href }}"
  {% endif %}

  {% comment %} We need aria-label because the text is hidden on Mobile {% endcomment %}
  {% if aria_label %}
    aria-label="{{ aria_label | escape_once }}"
  {% endif %}

  {% if active %}
    aria-current="page"

    {% if section.settings.underline_current_page %}
      x-init="
        initialUnderlinedEl = $el;
      "
    {% endif %}
  {% endif %}

  {{ attributes }}

  {% unless label_style == 'icon' %}
    x-data="{
      get isActive() {
        return underlinedEl == $el || (underlinedEl == null && initialUnderlinedEl == $el)
      },
      get shouldAnimateUnderlineIn() {
        return this.isActive && !hasInteractedWithNav
      }
    }"
  {% endunless %}

  x-hover:start.delay.100ms="setUnderlinedEl($el)"
  @click="
    initialUnderlinedEl = $el;
    setUnderlinedEl($el);
    {% comment %} Prevent scrollong to top of page when clicking # links {% endcomment %}
    {% if href == "#" %}
      $event.preventDefault();
      $event.stopPropagation();
    {% endif %}
  "
{% endcapture %}

{% capture class %}
  {{ class }} {{ color_class }}
  flex-row-center gap-x-r4 h-full min-h-[--header-row-height]
  relative z-0 text-stain

  {% render 'props-class-target-device', target_device: target_device %}
{% endcapture %}

{% comment %} Note: icon size is set in toolbar and menu as a user defined percentage of text size {% endcomment %}
{% capture icon_wrapper_class %}
  relative shrink-0
  {{ icon_type_class }}
{% endcapture %}

{% case label_style %}
  {% when 'icon' %}
    {% assign label = false %}
  {% when 'text' %}
    {% if icon != blank %}
      {% assign label_class = label_class | append: ' hidden md:!flex' %}
      {% assign icon_wrapper_class = icon_wrapper_class | append: ' block md:!hidden' %}
    {% else %}
      {% assign label_class = label_class | append: ' flex' %}
    {% endif %}
  {% when 'both' %}
    {% assign label_class = label_class | append: ' hidden md:!flex' %}
    {% assign icon_wrapper_class = icon_wrapper_class | append: ' block' %}
{% endcase %}

<{{ tag }} class="{{ class }}" data-header-link {{ attributes }}>
  {% if icon %}
    <span class="{{ icon_wrapper_class }}">
      {% render 'core-icon', icon: icon %}
      {{ icon_indicator }}
    </span>
  {% endif %}

  {% if label %}
    {% capture label_class %}
      shrink-0 flex py-r2 flex-center {{ label_class }}
    {% endcapture %}

    {% capture label_attributes %}
      {{ label_attributes }}
    {% endcapture %}

    {% capture label_with_line %}
      <span data-header-link-label class="relative">
        {{ label }}
        <div class="h-px bg-content absolute left-0 right-0 bottom-[-2px]"
          :class="{ 'animate-in scale-in-x': shouldAnimateUnderlineIn }"
          hidden
          x-show="isActive"
          x-shared-layout:element="underline"></div>
      </span>
    {% endcapture %}

    {% render 'core-text-preset',
      tag: 'span',
      class: label_class,
      text: label_with_line,
      settings_suffix: 'nav_link',
      s: s,
      attributes: label_attributes
    %}
  {% endif %}
</{{ tag }}>
