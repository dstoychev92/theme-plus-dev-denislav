<!-- snippets/core-section-content.liquid -->


{% liquid
  assign tag = tag | default: 'div'
  assign content_align = content_align | default: _settings.content_align
%}

{% capture class %}
  size-full relative z-10 flex flex-col

  row-section-content

  {% if inner_col_class %}
    {{ inner_col_class }}
  {% else %}
    col-section-content
  {% endif %}

  pt-[--section-content-pt,var(--section-setting-space)]
  pb-[--section-setting-space]

  {% if content_align %}
    vars-content-align-{{ content_align }}
  {% endif %}

  {{ class }}
{% endcapture %}

<section-content class="{{ class }}" style="{{ style }}" {{ attributes }}>
  {{ content }}
</section-content>
