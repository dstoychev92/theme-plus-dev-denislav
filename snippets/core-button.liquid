<!-- snippets/core-button.liquid -->



{% doc %}
  Renders a button with the given settings.

  @param {string} type - The type of button to render.
  @param {string} label - The label to render. This should be text
  @param {string} content - The content to render. This can be text, icons, or a combination of both.
  @param {string} color - The color of the button.
  @param {string} appearance - The appearance of the button.
  @param {string} href - The href of the button.
  @param {string} new_window - Whether to open the button in a new window.
{% enddoc %}

{% liquid
  assign type = type | default: 'button'
  assign label = label | default: _settings.text
  assign color = color | default: _settings.color, allow_false: true | default: 'primary', allow_false: true
  assign appearance = appearance | default: _settings.appearance, allow_false: true | default: 'solid', allow_false: true
  assign href = href | default: _settings.href
  assign new_window = new_window | default: _settings.open_in_new_window | default: null

  assign hover_effect = hover_effect | default: 'glow', allow_false: true

  # width settings
  assign sizing = sizing | default: _settings.sizing, allow_false: true | default: 'md', allow_false: true

  assign set_width = set_width | default: _settings.set_width | default: false

  if set_width
    # if width is set, pass sizing into height instead
    assign height = sizing | default: 'md'
    assign sizing = false

    assign width_unit = width_unit | default: _settings.width_unit
    assign width_px = width_px | default: _settings.width_px
    assign width_percent = width_percent | default: _settings.width_percent
  endif

  if set_width and width_unit == 'percent' and width_percent == 100
    assign flex_class = 'flex'
  else
    assign flex_class = 'inline-flex'
  endif

  if _settings.set_rounding
    assign rounding = rounding | default: _settings.rounding_style
  endif

  assign start_icon = start_icon | default: icon | default: false
  assign end_icon = end_icon | default: false

  assign tag = tag | default: 'button'
  assign wrap = wrap | default: false

  case sizing
    when 'xs'
      assign sizing_class = 'vars-btn-xs'
    when 'sm'
      assign sizing_class = 'vars-btn-sm'
    when 'md'
      assign sizing_class = 'vars-btn-md'
    when 'lg'
      assign sizing_class = 'vars-btn-lg'
    when 'xl'
      assign sizing_class = 'vars-btn-xl'
    when 'auto'
      assign sizing_class = 'vars-btn-auto'
  endcase

  case rounding
    when 'none'
      assign rounding_class = 'vars-btn-rounding-none'
    when 'sm'
      assign rounding_class = 'vars-btn-rounding-sm'
    when 'md'
      assign rounding_class = 'vars-btn-rounding-md'
    when 'pill'
      assign rounding_class = 'vars-btn-rounding-pill'
  endcase
%}

{% capture style %}
  {% if set_width %}
    {% if width_unit == 'pixel' %}
      min-width: {{ width_px }}px;
      max-width: max-content;
    {% elsif width_unit == 'percent' %}
      min-width: {{ width_percent }}%;
    {% endif %}
  {% endif %}
{% endcapture %}

{% capture class %}
  {% render 'props-class-type-preset',
    default_type_preset: 'btn',
    settings_suffix: settings_suffix,
    _settings: _settings,
    type_preset: type_preset,
    type_size: type_size,
    type_font: type_font,
    type_resize: type_resize,
    type_uppercase: type_uppercase
  %}
  {{ sizing_class }}
  {% if color %}
    vars-btn-{{ color }}
  {% endif %}
  {% if height %}
    vars-btn-height-{{ height }}
  {% endif %}
  {% if rounding %}
    vars-btn-rounding-{{ rounding }}
  {% endif %}
  {% if appearance %}
    vars-btn-{{ appearance }}
  {% endif %}
  {{ flex_class }}
  {% if hover_effect == 'glow' %}hover-effect-bg-highlight{% endif %}
  {% unless wrap %}whitespace-nowrap{% endunless %}
  {{ class }}

  {% comment %} Button bg color, text color, and border color are all parameterized with dependent classes like vars-btn-solid, vars-btn-primary, etc responsibile for setting appropriate variables {% endcomment %}
  btn
  group disabled:opacity-50 has-[:disabled]:opacity-50 flex-center gap-x-r4 select-none relative *:pointer-events-none hover-effect-target
{% endcapture %}

{% capture attributes %}
  {% if aria_label %}
    aria-label="{{ aria_label }}"
  {% endif %}
  {% if name %}
    name="{{ name }}"
  {% endif %}
  {% if value %}
    value="{{ value }}"
  {% endif %}
  {% if title %}
    title="{{ title }}"
  {% endif %}
  {% if checked %}
    checked
  {% endif %}
  {% if disabled %}
    disabled
  {% endif %}
  {% if style %}
    style="{{ style }}"
  {% endif %}
  x-cursor-position
  x-custom-cursor:snap-point
  {{ attributes }}
{% endcapture %}

{% capture label_content %}
  <span
    class="z-10 relative flex flex-center h-[--btn-height] pointer-events-none ty-type-center {{ label_class }}"
    {% if label_style %}
      style="{{ label_style }}"
    {% endif %}
    {% if label_attributes %}
      {{ label_attributes }}
    {% endif %}
  >
    {% if hover_effect == 'glow' %}
      <span aria-hidden="true" class="z-10 absolute inset-0 flex flex-center h-full pointer-events-none ty-type-center hover-effect-text-highlight">
        {{ label }}
      </span>
    {% endif %}
    {{ label }}
  </span>
{% endcapture %}

{% liquid
  if content == null
    capture content
      if start_icon != blank
        assign start_icon_class = start_icon_class | append: ' shrink-0'
        render 'core-icon', icon: start_icon, class: start_icon_class, size: icon_size
      endif
      if label != blank
        echo label_content
      endif
      if end_icon != blank
        assign end_icon_class = end_icon_class | append: ' shrink-0'
        render 'core-icon', icon: end_icon, class: end_icon_class, size: icon_size
      endif
    endcapture
  endif
%}

{% case tag %}
  {% when 'button' %}
    <button
      type="{{ type }}"
      {% if id %}
        id="{{ id }}"
      {% endif %}
      {% if form %}
        form="{{ form }}"
      {% endif %}
      {% if role and role != 'button' %}
        role="{{ role }}"
      {% endif %}
      class="{{ class }}"
      {{ attributes }}
    >
      {{ content }}
    </button>
  {% when 'a' %}
    <a
      href="{{ href }}"
      {% if new_window %}
        target="_blank"
        rel="noopener"
      {% endif %}
      class="cursor-pointer {{ class }}"
      {% if id %}
        id="{{ id }}"
      {% endif %}
      {% if role %}
        role="{{ role }}"
      {% endif %}
      {{ attributes }}
    >
      {{ content }}

      {% if new_window %}
        <span class="sr-only">, {{ 'other.accessibility.opens_in_new_tab' | t }}</span>
      {% endif %}
    </a>
  {% when 'input' %}
    {% assign dynamic_id = id | default: name | default: 'button' %}
    <div
      class="relative {{ class }}"
      x-id="['{{ dynamic_id }}']"
    >
      <input
        type="{{ type }}"
        class="sr-only"
        {% if role %}
          role="{{ role }}"
        {% endif %}
        {% if form %}
          form="{{ form }}"
        {% endif %}
        {% if id %}
          id="{{ id }}"
        {% endif %}
        :id="$id('{{ dynamic_id }}')"
        {{ attributes }}
      >
      <label
        class="cursor-pointer after:absolute after:inset-0"
        {% if id %}
          for="{{ id }}"
        {% endif %}
        :for="$id('{{ dynamic_id }}')"
        tabindex="0"
        {% comment %} Check the input on space/enter press {% endcomment %}
        @keydown.space.prevent="$el.previousElementSibling.checked = true"
        @keydown.enter.prevent="$el.previousElementSibling.checked = true"
      >
        {{ content }}
      </label>
    </div>
{% endcase %}
