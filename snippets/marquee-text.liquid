{% liquid
  assign text = _settings.text
  assign highlight_toggle = _settings.highlight_toggle
  assign enable_typography = _settings.enable_typography
  assign outline_text = _settings.outline_text

  # Split the text into seperate words wrapped in span tags
  capture split_text
    render 'split-text', text: text, attributes: 'data-scroll-stagger-item', class: 'inline'
  endcapture
%}

{% capture class %}
  {% if enable_typography %}
    {% render 'props-class-type-preset', _settings: _settings, type_preset: 'custom' %}
  {% endif %}

  {% if _settings.set_color %}
    text-{{ _settings.color | default: 'content' }}
  {% elsif hide_links %}
    text-content
  {% else %}
    text-default
  {% endif %}

  {% unless hide_links %}
    inline-richtext
  {% endunless %}

  {% if outline_text %}
    text-stroke text-stroke-[color:--color-custom-text]
  {% endif %}
{% endcapture %}

{% capture style %}
  {% if _settings.set_color and _settings.color == 'custom' %}
    --color-custom-text: {{ _settings.color_custom }};
  {% endif %}
{% endcapture %}

<div
  class="shrink-0 {{ class }}"
  {% if request.design_mode %}
    x-effect="
      if ($containsSelectedBlock) {
        $marquee.scrollTo($el)
      }
    "
  {% endif %}
  style="{{ style }}"
  {{ attributes }}
>
  {% if highlight_toggle == 'auto' %}
    {% render 'text-autohighlight', text: split_text, _settings: _settings %}
  {% elsif highlight_toggle == 'full' %}
    {% render 'text-highlight', text: split_text, _settings: _settings %}
  {% else %}
    {{ split_text }}
  {% endif %}
</div>
