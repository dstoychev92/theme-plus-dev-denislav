{% comment %}
  Renders PhotoSwipe slide data for video zoom. Place inside an x-photoswipe root.
  Uses data-photoswipe-json so the lightbox reads slides from the DOM when opened (no duplication on re-render).

  Parameters:
    - id: Optional ID for the PhotoSwipe item (default: blank)
    - video: Video object for video zoom
    - video_source: Video source URL (required)
{% endcomment %}

{% if video != blank and video_source != blank %}
  <script type="application/json" data-photoswipe-json>
    {
      "id": "{{ id }}",
      "type": "video",
      "videoSrc": "{{ video_source }}",
      "msrc": "{{ video.preview_image | image_url }}",
      "width": {{ video.preview_image.width }},
      "height": {{ video.preview_image.height }},
      {% if thumb_el != blank %}
        "thumbEl": {{ thumb_el | json }},
      {% endif %}
      "alt": {{ video.alt | strip_html | strip_newlines | escape | json }}
    }
  </script>
{% endif %}
