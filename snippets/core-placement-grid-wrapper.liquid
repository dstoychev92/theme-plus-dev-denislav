{% doc %}
  A layout container for text content that is meant to be displayed over top of background media
{% enddoc %}

{%- liquid
  assign vertical_placement = vertical_placement | default: _settings.vertical_placement, allow_false: true
  assign horizontal_placement = horizontal_placement | default: _settings.horizontal_placement, allow_false: true
  assign padding = padding | default: _settings.padding, allow_false: true
  assign padding_custom = padding_custom | default: _settings.padding_custom, allow_false: true

  # Optional mobile placement override. When set, only the mobile vertical
  # placement changes; desktop keeps using vertical_placement. On mobile the grid
  # gives content the full height, so positioning is just a justify-content value.
  assign set_mobile_placement = set_mobile_placement | default: _settings.set_mobile_placement, allow_false: true
  assign vertical_placement_mobile = vertical_placement_mobile | default: _settings.vertical_placement_mobile, allow_false: true
-%}

{%- capture mobile_placement_style -%}
  {%- if set_mobile_placement and vertical_placement_mobile -%}
    {%- case vertical_placement_mobile -%}
      {%- when 'top' -%}--placement-content-vertical-mobile: start;
      {%- when 'middle' -%}--placement-content-vertical-mobile: center;
      {%- when 'bottom' -%}--placement-content-vertical-mobile: end;
      {%- when 'full' -%}--placement-content-vertical-mobile: space-between;
    {%- endcase -%}
  {%- endif -%}
{%- endcapture -%}

{% if content != blank or controls != blank %}
  <div class="@container size-full z-10 pointer-events-none {{ class }}" style="{{ style }}" {{ attributes }}>
    <placement-grid
      style="
        {% if padding %}
          {% render 'props-style-padding', padding: padding, padding_custom: padding_custom %}
        {% endif %}
        {{ mobile_placement_style }}
      "
      class="
        size-full placement-grid pointer-events-none
        {% if vertical_placement and horizontal_placement %}
          vars-placement-grid-{{ vertical_placement }}-{{ horizontal_placement }}
        {% elsif vertical_placement %}
          vars-placement-grid-{{ vertical_placement }}-center
        {% elsif horizontal_placement %}
          vars-placement-grid-middle-{{ horizontal_placement }}
        {% endif %}

        {% if controls_alignment %}
          vars-placement-controls-horizontal-{{ controls_alignment }}
        {% endif %}

         has-[[data-controls]]:gap-x-md
      "
    >
      {{ content }}
    </placement-grid>
  </div>
{% endif %}
