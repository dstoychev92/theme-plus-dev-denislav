{% liquid
  assign color = color | default: 'content'
  assign appearance = appearance | default: 'blur'
  assign placeholder_button_text = 'product.quick_add' | t
  assign placeholder_button_tag = 'button'

  assign is_out_of_stock = false

  if product.available == false
    assign is_out_of_stock = true
  endif

  if is_out_of_stock
    assign placeholder_button_text = 'product.sold_out' | t
    assign placeholder_button_tag = 'a'
    assign placeholder_button_href = product.url
  endif

  assign placeholder_button_aria_label = placeholder_button_aria_label | default: placeholder_button_text

  if icon_swap == true
    assign swap_touch_content_class = 'mouse:hidden'
    assign swap_pointer_content_class = 'touch:hidden'
  else
    assign swap_touch_content_class = 'hidden'
    assign swap_pointer_content_class = ''
  endif

  assign close_aria_label = 'other.accessibility.close' | t
%}

{%- capture cart_icon -%}
  fill-add-{{- settings.cart_icon -}}
{%- endcapture -%}

{% capture placeholder_button_label %}
  {% render 'core-icon', icon: cart_icon, size: 'lg', class: swap_touch_content_class %}

  <span class="{{ swap_pointer_content_class }}">
    {{ placeholder_button_text }}
  </span>
{% endcapture %}

{% capture placeholder_button_label_class %}
  leading-[--leading-block] text-center line-clamp-2
  {{ placeholder_button_label_class }}
{% endcapture %}

{% capture placeholder_button_class %}
  pointer-events-auto w-fit relative z-10 max-md:!overflow-visible max-md:hit-area-[--card-lg-media-padding]
  !will-change-[transform,opacity,backdrop-filter,background-color]
  {{ placeholder_button_class }}
  origin-bottom touch:origin-bottom-right row-start-2
{% endcapture %}

{% capture placeholder_button_attributes %}
  :disabled="$sectionApi.state === 'loading'"
  :aria-expanded="$productCard.isQuickAddMenuVisible"
  :aria-controls="$id('quick-add-menu')"
  :aria-label="$productCard.isQuickAddMenuVisible ? '{{ close_aria_label | escape }}' : '{{ placeholder_button_aria_label  | escape }}'"

  {% unless is_out_of_stock %}
    x-product-card:quick-add-button
  {% endunless %}

  :class="{
    'bg-canvas opacity-0 scale-150 transition-[opacity,transform,background-color] duration-[calc(var(--quick-actions-exit-animation-duration)*0.9),var(--quick-actions-exit-animation-duration),var(--quick-actions-exit-animation-duration)]': $productCard.isQuickAddMenuVisible,
    'opacity-100 scale-100 transition-[opacity,transform] duration-[calc(var(--quick-actions-exit-animation-duration)*0.9),var(--quick-actions-exit-animation-duration),var(--quick-actions-exit-animation-duration)]': !$productCard.isQuickAddMenuVisible,
  }"

  {% unless is_out_of_stock %}
    data-available="true"
  {% endunless %}
{% endcapture %}

{% comment %} The button that says "Quick Add" that appears when the user hovers over the card but not the button {% endcomment %}
{% capture placeholder_button %}
  {% render 'core-button',
    tag: placeholder_button_tag,
    href: placeholder_button_href,
    label: placeholder_button_label,
    appearance: appearance,
    sizing: 'lg',
    color: color,
    attributes: placeholder_button_attributes,
    class: placeholder_button_class,
    label_class: placeholder_button_label_class,
    label_attributes: placeholder_button_label_attributes,
    wrap: true
  %}
{% endcapture %}

{% capture close_button %}
  <button
    class="md:hidden aspect-square p-0 min-h-0 size-row-md bg-canvas rounded-full flex flex-center row-start-1 justify-self-center transition-[opacity,transform]"
    type="button"
    aria-label="{{ 'other.accessibility.close' | t }}"
    x-cloak
    :class="{
      'delay-100 duration-[250ms,300ms] opacity-100 translate-y-0': $productCard.isQuickAddMenuVisible,
      'delay-0 duration-[200ms,250ms] opacity-0 translate-y-full': !$productCard.isQuickAddMenuVisible
    }"
    @click.stop="$productCard.isQuickAddMenuVisible = false"
  >
    {% render 'core-icon', icon: 'stroke-bare-x' %}
  </button>
{% endcapture %}

{% comment %} The menu that appears when the user hovers the "Quick Add" button {% endcomment %}
{% liquid
  # Logic to determine layout mode
  assign longest_value = 0
  assign shortest_value = 100

  for value in option.values
    if value.size > longest_value
      assign longest_value = value.size
    endif

    if value.size < shortest_value
      assign shortest_value = value.size
    endif
  endfor

  # Display in grid mode in cases where the values are similar in length and all quite short
  # Otherwise display in flex mode where the values are all different in length and/or are long
  assign chars_diff = longest_value | minus: shortest_value
  assign max_chars = 5
  assign max_variation = 5
  if chars_diff <= max_variation and longest_value <= max_chars
    assign layout_mode = 'grid'
  else
    assign layout_mode = 'flex'
    assign values_size = option.values.size
    assign cols_desktop_max = values_size | at_most: 3 | at_least: 1
    assign remainder_desktop = values_size | modulo: cols_desktop_max
    if remainder_desktop == 1 and cols_desktop_max > 2
      assign cols_desktop = cols_desktop_max | minus: 1
    else
      assign cols_desktop = cols_desktop_max
    endif
  endif
%}
{% capture quick_add_menu %}
  <div
    class="
      flex flex-col items-center justify-start overflow-clip w-full max-h-full row-start-2
      transition-[transform,opacity,content-visibility] contain-paint
      touch:origin-bottom-right origin-bottom
      relative z-20 pointer-events-none
      bg-canvas rounded-[--menu-radius]
      will-change-[transform,opacity]
      hit-area-[--card-lg-media-padding]
    "
    style="
      --menu-radius: min(var(--radius-btn, var(--radius-md)), calc(var(--control-height)/2));
      --menu-padding: min(var(--r6), calc(var(--r5) + var(--menu-radius)));
    "
    :class="{
      'delay-50 pointer-events-auto scale-100 opacity-100 duration-[var(--quick-actions-enter-animation-duration),calc(var(--quick-actions-enter-animation-duration)*0.75),var(--quick-actions-enter-animation-duration)]': $productCard.isQuickAddMenuVisible,
      'delay-50 pointer-events-none touch:scale-50 scale-75 opacity-0 duration-[var(--quick-actions-exit-animation-duration),calc(var(--quick-actions-exit-animation-duration)*0.75),var(--quick-actions-exit-animation-duration)]': !$productCard.isQuickAddMenuVisible
    }"
    :inert="!$productCard.isQuickAddMenuVisible"
    :id="$id('quick-add-menu')"
    x-product-card:quick-add-menu
  >
    <ul
      class="
        {% if layout_mode == "grid" %}
          grid grid-cols-[--grid-cols]
        {% else %}
          flex flex-row flex-wrap
        {% endif %}
        gap-[--quick-add-button-space] p-[--menu-padding]
        relative w-full h-full overflow-y-auto
        transition-[transform,opacity]
        origin-bottom touch:origin-bottom-right
        will-change-[transform,opacity]
        [--quick-add-button-ideal-cols:var(--quick-add-button-cols-mobile)]
        md:[--quick-add-button-ideal-cols:var(--quick-add-button-cols-desktop)]
      "
      style="
        --option-size: var(--row-md);
        --quick-add-button-space: var(--r3);
        {% if layout_mode == "grid" %}
          --grid-cols: repeat(auto-fit, minmax({{max_chars}}ch, 1fr));
        {% else %}
          --quick-add-button-ideal-cols-mobile: 2;
          --quick-add-button-ideal-cols-desktop: {{ cols_desktop }};
          --quick-add-button-basis: calc((100% / var(--quick-add-button-ideal-cols)) - (var(--layout-gutter-x) * (var(--quick-add-button-ideal-cols) - 1)));
        {% endif %}
      "
      :class="{
        'delay-50 opacity-100 scale-100 duration-[var(--quick-actions-enter-animation-duration),calc(var(--quick-actions-enter-animation-duration)*0.75)]': $productCard.isQuickAddMenuVisible,
        'delay-50 opacity-0 scale-75 duration-[var(--quick-actions-exit-animation-duration),calc(var(--quick-actions-exit-animation-duration)*0.75)]': !$productCard.isQuickAddMenuVisible,
      }"
      x-roving-tab="$productCard.isQuickAddMenuVisible"
      x-roving-tab:list
      aria-label="{{ 'product.accessibility.quick_add' | t }}"
    >
      {% for value in option.values %}
        {% liquid
          assign unavailable = false
          if value.variant == blank or value.variant.available == false
            assign unavailable = true
          endif
        %}
        <li
          class="
            relative max-w-full
            {% if layout_mode == "flex" %}
              flex-1 basis-[--quick-add-button-basis]
            {% endif %}
          "
          x-data="
            {
              get isSubmittingOptionVariant() {
                return $productForm.state !== 'idle' &&
                  Number($productForm.formData?.get('id')) === Number({{ value.variant.id }})
              }
            }
          "
        >
          <button
            class="
              btn vars-btn-outline max-md:vars-btn-sm vars-btn-md vars-btn-content
              flex flex-center whitespace-nowrap
              data-[selected=true]:vars-btn-solid
              relative z-10 type-btn type-resize-xs w-full
              [--btn-padding-x:var(--btn-padding)]

              {% if unavailable == true %}
                cursor-not-allowed
              {% else %}
                cursor-pointer
              {% endif %}
            "

            type="submit"
            name="id"
            x-id="['quick-add-btn']"
            :id="$id('quick-add-btn')"
            :disabled="$productForm.state == 'pending' || $sectionApi.state === 'loading'"

            {% if unavailable == true %}
              title="{{ value.name | escape }} - {{ 'product.unavailable' | t }}"
              data-available="false"
              disabled
              @click.stop.prevent=""
            {% else %}
              title="{{ value.name | escape }}"
              data-available="true"
              value="{{ value.variant.id }}"
            {% endif %}
          >
            {% if unavailable == true %}
              {% comment %} Strikethrough {% endcomment %}
              <svg
                role="presentation"
                class="pointer-events-none absolute inset-0 z-20 h-full p-r3 m-auto opacity-0 [[data-available=false]_&]:opacity-100"
                viewBox="0 0 38 38"
              >
                <path
                  d="M38 0 L0 38"
                  fill="none"
                  stroke-width="3"
                  vector-effect="non-scaling-stroke"
                  stroke-linecap="round"
                  class="stroke-canvas [[data-selected=true]_&]:stroke-content"
                />
                <path
                  d="M38 0 L0 38"
                  fill="none"
                  stroke-width="1"
                  vector-effect="non-scaling-stroke"
                  stroke-linecap="round"
                  class="stroke-content [[data-selected=true]_&]:stroke-canvas"
                />
              </svg>
            {% endif %}
            {% comment %} Initial State. We never use x-show with this because doing so would cause jumping {% endcomment %}
            <span
              class="flex-row-center gap-x-r3 truncate delay-300 transition-opacity will-change-opacity"
              :class="{
                'opacity-0 !delay-0': isSubmittingOptionVariant
              }"
            >
              <span aria-hidden="true" role="presentation">{{ value.name }}</span>
              <span class="sr-only">
                {% if value.variant == blank or value.variant.available == false %}
                  {{ value.name | escape }} - {{ 'product.unavailable' | t }}
                {% else %}
                  {{ 'product.add_product_to_cart_html' | t: title: value.name }}
                {% endif %}
              </span>
            </span>

            {% comment %} Saving State {% endcomment %}
            <span
              class="absolute inset-0 flex-row-center justify-center will-change-opacity"
              x-cloak
              x-show="isSubmittingOptionVariant && $productForm.state === 'pending'"
              x-transition.opacity.duration.500ms
            >
              {% render 'spinner' %}
              <span class="sr-only" aria-live="polite" role="status">{{- "product.adding_to_cart" | t -}}</span>
            </span>

            {% comment %} Success State {% endcomment %}
            <span class="absolute inset-0 flex-row-center justify-center gap-x-r3 will-change-opacity" x-cloak x-show="isSubmittingOptionVariant && $productForm.state === 'success'" x-transition.opacity.duration.500ms>
              {% render 'core-icon', icon: 'stroke-bare-check' %}
              <span class="sr-only" aria-live="polite" role="status">{{- "product.added_to_cart" | t -}}</span>
            </span>

            {% comment %} Error State {% endcomment %}
            <span class="absolute vars-scheme-error inset-0 text-content flex-row-center justify-center gap-x-r3 will-change-opacity" x-cloak x-show="isSubmittingOptionVariant && $productForm.state === 'error'" x-transition.opacity.duration.500ms>
              {% render 'core-icon', icon: 'stroke-bare-x' %}
              <span class="sr-only" aria-live="polite" role="status">{{- "product.error_adding_to_cart" | t -}}</span>
            </span>
          </button>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endcapture %}

<div
  class="
    group/quick-add-toolbar relative w-full h-fit max-h-full items-end touch:justify-items-end justify-items-center
    grid grid-cols-1 max-md:grid-rows-[minmax(0,auto),minmax(0,1fr)] grid-rows-2 gap-y-r2 *:col-span-full
    !pointer-events-none *:pointer-events-auto
    {{ class }}
  "
  x-id="['quick-add-menu']"
  {% unless is_out_of_stock %}
    x-product-card:quick-add
  {% endunless %}
>
  {{ close_button }}
  {{ placeholder_button }}
  {% unless is_out_of_stock %}
    {{ quick_add_menu }}
  {% endunless %}
</div>
