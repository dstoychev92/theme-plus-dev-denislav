{% liquid
  assign sticky_style = _settings.sticky_style
  assign transparent = _settings.transparent

  if sticky_style != 'never'
    assign sticky_background_style = _settings.sticky_background_style
  endif

  assign tag = tag | default: 'div'

  if transparent
    assign is_overlay = true
  endif

  assign content_width = content_width | default: _settings.content_width, allow_false: true
  assign padding_y = padding_y | default: _settings.padding_y, allow_false: true
  assign target_device = target_device | default: _settings.target_device

  assign color_scheme = color_scheme | default: _settings.color_scheme, allow_false: true
  assign background = background | default: _settings.background
  assign background_color = background_color | default: _settings.background_color
%}

<{{ tag }}
  class="
    {% if color_scheme -%}vars-{{ color_scheme.id }}{%- endif %}
    {% if content_width -%}vars-section-content-width-{{ content_width }}{%- endif %}
    section-grid relative w-full overflow-hidden text-content

    {% case background -%}
      {%- when 'transparent' -%}
        bg-transparent
      {%- when 'canvas' -%}
        bg-canvas
      {%- when 'tint' -%}
        bg-content-mix-5
      {%- when 'custom' -%}
        bg-[--section-custom-bg]
      {%- else -%}
        bg-canvas
    {%- endcase %}
    bg-opacity-[--header-bg-opacity]
    {% if sticky_background_style == 'blur' %}
      backdrop-blur-[var(--header-blur-amount)]
    {% endif %}
    will-change-[opacity,transform]

    [--header-section-border-opacity:calc(var(--line-alpha-subtle)*(var(--header-auto-border)))]
    [--header-row-height:calc(var(--control-height)+var(--section-pt,0px)+var(--section-pb,0px))]
    [--control-padding-x:--control-padding]

    {{ class }}
  "
  style="
    --section-pt: calc({{- padding_y | default: 0 -}}px * var(--r-multiplier));
    --section-pb: calc({{- padding_y | default: 0 -}}px * var(--r-multiplier));

    {%- if background == 'custom' and background_color -%}
      {% comment %} Solid color; background layer uses opacity for transparent fade {% endcomment %}
      --section-custom-bg: hsl({{ background_color.hue }} {{ background_color.saturation }}% {{ background_color.lightness }}%);
    {%- elsif background == 'custom' -%}
      --section-custom-bg: transparent;
    {%- endif -%}

    {{ style }}
  "
  x-data="
    {
      initialActiveEl: null,
      activeEl: null,
      hasInteractedWithNav: false,
      async setActiveEl(el) {
        if (el) this.hasInteractedWithNav = true;
        const animateLayout = await $m.loadAnimateLayout();

        animateLayout(
          $el,
          () => {
            this.activeEl = el;
          },
          {duration: 0.3, ease: [0.4, 0, 0.2, 1]},
        )
      }
    }
  "

  {% comment %} Unset active element when pointer leaves the header entirely {% endcomment %}
  x-hover:end.delay.500ms="setActiveEl(null)"

  data-sticky-header="{{ sticky_style }}"
  x-header-stack:header.{{ sticky_style }}

  {% if is_overlay %}
    {% comment %} Mark this header as one that can appear as an overlay over other content on the page like image banners {% endcomment %}
    data-overlay-header
  {% endif %}

  {% if sticky_background_style == 'blur' %}
    data-sticky-blur
  {% endif %}

  {% comment %} Close any open popup when use presses escape {% endcomment %}
  @keydown.escape.stop.prevent="$store.headerMenu.activePopupId = null"

  {{ attributes }}
>
  {{ 'theme.header.css' | asset_url | stylesheet_tag: preload: true }}

  <div
    class="
      col-section-content text-content
      flex flex-row flex-nowrap items-stretch gap-x-r8
      min-h-[--header-row-height] relative z-[1]
      {{ inner_class }}
    "
  >
    {{ content }}
  </div>
</{{ tag }}>
