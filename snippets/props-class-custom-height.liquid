{% doc %}
  - Prints height classes reading the custom height variables

  props-style-custom-height sets the variables these classes read. The height classes print
  even when set_height is false.

  @param {string} [custom_height_type] - 'percentage' or 'px'
  @param {string} [custom_height_type_mobile] - 'percentage' or 'px'
  @param {string} [height] - 'custom' with a 'percentage' type adds the svh support class
  @param {string} [height_mobile] - 'custom' with a 'percentage' type adds the mobile svh support class
  @param {string} [mode] - 'min' for min-height, or 'height', defaults to 'min'
  @param {object} [s] - settings object
  @param {boolean} [set_height] - has no effect
  @param {boolean} [set_height_mobile] - has no effect
{% enddoc %}

{%- liquid
  assign set_height = set_height | default: s.set_height, allow_false: true | default: true, allow_false: true
  assign height = height | default: s.height
  assign custom_height_type = custom_height_type | default: s.custom_height_type

  assign set_height_mobile = set_height_mobile | default: s.set_height_mobile, allow_false: true
  assign height_mobile = height_mobile | default: s.height_mobile
  assign custom_height_type_mobile = custom_height_type_mobile | default: s.custom_height_type_mobile

  # Control whether this height controls min height or height
  assign mode = mode | default: 'min'
-%}

{% if height == 'custom' and custom_height_type == 'percentage' %}
  vars-custom-height-svh-support
{% endif %}

{% if mode == 'height' %}
  h-[--custom-height]
{% else %}
  min-h-[--custom-height]
{% endif %}

{% if height_mobile == 'custom' and custom_height_type_mobile == 'percentage' %}
  vars-mobile-custom-height-svh-support
{% endif %}

{% if mode == 'height' %}
  max-md:h-[--mobile-custom-height,var(--custom-height)]
{% else %}
  max-md:min-h-[--mobile-custom-height,var(--custom-height)]
{% endif %}
