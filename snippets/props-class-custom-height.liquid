{%- liquid
  assign set_height = set_height | default: _settings.set_height, allow_false: true | default: true, allow_false: true
  assign height = height | default: _settings.height
  assign custom_height_type = custom_height_type | default: _settings.custom_height_type

  assign set_height_mobile = set_height_mobile | default: _settings.set_height_mobile, allow_false: true
  assign height_mobile = height_mobile | default: _settings.height_mobile
  assign custom_height_type_mobile = custom_height_type_mobile | default: _settings.custom_height_type_mobile

  # Control whether this height controls min height or height
  assign mode = mode | default: 'min'
-%}

{% if height == 'custom' and custom_height_type == 'percentage' %}
  vars-custom-height-svh-support
{% endif %}

{% if mode == 'height' %}
  h-[--custom-height]
{% else %}
  min-h-[--custom-height]
{% endif %}

{% if height_mobile == 'custom' and custom_height_type_mobile == 'percentage' %}
  vars-mobile-custom-height-svh-support
{% endif %}

{% if mode == 'height' %}
  max-md:h-[--mobile-custom-height]
{% else %}
  max-md:min-h-[--mobile-custom-height,var(--custom-height)]
{% endif %}
