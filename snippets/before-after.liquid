{%- liquid
  assign before_image = before_image | default: _settings.before_image
  assign after_image = after_image | default: _settings.after_image
  assign orientation = orientation | default: _settings.orientation | default: 'horizontal'
  assign handle_color = handle_color | default: _settings.handle_color | default: '#FFFFFF'
  assign start_position = start_position | default: _settings.start_position | default: 50
  assign set_height = set_height | default: _settings.set_height | default: true, allow_false: true

  assign min_start_position = 3
  assign max_start_position = 100 | minus: min_start_position

  assign start_position = start_position | at_least: min_start_position | at_most: max_start_position

  assign animate_from_position = 0

  if start_position > 50
    assign animate_from_position = max_start_position
  endif

  assign icon_class = 'rtl:rotate-180'

  assign alignment = _settings.content_align | default: _settings.alignment
-%}

{% capture style %}
  --handle-color: {{ handle_color }};
  --thumb-size: 2.8rem;
  {% render 'props-style-custom-height', _settings: _settings %}
{% endcapture %}

{% capture attributes %}
  {{ attributes }}

  {% if orientation == 'vertical' %}
    x-slider-reveal.vertical.progress.{{ start_position }}%
  {% else %}
    x-slider-reveal.progress.{{ start_position }}%
  {% endif %}

  x-init="
    $watch('$store.sections.hasIntersected($sectionId)', async (wasViewed, wasNotViewed) => {
      if (wasViewed && !wasNotViewed) {
        $sliderReveal.enableScroll()
        const animate = await $m.loadAnimate();

        $nextTick(() => {
          animate($sliderReveal.progressMotionValue, [{{ animate_from_position }}, {{ start_position }}], {
            duration: 0.6,
            ease: ['easeOut'],
          })
        })
      }
    })

    $watch('$store.sections.isIntersecting($sectionId)', (isVisible) => {
      if ($store.sections.hasIntersected($sectionId)) {
        if (isVisible) {
          $sliderReveal.enableScroll()
        } else {
          $sliderReveal.disableScroll()
        }
      }
    })
  "
{% endcapture %}

{% capture class %}
  overflow-hidden relative {{ class }}
  {% if set_height -%}
    {% render 'props-class-custom-height', _settings: _settings %}
    max-h-screen
  {% else %}
    h-full
  {%- endif %}
{% endcapture %}

{% capture content %}
  <input
    x-model.number="$sliderReveal.progress"
    type="range"
    min="{{ min_start_position }}"
    max="{{ max_start_position }}"
    class="
      absolute z-40 size-full !p-0 opacity-0
      [&::-moz-range-thumb]:rounded-none
      [&::-webkit-slider-thumb]:rounded-none

      {% if orientation == 'vertical' %}
        cursor-row-resize
        [writing-mode:vertical-lr]
        [&::-moz-range-thumb]:h-[--thumb-size]
        [&::-webkit-slider-thumb]:h-[--thumb-size]
        [&::-moz-range-thumb]:w-[100vw]
        [&::-webkit-slider-thumb]:w-[100vw]
      {% else %}
        cursor-col-resize
        [&::-moz-range-thumb]:h-[100vh]
        [&::-webkit-slider-thumb]:h-[100vh]
        [&::-moz-range-thumb]:w-[--thumb-size]
        [&::-webkit-slider-thumb]:w-[--thumb-size]
      {% endif %}
    "
    aria-label="{{ 'other.accessibility.before_after_controller' | t }}"
  >

  <div
    x-slider-reveal:handle
    class="absolute z-30 size-full flex rtl:items-end "
    style="transform: translateX({{ animate_from_position }}%)"
  >
    <div
      class="
        flex items-center
        {% if orientation == 'vertical' %}
          h-0 w-full
        {% else %}
          w-0 h-full
        {% endif %}
      "
    >
      <!-- Vertical line -->
      <div
        class="
          absolute start-[-1.5px] bg-[--handle-color]
          {% if orientation == 'vertical' %}
            h-[1.5px] w-full
          {%- else -%}
            w-[1.5px] h-full
          {% endif %}
        "
      ></div>

      <!-- White circle with blur -->
      <div
        class="
          group-focus-within/before-after:ring-focus-outline
          group-focus-within/before-after:ring-2
          absolute h-[--thumb-size] w-[--thumb-size] rounded-full border-[1.5px] border-[--handle-color] bg-white/10 backdrop-blur
          {% if orientation == 'vertical' %}
            start-[calc(50%+(var(--thumb-size)/-2))] rotate-90
          {%- else -%}
            start-[calc(var(--thumb-size)/-2)]
          {% endif %}
        "
      >
        <div class="flex h-full flex-center">
          <div class="text-[1rem] text-[color:var(--handle-color)]">
            {% render 'core-icon', icon: 'stroke-chevron-left', stroke_width_custom: '2.2', class: icon_class %}
          </div>
          <div class="text-[1rem] text-[color:var(--handle-color)]">
            {% render 'core-icon', icon: 'stroke-chevron-right', stroke_width_custom: '2.2', class: icon_class %}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="z-0 w-full grid-stack h-full">
    {% render 'core-background-image',
      _settings: _settings,
      image: before_image,
      class: 'z-0',
      parallax: false,
      placeholder: 'collection-4',
    %}
    {% render 'core-background-image',
      _settings: _settings,
      image: after_image,
      class: 'z-40',
      parallax: false,
      placeholder: 'collection-3',
      attributes: 'x-slider-reveal:reveal'
    %}
  </div>
{% endcapture %}

<before-after
  class="
    group/before-after
    flex flex-col h-full min-h-0
    text-content-align vars-content-align-{{ alignment }} items-content-align
    {{ class }}
  "
  style="{{ style }}"
  {{ attributes }}
>
  {{ content }}
</before-after>
