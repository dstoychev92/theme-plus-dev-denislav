{% liquid
  assign default_id = 'variant-select-' | append: block.id
  assign id = id | default: default_id | append: '-' | append: option.name | handleize

  assign select_size = select_size | default: 'md'

  if history
    assign history_mode = 'replace'
  else
    assign history_mode = 'none'
  endif

  assign selected_values_ids = product.options_with_values | map: 'selected_value' | map: 'id' | join: '-'
%}

{% capture options %}
  {% for value in option.values %}
    {% liquid
      assign can_buy = true
      assign has_variant = true
      assign available = true
      assign option_value_variant_id = value.variant.id
      assign option_selected = value.selected

      if value.variant == null
        assign has_variant = false
        assign can_buy = false
        # Use option value ID instead of variant ID when variant is null
        assign option_value_variant_id = value.id
        if selected_values_ids contains option_value_variant_id
          assign option_selected = true
          assign option_selected_value_variant_id = option_value_variant_id
        endif

      elsif value.available == false
        assign can_buy = false
      endif

      if can_buy == false or has_variant == false
        assign available = false
      endif
    %}
    {% capture option_label %}
      <span class="{% if available == false %} line-through opacity-50 {% endif %}">
        {{- value.name -}}
      </span>
    {% endcapture %}

    {%- capture option_url -%}
      {%- if value.variant == null and value.product_url != null -%}
        {%- render 'product-url',
          product: product,
          base_url: value.product_url,
          option_position: option.position,
          value_id: value.id
        -%}
      {%- else -%}
        {%- render 'product-url',
          product: product,
          variant: value.variant,
          option_position: option.position,
          value_id: value.id
        -%}
      {%- endif -%}
    {%- endcapture -%}

    {% capture option_attributes %}
      data-preload-url="{{- option_url -}}"
      @change="
        {% if value.variant != null %}
          $dispatch('theme:variant:change', { variantId: {{ value.variant.id }}, productId: {{ product.id }} })
        {% endif %}

        await $yieldToMain();
        $sectionApi.navigate('{{- option_url -}}', '{{ history_mode }}')
      "
    {% endcapture %}

    {% render 'custom-select-option', label: option_label, value: option_value_variant_id, selected: option_selected, attributes: option_attributes %}
  {% endfor %}
{% endcapture %}

{% capture select_label %}
  {% liquid
    assign can_buy = true
    assign has_variant = true
    assign available = true

    if option_selected_value_variant_id == null
      assign option_selected_value_variant_id = option.selected_value.variant.id
    endif

    if option.selected_value.variant == null
      assign has_variant = false
      assign can_buy = false
    elsif option.selected_value.available == false
      assign can_buy = false
    endif

    if can_buy == false or has_variant == false
      assign available = false
    endif
  %}
  <span class="{% if available == false %} line-through opacity-50 {% endif %}">
    {% if option.selected_value != blank %}
      {{ option.selected_value.name }}
    {% else %}
      {{ 'product.accessibility.select_option' | t: name: option.name }}
    {% endif %}
  </span>
{% endcapture %}

{% capture attributes %}
  key="{{ option.name | escape }}-{{ option.selected_value.name | escape }}-{{ option.selected_value.variant.id }}"
  x-preloader.interact.intersect
{% endcapture %}

{% render 'field-custom-select',
  size: select_size,
  id: id,
  value: option_selected_value_variant_id,
  options: options,
  class: class,
  button_class: '*:pointer-events-none',
  name: 'variant',
  label: select_label,
  hide_label: true,
  attributes: attributes
%}
