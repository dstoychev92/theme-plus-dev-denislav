{% doc %}
  - Renders the shared accessible link around a swatch

  Selection behavior is provided by x-selection-group through the emitted data attributes.

  @param {string} content - rendered swatch markup
  @param {string} label - accessible name
  @param {boolean} selected
  @param {string} url
  @param {string} [attributes]
  @param {string} [class]
  @param {string} [focus_key]
  @param {string} [selection_id]
  @param {string} [title]
{% enddoc %}

<a
  class="
    block transition-[filter]
    has-[[data-selected=true]]:pointer-events-none
    {% if settings.swatch_shape == 'circle' %}rounded-full{% endif %}
    {{ class }}
  "
  href="{{ url }}"
  title="{{ title | default: label | escape_once }}"
  aria-label="{{ label | escape_once }}"
  data-selected="{{ selected }}"
  {% if selection_id != blank %}
    data-selection-id="{{ selection_id }}"
  {% endif %}
  {% if focus_key != blank %}
    data-preserve-focus-key="{{ focus_key }}"
  {% endif %}
  {% if selected %}
    aria-current="true"
  {% endif %}
  {{ attributes }}
>
  {{ content }}
</a>
