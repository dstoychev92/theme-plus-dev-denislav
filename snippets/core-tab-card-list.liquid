{% liquid
  assign block_index = section.blocks | find_index: 'id', block.id
  assign selected = false

  assign title = title | default: block.settings.title

  if block_index == 0
    assign selected = true
  endif

  #
  # Desktop
  #

  assign columns_lg = columns_lg | default: _settings.columns_lg

  #
  # Tablet
  #

  assign layout_tablet = 'slider'
  assign columns_md = columns_md | default: _settings.columns_md

  #
  # Mobile
  #

  assign layout_mobile = 'slider'
  assign columns_sm = settings.slider_columns_mobile
%}

{% capture tab_style %}
  {% if block_index != blank %}
    --stagger-order: {{ block_index }};
  {% endif %}
{% endcapture %}

<div
  x-tabs:tabpanel
  {% unless selected %}
    x-cloak
  {% endunless %}
  {{ attributes }}
  class="contents entrance-container *:auto-stagger-animations-[--entrance-animation-stagger]"
  x-carousel
  x-overflow.autoregister
  aria-label="{{ title | strip_html | escape }}"
  aria-live="off"
>
  <template data-tab-template>
    {% render 'core-tab',
      selected: selected,
      attributes: tab_button_attributes,
      label: title,
      type: 'button',
      value: block.id,
      style: tab_style,
      tab_index: block_index
    %}
  </template>

  {% render 'core-section-card-list-elements',
    _settings: section.settings,
    list_items: list_items,
    layout_desktop: 'slider',
    layout_tablet: layout_tablet,
    layout_mobile: layout_mobile,
    columns_lg: columns_lg,
    columns_md: columns_md,
    columns_sm: columns_sm
  %}
</div>
