{% comment %}
  Renders a gift card recipient form.

  Accepts:
  - product: {Object} The product object.

  Usage:
  {% render 'product-gift-card-recipient', product: product %}
{% endcomment %}

{%- liquid
  assign gift_card_recipient_control_flag = 'properties[__shopify_send_gift_card_to_recipient]'

  assign checkbox_id = 'recipient-checkbox-' | append: section.id
  assign email_id = 'recipient-email-' | append: section.id
  assign name_id = 'recipient-name-' | append: section.id
  assign message_id = 'recipient-message-' | append: section.id
  assign activate_date_id = 'recipient-activate-date-' | append: section.id
  assign send_on_id = 'recipient-send-on-' | append: section.id

  assign checkbox_label = 'gift_card.form.checkbox' | t
  assign email_label = 'gift_card.form.email' | t
  assign name_label = 'gift_card.form.name' | t
  assign message_label = 'gift_card.form.message' | t
  assign activate_date_label = 'gift_card.form.send_later' | t
  assign send_on_label = 'gift_card.form.send_on' | t

  assign max_chars_message = 200
  assign max_chars_message_rendered = 'gift_card.form.max_characters' | t: max_chars: max_chars_message

  assign current_date = 'now' | date: '%m-%d-%Y'
  assign days = 90
  assign days_in_seconds = days | times: 24 | times: 60 | times: 60
  assign current_date_timestamp = 'now' | date: '%s'
  assign end_date = current_date_timestamp | plus: days_in_seconds | date: '%m-%d-%Y'
%}

{% if form.errors contains 'email' %}
  {%- capture email_error -%}
    {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}.
  {%- endcapture -%}
{% endif %}

{% capture email_attributes %}
  spellcheck="false"
  autocapitalize="off"
  autocomplete="email"
  required
  :disabled="!isActive"
  {% if form.errors contains 'email' %}
    aria-invalid="true"
  {% endif %}
{% endcapture %}

{% capture name_attributes %}
  autocomplete="name"
  :disabled="!isActive"
{% endcapture %}

{% capture message_attributes %}
  rows="5"
  maxlength="{{ max_chars_message }}"
  aria-label="{{ message_label }} {{ max_chars_message_rendered }}"
  :disabled="!isActive"
  x-submittable-textarea
{% endcapture %}

{% capture send_on_attributes %}
  autocomplete="send_on"
  pattern="\d{4}-\d{2}-\d{2}"
  min="{{ current_date }}"
  max="{{ end_date }}"
  {% if form.errors contains 'send_on' %}
    aria-invalid="true"
  {% endif %}
{% endcapture %}

{% comment %} Render Form {% endcomment %}
{% if product.gift_card? %}
  <div
    class="mb-r6 flex flex-col gap-y-r6 {{ class }}"
    role="group"
    aria-labelledby="{{ checkbox_id }}"
    x-data="
      {
        isActive: false,
        includeDate: false,
      }
    "
  >
    {% render 'field-checkbox',
      class: 'peer',
      id: checkbox_id,
      name: gift_card_recipient_control_flag,
      label: checkbox_label,
      input_attributes: 'x-model="isActive"'
    %}

    <div
      class="
        hidden flex-col gap-y-r4
        peer-has-[:checked]:flex
      "
      :class="{ 'animate-in fade-in': isActive }"
      x-show="isActive"
      x-cloak
    >
      {%- render 'field-input',
        type: 'email',
        name: 'properties[Recipient email]',
        value: form.email,
        id: email_id,
        label: email_label,
        input_attributes: email_attributes,
        error_message: email_error
      -%}

      {%- render 'field-input',
        type: 'text',
        name: 'properties[Recipient name]',
        value: form.name,
        id: name_id,
        label: name_label,
        input_attributes: name_attributes
      -%}

      {%- render 'field-textarea',
        name: 'properties[Message]',
        id: message_id,
        label: message_label,
        input_attributes: message_attributes
      -%}

      <div role="group" aria-label="{{ send_on_label }}" class="flex flex-col gap-y-r6">
        {%- render 'field-checkbox',
          id: activate_date_id,
          label: activate_date_label,
          input_attributes: 'x-model="includeDate" :disabled="!isActive"'
        -%}

        <template x-if="includeDate">
          <div>
            {%- render 'field-input',
              type: 'date',
              name: 'properties[Send on]',
              id: send_on_id,
              label: send_on_label,
              input_attributes: send_on_attributes
            -%}

            <input
              type="hidden"
              name="properties[__shopify_offset]"
              :value="new Date().getTimezoneOffset();"
            >
          </div>
        </template>
      </div>
    </div>
  </div>
{% endif %}
