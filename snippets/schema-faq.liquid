{% comment %}
  Schema: FAQPage
  Generates FAQ structured data from a page that uses a specific format.

  Usage: {% render 'schema-faq', faq_items: faq_items %}

  Pass an array of objects with .question and .answer properties,
  OR use on pages/articles that have FAQ blocks.

  For manual use, build the array in the template:
    {% assign faq_items = '' | split: '' %}
    Then pass to this snippet.

  Alternatively, this snippet can extract FAQ data from page content
  when rendered with metaobject references or blocks.
{% endcomment %}

{%- if faq_items != blank and faq_items.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq_items -%}
    {
      "@type": "Question",
      "name": {{ item.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | strip_html | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
