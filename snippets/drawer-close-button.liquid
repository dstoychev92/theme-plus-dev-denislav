{% liquid
  assign side = side | default: 'left'
  assign autofocus_close_button = autofocus_close_button | default: true, allow_false: true
  assign close_button_label = 'other.accessibility.close' | t
  assign icon = icon | default: 'stroke-bare-x'
%}

<button
  class="text-r4 hit-area-r5 hover:opacity-75 rounded-full flex flex-center relative {{ class }}"
  aria-label="{{ close_button_label }}"
  x-dialog:close
  data-skip-animation-wait
  {{ close_button_attributes }}
  {% if autofocus_close_button %}
    autofocus
  {% endif %}
>
  {% if content %}
    {{ content }}
  {% else %}
    {% render 'core-icon',
      icon: icon,
      size: 'xl',
      class: close_button_icon_class,
      attributes: close_button_icon_attributes
    %}
  {% endif %}
</button>
