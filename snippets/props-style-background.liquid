{% liquid
  assign set_color_scheme = set_color_scheme | default: _settings.set_color_scheme | default: false

  if set_color_scheme
    assign background = background | default: _settings.background
    assign background_custom = background_custom | default: _settings.background_custom
  endif
%}

{% if set_color_scheme %}
  {% if background == 'custom' and background_custom != blank %}
    background-color: {{ background_custom }};
  {% endif %}
{% endif %}
