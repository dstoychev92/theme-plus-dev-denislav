{% liquid
  assign video = video | default: _settings.video_bg
  assign aspect_ratio = aspect_ratio | default: _settings.aspect_ratio | default: video.aspect_ratio
  assign height = height | default: _settings.height, allow_false: true
  assign height_mobile = height_mobile | default: _settings.height_mobile, allow_false: true

  if id == blank
    assign id_prefix = id_prefix | default: block.id | default: section.id
    assign id = id_prefix | append: '-video'
  endif

  if set_height_mobile == null and _settings.set_height_mobile == null
    assign set_height_mobile = true
  endif

  if id == blank
    assign id_prefix = id_prefix | default: block.id | default: section.id
    assign id = id_prefix | append: '-video'
  endif

  if preload == null and section.index0 == 0
    assign preload = true
  endif
%}

{% capture video_wrapper_class %}
  size-full absolute inset-0 !z-10
  {{ video_wrapper_class }}
{% endcapture %}

<div
  class="
    {{ class }} overflow-hidden w-full
    {% if height == 'image' and set_height %}
      h-auto aspect-[var(--video-aspect-ratio)]
    {% else %}
      h-full
    {% endif %}

    {% if height_mobile == 'image' and set_height_mobile %}
      max-md:h-auto
      max-md:aspect-[var(--video-aspect-ratio)]
    {% else %}
      max-md:h-full
    {% endif %}
  "
  style="
    {{ style }}
    {% if aspect_ratio != 0 and aspect_ratio != blank %}
      {% if height == 'image' and set_height %}
        --video-aspect-ratio: {{ aspect_ratio }};
      {% elsif height_mobile == 'image' and set_height_mobile %}
        --video-aspect-ratio: {{ aspect_ratio }};
      {% endif %}
    {% endif %}
  "
  {{ attributes }}
>
  {% render 'core-video',
    video: video,
    preload: preload,
    autoplay: true,
    controls: false,
    aspect_ratio: aspect_ratio,
    width: width,
    video_class: video_class,
    class: video_wrapper_class,
    id: id
  %}
</div>
