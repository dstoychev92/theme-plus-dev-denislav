{% comment %}
  Schema: BreadcrumbList
  Generates breadcrumb structured data for all page types.
  Rendered globally in theme.liquid.
{% endcomment %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ shop.name | json }},
      "item": {{ shop.url | json }}
    }

    {%- if template.name == 'product' -%}
      {%- if product.collections.size > 0 -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.collections.first.title | json }},
          "item": {{ shop.url | append: '/collections/' | append: product.collections.first.handle | json }}
        }
        ,{
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }}
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }}
        }
      {%- endif -%}

    {%- elsif template.name == 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }}
      }

    {%- elsif template.name == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ shop.url | append: '/blogs/' | append: blog.handle | json }}
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }}
      }

    {%- elsif template.name == 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }}
      }

    {%- elsif template.name == 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }}
      }

    {%- elsif template.name == 'search' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "Search"
      }

    {%- endif -%}
  ]
}
</script>
