{% doc %}
  - Renders share button or copy-link popover

  The URL comes from product.selected_variant, then product, then article, then page.

  @param {article} [article] - article being shared
  @param {block} [block]
  @param {string} [label] - button label, defaults to block.settings.share_label
  @param {product} [product] - product being shared
  @param {section} [section]
{% enddoc %}

{% liquid
  assign label = label | default: block.settings.share_label
  assign copy_icon_class = 'w-r8 h-r8 shrink-0 text-content'

  if product
    assign resource = product.selected_variant | default: product
  elsif article
    assign resource = article
  else
    assign resource = page
  endif
  assign share_url = request.origin | append: resource.url
%}

{% assign max_width = 'calc(100vw - calc(var(--root-buffer) * 2))' %}
{% capture share_icon_class %}
  w-r6 h-r6 text-muted shrink-0
{% endcapture %}

{% capture share_icon %}
  {% render 'core-icon', icon: 'fill-share-ios', class: share_icon_class, attributes: 'x-show="!isAndroid"' %}
  {% render 'core-icon', icon: 'fill-share-android', class: share_icon_class, attributes: 'x-show="isAndroid" x-cloak' %}
{% endcapture %}

{% capture copy_icon_attributes %}
  x-show="$clipboard.state == 'initial' || $clipboard.state == 'denied'"
{% endcapture %}
{% capture success_icon_attributes %}
  x-show="$clipboard.state == 'success'"
  x-cloak
{% endcapture %}
{% capture fallback_button_content %}
  {% render 'core-icon', icon: 'fill-copy', class: copy_icon_class, attributes: copy_icon_attributes %}
  {% render 'core-icon', icon: 'fill-copy-check', class: copy_icon_class, attributes: success_icon_attributes %}
  {% comment %} Dummy input element to handle the validation error message when clipboard access is denied {% endcomment %}
  <input class="sr-only" tabindex="-1" aria-hidden="true"/>
{% endcapture %}

{% capture fallback_button_attributes %}
  aria-label="{{ 'other.accessibility.copy_url' | t }}"
  x-clipboard:button
  {% # The French value holds an apostrophe in "l'accès", which ends the JS string %}
  data-clipboard-denied="{{ 'other.accessibility.clipboard_access_denied' | t | escape_once }}"
  x-effect="
    if ($clipboard.state == 'denied') {
      const validator = $el.querySelector('input');
      validator.setCustomValidity($el.dataset.clipboardDenied);
      validator.reportValidity();
    }
  "
  x-show="$clipboard.isClipboardWriteAllowed"
{% endcapture %}

{% capture fallback_button %}
  <button
    class="flex items-center gap-x-r5 font-family-body text-r3 font-bold"
    style="flex-direction: var(--share-direction)"
    x-popup:button
    data-test-id="fallback-share-button"
  >
    {{ share_icon }}
    {{ label | escape_once }}
  </button>

  {% comment %} Anchor the popover to the full block width instead of the button {% endcomment %}
  <span
    class="block w-full"
    aria-hidden="true"
    x-popup:float-reference
  ></span>
{% endcapture %}

{% capture fallback_content %}
  <div
    class="flex-row-center p-r2 rounded-sm border border-line-bold"
    x-clipboard
    x-effect="if($clipboard.state == 'initial') { $popup.close() }"
    style="max-width: {{ max_width }};"
  >
    {% assign input_id = section.id | append: block.id | append: 'share-url' %}
    <label for="{{ input_id }}" class="sr-only">{{ 'other.accessibility.share_url' | t }}</label>
    <input
      id="{{ input_id }}"
      type="text"
      class="
        bg-transparent flex-row-center h-row-md px-r4 font-family-body text-r4
        min-w-0 truncate
        supports-[field-sizing:content]:[field-sizing:content]
      "
      {% # size approximates the text width in browsers without field-sizing %}
      size="{{ share_url.size }}"
      @click="$el.select()"
      x-clipboard:target
      value="{{ share_url }}"
      readonly
    >

    {% render 'core-button',
      content: fallback_button_content,
      class: 'shrink-0',
      color: 'link',
      appearance: 'bare',
      attributes: fallback_button_attributes
    %}
  </div>
{% endcapture %}

{% capture fallback_attributes %}
  x-show="!canShare"
  x-cloak
  x-ref="shareContainerEl"
{% endcapture %}

<div
  class="relative text-content"
  x-data="
    {
      canShare: false,

      get isAndroid() {
        return navigator.userAgentData?.platform.toLowerCase().includes('android') || /Android/i.test(navigator.userAgent);
      },

      init() {
        if (this.isWindowsOS()) {
          this.canShare = false;
        } else {
          {% comment %} Check if build-in share functionality is available {% endcomment %}
          this.canShare = navigator.share ? navigator.canShare({url:'{{ share_url }}'}) : false;
        }
      },

      isWindowsOS() {
        if (navigator.userAgentData?.platform) {
          return navigator.userAgentData.platform === 'Windows';
        }
        return /Windows/i.test(navigator.userAgent);
      }
    }
  "
>
  {% comment %} Build-in share functionality {% endcomment %}
  <button
    class="flex items-center gap-x-r5 font-family-body text-r3 font-bold"
    style="flex-direction: var(--share-direction)"
    data-share-url="{{ share_url | strip }}"
    @click="navigator.share({url: $el.dataset.shareUrl, title: document.title}).catch(() => {})"
    x-show="canShare"
    data-test-id="share-button"
  >
    {{ share_icon }}
    {{ label | escape_once }}
  </button>

  <template x-if="!canShare">
    {% comment %}
      Copy URL fallback. The popover grows from the block width to the URL width.
      fitX caps it to the clipping ancestor, since a drawer such as the quickview
      is narrower than the URL. min-w-fit would beat that cap
    {% endcomment %}
    {% render 'core-popover',
      button: fallback_button,
      content: fallback_content,
      show_arrow: false,
      position: 'bottom-start',
      offset: 12,
      size: false,
      max_width: max_width,
      popover_class: 'min-w-full shadow-none !ring-0',
      float_options: '{ fitX: true }',
      attributes: fallback_attributes
    %}
  </template>
</div>
