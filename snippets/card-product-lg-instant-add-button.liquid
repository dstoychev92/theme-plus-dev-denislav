{% comment %}
  * Renders the product-card add-to-cart button that adds directly to cart, no quick-view or inline size buttons
{% endcomment %}

{% liquid
  assign variant = variant | default: product.selected_or_first_available_variant
  assign size = size | default: 'lg'
  assign color = color | default: 'content'
  assign appearance = appearance | default: 'blur'
  assign button_text = 'product.add_to_cart' | t
  assign button_tag = 'button'

  assign is_out_of_stock = false
  if product.available == false
    assign is_out_of_stock = true
  endif

  if is_out_of_stock
    assign button_text = 'product.sold_out' | t
    assign button_href = product.url
    assign button_tag = 'a'
  endif

  assign aria_label = aria_label | default: button_text

  # Pre-order button text
  if settings.metafield_preorder != blank
    assign preorder_metafield_namespace = settings.metafield_preorder | split: '.' | first
    assign preorder_metafield_key = settings.metafield_preorder | split: '.' | last
    assign preorder_metafield = product.metafields[preorder_metafield_namespace][preorder_metafield_key]
    if preorder_metafield.value == true
      assign button_text = 'product.pre_order.add_button' | t
    endif
  endif

  if icon_only == true
    # Always show the icon, never the text label. The add-to-cart animation
    # states (spinner / check / x) live in separate spans and are unaffected.
    assign swap_touch_content_class = ''
    assign swap_pointer_content_class = 'hidden'
  elsif icon_swap == true
    assign swap_touch_content_class = 'mouse:hidden'
    assign swap_pointer_content_class = 'touch:hidden'
  else
    assign swap_touch_content_class = 'hidden'
    assign swap_pointer_content_class = ''
  endif
%}

{%- capture cart_icon -%}
  fill-add-{{- settings.cart_icon -}}
{%- endcapture -%}

{%- capture label -%}
  <span class="transition-opacity delay-300" :class="{ 'opacity-0 !delay-0': $productForm.state !== 'idle' }">
    {% render 'core-icon', icon: cart_icon, size: 'lg', class: swap_touch_content_class %}

    <span class="{{ swap_pointer_content_class }}">
      {{ button_text }}
    </span>
  </span>
  <span
    class="absolute"
    x-show="$productForm.state === 'pending'"
    x-cloak
    x-transition.opacity.duration.500ms
  >
    {% render 'spinner' %}

    <span class="sr-only">
      {{ "product.adding_to_cart" | t }}
    </span>
  </span>
  <span class="absolute flex-row-center justify-center gap-x-r3" x-cloak x-show="$productForm.state === 'success'" x-cloak x-transition.opacity.duration.500ms>
    {% render 'core-icon', icon: 'stroke-bare-check' %}
    <span class="sr-only">
      {{ "product.added_to_cart" | t }}
    </span>
  </span>
  <span class="absolute flex-row-center justify-center gap-x-r3" x-cloak x-show="$productForm.state === 'error'" x-cloak x-transition.opacity.duration.500ms>
    {% render 'core-icon', icon: 'stroke-bare-x' %}
    <span class="sr-only">
      {{ "product.error_adding_to_cart" | t }}
    </span>
  </span>
{%- endcapture -%}

{% capture label_class %}
  leading-[--leading-block] text-center line-clamp-2
  flex-row-center justify-center
  {{ label_class }}
{% endcapture %}

{% capture class %}
  relative !overflow-visible max-md:hit-area-[--card-lg-media-padding]
  {{ class }}
{% endcapture %}

{% unless is_out_of_stock %}
  {% capture attributes %}
    :class="
      {
        'vars-scheme-error': $productForm.state === 'error',
        {% comment %} Don't fade out the button when pending {% endcomment %}
        'disabled:!opacity-100': $productForm.state === 'pending',
      }
    "
    {% comment %} Use the user selected variant if one exists, otherwise fall back to the intial product variant {% endcomment %}
    :value="variantId || {{ variant.id }}"
    data-available="true"
    :disabled="$productForm.state == 'pending' || $sectionApi.state === 'loading'"
  {% endcapture %}
{% endunless %}

{% render 'core-button',
  tag: button_tag,
  type: 'submit',
  href: button_href,
  label: label,
  aria_label: aria_label,
  appearance: appearance,
  sizing: size,
  type_resize: type_resize,
  color: color,
  name: 'id',
  form: form_id,
  value: variant.id,
  class: class,
  attributes: attributes,
  label_class: label_class,
  wrap: true
%}
