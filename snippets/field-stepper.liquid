{% liquid
  assign id = id | default: name | handleize
%}

{% capture field_class %}
  {{ class }}

  {% comment %} Hide label when option disabled option is checked aka placeholder option {% endcomment %}
  has-[:checked:disabled]:[--field-active:0]
{% endcapture %}

{% capture stepper_wrapper_class %}
  bg-transparent
{% endcapture %}

{% capture stepper_input_class %}
  text-[color:var(--input-text-color)] leading-normal text-size-input
  placeholder-[--input-placeholder-text-color]

  {% comment %} Turn off default keyboard focus style since field should handle that {% endcomment %}
  keyboard-focus:!outline-none
{% endcapture %}

{% capture select %}
  {% render 'stepper',
    id: id,
    name: name,
    form: form,
    min: min,
    max: max,
    value: value,
    disabled: disabled,
    aria_label: label,
    attributes: stepper_attributes,
    input_attributes: stepper_input_attributes,
    button_attributes: stepper_button_attributes,
    input_class: stepper_input_class,
    class: stepper_wrapper_class,
    size: size
  %}
{% endcapture %}

{% render 'field',
  label: label,
  id: id,
  name: name,
  class: field_class,
  label_class: label_class,
  input: select,
  size: size,
  style: style,
  attributes: attributes,
  error_message: error_message,
  success_message: success_message,
  hide_label: hide_label
%}
