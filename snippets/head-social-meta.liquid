<!-- Social meta -->

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
%}
{%- capture og_description -%}
  {%- render 'replace-dose-placeholders', text: og_description -%}
{%- endcapture -%}
{%- assign og_description = og_description | strip -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if request.page_type == 'product' -%}
  {% comment %}
    Product
  {% endcomment %}
  {% liquid
    assign og_price_currency = cart.currency.iso_code
    if product.available
      assign product_availability = 'in stock'
    else
      assign product_availability = 'out of stock'
    endif
  %}
  {% comment %} We can optionally include more than 1 image {% endcomment %}
  {%- for media in product.media limit: 3 -%}
    {% assign image = media.preview_image %}
    <meta property="og:image" content="https:{{ image | image_url }}">
    <meta property="og:image:secure_url" content="https:{{ image | image_url }}">
    <meta property="og:image:alt" content="{{ image.alt | default: product.title | escape }}">
    <meta property="og:image:height" content="{{ image.height }}">
    <meta property="og:image:width" content="{{ image.width }}">
  {%- endfor -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="og:price:currency" content="{{ og_price_currency }}">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="product:price:currency" content="{{ og_price_currency }}">
  {% if product.compare_at_price > product.price %}
    <meta property="product:sale_price:amount" content="{{ product.compare_at_price | money_without_currency }}">
    <meta property="product:sale_price:currency" content="{{ og_price_currency }}">
  {% endif %}
  <meta property="product:availability" content="{{ product_availability }}">
  {% comment %} Rating {% endcomment %}
  {% if product.metafields.reviews.rating.value != blank %}
    <meta property="og:rating" content="{{ product.metafields.reviews.rating.value.rating | round: 1 }}">
    <meta property="og:rating_scale" content="{{ product.metafields.reviews.rating.value.scale_max }}">
    <meta property="og:rating_count" content="{{ product.metafields.reviews.rating_count }}">
  {% endif %}
{%- elsif article -%}
  {% comment %}
    Article
  {% endcomment %}
  {% comment %} Date in ISO 8601 format {% endcomment %}
  <meta property="article:published_time" content="{{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%:z" }}">
  {% if article.author != blank -%}
    <meta property="article:author" content="{{ article.author }}">
  {% endif %}
  {% if article.tags.size > 0 %}
    <meta property="article:tag" content="{{ article.tags | join: ', ' }}">
  {% endif %}
  {% if blog.previous_article %}
    <meta property="og:see_also" content="{{ request.origin | append: blog.previous_article.url }}">
  {% endif %}
  {% if blog.next_article %}
    <meta property="og:see_also" content="{{ request.origin | append: blog.next_article.url }}">
  {% endif %}
{%- elsif page_image -%}
  {% comment %}
    Default
  {% endcomment %}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{% comment %} X has its own meta tag requirements {% endcomment %}
{%- liquid
  assign twitter_image = page_image
  if request.page_type == 'product' and product.featured_image
    assign twitter_image = product.featured_image
  endif
-%}
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'x.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if twitter_image != blank -%}
  <meta name="twitter:image" content="https:{{ twitter_image | image_url }}">
  <meta name="twitter:image:alt" content="{{ twitter_image.alt | default: og_title | escape }}">
{%- endif -%}
