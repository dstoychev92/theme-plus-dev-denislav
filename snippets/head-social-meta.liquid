{% doc %}
  - Renders Open Graph and Twitter meta tags
{% enddoc %}

<!-- Social meta -->

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape_once }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape_once }}">

{%- if request.page_type == 'product' -%}
  {% comment %}
    Product
  {% endcomment %}
  {% liquid
    assign og_price_currency = cart.currency.iso_code
    assign variant = product.selected_or_first_available_variant

    if variant
      assign price = variant.price
      assign compare_at_price = variant.compare_at_price
    else
      assign price = null
      assign compare_at_price = null
    endif

    assign on_sale = false
    if compare_at_price != blank and compare_at_price > price
      assign on_sale = true
    endif

    if product.available
      assign product_availability = 'in stock'
    else
      assign product_availability = 'out of stock'
    endif
  %}
  {% comment %} We can optionally include more than 1 image {% endcomment %}
  {%- for media in product.media limit: 3 -%}
    {% assign image = media.preview_image %}
    <meta property="og:image" content="http:{{ image | image_url }}">
    <meta property="og:image:secure_url" content="https:{{ image | image_url }}">
    <meta property="og:image:alt" content="{{ image.alt | escape_once }}">
    <meta property="og:image:height" content="{{ image.height }}">
    <meta property="og:image:width" content="{{ image.width }}">
  {%- endfor -%}
  <meta property="og:price:amount" content="{{ price | money_without_currency }}">
  <meta property="og:price:currency" content="{{ og_price_currency }}">
  {% # product:sale_price is the discounted price, so on sale product:price carries the compare-at %}
  {% if on_sale %}
    <meta property="product:price:amount" content="{{ compare_at_price | money_without_currency }}">
    <meta property="product:price:currency" content="{{ og_price_currency }}">
    <meta property="product:sale_price:amount" content="{{ price | money_without_currency }}">
    <meta property="product:sale_price:currency" content="{{ og_price_currency }}">
  {% else %}
    <meta property="product:price:amount" content="{{ price | money_without_currency }}">
    <meta property="product:price:currency" content="{{ og_price_currency }}">
  {% endif %}
  <meta property="product:availability" content="{{ product_availability }}">
  {% comment %} Rating {% endcomment %}
  {% if product.metafields.reviews.rating.value != blank %}
    <meta property="og:rating" content="{{ product.metafields.reviews.rating.value | round: 1 }}">
    <meta property="og:rating_scale" content="{{ product.metafields.reviews.rating.value.scale_max }}">
    <meta property="og:rating_count" content="{{ product.metafields.reviews.rating_count }}">
  {% endif %}
{%- elsif article -%}
  {% comment %}
    Article
  {% endcomment %}
  {% comment %} Date in ISO 8601 format {% endcomment %}
  <meta property="article:published_time" content="{{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%:z" }}">
  {% if article.author != blank -%}
    <meta property="article:author" content="{{ article.author }}">
  {% endif %}
  {% if article.tags.size > 0 %}
    <meta property="article:tag" content="{{ article.tags | join: ', ' }}">
  {% endif %}
  {% if blog.previous_article %}
    <meta property="og:see_also" content="{{ request.origin | append: blog.previous_article.url }}">
  {% endif %}
  {% if blog.next_article %}
    <meta property="og:see_also" content="{{ request.origin | append: blog.next_article.url }}">
  {% endif %}
{%- elsif page_image -%}
  {% comment %}
    Default
  {% endcomment %}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:alt" content="{{ page_image.alt | escape_once }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{% comment %} X has its own meta tag requirements {% endcomment %}
{%- if settings.social_x_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_x_link | split: 'x.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape_once }}">
<meta name="twitter:description" content="{{ og_description | escape_once }}">
<meta name="twitter:image" content="https:{{ page_image | image_url }}">
<meta name="twitter:image:alt" content="{{ page_image.alt | escape_once }}">
