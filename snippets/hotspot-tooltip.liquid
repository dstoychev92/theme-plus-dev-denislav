{% capture wrapper_attributes %}
  x-init="$hotspots.register($el)"

  x-data="{
    get index() {
      return $hotspots.indexOf($el)
    },
    get isSelected() {
      return $hotspots.isSelected(this.index)
    },
    set isSelected(value) {
      if (value) {
        $hotspots.select(this.index)
      } else if ($hotspots.isSelected(this.index)) {
        $hotspots.deselect(this.index)
      }
    },
  }"

  {% if request.design_mode %}
    x-effect="isSelected = $containsSelectedBlock"
  {% endif %}
{% endcapture %}

{% capture button_attributes %}
  :id="`{{section.id}}-${ensembleId}-hotspot-${index}`"
  :aria-labelledby="
    ensemblePeerId ? `{{section.id}}-${ensemblePeerId}-element-${index}` : null
  "
  x-custom-cursor:snap-point
  x-popover:button
  :aria-selected="isSelected"
  aria-label="{{ 'other.accessibility.hotspot' | t }}"

  @click.stop.prevent="isSelected = true;"
  x-hover:start="isSelected = true"
  x-hover:end="isSelected = false"

  {{ attributes }}
{% endcapture %}

{% capture float_options %}
  {
    get rootBoundary() {
      return $refs.hotspotsContainerEl
    }
  }
{% endcapture %}

{% capture dot_class %}
  {% render 'props-class-float', _settings: _settings %}
  cursor-[initial]
  {{ class }}
{% endcapture %}

{% capture dot_style %}
  {% render 'props-style-float', _settings: _settings, z_index: 10 %}
  {{ style }}
{% endcapture %}
{% capture dot %}
  {% render 'hotspot-dot',
    _settings: _settings,
    attributes: button_attributes,
    class: dot_class,
    style: dot_style,
  %}
{% endcapture %}

{% capture popover_attributes %}
  {{ wrapper_attributes }}
{% endcapture %}

{% render 'core-popover',
  button: dot,
  content: content,
  class: class,
  style: style,
  popover_options: popover_options,
  float_options: float_options,
  attributes: popover_attributes
%}
