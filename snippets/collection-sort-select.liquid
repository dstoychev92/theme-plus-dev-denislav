{% liquid
  assign sort_label = 'collection.sort_by' | t
  assign initial_sort_value = collection.sort_by | default: collection.default_sort_by
  assign initial_sort_display = null
%}

{% capture options %}
  {% for sort_option in collection.sort_options %}
    {%- if initial_sort_value == sort_option.value -%}
      {%- assign initial_sort_display = sort_option.name -%}
    {%- endif -%}
    {% capture option_content %}
      {{ sort_option.name }}
    {% endcapture %}
    {% capture option_display_value %}
      <span aria-hidden="true" class="absolute inset-0 flex flex-center hover-effect-text-highlight h-full pointer-events-none">
        {{ sort_option.name }}
      </span>
      {{ sort_option.name }}
    {% endcapture %}
    {% render 'custom-select-option', label:option_content, display_value: option_display_value, value: sort_option.value %}
  {% endfor %}
{% endcapture %}

{% capture attributes %}
  {% comment %} When the custom select value changes, autosubmit the associated form {% endcomment %}
  @change="$refs.collectionFiltersForm.requestSubmit()"
{% endcapture %}

{% capture button_content %}
  {% render 'core-icon', icon: 'fill-sort', size: 'md' %}

  {% comment %} Desktop {% endcomment %}
  <span
    class="truncate relative text-ellipsis flex-1 max-md:hidden leading-[1.5]"
    x-select:display
  >
    <span aria-hidden="true" class="absolute inset-0 flex flex-center hover-effect-text-highlight h-full pointer-events-none">
      {{ initial_sort_display }}
    </span>
    {{ initial_sort_display }}
  </span>

  {% comment %} Mobile {% endcomment %}
  <span class="md:hidden">
    {{ 'collection.sort' | t }}
  </span>
{% endcapture %}

{% capture button_attributes %}
  x-select:button
{% endcapture %}

{% capture button %}
  {% render 'core-button',
    content: button_content,
    color: 'content',
    appearance: 'outline',
    sizing: 'sm',
    type_resize: 'sm',
    attributes: button_attributes
  %}
{% endcapture %}

{% render 'custom-select',
  name: 'sort_by',
  size: 'sm',
  label: sort_label,
  options: options,
  value: initial_sort_value,
  button: button,
  attributes: attributes,
  form: form,
  class: class,
  popup_class: 'md:min-w-fit [--custom-select-popup-radius:min(var(--radius-btn),16px)]',
  rounding: rounding
%}
