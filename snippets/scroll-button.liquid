{% doc %}
  - Renders button that scrolls past the current section

  Absolutely positioned, and reads $sectionEl, so it needs a positioned ancestor inside the
  section's Alpine scope.

  @param {string} [attributes]
  @param {string} [class] - The classes
{% enddoc %}

<button
  class="absolute bottom-r5 left-1/2 -translate-x-1/2 !z-20 px-r10 py-r3 pointer-events-all {{ class }}"
  aria-label="{{ 'other.accessibility.scroll_down' | t }}"
  {% comment %} Scroll down to the next section {% endcomment %}
  @click.prevent.stop="
    window.scroll({
      top: $sectionEl.offsetTop + $sectionEl.clientHeight,
      left: 0,
      behavior: 'smooth'
    })
  "
  {{ attributes }}
>
  {% render 'core-icon', icon: 'stroke-chevron-down', size: 'xl', class: 'animate-bounce pointer-events-none' %}
</button>
