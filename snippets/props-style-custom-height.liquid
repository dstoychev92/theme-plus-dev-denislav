{%- liquid
  assign set_height = set_height | default: _settings.set_height, allow_false: true | default: true, allow_false: true
  assign height = height | default: _settings.height
  assign custom_height_type = custom_height_type | default: _settings.custom_height_type
  assign custom_height_percentage = custom_height_percentage | default: _settings.custom_height_percentage
  assign custom_height_px = custom_height_px | default: _settings.custom_height_px

  assign set_height_mobile = set_height_mobile | default: _settings.set_height_mobile, allow_false: true
  assign height_mobile = height_mobile | default: _settings.height_mobile
  assign custom_height_type_mobile = custom_height_type_mobile | default: _settings.custom_height_type_mobile
  assign custom_height_percentage_mobile = custom_height_percentage_mobile | default: _settings.custom_height_percentage_mobile
  assign custom_height_px_mobile = custom_height_px_mobile | default: _settings.custom_height_px_mobile
-%}
{% if set_height %}
  {%- if height == 'custom' -%}
    {% case custom_height_type %}
      {% when 'percentage' %}
        {% comment %} 'svh' is handled by the .vars-custom-height-svh-support class {% endcomment %}
        --custom-height-unit: 1vh; --custom-height-value: {{ custom_height_percentage }};
      {% when 'px' %}
        --custom-height-unit: 1px; --custom-height-value: {{ custom_height_px }};
    {% endcase %}
    --custom-height: calc(var(--custom-height-value) * var(--custom-height-unit));

  {%- elsif height == 'image' or height == 'content' -%}
    --custom-height: fit-content;

  {%- elsif height != blank -%}
    --custom-height: var(--height-{{ height }});
  {%- endif -%}
{% endif %}

{% if set_height_mobile %}
  {%- if height_mobile == 'custom' -%}
    {% case custom_height_type_mobile %}
      {% when 'percentage' %}
        {% comment %} 'svh' is handled by the .vars-custom-height-svh-support class {% endcomment %}
        --mobile-custom-height-unit: 1vh; --mobile-custom-height-value: {{ custom_height_percentage_mobile }};
      {% when 'px' %}
        --mobile-custom-height-unit: 1px; --mobile-custom-height-value: {{ custom_height_px_mobile }};
    {% endcase %}
    --mobile-custom-height: calc(var(--mobile-custom-height-value) * var(--mobile-custom-height-unit));

  {%- elsif height_mobile == 'image' or height_mobile == 'content' -%}
    --mobile-custom-height: fit-content;

  {%- elsif height_mobile != blank -%}
    --mobile-custom-height: var(--height-{{ height_mobile }});
  {%- endif -%}
{%- endif -%}
