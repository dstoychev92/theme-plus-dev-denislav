<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="{{ shop.brand.colors.secondary[0].background }}">

<!-- ======================= Pipeline Theme V9.0.0 ========================= -->

<!-- Title and description -->
{%- if settings.favicon != blank -%}
  <link id="favicon" rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{%- else -%}
  {% # theme-check-disable RemoteAsset %}
  <link id="favicon" rel="shortcut icon" href="data:;base64,iVBORw0KGgo=">
  {% # theme-check-enable RemoteAsset %}
{%- endif -%}

{%- comment -%} Animated favicon (desktop only): cycles Favicon01..07.jpg every 700ms. {%- endcomment -%}
<script>
  (function() {
    if (!window.matchMedia || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var frames = [
      {{ 'Favicon01.jpg' | asset_url | json }},
      {{ 'Favicon02.jpg' | asset_url | json }},
      {{ 'Favicon03.jpg' | asset_url | json }},
      {{ 'Favicon04.jpg' | asset_url | json }},
      {{ 'Favicon05.jpg' | asset_url | json }},
      {{ 'Favicon06.jpg' | asset_url | json }},
      {{ 'Favicon07.jpg' | asset_url | json }}
    ];
    /* Preload all frames so the cycle doesn't stutter on first pass */
    frames.forEach(function(src) { var i = new Image(); i.src = src; });
    var link = document.getElementById('favicon');
    if (!link) return;
    link.type = 'image/jpeg';
    var idx = 0;
    setInterval(function() {
      link.href = frames[idx];
      idx = (idx + 1) % frames.length;
    }, 700);
  })();
</script>

<title>
  {%- if page_title != blank -%}
    {{ page_title }}
    {%- if current_tags -%}
      {%- assign tag_list = current_tags | join: ', ' -%}
      &ndash; {{ 'boom.meta.tagged_with' | t: tags: tag_list }}
    {%- endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'collection.pagination.page_number' | t: page: current_page }}{% endif -%}
    {%- assign page_title_lower = page_title | downcase -%}
    {%- assign shop_name_lower = shop.name | downcase -%}
    {%- unless page_title_lower contains shop_name_lower %} &ndash; {{ shop.name }}{% endunless -%}
  {% else %}
    {{ shop.name }}
  {% endif -%}
</title>

{% if page_description %}
  {%- capture meta_description -%}
    {%- render 'replace-dose-placeholders', text: page_description -%}
  {%- endcapture -%}
  <meta name="description" content="{{ meta_description | strip | escape }}">
{% endif %}

