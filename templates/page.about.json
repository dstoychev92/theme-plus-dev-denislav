                  ]
                },
                "accordion_3hmBBp_anlgv0p0": {
                  "type": "_accordion",
                  "settings": {
                    "title": "Materials",
                    "expand": false,
                    "type_preset": "accordion",
                    "type_resize": "md",
                    "type_font": "body",
                    "type_size": 4,
                    "type_uppercase": false
                  },
                  "blocks": {
                    "theme_richtext_ArhAwb_anlgv0p0": {
                      "type": "theme-richtext",
                      "settings": {
                        "text": "<p>We hunt down the best materials we can find and ask annoying questions until we're sure. If something better exists, we use it. If it doesn't exist yet, we wait.</p>",
                        "richtext_size": "md",
                        "limit_width": false,
                        "max_width": 500,
                        "set_color": false,
                        "color": "content",
                        "color_custom": "#000000"
