                  "settings": {
                    "title": "Production",
                    "expand": false,
                    "type_preset": "accordion",
                    "type_resize": "md",
                    "type_font": "body",
                    "type_size": 4,
                    "type_uppercase": false
                  },
                  "blocks": {
                    "theme_richtext_1atAIF_anlgv0p0": {
                      "type": "theme-richtext",
                      "settings": {
                        "text": "<p>We work with small-batch producers who share our standards: real craftsmanship, fair labor, quality you can count on. We visit, we ask questions, we stay close.</p>",
                        "richtext_size": "md",
                        "limit_width": false,
                        "max_width": 500,
                        "set_color": false,
                        "color": "content",
