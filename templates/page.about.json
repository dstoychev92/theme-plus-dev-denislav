                    "theme_richtext_MlOea6_anlgv0p0": {
                      "type": "theme-richtext",
                      "settings": {
                        "text": "<p>Before anything reaches you, we live with it. We wear it, wash it, stretch it, and occasionally try to break it. The only way to know if something works is to use it for real.</p>",
