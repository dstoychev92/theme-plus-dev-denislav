                    "type_uppercase": false
                  },
                  "blocks": {
                    "theme_richtext_vS3nPI_anlgv0p0": {
                      "type": "theme-richtext",
                      "settings": {
                        "text": "<p>We start with the problem the product needs to solve, then sketch, prototype, and test it. Function comes first; form follows.</p>",
                        "richtext_size": "md",
                        "limit_width": false,
                        "max_width": 500,
                        "set_color": false,
