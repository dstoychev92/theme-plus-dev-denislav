            "theme_richtext_FBMD4F": {
              "type": "theme-richtext",
              "name": "Rich Text",
              "settings": {
                "text": "<p>10g суроватъчен протеин, D3, магнезий и B-комплекс в 5g арабика кафе. Ситост до 3 часа и мускулна подкрепа. 22 дози в пакет, 5 вкуса.</p>",
