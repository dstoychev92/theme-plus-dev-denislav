            "type_uppercase": false
          },
          "blocks": {
            "theme_richtext_EUxqUN": {
              "type": "theme-richtext",
              "settings": {
                "text": "<p>Разбъркай 1 мерителна лъжичка с 100-150ml гореща или студена вода. Можеш да добавиш мляко по желание.</p>",
